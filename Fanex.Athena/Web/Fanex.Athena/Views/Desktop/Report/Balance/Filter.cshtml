@model Fanex.Athena.Model.Report.ViewModel.BalanceViewModel

<div class="page-form">
    @using (Html.BeginForm("Index", "BalanceReport", FormMethod.Post, new { @id = "BalanceForm" }))
    {
        @Html.AntiForgeryToken()
        //-----------------------------Hidden Field-------------------------------//

        @Html.Hidden("IsExportExcel", Model.Param.IsExportExcel)
        @Html.Hidden("FromDate", Model.Param.FromDate)
        @Html.Hidden("ToDate", Model.Param.ToDate)

        <div class="row">
            @*// ----------------------------Type of licensee---------------------------//*@
            @if (Model.LicenseeTypeList.Count > 0)
            {
                <div class="col l2 m2 s12 input-field">
                    @RazorHelperDesktop.LicenseeType(Model.LicenseeTypeList, "select licenseetype", Model.Param.LicenseeType)
                    <label>@ViewResources.Type</label>
                </div>
            }

            @*// -----------------------------Currency-----------------------------------//*@
            <div class="col l2 m2 s12 input-field">
                @RazorHelperDesktop.CurrencyList(Model.CurrencyList, "select CurrencyId", Model.Param.CurrencyId)
                <label>@ViewResources.Currency</label>
            </div>

            @*// -----------------------------Base Currency-----------------------------------//*@
            <div class="col l2 m2 s12 input-field">
                @RazorHelperDesktop.BasedCurrency(Model.Param.BaseCurrency)
                <label>@ViewResources.Based</label>
            </div>

            @*// -----------------------------Month-----------------------------------//*@
            <div class="col l2 m2 s12 input-field">
                @RazorHelperDesktop.MonthDropDownList(Model.Param.FromDate.Month)
                <label>@ViewResources.Month</label>
            </div>

            @*// -----------------------------Year-----------------------------------//*@
            <div class="col l2 m2 s12 input-field">
                @RazorHelperDesktop.YearDropDownList(Model.Param.FromDate.Year, 5)
                <label>@ViewResources.Year</label>
            </div>

            <div class="col l1 m2 s12 button-block">
                <a id="SubmitButton" class="waves-effect waves-light btn btn-primary">@ViewResources.Submit</a>
            </div>

            <div class="col right icon-block">
                <i class="icon-excel right" title="@ViewResources.ExportToExcel" id="ExportToExcel"></i>
            </div>
        </div>
    }
</div>
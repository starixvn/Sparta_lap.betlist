@using Fanex.Athena.Models.ViewModel
@using Fanex.Athena.Extension.Helper
@model Fanex.Athena.Models.ViewModel.Report.TurnoverViewModel
@{
    var isDataAvailable = Model.DataList != null && Model.DataList.Count > 0;
}
<div class="container_26 new-line" style="width:@(ViewBag.FilterWidth + 12)@("px");">
    <div class="grid_26">
        <div class="report-title" style="width:@ViewBag.TitleWidth@("px");">
            @{ 
                var currencyName = @Model.Param.IsConvert ? @Model.Param.BaseCurrency : @Model.CurrencyList.FirstOrDefault(a => a.Value == Model.Param.CurrencyId).Key;
                var formatCurrency = "{0} {1}";
                var formatTitle = "{0}, {1} - {2}";
                var formatTitleUserName = "{0}, {1} - {2} {3} ({4})";
            }
            @if (Model.Param.Username.IsEmpty())
            {
                var currencyTitle = Model.Param.IsConvert
                    ? string.Format(formatCurrency, ViewResources.Viewin, Model.Param.BaseCurrency.ToUpper())
                    : string.Format(formatCurrency, ViewResources.Viewin, currencyName.ToUpper());
                
                @(string.Format(formatTitle,
                                ViewResources.Turnover,
                                RazorHelper.TitleDateTime(Model.Param.FromDate, Model.Param.ToDate),
                                currencyTitle))
            }
            else
            {
                @(string.Format(formatTitleUserName,
                                ViewResources.Turnover,
                                RazorHelper.TitleDateTime(Model.Param.FromDate, Model.Param.ToDate),
                                ViewResources.Customer,
                                Model.Param.Username,
                                currencyName))
            }
        </div>
        <div class="report-content " style="width:@(ViewBag.WrapperWidth)px;">
            @{Html.RenderPartial("~/Views/Report/Turnover/Content.Header.cshtml");}
            @if (!isDataAvailable)
            {
                <!--No result-->
                Html.RenderPartial("~/Views/Report/Turnover/Content.Data.Empty.cshtml");
            }
            else
            {
                Html.RenderPartial("~/Views/Report/Turnover/Content.Data.cshtml");
            }
            @if (isDataAvailable)
            {
                Html.RenderPartial("~/Views/Report/Turnover/Content.Total.cshtml");
            }
        </div>
    </div>
</div>

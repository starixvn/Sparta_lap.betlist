@{
    Layout = null;
    var total = Model.TotalData; //total
}
@using Fanex.Athena.Extension.Helper
@using Fanex.Athena.Models.ViewModel
@model Fanex.Athena.Models.ViewModel.Report.PlaytechCasinoViewModel
@if (Model.MainData != null && Model.MainData.Count > 0)
{  
    var isFirst = true;
    var colSpan = Model.Param.Level == 2 ? 3 : 2;
    <div id="ContentMainFooter" style="width:@(ViewBag.WrapperWidth)@("px");">
        <table id="TableTotal" class="total-table" cellpadding="0" cellspacing="0" style="width:@(ViewBag.ContainerWidth)@("px");">
            @foreach (var item in Model.TotalData)
            {
                <tr class="total-rows @(isFirst ? "total-first-row" : string.Empty)" style="width:@ViewBag.ContainerWidth@("px");">
                    @if(isFirst)
                    {
                        isFirst = false;
                    <td class="row title-text" rowspan="@Model.TotalData.Count" colspan="@(colSpan++)">
                        @ViewResources.Total
                    </td>
                    }
                    <td class="row title-text" style="width:@ViewBag.CurrencyWidth@("px")">
                        @item.CurrencyName
                    </td>
                    <td class="row" style="width:@ViewBag.TurnoverWidth@("px")">
                        <div>@item.Turnover.ToStringExt()</div>
                    </td>
                    <td class="row" style="width:@ViewBag.TotalTransWidth@("px")">
                        <div>@item.TotalTrans.ToString("#,##")</div>
                    </td>
                    <td class="row line-height" style="width:@ViewBag.CustomerWLWidth@("px")">
                        <div>@item.CustomerWinLoss.ToStringExt()</div>
                    </td>
                    <td class="row highlight" style="width:@ViewBag.LicenseeWLWidth@("px")">
                        @FormatHelper.NegativeFormat(item.LicenseeWinLoss)
                    </td>
                </tr>                
            }
            <tr class="total-rows grant-total-row" style="width:@ViewBag.ContainerWidth@("px")">
                <td class="row title-text" colspan="@colSpan">
                    @ViewResources.Totalin @ViewResources.USD
                </td>
                <td class="row" style="width:@ViewBag.TurnoverWidth@("px")">
                    <div>@Model.TotalInUsd.Turnover.ToStringExt()</div>
                </td>
                <td class="row" style="width:@ViewBag.TotalTransWidth@("px")">
                    <div>@Model.TotalInUsd.TotalTrans.ToString("#,##")</div>
                </td>
                <td class="row line-height" style="width:@ViewBag.CustomerWLWidth@("px")">
                    <div>@Model.TotalInUsd.CustomerWinLoss.ToStringExt()</div>
                </td>
                <td class="row highlight" style="width:@(ViewBag.LicenseeWLWidth)@("px")">
                    @FormatHelper.NegativeFormat(Model.TotalInUsd.LicenseeWinLoss)
                </td>
            </tr>
            <tr class="total-rows grant-total-row" style="width:@ViewBag.ContainerWidth@("px");">
                <td class="row title-text" colspan="@colSpan">
                    @ViewResources.Totalin @ViewResources.EUR
                </td>
                <td class="row" style="width:@ViewBag.TurnoverWidth@("px")">
                    <div>@Model.TotalInEur.Turnover.ToStringExt()</div>
                </td>
                <td class="row" style="width:@ViewBag.TotalTransWidth@("px")">
                    <div>@Model.TotalInEur.TotalTrans.ToString("#,##")</div>
                </td>
                <td class="row line-height" style="width:@ViewBag.CustomerWLWidth@("px")">
                    <div>@Model.TotalInEur.CustomerWinLoss.ToStringExt()</div>
                </td>
                <td class="row highlight" style="width:@(ViewBag.LicenseeWLWidth)@("px")">
                    @FormatHelper.NegativeFormat(Model.TotalInEur.LicenseeWinLoss)
                </td>
            </tr>
        </table>
    </div>
}
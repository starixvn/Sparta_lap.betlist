@model Fanex.Athena.Model.Report.ViewModel.DailyRacingWinLossViewModel
@{
    var grandTotalData = Model.DailyRacingWinLossData.GrandTotalData;
}

@*------------------------------------- MYR -------------------------------------*@
<tr class="total">
    <td colspan="2" class="center-align text-bold">@ViewResources.GrandTotalIn @ViewResources.MYR</td>

    <td class="right-align text-bold">@grandTotalData.WinTOMYR.ToStringExt()</td>
    <td class="right-align text-bold">@grandTotalData.PlaceTOMYR.ToStringExt()</td>
    <td class="right-align text-bold">@grandTotalData.WPTOMYR.ToStringExt()</td>
    <td class="right-align text-bold">@grandTotalData.TotalTOMYR.ToStringExt()</td>
    <td class="right-align text-bold">@grandTotalData.DividendWonMYR.ToStringExt()</td>
    @if (Model.IsAllowedCustomerCommission)
    {
        <td class="right-align text-bold">@grandTotalData.CustomerCommissionMYR.ToStringExt()</td>
    }

    <td class="right-align text-bold">@grandTotalData.CommIncomeMYR.ToStringExt()</td>
    <td class="right-align text-bold">@grandTotalData.AmountDueToRacingMYR.ToStringExt()</td>
</tr>


@model Fanex.Athena.Model.Report.ViewModel.LiveReports.LiveReportMatchListViewModel

@{
    var index = 0;
    foreach (var item in Model.MainResult)
    {
        var drillDownParam = new
        {
            item.BetCount,
            item.CustomerWinLoss,
            item.CustomerComm,
            item.LicenseeWinLoss,
            item.LicenseeComm,
            item.TurnOver,
            item.AmountDue,
            item.BetType,
            item.MatchId,
            item.HomeId,
            item.AwayId,
            LiveIndicator = Model.Param.LiveIndicator
        };

        <tr>
            <td>
                @{
                    var matchName = WebUtility.HtmlDecode(item.MatchName);
                }
                <a href="javascript:;" class="match-detail-link" data-drill-down="@drillDownParam.ToJson()" title="@matchName">
                    @(matchName.Length > 60 ? matchName.Substring(0, 60) + "..." : matchName)
                </a>
            </td>

            @ReportContentHelperDesktop.RenderCustomerWinLossForLiveReport(item, Model.IsAllowedCustomerCommission)

            <td class="right-align">@item.TurnOver.ToStringExt()</td>
            <td class="right-align">@item.BetCount.ToStringExt()</td>
            <td class="right-align highlight">@RazorHelperDesktop.HighlightNegativeFormat(item.LicenseeWinLoss)</td>

            @if (Model.ProductAccess.IsAllowRB || Model.ProductAccess.IsAllowBA)
            {
                <td class="right-align highlight">@item.LicenseeComm.ToStringExt()</td>
            }

            <td class="right-align">@item.AmountDue.ToStringExt()</td>
        </tr>
    }
}
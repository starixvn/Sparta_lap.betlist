@{
    ViewBag.Title = "LRF - " + ViewResources.Report +
    " - " + ViewResources.MatchWinLoss;
    Layout = "~/Views/Shared/_ReportTableLayout.cshtml";
}
@using Fanex.Athena.Models.ViewModel
@using Fanex.Athena.Model.Core.DTO.Common
@using Fanex.Athena.Model.Report.ViewModel
@model MatchWinLossViewModel
@section pagecss {    
    <link href="@Url.ContentLink("/Content/Report/matchWinLoss.css")" rel="stylesheet" type="text/css" />
}
@section pagejs {    
    <script src="@Url.ContentLink("/Scripts/Report/matchwinloss.js")" type="text/javascript"></script>
}
@section ContentTitle
    {
    @ViewResources.MatchWinLoss
}
@section ContentFilter
{
    @{        
        Html.RenderPartial("~/Views/Report/MatchWinLoss/Filter.cshtml");
    }
}
@{
    if (!Model.ShowEmptyContent)
    {
        Html.RenderPartial("~/Views/Report/MatchWinLoss/Content.cshtml");
    }
}

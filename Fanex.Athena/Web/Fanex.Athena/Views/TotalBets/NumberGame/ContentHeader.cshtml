@{
    <thead>
        <tr class="report-header">
            <td style="width: 3%" rowspan="2">
                #
            </td>
            <td style="width: 14%" rowspan="2">@ViewResources.Event
            </td>
            <td style="width: 14%" colspan="2">@ViewResources.Warrior
            </td>
            <td style="width: 8%" colspan="2">@ViewResources.lbl1stBall
            </td>
            <td style="width: 8%" colspan="2">@ViewResources.LastBall
            </td>
            <td style="width: 16%" colspan="3">@ViewResources.NextBall
            </td>
            <td style="width: 16%" colspan="4">@ViewResources.NextCombo
            </td>
            <td style="width: 6%" rowspan="2">@ViewResources.FullTimeOE
            </td>
            <td style="width: 14%" colspan="2">@ViewResources.NumberWheel
            </td>
        </tr>
        <tr class="report-header">
            <td style="width: 8%">@ViewResources.lbl2ndballwin
            </td>
            <td style="width: 8%">@ViewResources.lbl3rdballwin
            </td>
            <td style="width: 4%">
                @ViewResources.O_U
            </td>
            <td style="width: 4%">
                @ViewResources.O_E
            </td>
            <td style="width: 4%">
                @ViewResources.O_U
            </td>
            <td style="width: 4%">
                    @ViewResources.O_E
            </td>
            <td style="width: 5%">
                    @ViewResources.O_U
            </td>
            <td style="width: 5%">
                @ViewResources.O_E
            </td>
            <td style="width: 6%">
            @ViewResources.HighLow
            </td>
            <td style="width: 4%">
                @ViewResources.O_O
            </td>
            <td style="width: 4%">
                    @ViewResources.U_O
            </td>
            <td style="width: 4%">
                @ViewResources.NextCombo_O_E
            </td>
            <td style="width: 4%">
                @ViewResources.NextCombo_U_E
            </td>
            <td style="width: 7%">@ViewResources.LiveGame
            </td>
            <td style="width: 7%">@ViewResources.PreGame
            </td>
        </tr>
    </thead>
}
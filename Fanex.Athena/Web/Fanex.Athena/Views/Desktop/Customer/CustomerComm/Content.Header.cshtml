<thead>
    <tr>
        <th style="width: 4%">#</th>
        <th style="width: 8%">@ViewResources.GroupId</th>
        <th style="width: 20%">@ViewResources.GroupName</th>
        <th style="width: 8%">@ViewResources.DefaultGroup</th>
        <th style="width: 10%">@ViewResources.NoOfCustmer</th>
        <th style="width: 8%">@ViewResources.SBComm (%)</th>
        @if (ViewBag.IsAllowRC)
        {
            <th style="width: 8%">@ViewResources.RacingComm (%)</th>
        }
        @if (ViewBag.IsAllowNG)
        {
            <th style="width: 8%">@ViewResources.NGComm (%)</th>
        }
        @if (ViewBag.IsAllowLC)
        {
            <th style="width: 8%">@ViewResources.LCComm (%)</th>
        }
        @if (ViewBag.IsAllowCS)
        {
            <th style="width: 8%">@ViewResources.CSComm (%)</th>
        }
        <th style="width: 10%">@ViewResources.GroupColor</th>
        <th style="width: 10%">@ViewResources.EditGroup</th>
    </tr>
</thead>
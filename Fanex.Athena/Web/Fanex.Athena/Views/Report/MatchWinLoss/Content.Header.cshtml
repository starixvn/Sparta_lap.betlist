@using Fanex.Athena.Model.Report.ViewModel
@model Fanex.Athena.Model.Report.ViewModel.MatchWinLossViewModel
@{
    var rowSpan = Model.IsAllowedCustomerCommission ? 2: 1;
}
<table class="report-table">
    <thead>
        <tr class="report-header">
            <td style="width: 30px" rowspan="@rowSpan">
                #
            </td>
            <td rowspan="@rowSpan">@ViewResources.Match
            </td>
            <td style="width: 85px" rowspan="@rowSpan">@ViewResources.Turnover
            </td>
            <td style="width: 70px" rowspan="@rowSpan">@ViewResources.TotalTransaction
            </td>
            <td style="width: @(Model.IsAllowedCustomerCommission ? "230px" : "85px")" colspan="@(Model.IsAllowedCustomerCommission ? 3 : 1)">@ViewResources.CustomerW_L
            </td>
            <td style="width: 85px" rowspan="@rowSpan">
                @ViewResources.LicenseeW_L
            </td>
            @{
                if (Model.ProductAccess.IsAllowBA)
                {
                <td style="width: 60px" rowspan="@rowSpan">@ViewResources.BACommission
                </td>
                }
            }
            @if (Model.ProductAccess.IsAllowRB)
            {
                <td style="width: 70px" rowspan="@rowSpan">@ViewResources.RacingRevenue
                </td>
            }
            @if (Model.ProductAccess.IsAllowBA)
            {
                <td style="width: 70px" rowspan="@rowSpan">@ViewResources.AmtDueToBA
                </td>
            }
            @if (Model.ProductAccess.IsAllowRB)
            {
                <td style="width: 70px" rowspan="@rowSpan">@ViewResources.AmtDueToRacing
                </td>
            }
        </tr>
        @if (Model.IsAllowedCustomerCommission)
        {
            <tr class="report-header">
                <td style="width: 85px">
                    @ViewResources.WinLoss
                </td>
                <td style="width: 60px">
                    @ViewResources.Commission
                </td>
                <td style="width: 85px">
                    @ViewResources.Total
                </td>
            </tr>
        }
    </thead>
</table>

@{
    Layout = null;
}

@using Fanex.Athena.Models.ViewModel.Report
@using Fanex.Athena.Models.DataDomain;
@model PlatformWinLossViewModel

<div class="theme_jqGrid">
    <div class="container_26">
        <div class="grid_26 mobile_winloss">
            <div class="breadCrumbHolder module hide">
                <div id="level-link-container" class="breadCrumb module">
                    <ul>
                        <li class="level0 hide level-link" data-level="0">@ViewResources.Main</li>
                        <li class="last level1 hide level-link" data-level="1">@ViewResources.Member</li>
                    </ul>
                </div>
            </div>
            <div class="report-title hide">
                @{
                    var currencyText = Model.Param.CurrencyId == 0
                        ? ViewResources.AllCurrencies
                        : string.Format(ViewResources.Viewin, Model.Param.IsConvert
                                ? Model.Param.BaseCurrency
                                : Model.Param.CurrencyName);
                    var siteText = ViewResources.Platform + ": " + PlatformType.GetPlatformName(Model.Param.PlatformType);
                }

                @ViewResources.PlatformWinLoss,
                @RazorHelper.TitleDateTime(Model.Param.FromDate,Model.Param.ToDate)
                @currencyText -
                @siteText
            </div>
            <div class="report-content ">
                <div style="width: 100%">
                    <table id="ReportGrid" data-hidden-column="">
                        <tr>
                            <td>
                            </td>
                        </tr>
                    </table>
                    <div id="ppdata">
                    </div>
                    <div id="footer" class="hide">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@{
    // Game type:  Keno Chinese, Keno Camera //
    Layout = null; 
}
<link href="@Url.ContentLink("/Content/RNGCasino/rng-casino-hand-history.css")" rel="stylesheet" type="text/css" />
@model Fanex.Athena.Model.Casino.ViewModel.CasinoHandHistoryDetailViewModel
@{
    var headerItem = Model.CasinoDetailHeaderList.FirstOrDefault();
}
<table style="width: 100%;" class="casino-detail-table" cellpading="0" cellspacing="0">
    <tr class="detail-header-row">
        <td class="game-type-text" colspan="3">@Model.Param.GameTypeName - @headerItem.BetTime
        </td>
    </tr>
    <tr class="player-total-row">
        <td colspan="3">
            @ViewResources.Player: @headerItem.UserName - @string.Format(ViewResources.Viewin,Model.Param.CurrencyName)
        </td>
    </tr>
    <tr class="detail-header-row">
        <td colspan="3">
            @headerItem.ResultName
        </td>
    </tr>
    <tr>
        <td colspan="3">
            <table style="width: 100%;" class="casino-detail-table" cellpading="0" cellspacing="0">
                @{
                    var results = headerItem.Result.Split(',');
                    if (!string.IsNullOrEmpty(headerItem.Result) && results.Length == 20)
                    {
                        <tr>
                            @for (int i = 0; i < 10; i++)
                            {
                                <td>@results[i]
                                </td>
                            }
                        </tr>
                        <tr>
                            @for (int i = 10; i < 20; i++)
                            {
                                <td>@results[i]
                                </td>
                            }
                        </tr>
                    }
                }
            </table>
        </td>
    </tr>
    <tr>
        <td>@ViewResources.PlayerHistoryNo
        </td>
        <td colspan="2" class="align-left">@Model.Param.PlayerHistoryNo
        </td>
    </tr>
    <tr>
        <td>@ViewResources.AutoPlay
        </td>
        <td colspan="2" class="align-left">@headerItem.AutoPlayResult
        </td>
    </tr>
    <tr class="detail-header-row">
        <td>
        </td>
        <td>@ViewResources.Characters or @ViewResources.Number
        </td>
        <td>
            #
        </td>
    </tr>
    <tr>
        <td>@ViewResources.Pick
        </td>
        <td>@headerItem.PickNo
        </td>
        <td>@headerItem.PickCount
        </td>
    </tr>
    <tr>
        <td>@ViewResources.Hit
        </td>
        <td>@headerItem.HitNo
        </td>
        <td>@headerItem.HitCount
        </td>
    </tr>
    <tr class="player-total-row">
        <td class="align-left">@ViewResources.Bet
        </td>
        <td colspan="2" class="align-right">@Model.CasinoDetailList.Sum(p => p.Bet).ToStringExt()
        </td>
    </tr>
    <tr class="player-total-row">
        <td class="align-left">@ViewResources.Odds
        </td>
        <td colspan="2" class="align-right">@Model.CasinoDetailList.Sum(p => p.Odds).ToStringExt()
        </td>
    </tr>
    <tr class="player-total-row">
        <td class="align-left">@ViewResources.Win/@ViewResources.Loss
        </td>
        <td colspan="2" class="align-right">@Model.CasinoDetailList.Sum(p => p.WinLoss).ToStringExt()
        </td>
    </tr>
</table>

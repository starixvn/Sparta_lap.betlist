@using Fanex.Athena.Extension.Helper
@using Fanex.Athena.Extension.Utility
@using Fanex.Athena.Models.DTO.Common
@model Fanex.Athena.Models.ViewModel.Report.MatchWinLossViewModel
@{
    ViewBag.Title = null;
    Layout = null;
}
@{
    var matchWinlossList = Model.MainResult;
    var productAccess = Model.ProductAccess;

    foreach (var matchWinloss in matchWinlossList)
    {
    <tr class="expand">
        <td class="bet-type">
            @{
        var drillDownParam = new
        {
            LeagueId = matchWinloss.LeagueId,
            MatchId = matchWinloss.MatchId,
            BetType = matchWinloss.BetType,
            RaceNo = matchWinloss.RaceNo,
            IsLive = matchWinloss.IsLive,
            HomeId = matchWinloss.HomeId,
            AwayId = matchWinloss.AwayId,
        };
            }
            <span class="downline-link" onclick="MatchWinLoss.viewMatchWinlossBetList(@drillDownParam.ToJson())">
               @matchWinloss.BettypeName
            </span>
        </td>
        <td>
            @NumberHelper.DecFormat(matchWinloss.Turnover, 2)
        </td>
        <td>
            @matchWinloss.TotalTransaction.ToString("#,###")
        </td>
        @if (Model.IsAllowedCustomerCommission)
        {
            <td>
                @NumberHelper.DecFormat(matchWinloss.CustomerWL, 2)
            </td>
            <td>
                @NumberHelper.DecFormat(matchWinloss.CustomerComm, 2)
            </td>
            <td>
                @NumberHelper.DecFormat(matchWinloss.CustomerWL + matchWinloss.CustomerComm, 2)
            </td>
        }
        else
        {
            <td>
                @NumberHelper.DecFormat(matchWinloss.CustomerWL, 2)
            </td>
        }
        <td class="highlight">
            @RazorHelper.NegativeFormat(matchWinloss.LicenseeWL)
        </td>
        @if (Model.ProductAccess.IsAllowBA)
        {
            <td class="highlight">
                @RazorHelper.NegativeFormat(matchWinloss.BACommission)
            </td>
        }
        @if (Model.ProductAccess.IsAllowRB)
        {
            <td class="highlight">
                @RazorHelper.NegativeFormat(matchWinloss.RacingRevenue)
            </td>
        }
        @if (Model.ProductAccess.IsAllowBA)
        {
            <td>
                @NumberHelper.DecFormat(matchWinloss.AmtDueToBA, 2)
            </td>
        }
        @if (Model.ProductAccess.IsAllowRB)
        {
            <td>
                @NumberHelper.DecFormat(matchWinloss.AmtDueToRacing, 2)
            </td>
        }
    </tr>
    }
}

@{
    Layout = null;
}
<link href="@Url.ContentLink("/Content/RNGCasino/rng-casino-hand-history.css")" rel="stylesheet" type="text/css" />
@model Fanex.Athena.Models.ViewModel.Casino.RNGResultDetail.CasinoHandHistoryDetailViewModel
@{
    var headerItem = Model.CasinoDetailHeaderList.FirstOrDefault();
}
<table style="width: 100%;" class="casino-detail-table" cellpading="0" cellspacing="0">
    <tr class="detail-header-row">
        <td class="game-type-text" colspan="4">@Model.Param.GameTypeName - @headerItem.BetTime
        </td>
    </tr>
    <tr class="player-total-row">
        <td colspan="4">
            @ViewResources.Player: @headerItem.UserName - @ViewResources.Viewin @Model.Param.CurrencyName
        </td>
    </tr>
    <tr class="detail-header-row">
        <td colspan="4">@headerItem.ResultName
        </td>
    </tr>
    <tr>        
        <td colspan="4">
            @if (!string.IsNullOrEmpty(headerItem.Result))
            {
                @Html.Raw(headerItem.Result.Replace("/Form", Url.Content("~/") + "Form"))
            }
        </td>
    </tr>   
    <tr>
        <td>@ViewResources.PlayerHistoryNo
        </td>
        <td colspan="3" class="align-left">@Model.Param.PlayerHistoryNo
        </td>
    </tr>    
    <tr class="detail-header-row">
        <td>@ViewResources.Bet
        </td>
        <td>@ViewResources.Bet @ViewResources.Money
        </td>
        <td>@ViewResources.Odds
        </td>
        <td>@ViewResources.Win/@ViewResources.Loss
        </td>
    </tr>
    @foreach (var detailItem in Model.CasinoDetailList)
    {
        <tr>
            <td>@detailItem.BetTypeName
            </td>
            <td>@detailItem.Bet.ToStringExt()
            </td>
            <td>@detailItem.Odds.ToStringExt()
            </td>
            <td class="align-right">@detailItem.WinLoss.ToStringExt()
            </td>        
        </tr>  
    }  
    <tr class="player-total-row">
        <td class="align-left">@ViewResources.Total @ViewResources.Bet
        </td>
        <td colspan="3" class="align-right">@Model.CasinoDetailList.Sum(p => p.Bet).ToStringExt()
        </td>
    </tr>
     <tr class="player-total-row">
        <td class="align-left">@ViewResources.Total @ViewResources.Win/@ViewResources.Loss
        </td>
        <td colspan="3" class="align-right">@Model.CasinoDetailList.Sum(p => p.WinLoss).ToStringExt()
        </td>
    </tr>
</table>

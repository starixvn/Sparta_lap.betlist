@{
    Layout = "~/Views/Shared/_BetSettingLayout.cshtml";
}
@model Fanex.Athena.Model.BetSettings.ViewModel.BetSettingBaseViewModel
@section pagejs {
    <script src="@Url.ContentLink("/Scripts/Customer/BetSetting/exchange.js")" type="text/javascript"></script>
}
@{Html.RenderPartial("~/Views/Customer/BetSetting/_Menu.cshtml", Model);}
@{ 
    var disabledText = Model.IsEnabled == true ? null : "disabled";
}

<div class="content-title" style="width: 855px">
    @Model.Param.BetSettingName @ViewResources.BetSettings - @Model.Param.NickName @(Model.Param.IsFakeLicensee ? string.Empty : "(" + Model.Param.UserName + ")")
</div>
<!--Content-->
<div class="data-content" style="padding: 10px 0">
    <label>@ViewResources.ChargeCommission</label>
    <select @disabledText data-original-value="2" id="ddlCommission" style="width: 122px">
        @for(float i = 2; i <=7; i += 0.5f)
        {
            <option value="@i">@(i)%</option>
        }
    </select>
</div>
<!--/Content-->
<!--SubmitButton-->
@if (Model.Editable && Model.IsEnabled.HasValue)
{
    <div style="width: 855px">
        <input @disabledText type="button" class="button" data-cust-id="@Model.Param.CustId" value="@ViewResources.Submit" id="btnSubmit" />
        <input @disabledText type="button" class="button" value="@ViewResources.Reset" id="btnReset" />
        <input type="button" class="button" data-status="@(Model.IsEnabled.HasValue && Model.IsEnabled.Value ? 0 : 1)"
                   data-cust-id="@Model.Param.CustId"
                   data-nick-name="@Model.Param.NickName" value="@(string.Format(Model.IsEnabled.Value ? ViewResources.DisableProduct : ViewResources.EnableProduct, ViewResources.ProductBX))"
                   id="btnUpdateStatus" />
    </div>
}
<!--/SubmitButton-->
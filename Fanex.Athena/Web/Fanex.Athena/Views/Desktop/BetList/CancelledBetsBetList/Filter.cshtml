@model Fanex.Athena.Model.BetList.ViewModel.CancelledBetsBetListViewModel

@using (Html.BeginForm("Index", "CancelledBetsBetList", FormMethod.Post, new { @id = "CancellerBetsBetListForm" }))
{
    @Html.AntiForgeryToken()

    <div class="row">
        @*// -----------------------------Currency-----------------------------------//*@
        <div class="col l2 m2 s12 input-field">
            @RazorHelperDesktop.CurrencyList(Model.CurrencyList, "select currencylist", Model.Param.CurrencyId)
            <label>@ViewResources.Currency</label>
        </div>

        @*// -----------------------------Base Currency-----------------------------------//*@
        <div class="col l2 m2 s12 input-field">
            @RazorHelperDesktop.BasedCurrency(Model.Param.BaseCurrency)
            <label>@ViewResources.Based</label>
        </div>

        @if (Model.CustomerList.Any())
        {
            <div class="col l2 m2 s12 input-field">
                @{
                    var custList = Model.CustomerList.Select(c => new SelectListItem
                    {
                        Value = c.CustId.ToString(),
                        Text = string.Format("{0} ({1} {2})", c.NickName, c.BetCount, c.BetCount <= 1 ? "bet" : "bets"),
                        Selected = c.CustId == Model.Param.CustId,
                    });
                    @Html.DropDownList("CustId", custList, new { @id = "CustId", @class="select" })
                }
                <label>@ViewResources.ExternalId</label>
            </div>
        }

        <div class="col l1 m2 s12 button-block">
            <a id="SubmitButton" class="waves-effect waves-light btn btn-primary">@ViewResources.Submit</a>
        </div>

        <div class="col right icon-block">
            <i class="icon-book right" id="UserGuide" title="@ViewResources.UserGuide"></i>
            <i class="icon-excel right" title="@ViewResources.ExportToExcel" id="ExportToExcel"></i>
        </div>
    </div>

    <input type="hidden" name="LicenseeId" id="LicenseeId" value="@Model.Param.LicenseeId" />
    <input type="hidden" name="IsExportExcel" id="IsExportExcel" value="@Model.Param.IsExportExcel" />
    <input type="hidden" name="SortBy" id="SortBy" value="@Model.Param.SortBy" />
    <input type="hidden" name="SortOrder" id="SortOrder" value="@Model.Param.SortOrder" />
}

@{
    Layout = null;
}
@using Fanex.Athena.Model.BetList.ViewModel

@model SystemParlayDetailViewModel
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <title>@string.Format("LRF - {0}", ViewResources.SystemParlay)</title>
    <link href="@Url.ContentLinkByEnv("/www/css/build/main.css")" rel="stylesheet" />
    <link href="@Url.ContentLinkByEnv("/www/css/build/pages/betlist/systemparlaydetail.css")" rel="stylesheet" type="text/css" />
</head>
<body>
    <div class="system-parlay-detail-container">
        @Html.Raw(Model.DetailText)

        <div class="note-block">
            <p class="text-bold"><span class="red-text">* </span>@ViewResources.Note</p>
            <p>@ViewResources.SystemParlayDetailNote</p>
        </div>
    </div>
</body>
</html>
@{
    Layout = null;
}
@using Fanex.Athena.Models.ViewModel
@using Fanex.Athena.Model.Core.DTO.Common
@model Fanex.Athena.Model.Warehouse.ViewModel.WinLossViewModel
@{    
    var maxDate = (DateTime)ViewBag.MaxDate;
    var minDate = maxDate.AddMonths(-3);
}
<div class="grid_26 content-filter new-line" style="width:@(ViewBag.FilterWidth)px">
    @using (Html.BeginForm("WinLoss", "WareHouse", FormMethod.Post, new { @id = "WarehouseWinLossForm" }))
    {
        <div class="grid_2 filter-label">
            <label>@ViewResources.Currency</label>
        </div>
        <div id="CurrencyResult" class="grid_3 filter-input">
            @RazorHelper.CurrencyList(Model.CurrencyList, "currencylist", Model.Param.CurrencyId, true)
        </div>
        <div class="grid_2 filter-label">
            <label for="BaseCurrency">@ViewResources.Based</label>
        </div>
        <div class="grid_1 filter-input">
            @RazorHelper.BasedCurrency(Model.Param.BaseCurrency)
        </div>
        <div class="gird_2 note-group">
            <div>
                @{Html.RenderAction("Index", "Note", new { viewName = "Warehouse" });}
            </div>
            <div>
                <input alt="@ViewResources.ExportToExcel" src="@Url.ContentLink("/Content/Global/Images/excel.gif")"
               type="image" id="ExportToExcel" name="exporttoexcel"
               title="@ViewResources.ExportToExcel" class="hand" />
            </div>
        </div>
        
        <div class="new-line">
        </div>
        
        <div>
            @Html.Hidden("ReportBy", Model.Param.ReportBy)
            @Html.Hidden("IsExportExcel", Model.Param.IsExportExcel)
            @Html.HiddenFor(m => m.Param.IsExportExcel)
        </div>
        @DatePickerHelper.RenderDateRangePicker(Model.Param.FromDate, Model.Param.ToDate, minDate, maxDate, "date-range", "date-range", 2, 3, 2, 3)
        <div class="grid_2 filter-label">
            <label>@ViewResources.ReportBy</label>
        </div>
        <div class="grid_3 filter-input">
            @Html.DropDownList("SelectReportBy", new SelectList(new Dictionary<string, string>
                {
                    {"1",ViewResources.Day},  {"2",ViewResources.Month},  {"3",ViewResources.Currency},  {"4",ViewResources.BetType}, {"5",ViewResources.League}
                  
                }, "Key", "Value", Model.Param.ReportBy))
        </div>
    
        <div class="new-line">
        </div>
        <div class="grid_2 new-line filter-label">
            <label>@ViewResources.DrawFilter</label>
        </div>
        <div class="grid_8 filter-input option-list" style="width: 400px">
            @Html.RadioButton("DrawFilter", "1", Model.Param.DrawFilter == 1, new { id = "RadioNormal" })
            <label for="RadioNormal">@ViewResources.Normal</label>
            @Html.RadioButton("DrawFilter", "2", Model.Param.DrawFilter == 2, new { id = "RadioNoDraws" })
            <label for="RadioNoDraws">@ViewResources.NoDraws</label>
            @Html.RadioButton("DrawFilter", "3", Model.Param.DrawFilter == 3, new { id = "RadioNoDrawsForTurnoverOnly" })
            <label for="RadioNoDrawsForTurnoverOnly">@ViewResources.NoDrawsForTurnoverOnly</label>
        </div>
        <div class="grid_2 filter-label new-line">
            &nbsp;</div>
        <div class="grid_2 filter-input">
            <input type="button" id="SubmitButton" value="@ViewResources.Submit" class="button" />
        </div>

        <div class="clear">
        </div>    
    }
</div>

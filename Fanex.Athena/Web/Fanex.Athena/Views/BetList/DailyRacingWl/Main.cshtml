@{
    ViewBag.Title = string.Format("LRF - {0}", ViewResources.BetList);
    Layout = "~/Views/Shared/_BetListSimpleLayout.cshtml";
}

@model Fanex.Athena.Model.BetList.MetaModel.BetListMetaModel
@section pagecss {}
@section pagejs {}
@section ContentTitle
{
    @ViewResources.BetList - @Model.Date.ToShortDateString() - <span class="base-currency">@RazorHelper.ViewBaseCurrency(Model.CurrencyName, Model.BaseCurrency)</span>
}
@section BackButton
{
    <div onclick="history.back()" class="history-link"></div>
}
@{
    <input type="hidden" id="ApiUrl" value="api/DailyRacingWinLossBetList/Index" />
    <input type="hidden" id="BetListMetaModel" value="@Model.ToJson()" />
    <input type="hidden" id="HiddenColumnList" value="" />
}

<#@ template debug="true" hostSpecific="true" #>
<#
    SiteInfo.Host = Host;
#>
<#@ import namespace="System" #>
<#
    var sites = new SiteInfo[]{        
        new SiteInfo
        {
            SiteEnvironment = SiteEnvironment.DEV
        },
		new SiteInfo
        {
            SiteEnvironment = SiteEnvironment.LOCAL
        },
        new SiteInfo
        {
            SiteEnvironment = SiteEnvironment.UAT
        },
        new SiteInfo
        {
            SiteEnvironment = SiteEnvironment.PRO
        },
        new SiteInfo
        {
            SiteEnvironment = SiteEnvironment.BACKUPMNL
        },
        new SiteInfo
        {
            SiteEnvironment = SiteEnvironment.SANDBOX
        }
    };
#>
<#+
	enum SiteEnvironment
    {
		DEV,
        LOCAL,
        UAT,
        PRO,
        BACKUPMNL,
        SANDBOX
    }

	class SiteInfo
    {
		public static ITextTemplatingEngineHost Host { get; set; }

        //Web config value.
        public SiteEnvironment SiteEnvironment { get; set; }

		public string SpNameTemplate = "SpName=\"{0}\"";
		
		public System.Collections.Generic.List<SpNameConfig> ListOfConfig
		{
			get
			{			
				string path = SiteInfo.Host.ResolveAssemblyReference("$(SolutionDir)");
				Directory.SetCurrentDirectory(path);				
				var document = System.Xml.Linq.XDocument.Load(@"Fanex.Athena\Web\Fanex.Athena\App_Data\SpNameConfig\FanexSpNameConfig.xml");
				var elements = document.Root.Elements("SpNameConfig");
				var listOfConfig = new System.Collections.Generic.List<SpNameConfig>();
				
				foreach (var element in elements)
				{
					listOfConfig.Add(new SpNameConfig
					{
						Environment = element.Attribute("Environment").Value.Trim(),
						SpName = element.Attribute("SpName").Value.Trim(),
						EnvironmentText = element.Attribute("EnvironmentText").Value.Trim(),
					});
				}

				return listOfConfig;
			}
		}

		public string GenerateSpName
		{
			get 
			{				
				var listOfConfig = ListOfConfig.Where (x=>x.Environment == SiteEnvironment.ToString()).ToList();
				string generateSpNameText = AllSpName;
				foreach (var item in listOfConfig)
				{
					generateSpNameText = generateSpNameText.Replace(string.Format(SpNameTemplate, item.SpName), string.Format(SpNameTemplate, item.SpName + item.EnvironmentText));
				}
			
				return generateSpNameText;
			}
		}

        public string AllSpName
        {
            get
            {
                return System.IO.File.ReadAllText(@"Fanex.Athena\Web\Fanex.Athena\App_Data\SpNameConfig\FanexSpNameOriginal.xml");
            }
        }		
    }

	class SpNameConfig
	{
		public string Environment {get;set;}

		public string SpName {get;set;}

		public string EnvironmentText {get;set;}
	}
#>
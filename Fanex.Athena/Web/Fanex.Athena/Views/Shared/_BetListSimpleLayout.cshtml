@using System.Web.Optimization
@{    
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section css
{
    @Styles.Render("~/bundles/BetListSimpleLayoutStyles")
    @RenderSection("pagecss", required: false)
}
@section js
{
    @Scripts.Render("~/bundles/BetListSimpleLayoutScripts")
    
    @RenderSection("pagejs", required: false)
}
@RazorHelper.MoveBetNotification()
<div class="content-title">
    @RenderSection("ContentTitle", required: false)
    <div class="export-excel">
        @RenderSection("BackButton", required: false)
        @if (ViewBag.HideExportExcel != true)
        {
        <input alt="@Fanex.Athena.Resources.ViewResources.ExportToExcel" 
            src="@Url.ContentLink("/Content/Global/Images/excel.gif")" type="image" id="ExportToExcel" name="exporttoexcel"
            title="@Fanex.Athena.Resources.ViewResources.ExportToExcel" class="hand" />
        }
    </div>
</div>
<div class="content-main">
    <div class="loading">
    </div>
    <div class="block-body">
    </div>
    <div id="dialog">
    </div>
    <div class="theme_jqGrid" style="width: 100%">
        <div id="pager1">
        </div>
        <table id="BetListGrid" style="border-left: 0px">
            <tr>
                <td>
                </td>
            </tr>
        </table>
        <div id="pager2">
        </div>
    </div>
    @RenderBody()
</div>

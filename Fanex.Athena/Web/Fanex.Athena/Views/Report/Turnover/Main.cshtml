@{
    ViewBag.Title = "LRF - " + ViewResources.Report + " - " + ViewResources.Turnover;
    Layout = "~/Views/Shared/_Report.jqGridLayout.cshtml";
}
@using Fanex.Athena.Model.Report.ViewModel
@model Fanex.Athena.Model.Report.ViewModel.TurnoverViewModel
@section pagecss {
    <link href="@Url.ContentLink("/Content/Report/Turnover.css")" rel="stylesheet" type="text/css" />
}
@section pagejs {
    <script src="@Url.ContentLink("/Scripts/Report/Turnover.option.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Report/Turnover.js")" type="text/javascript"></script>
}
@section ContentTitle    {
    @ViewResources.Turnover
}
<div class="container_26"  style="margin-left: -7px">
    <div class="grid_26">
        @{
            Html.RenderPartial("~/Views/Report/Turnover/Content.cshtml");
        }
    </div>
  
</div>
@section ContentFilter
{
    @{        
        Html.RenderPartial("~/Views/Report/Turnover/Filter.cshtml");
    }
}
@using Fanex.Athena.Models.ViewModel
@model Fanex.Athena.Model.Forecast.ViewModel.ForecastOneXTwoViewModel
@using (Html.BeginForm("ForecastOneXTwo", "Forecast", FormMethod.Post, new { @id = "ForecastOneXTwoForm" }))
{
    // ----------------------------- Hidden field -----------------------------//
    <div>
        @Html.Hidden("IsPopUp", Model.Param.IsPopUp.ToString())
        @Html.Hidden("CurrencyId-Hidden", Model.Param.CurrencyId)
        @Html.Hidden("LicenseeType-Hidden", Model.Param.LicenseeType)
        @Html.Hidden("IsConvert-Hidden", Model.Param.IsConvert.ToString())
    </div>
    // ----------------------------- Hidden field -----------------------------//

    // -----------------------------Refresh countdown------------------------ //
    <div class="grid_3">
        @RazorHelper.TimerCountDown("forecastonextwo", 15)
    </div>
    // -----------------------------Refresh countdown------------------------ //

    // -------------Render forecast one x two filter if matchid == 0 ----------//
    <div id="forecast-filter">
        @{
    // ----------------------------Type of licensee------------------------//
    if (@Model.LicenseeTypeList.Count > 0)
    {
            <div class="grid_1 filter-label" style="width: 25px">
                @ViewResources.Type
            </div>
            <div class="grid_3 filter-input">
                @RazorHelper.LicenseeType(Model.LicenseeTypeList, "licenseetype", Model.Param.LicenseeType)
            </div>
    }

    // -----------------------------Currency-------------------------------//
            <div class="grid_2 filter-label" style="width: 50px">
                @ViewResources.Currency
            </div>
            <div class="grid_3 filter-input" style="width: 110px">
                @RazorHelper.CurrencyList(Model.CurrencyList, "currencylist", Model.Param.CurrencyId)
            </div>
            <div class="grid_4 filter-input">
                <label for="BaseCurrency">@ViewResources.Based
                </label>
                @RazorHelper.BasedCurrency(Model.Param.BaseCurrency)
            </div>
            <div class="grid_2 filter-input">
                <input type="button" id="SubmitButton" value="@ViewResources.Submit" class="button" />
            </div>
            <div class="grid_2 note-group">
                <div class="userguide-icon" id="UserGuide" title="@ViewResources.UserGuide">
                </div>
            </div>
            <div class="clear">
            </div>

@*Render league list*@
    if (Model.Param.LeagueId != 0)
    {
            <div class="grid_2 filter-label left-text" style="width: 45px">@ViewResources.League</div>
            <div class="grid_4 filter-input">
                @{
        var selectedLeague = Model.Param.LeagueId == 0 ? 0 : Model.Param.LeagueId;
                }
                <select class="league-list" id="LeagueId" name="LeagueId">
                    @foreach (var league in Model.LeagueList)
                    {
                        <option @(league.LeagueId == selectedLeague ? "selected=selected" : "") value="@league.LeagueId">@league.LeagueName</option>
                    }
                </select>
            </div>
    }
        }
    </div>
}
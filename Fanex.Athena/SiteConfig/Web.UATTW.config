<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data" />
    <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
    <section name="VoidbridgeResultConfigs" type="Fanex.Result.Core.Voidbridge.VoidbridgeConfigs, Fanex.Result.Core.Voidbridge" />
    <section name="GlobalGamingResultConfigs" type="Fanex.Result.Core.GlobalGaming.GlobalGamingConfigs, Fanex.Result.Core.GlobalGaming" />
    <section name="ONEbook.UM" type="ONEbook.UM.Configurations.UMClientConfiguration, ONEbook.UM" />
    <section name="PPResultConfigs" type="Fanex.Result.Core.PP.PPConfigs, Fanex.Result.Core.PP" />
  </configSections>
  <log4net>
    <appender name="ConsoleAppender" type="log4net.Appender.ConsoleAppender">
      <layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="%d [%t] %-5p %c [%x] &lt;%X{auth}&gt; - %m%n" />
      </layout>
    </appender>
    <appender name="GeneralLog" type="log4net.Appender.RollingFileAppender">
      <file value="E:/3.Logs/lrf/log4net.txt" />
      <appendToFile value="true" />
      <maximumFileSize value="100MB" />
      <rollingStyle value="Date" />
      <maxSizeRollBackups value="5" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%d{HH:mm:ss.fff} [%t] %-5p %c - %m%n" />
      </layout>
      <filter type="log4net.Filter.LevelRangeFilter">
        <param name="LevelMin" value="DEBUG" />
        <param name="LevelMax" value="ERROR" />
      </filter>
    </appender>
    <!-- levels: DEBUG, INFO, WARN, ERROR, FATAL -->
    <root>
      <level value="ERROR" />
      <appender-ref ref="ConsoleAppender" />
      <appender-ref ref="GeneralLog" />
    </root>
  </log4net>
  <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
    <providers>
      <add name="XmlDbSettingProvider" type="Fanex.Data.DbSettingProviderExtension.XmlDbSettingProvider3, Fanex.Data.DbSettingProviderExtension" resourcePath="~\SpNameConfig\FanexSpName.xml" enableWatching="1" />
    </providers>
  </Fanex.Data.DbSettingProvider>
  <Fanex.Logging msmqPath="FormatName:DIRECT=tcp:10.40.40.73\private$\entlib" defaultCategory="LRF-UAT" />
  <VoidbridgeResultConfigs Url="http://10.40.40.41:8072/api/RNGSingleLobby/GetBetHistoryUrl" Login="login" Password="U1YwYm1IbGpSeVdMeWhTaE1Ia1I3QT09" SiteId="3000" VendorId="12" Debug="0" />
  <GlobalGamingResultConfigs Url="http://10.40.40.248:8066/api/GlobalGamingInternal/GetResultUrl" Login="login" Password="U1YwYm1IbGpSeVdMeWhTaE1Ia1I3QT09" SiteId="3000" Style="0" Debug="0" />
  <PPResultConfigs Url="http://10.40.40.41:8072/api/PragmaticPlayInternal/GetResultUrl" Login="login" Password="U1YwYm1IbGpSeVdMeWhTaE1Ia1I3QT09" SiteId="3000" VendorId="32" Debug="0" />

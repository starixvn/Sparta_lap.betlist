@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section css
{
    @System.Web.Optimization.Styles.Render("~/bundles/TotalBetsLayoutStyles")
}
@section js
{
    @System.Web.Optimization.Scripts.Render("~/bundles/TotalBetsLayoutScripts")
    @RenderSection("page", required: false)
}
@{
    var userSession = new Fanex.Athena.Service.Core.Users.SessionService().UserSession;
    var isAppModeSelf = userSession == null ? true : userSession.ApplicationMode == Fanex.Athena.Model.Core.DataDomain.AppMode.Self;
}
<div>
    <div class="container_26">
        <div class="grid_26  @(isAppModeSelf ? string.Empty: "hide")">
            <div class="content-title">
                @RenderSection("ContentTitle", required: false)
            </div>
        </div>
        <div class="clear">
        </div>
        <div class="grid_26 content-filter">
            @RenderSection("ContentFilter", required: false)
        </div>
        <div class="clear">
        </div>
        <div class="grid_26">
            <div class="content-main">
                <div class="loading">
                </div>
                <div class="block-body">
                </div>
                <div id="Refresh-Content">
                    @RenderBody()
                </div>
            </div>
        </div>
    </div>
</div>
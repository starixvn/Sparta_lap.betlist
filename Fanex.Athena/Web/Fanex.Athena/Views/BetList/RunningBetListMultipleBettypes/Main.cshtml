@{
    
    var formatTitle = "{0} {1} {2} - {3}";
    ViewBag.Title = string.Format(formatTitle, "LRF", HttpUtility.HtmlDecode("&bull;"), ViewResources.TotalBets, ViewBag.ReportTitle);
    
    Layout = "~/Views/Shared/_BetListLayout.cshtml";
}

@model Fanex.Athena.Model.BetList.ViewModel.BetListBaseViewModel
@section pagecss {
    <link href="@Url.ContentLink("/Content/UserGuide/user-guide.css")" rel="stylesheet" type="text/css" />
}
@section pagejs {
    <script src="@Url.ContentLink("/Scripts/BetList/runningbetlist.multiplebettypes.js")" type="text/javascript"></script>
}
@section ContentTitle
{
    @{
        if (ViewBag.IsMixParlay == true || ViewBag.IsSystemParlay == true)
        {
            <span id="mixparlay_link" class="@(ViewBag.IsMixParlay == true ? "inactive-switch-link" : "active-switch-link")">@ViewResources.MixParlay</span>
            <span>|</span>
            <span id="systemparlay_link" class="@(ViewBag.IsSystemParlay == true ? "inactive-switch-link" : "active-switch-link")">@ViewResources.SystemParlay</span>
        }
        else
        {
            @ViewBag.ReportTitle
        }
    }
}
@section ContentFilter
{
    @{
        Html.RenderPartial("~/Views/BetList/RunningBetListMultipleBettypes/Filter.cshtml");
    }
}

<div id="popupSystemParlay"></div>
<input type="hidden" id="HiddenColumnList" value="winloss,licenseewl" />
<input type="hidden" id="IsShowSumStake" value="1" />
<input type="hidden" id="title" value="@ViewBag.ReportTitle" />
<input type="hidden" id="userGuideName" value="@ViewBag.UserGuideName" />
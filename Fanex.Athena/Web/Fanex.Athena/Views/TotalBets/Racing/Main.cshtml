@{
    ViewBag.Title = "LRF - " + ViewResources.TotalBets +
    " - " + ViewResources.ProductRB;
    Layout = Request.IsAjaxRequest() ? null : "~/Views/Shared/_TotalBetsLayout.cshtml";
}
@using Fanex.Athena.Models.ViewModel
@model Fanex.Athena.Model.TotalBet.ViewModel.RacingViewModel
@section page {
    <script src="@Url.ContentLink("/Scripts/TotalBets/racing.js")" type="text/javascript"></script>
    <script type="text/javascript">
        $(window).load(function () {
            Racing.initialize();
            RefreshCountDown.initEvent();
        });
    </script>
}
@section ContentTitle
    {
    @ViewResources.ProductRB
}
@section ContentFilter
{
    @{
        Html.RenderPartial("~/Views/TotalBets/Racing/Filter.cshtml");
    }
}
@{
    Html.RenderPartial("~/Views/TotalBets/Racing/Content.cshtml");
}
@{
    ViewBag.Title = string.Format("LRF - {0}", ViewResources.BetList);
    Layout = "~/Views/Desktop/Shared/_Layout.cshtml";
}
@section css{
    <link href="@Url.ContentLinkByEnv("/www/css/build/pages/betlist/betlistSimpleLayout.css")" rel="stylesheet" type="text/css" />
}
@model Fanex.Athena.Model.BetList.ViewModel.CashOutBetListDetailViewModel
<div class="content-wrapper">
    <p>
        @(ViewResources.OriginalBetTicket):
    </p>
    <p>
        <table class="table" style="width: 800px">
            <thead>
                <tr style="height: 25px">
                    <th width="150">@ViewResources.TransTime</th>
                    <th width="250">@ViewResources.Choice</th>
                    <th width="100">@ViewResources.Odds</th>
                    <th width="100">@ViewResources.Stake</th>
                    <th width="100">@(ViewResources.WinLoss)/@(ViewResources.Comm)</th>
                    <th width="100">@ViewResources.Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.TicketTextList)
            {
                    <tr>
                        <td style="text-align: center">@Html.Raw(item.TransTime)</td>
                        <td>@Html.Raw(item.Choice)</td>
                        <td>@Html.Raw(item.Odds)</td>
                        <td>@Html.Raw(item.Stake)</td>
                        <td>@Html.Raw(item.WinLoss)</td>
                        <td style="text-align: center">@Html.Raw(item.Status)</td>
                    </tr>
                }
            </tbody>
        </table>
    </p>
    <p>
        @(ViewResources.CashOutTicketsList):
    </p>
    <p>
        <table class="table" style="width: 700px">
            <thead>
                <tr style="height: 25px">
                    <th width="150">@ViewResources.TransTime</th>
                    <th width="250">@(Model.IsBoughtTicket ? ViewResources.BoughtStake : ViewResources.CashOutStake)</th>
                    <th width="100">@ViewResources.Price</th>
                    <th width="100">@ViewResources.WinLoss</th>
                    <th width="100">@ViewResources.Status</th>
                </tr>
            </thead>
            @{ 
                var firstRow = true;
            }
            <tbody>
                @foreach (var item in Model.CashOutTicketTextList)
            {
                var tdClass = firstRow ? "highlight" : null;
                    <tr>
                        <td class="@tdClass" style="text-align: center">@Html.Raw(item.TransTime)</td>
                        <td class="@tdClass">@Html.Raw(item.Stake)</td>
                        <td class="@tdClass">@Html.Raw(item.Price)</td>
                        <td class="@tdClass">@Html.Raw(item.WinLoss)</td>
                        <td class="@tdClass" style="text-align: center">@Html.Raw(item.Status)</td>
                    </tr>
                    firstRow = false;
                }
            </tbody>
        </table>
    </p>
</div>
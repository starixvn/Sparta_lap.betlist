@using Fanex.Athena.Model.Report.ViewModel
@using Fanex.Athena.Model.Core.MetaModel.Product
@model Fanex.Athena.Model.BetList.ViewModel.BetListBaseViewModel
@using (Html.BeginForm("Index", "CorrectScoreBetList", FormMethod.Post, new { @id = "CorrectScoreBetListForm" }))
{
    //-----------------------------Type of licensee---------------------------//
    if (Model.LicenseeTypeList.Count > 0)
    {
    <div class="grid_2 filter-label">
        <label>@ViewResources.Type</label>
    </div>
    <div class="grid_3 filter-input">
        @RazorHelper.LicenseeType(Model.LicenseeTypeList, "", Model.Param.LicenseeType, true)
    </div>
    }

    //-----------------------------Currency-----------------------------------//
    <div class="grid_2 filter-label">
        <label>
            @ViewResources.Currency</label>
    </div>
    <div class="grid_3 filter-input">
        @RazorHelper.CurrencyList(Model.CurrencyList, "", Model.Param.CurrencyId, true, false)
    </div>
    <div class="grid_2 filter-label">
        <label for="BaseCurrency">@ViewResources.Based</label>
    </div>
    <div class="grid_2 filter-input">
        @RazorHelper.BasedCurrency(Model.Param.BaseCurrency)
    </div>
    <div class="grid_2 note-group">
        <div class="userguide-icon" id="UserGuide" title="@ViewResources.UserGuide">
        </div>
        <div>
            <input alt="@ViewResources.ExportToExcel" src="@Url.ContentLink("/Content/Global/Images/excel.gif")"
               type="image" id="ExportToExcela" name="exporttoexcel"
               title="@ViewResources.ExportToExcel" class="hand" />
        </div>
    </div>
    <div class="grid_2 filter-input">
        <input type="button" id="SubmitButton" value="@ViewResources.Submit" class="button" />
    </div>
    <input type="hidden" name="LicenseeId" id="LicenseeId" value="@Model.Param.LicenseeId" />
    <input type="hidden" name="SortBy" id="SortBy" value="" />
    <input type="hidden" name="SortOrder" id="SortOrder" value="" />
}
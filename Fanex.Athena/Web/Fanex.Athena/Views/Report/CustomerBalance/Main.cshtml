@{
    ViewBag.Title = "LRF - " + ViewResources.Report + " - " + ViewResources.CustomerBalance;
    Layout = "~/Views/Shared/_Report.jqGridLayout.cshtml";
}

@model Fanex.Athena.Model.Report.ViewModel.CustomerBalanceViewModel

@section pagecss {
    <link href="@Url.ContentLink("/Content/Global/Paging.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.ContentLink("/Content/Report/CustomertBalance.css")" rel="stylesheet" type="text/css" />
}

@section pagejs {
    <script src="@Url.ContentLink("/Scripts/Global/Paging.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Report/CustomerBalance.option.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Report/CustomerBalance.js")" type="text/javascript"></script>
}

@section ContentTitle
{
    @ViewResources.CustomerBalance
}

@section ContentFilter
{
    @{
        Html.RenderPartial("~/Views/Report/CustomerBalance/Filter.cshtml");
    }
}

<div class="container_26" style="margin-left: -7px">
    <div class="grid_26">
        @{
            Html.RenderPartial("~/Views/Report/CustomerBalance/Content.cshtml");
        }
    </div>

</div>

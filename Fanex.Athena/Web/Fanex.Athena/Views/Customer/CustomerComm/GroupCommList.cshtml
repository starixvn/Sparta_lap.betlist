@{
    ViewBag.Title = "LRF - Group Management";
    Layout = "~/Views/Shared/_GroupCommLayout.cshtml";
}
@section pagecss {
    <link href="@Url.ContentLink("/Content/Global/grid26.css")" rel="stylesheet" type="text/css" />
}
@section pagejs {
    <script src="@Url.ContentLink("/Scripts/Customer/CustomerComm/groupcomm.js")" type="text/javascript"></script>
}
@section ContentTitle
{
    @ViewResources.CommissionGroupList
}
@using Fanex.Athena.Model.Report.ViewModel;
@model IList<Fanex.Athena.Model.Customer.MetaModel.GroupCommMetaModel>
<div class="note-message">
    @ViewResources.GroupCommNote
</div>
<div class="clear" style="height: 5px">
</div>
@using (Html.BeginForm("ExportExcel", "CustomerComGroup", FormMethod.Post, new { @id = "CommissionGroupForm" }))
{
    @Html.AntiForgeryToken()
    @Html.Hidden("IsExportExcel", false)
    <div class="container_26">
        <div class="grid_3">
            <input type="button" id="NewGroupButton" value="@ViewResources.NewGroup" class="button" style="margin-bottom: 5px;"
                title="@ViewResources.CreateNewGroup" />
        </div>
        <div class="grid_22 push_1 align-right">
            <input alt="@ViewResources.ExportToExcel" src="@Url.ContentLink("/Content/Global/Images/excel.gif")"
            type="image" id="ExportToExcel" name="exporttoexcel"
            title="@ViewResources.ExportToExcel" class="hand" />
            <div style="float: right; margin-left: 5px;">
                <div class="userguide-icon" id="UserGuide" title="@ViewResources.UserGuide">
                </div>
            </div>
        </div>
    </div>
    <div class="content-main new-line">
        <div class="loading">
        </div>
        <div class="block-body">
        </div>
        <div id="ContentMainHeader">
            <table class="report-table">
                <thead>
                    <tr class="report-header">
                        <td style="width: 4%">
                            #
                        </td>
                        <td style="width: 8%">
                            @ViewResources.GroupId
                        </td>
                        <td style="width: 20%">
                            @ViewResources.GroupName
                        </td>
                        <td style="width: 8%">
                            @ViewResources.DefaultGroup
                        </td>
                        <td style="width: 10%">
                            @ViewResources.NoOfCustmer
                        </td>
                        <td style="width: 8%">
                            @ViewResources.SBComm (%)
                        </td>
                        @{
    var isAllowNg = ViewBag.IsAllowNG;
    var isAllowRc = ViewBag.IsAllowRC;
    var isAllowLc = ViewBag.IsAllowLC;
    var isAllowCs = ViewBag.IsAllowCS;
                        }
                        @if (isAllowRc)
                        {
                            <td style="width: 8%">
                                @ViewResources.RacingComm (%)
                            </td>
                        }
                        @if (isAllowNg)
                        {
                            <td style="width: 8%">
                                @ViewResources.NGComm (%)
                            </td>
                        }
                        @if (isAllowLc)
                        {
                            <td style="width: 8%">
                                @ViewResources.LCComm (%)
                            </td>
                        }
                        @if (isAllowCs)
                        {
                            <td style="width: 8%">
                                @ViewResources.CSComm (%)
                            </td>
                        }
                        <td style="width: 10%">
                            @ViewResources.GroupColor
                        </td>
                        <td style="width: 10%">
                            @ViewResources.EditGroup
                        </td>
                    </tr>
                </thead>
                <tbody id="data-content" class="report-table">
                    @{int number = 1; var maxLength = 35;}
                    @if (Model.Count > 0)
                    {
                        foreach (var groupComm in Model)
                        {
                        <tr>
                            <td style="width: 4%" class="title-text">
                                @(number++)
                            </td>
                            <td class="middle-text" style="width: 8%">@groupComm.GroupCommId
                            </td>
                            <td style="width: 20%;" class="left-text">
                                <a href="@Url.Action("Update", "CustomerComGroup", new { groupId = @groupComm.GroupCommId })" title="@ViewResources.EditGroup">
                                    @if (groupComm.GroupName.Length > maxLength)
                                    {
                                        @Html.Raw(String.Format("<span title='{0}'>{1}...</span>", groupComm.GroupName.Replace("'", "&#39;"),
                                                            HttpUtility.HtmlEncode(groupComm.GroupName.Substring(0, maxLength - 3))));
                                    }
                                    else
                                    {
                                        @groupComm.GroupName
                                    }
                                </a>
                            </td>
                            <td style="width:8%;" class="middle-text @(groupComm.IsDefaultGroup ? "default-group" : string.Empty)">
                            </td>
                            <td style="width: 10%;" class="middle-text">
                                <div class="no-customer-border" onclick="javascript:GroupComm.navigateNoOfCustomer(@groupComm.GroupCommId)">
                                    <span class="no-cus-font">@groupComm.NumberOfCustomer</span>
                                </div>
                            </td>
                            <td style="width: 8%;" class="middle-text">
                                @((groupComm.SBComm * 100).ToString("0.##"))
                                %
                            </td>
                            @if (isAllowRc)
                            {
                                <td style="width: 8%;" class="middle-text">
                                    @((groupComm.RCComm * 100).ToString("0.##"))
                                    %
                                </td>
                            }
                            @if (isAllowNg)
                            {
                                <td style="width: 8%; text-align: center">
                                    @((groupComm.NGComm * 100).ToString("0.##"))
                                    %
                                </td>
                            }
                            @if (isAllowLc)
                            {
                                <td style="width: 8%; text-align: center">
                                    @((groupComm.LCComm * 100).ToString("0.##"))
                                    %
                                </td>
                            }
                            @if (isAllowCs)
                            {
                                <td style="width: 8%; text-align: center">
                                    @((groupComm.CSComm * 100).ToString("0.##"))
                                    %
                                </td>
                            }
                            <td style="width: 10%; text-align: center;">
                                <div class="group-color-box" style="background-color:@groupComm.GroupColor;">
                                </div>
                            </td>
                            <td style="width: 10%; text-align: center">
                                <a class="underline" href="@Url.Action("Update", "CustomerComGroup", new { groupId = @groupComm.GroupCommId })" title="@ViewResources.EditGroup">
                                    <img src="@Url.ContentLink("/Content/Customer/images/edit.png")"
                                style="width:16px; height: 16px;" />
                                </a>&nbsp; <a class="underline" href="javascript:GroupComm.initDeleteGroup('@groupComm.GroupCommId')" title="@ViewResources.DeleteGroup">
                                    <img src="@Url.ContentLink("/Content/Customer/images/validatefail.png")"
                                style="width:16px; height: 16px;" />
                                </a>
                            </td>
                        </tr>
                        }
                    }
                    else
                    {
                        int col = 9;
                        if (!isAllowNg)
                        {
                            col--;
                        }
                        if (!isAllowRc)
                        {
                            col--;
                        }
                        <tr class="no-info">
                            <td class="middle-text" colspan="@col">@ViewResources.NoInfo
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div id="Delete">
        <div id="keep">
            @Html.RadioButton("IsRemovePlayerComm", false, false)
            <span>@ViewResources.KeepCurrentComm</span>
        </div>
        <div id="clear">
            @Html.RadioButton("IsRemovePlayerComm", true, true)
            <span>@ViewResources.ClearCurrentComm</span>
        </div>
    </div>

    <div id="confirm-delete">
        <p>@ViewResources.AreYouSure</p>
    </div>

}
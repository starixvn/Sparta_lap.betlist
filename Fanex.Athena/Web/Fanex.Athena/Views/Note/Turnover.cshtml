@using Fanex.Athena.Model.Core.DTO.Common
@{
    Layout = "~/Views/Shared/_NoteLayout.cshtml";
}

@using Fanex.Athena.Model.Core.DTO.Common;
@model Fanex.Athena.Models.ViewModel.Note.NoteViewModel

@section content{
    @if (Model.ProductList.Any(p => p.ProductCode == Product.BA))
    {
        <li>@ViewResources.BaTurnoverReferenceNote</li>
    } 
    @if (Model.ProductList.Any(p => p.ProductCode == Product.BG))
    {
        <li>@ViewResources.BingoExcludedNote </li>
    }
    <li>@string.Format(ViewResources.DateRangeNote, RazorHelper.TitleDateTime( DateTime.Today.AddMonths(-18).AddDays(1-DateTime.Now.Day),null)) </li>
   <li>@ViewResources.OANDANote</li>
}

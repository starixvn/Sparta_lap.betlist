@using Fanex.Athena.Models.ViewModel
@model Fanex.Athena.Model.Report.ViewModel.WinLossByProductViewModel
<!--grid_26-->
<div class="grid_26 content-filter new-line">
    <form id="winlossbyproduct" name="winlossbyproduct" method="post" action="">
    @DatePickerHelper.RenderDateRangePicker(Model.Param.FromDate, Model.Param.ToDate,
                        Fanex.Athena.Extension.Utility.AppSettings.HistoryDate, AppSettings.MaxDate, "date-range", "date-range", 3, 3, 2, 3)
    <div class="grid_2 filter-label">
        <label>
            @ViewResources.Currency
        </label>
    </div>
    <div class="grid_3 filter-input">
        @RazorHelper.CurrencyList(Model.CurrencyList, "currency-list", Model.Param.CurrencyId, true, true)
    </div>
    <div class="grid_2 filter-label ">
            <label>@ViewResources.Username</label>
        </div>
        <div class="grid_3 filter-input">
            <input type="text" id="Username" name="Username" class="text_f1" style="width: 120px" />
        </div>
    <div class="grid_2 userguide-group">
        <div>
            <div class="userguide-icon" id="UserGuide" title="@ViewResources.UserGuide"></div>
        </div>
        <div>
            <input alt="@ViewResources.ExportToExcel" src="@Url.ContentLink("/Content/Global/Images/excel.gif")"
               type="image" id="ExportToExcel" name="exporttoexcel"
               title="@ViewResources.ExportToExcel" class="hand" />
        </div>
    </div>
    <div class="grid_3 filter-label new-line">
        <label>
            @ViewResources.ReportBy
        </label>
    </div>
    <div class="grid_4 filter-input option-list">
        <input type="radio" value="1" @(Model.Param.ReportBy == 1 ? "checked=checked" : "") name="ReportBy" />
        <label>
            @ViewResources.Daily
        </label>
        <input type="radio" class="report-by-monthly" value="2" @(Model.Param.ReportBy == 2 ? "checked=checked" : "") name="ReportBy" />
        <label>
            @ViewResources.Monthly
        </label>
    </div>
    <div class="grid_3 filter-label new-line">
        <label>
            @ViewResources.DrawFilter
        </label>
    </div>
    <div class="grid_9 filter-input option-list">
        <input type="radio" value="1" @(Model.Param.DrawFilter == 1 ? "checked=checked" : "") name="DrawFilter" />
        <label>
            @ViewResources.Normal
        </label>
        <input type="radio" value="2" @(Model.Param.DrawFilter == 2 ? "checked=checked" : "") name="DrawFilter" />
        <label>
            @ViewResources.NoDraws
        </label>
        <input type="radio" value="3" @(Model.Param.DrawFilter == 3 ? "checked=checked" : "") name="DrawFilter" />
        <label>
            @ViewResources.NoDrawsForTurnoverOnly
        </label>
    </div>
    <div class="grid_3 filter-label new-line">
        <label>
            @ViewResources.ExcludeTestData
        </label>
    </div>
    <div class="grid_4 filter-input option-list">
        <input type="radio" value="true" @(Model.Param.IsExcludedTestData == true ? "checked=checked" : "") name="IsExcludedTestData" />
        <label>
            @ViewResources.Yes
        </label>
        <input type="radio" class="exclude-data-no" value="false" @(Model.Param.IsExcludedTestData == false ? "checked=checked" : "") name="IsExcludedTestData" />
        <label>
            @ViewResources.No
        </label>
    </div>
    @RazorHelper.RenderProductFilter(Model.Param.ProductOptions, 3)
    <div class="grid_3 filter-label new-line">
        &nbsp;</div>
    <div class="grid_2 filter-input" id="control-container">
        @Html.Hidden("IsExportExcel", Model.Param.IsExportExcel)
        <input type="button" id="SubmitButton" class="button" value="@ViewResources.Submit" />
    </div>
    </form>
    @Html.Hidden("ProductOptionJson", Model.Param.ProductOptions.ToJson())
    @Html.Hidden("drillDownLicenseeId", Model.Param.LicenseeId)
    @Html.Hidden("IsAllowedBACommission", Model.ProductAccess.IsAllowBA)
    @Html.Hidden("IsAllowedRacing", Model.ProductAccess.IsAllowRB)
    @Html.Hidden("IsAllowedCustomerCommission", Model.IsAllowedCustomerCommission)    
</div>
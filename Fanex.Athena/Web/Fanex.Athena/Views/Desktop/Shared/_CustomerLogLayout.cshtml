@{
    Layout = "~/Views/Desktop/Shared/_Layout.cshtml";
}

@section css
{
    <link href="@Url.ContentLinkByEnv("/www/css/build/pages/customer/customerlog.css")" rel="stylesheet" />
}
@section js
{
    <script src="@Url.ContentLinkByEnv("/www/js/build/pages/customer/customerlog.chunk.js")"></script>
    @RenderSection("pagejs", required: false)
}

@RenderSection("Menu", required: false)

<div id="report-container">
    <div class="page-form">
        @RenderSection("Filter", required: false)
    </div>
    <div class="page-results">
        <div class="main-content">
            <div class="panel-body">
                <div class="theme_jqGrid">
                    <table id="ReportGrid" class="table"></table>
                    <div id="ppdata">
                    </div>
                </div>

                @RenderBody()
            </div>
        </div>
    </div>
</div>
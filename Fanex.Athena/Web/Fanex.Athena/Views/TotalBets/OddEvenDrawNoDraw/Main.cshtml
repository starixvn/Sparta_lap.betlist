@{
    ViewBag.Title = "LRF - " + ViewResources.TotalBets +
    " - " + ViewResources.OddEvenDND;
    Layout = Request.IsAjaxRequest() ? null : "~/Views/Shared/_TotalBetsLayout.cshtml";
}
@using Fanex.Athena.Models.ViewModel
@model Fanex.Athena.Models.ViewModel.TotalBets.OddEvenDrawNoDrawViewModel
@section page {
    <script src="@Url.ContentLink("/Scripts/TotalBets/oddevendrawnodraw.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Forecast/forecastpopup.js")" type="text/javascript"></script>
    <script type="text/javascript">
        $(window).load(function () {
            OddEvenDND.initialize();
            RefreshCountDown.initEvent();
        });
    </script>
}
@section ContentTitle
    {
    @ViewResources.OddEvenDND
}
@section ContentFilter
{
    @{
        Html.RenderPartial("~/Views/TotalBets/OddEvenDrawNoDraw/Filter.cshtml");
    }
}
@{
    Html.RenderPartial("~/Views/TotalBets/OddEvenDrawNoDraw/Content.cshtml");
}
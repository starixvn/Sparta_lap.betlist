@using Fanex.Athena.Models.ViewModel
@using Fanex.Athena.Extension.Helper
@model Fanex.Athena.Models.ViewModel.Report.LiveReports.LiveReportViewModel
<div class="container_26">
    <div class="grid_26">
        <div class="report-title" style="width:@(ViewBag.TitleWidth)px;">
            @ViewResources.LiveReport, @RazorHelper.TitleDateTime(Model.Param.FromDate,Model.Param.ToDate)
            - @RazorHelper.ViewCurrencyBasedOnConverter(Model.Param.IsConvert, Model.Param.BaseCurrency, Model.Param.CurrencyName)
        </div>
        <div class="summary-title ">
            @ViewResources.Summary
        </div>
        <div class="report-content" style="width:@(ViewBag.WrapperWidth)px">
            @{
                Html.RenderPartial("~/Views/Report/LiveReport/Content.Header.cshtml");
            }
            <!--Grid.Content-->
            @if (Model.MainResult.Count == 0)
            {
                <div class="content-row" style="width:@(ViewBag.ContainerWidth)px;">
                    <div class="row grid-noinfo" style="width:@(ViewBag.ContainerWidth)px;" >
                        <div>
                            @ViewResources.NoInfo
                        </div>
                    </div>
                </div>
            }
            else
            {
                Html.RenderPartial("~/Views/Report/LiveReport/Content.Data.cshtml");
            }
            <!--Grid.Content-->
            <div class="clear"></div>
            <div id="detail-content">
            </div>
        </div>
    </div>
</div>

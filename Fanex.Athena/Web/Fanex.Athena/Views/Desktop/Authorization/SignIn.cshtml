@{
    Layout = null;
    var loginToken = ViewBag.LogInToken as string;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="">
    <meta name="author" content="">
    <title>Licensee Admin | Live Report</title>

    <!-- Font -->
    <link href="https://fonts.googleapis.com/css?family=Montserrat" rel="stylesheet">
    <!-- Materialize CSS -->
    <link href="~/www/css/build/vendors/materialize.css" rel="stylesheet" />
    <!-- Style for page -->
    <link href="~/www/css/build/main.css" rel="stylesheet" />
    <link href="~/www/css/build/pages/login/login.css" rel="stylesheet" />

    <script type="text/javascript">
        var _page=
        {
            errCode: @(ViewBag.errCode),
            errMsg: '@(ViewBag.errMsg)'
        };
        var resolveClientUrl = function (relativeUrl) {
            return '@Url.Content("~/")' + relativeUrl;
        };
    </script>
</head>
<body class="page-login layout-full">
    <div class="page text-center">

        <div class="page-content">
            <div class="brand">
                <div class="brand-text text-left">
                    <div class="text-small">Welcome</div>
                    <div class="big-text">Licensee Admin</div>
                </div>
            </div>

            <form action="@Url.Content("~/Authorization/SignIn")" method="post" name="fLogin">
                @Html.AntiForgeryToken()
                <div class="input-field col s12">
                    <div class="input-icon-group">
                        <i class="icon icon-account" aria-hidden="true"></i>
                        <input type="text" class="form-control" placeholder="@ViewResources.Username" id="userName" name="userName" value="" />
                        <i class="icon icon-close pull-right" id="btn-reset-1"></i>
                    </div>
                </div>

                <div class="input-field col s12">
                    <div class="input-icon-group">
                        <i class="icon icon-lock" aria-hidden="true"></i>
                        <input type="password" class="form-control" placeholder="@ViewResources.Password" id="passWord" name="passWord" value="" autocomplete="off" />
                        <i class="icon icon-close pull-right"></i>
                    </div>
                </div>

                <div class="input-field col s12">
                    <div class="input-icon-group input-capcha-group">
                        <div class="capcha-img" onclick="GetValidateImage()">
                            <img src="@Url.Content("~/Authorization/Captcha")" class="img-captcha" id="imgCode" alt="" />
                        </div>
                        <input type="text" maxlength="4" autocomplete="off" value="" id="captcha" name="captcha" class="form-control capcha-input" />
                    </div>
                </div>

                <div class="input-field col s12">
                    <div class="row">
                        <div class="col m8 l9">
                            <p id="errmsg" class="errmsg">
                            </p>
                        </div>
                        <div class="col m4 l3">
                            <input type="submit" class="btn btn-login" id="button" name="button" value="@ViewResources.Login" />
                        </div>
                    </div>
                </div>

                @Html.Hidden("LogInToken")
            </form>
        </div>
    </div>

    <input type="hidden" id="captchaUrl" value="@Url.Content("~/Authorization/Captcha")" />
    @Html.Hidden("LogInTokenTemp", loginToken)

    @*<script src="~/www/js/test/vendors.chunk.js"></script>*@
    <script src="@Url.ContentLink("/Scripts/Library/jquery.min.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Library/CryptoJS.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/SignIn/SignIn.js")" type="text/javascript"></script>
</body>
</html>
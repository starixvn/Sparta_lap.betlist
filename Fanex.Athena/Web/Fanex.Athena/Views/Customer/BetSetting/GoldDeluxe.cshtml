@{
    Layout = "~/Views/Shared/_BetSettingLayout.cshtml";
}
@model Fanex.Athena.Models.ViewModel.BetSettings.GoldDeluxeBetSettingViewModel
@using Fanex.Athena.Models.ViewModel;
@using Fanex.Athena.Models.DataDomain;
@section pagecss
{
}
@section pagejs {
    <script src="@Url.ContentLink("/Scripts/Customer/BetSetting/golddeluxe.js")" type="text/javascript"></script>
}
@{Html.RenderPartial("~/Views/Customer/BetSetting/Menu.cshtml", Model.Param);}
@{    
    var hasData = Model.Games.Count > 0;
    var isLineEnabled = Model.BetSetting.IsLineEnabled;
    var tableTextClass = Model.IsEnabled.HasValue && Model.IsEnabled.Value ? "" : "disabled-text";
}
<div class="content-title" style="width: 855px">
    @Model.Param.BetSettingName @ViewResources.BetSettings - @Model.Param.NickName (@Model.Param.UserName)
</div>
@if (isLineEnabled)
{
    <div style="padding-bottom: 5px">
        @ViewResources.BetSettingGroups:
        @if (Model.BetSetting.IsEnabled && hasData)
        {
            <select id="betSettingGroup" data-default="@Model.BetSetting.Group">
                @foreach (var item in Model.BetSetting.CheckedGroups)
                {
                    <option value="@item" @(item == Model.BetSetting.Group ? "selected" : null) >@item</option>
                }
            </select>
        }
        else
        {
            <span class="@tableTextClass">@Model.BetSetting.Group</span>
        }
    </div>
    
    @Html.Hidden("editable", Model.Param.Editable)
    @Html.Hidden("dataCount", Model.BetSetting.IsEnabled ? 1 : 0)
    @Html.Hidden("BettingLimit", new System.Web.Script.Serialization.JavaScriptSerializer().Serialize(Model.Games))
}
  
@if (isLineEnabled && !hasData)
{              
    var currencyId = Model.BetSetting.CurrencyId;
    if (currencyId == CurrencyType.Aud || currencyId == CurrencyType.Chf || currencyId == CurrencyType.Eur || currencyId == CurrencyType.Gbp)
    {
        <div style="width: 885px!important; padding: 20px 0px 20px 0px">
            <div>@ViewResources.CurrencyNotSupportedForGoldDeluxe</div>
        </div>
    }
    else
    {
        <div style="width: 885px!important; padding: 20px 0px 20px 0px">
            <div>@ViewResources.ProblemDisplayBetSetting</div>
        </div> 
    }
}
else
{
    <!--Header-->
    <div class="header-content" style="width: 884px;">
        <div class="row" style="width: 295px;">@ViewResources.GameType</div>
        <div class="row" style="width: 293px;">
            @ViewResources.MinBet
        </div>
        <div class="row" style="width: 293px;">
            @ViewResources.MaxBet
        </div>
    </div>
    <!--/Header-->
    <!--Content-->
    <div class="data-content">
        @if (isLineEnabled == false)
        {
            <div class="content-row" style="width: 885px!important">
                <div class="no-info">
                    <div>@ViewResources.GoldDeluxeNotOfferCurrency</div>
                </div>
            </div>
        }
        else
        {
            foreach (var game in Model.Games)
            {
                var group = game.Groups.Where(x => x.GroupType == Model.BetSetting.Group).FirstOrDefault();
            <div class="content-row">
                <div class="row text-data first-column" style="width: 295px">
                    <div>@game.Name</div>
                </div>
                <div id="min-@(game.GameType)" class="row text-data @tableTextClass" style="width: 293px">
                    @(group != null ? group.Min.ToString("#,###,##0.##") : "")
                </div>
                <div id="max-@(game.GameType)" class="row text-data @tableTextClass" style="width: 293px">
                    @(group != null ? group.Max.ToString("#,###,##0.##") : "")
                </div>
            </div>
            }
        }
    </div>
}
<!--/Content-->
<!--SubmitButton-->
@if (Model.Param.Editable)
{
    <div style="width: 855px">
        <input type="button" @(isLineEnabled && hasData ? null : "disabled") class="button" data-cust-id="@Model.Param.CustId" data-user-name="@Model.Param.UserName.ToString()" 
        data-nick-name="@Model.Param.NickName" value="@ViewResources.Submit"
        id="btnSubmitBetSetting"/>
        <input type="button" @(isLineEnabled && hasData ? null : "disabled") class="button" value="@ViewResources.Reset"
        id="btnReset" />
        @if (isLineEnabled)
        {
            <input type="button" class="button" data-status="@(Model.IsEnabled.HasValue && Model.IsEnabled.Value ? 0 : 1)" 
            data-cust-id="@Model.Param.CustId" 
            data-nick-name="@Model.Param.NickName" value="@(Model.IsEnabled.HasValue && Model.IsEnabled.Value ? ViewResources.DisableGoldDeluxe : ViewResources.EnableGoldDeluxe)"
            id="btnUpdateStatus" />
        }
    </div>
}
<!--/SubmitButton-->

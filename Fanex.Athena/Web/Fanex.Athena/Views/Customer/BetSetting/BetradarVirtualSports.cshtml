@{
    Layout = "~/Views/Shared/_BetSettingLayout.cshtml";
}
@model Fanex.Athena.Model.BetSettings.ViewModel.BetSettingViewModel
@section pagecss
{
}
@section pagejs
{
}
@{Html.RenderPartial("~/Views/Customer/BetSetting/Menu.cshtml", Model);}

<div class="content-title" style="width: 855px">
    @Model.Param.BetSettingName @ViewResources.BetSettings - @Model.Param.NickName (@Model.Param.UserName)
</div>
@Html.Hidden("dataCount", (Model.MainData.Count))
<!--Header-->
<div class="header-content" style="width: 884px;">
    <div class="row" style="width: 190px;">@ViewResources.Sport</div>
    <div class="row" style="width: 230px;">@ViewResources.MinBet</div>
    <div class="row" style="width: 230px;">@ViewResources.MaxBet</div>
    <div class="row" style="width: 230px;">@ViewResources.MaxPerMatch</div>
</div>
<!--/Header-->
<!--Content-->
<div class="data-content">
    @if (Model.MainData.Count == 0)
    {
        <div class="content-row" style="width: 885px!important">
            <div class="no-info">
                <div>@ViewResources.NoInfo</div>
            </div>
        </div>
    }
    else
    {
        var decimalFormatter = "#,###,##0.##";
        foreach (var item in Model.MainData)
        {
            <div class="content-row">
                <div class="row text-data first-column" style="width: 190px">
                    <div>@item.BetSettingType</div>
                </div>
                <div class="row text-data" style="width: 230px">
                    @item.MinBet.ToString(decimalFormatter)
                </div>
                <div class="row text-data" style="width: 230px">
                    @item.MaxBet.ToString(decimalFormatter)
                </div>
                <div class="row text-data" style="width: 230px">
                    @item.MaxPerMatch.ToString(decimalFormatter)
                </div>
            </div>
        }
    }
</div>
<!--/Content-->
@model Fanex.Athena.Model.Report.ViewModel.ThirdPartyWinLossViewModel
@{
    ViewBag.Title = "LRF - " + ViewResources.Report +
    " - " + ViewResources.GoldDeluxeWinLoss;
    Layout = "~/Views/Shared/_Report.jqGridLayout.cshtml";
}
@section pagecss {
    <link href="@Url.ContentLink("/Content/Report/thirdpartywinloss.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.ContentLink("/Content/Plugin/Common/bread-crumb.css")" rel="stylesheet" type="text/css" />
}
@section pagejs {
    <script src="@Url.ContentLink("/Scripts/Report/thirdpartywinloss.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Report/thirdpartywinloss.option.js")" type="text/javascript"></script>
<script src="@Url.ContentLink("/Scripts/Report/thirdpartywinloss.golddeluxe.js")" type="text/javascript"></script>
}
@section ContentTitle
    {
    @ViewResources.GoldDeluxeWinLoss
}
<div class="container_26" style="margin-left: -7px">
    <div class="grid_26">
        @{
            Html.RenderPartial("~/Views/Report/GoldDeluxeWinLoss/Content.cshtml");
        }
    </div>
  
</div>
@section ContentFilter
{
    @{Html.RenderPartial("~/Views/Report/GoldDeluxeWinLoss/Filter.cshtml");}
}

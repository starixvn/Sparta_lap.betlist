@{
    string titleFormat = @"LRF {0} {1} - {2}";
    ViewBag.Title = string.Format(titleFormat, HttpUtility.HtmlDecode("&bull;"),
                                         ViewResources.AccountManagement, ViewResources.ManageAccount);
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}
@using Fanex.Athena.Model.Core.DTO.Users;
@using Fanex.Athena.Model.Report.ViewModel;
@model List<User>
@section pagecss {
    <link href="@Url.ContentLink("/Content/Global/lrf.global.reportable.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.ContentLink("/Content/Account/AccountManagement.css")" rel="stylesheet" type="text/css" />
}
@section pagejs {
    <script src="@Url.ContentLink("/Scripts/Account/ManageAccount.js")" type="text/javascript"></script>
}
@section ContentTitle
{
    @ViewResources.AccountManagement
    <div class="note-group" style="right: 220px;">
        <div class="userguide-icon" id="UserGuide" title="@ViewResources.UserGuide">
        </div>
    </div>
}

<div>
    <table cellspacing="0" cellpadding="0" border="0" style="width: 80%; display: table;"
        class="report-table" id="tbl-rpt">
        <thead>
            <tr class="report-table-header">
                <th class="RowNo">
                    #
                </th>
                <th>@ViewResources.Username
                </th>
                <th>@ViewResources.FirstName
                </th>
                <th>@ViewResources.LastName
                </th>
                <th>@ViewResources.Status
                </th>
                

                    <th>@ViewResources.Password
                    </th>

                    <th>@ViewResources.Account
                    </th>
                
                <th>@ViewResources.Permission
                </th>
                <th>@ViewResources.AccountManagement
                </th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count > 0)
            {
                int count = 1;
                foreach (var user in Model)
                {
                    var bgTr = string.Empty;

                    if (user.Status.Equals("Close"))
                    {
                        bgTr = "bgcolor=#ccc7ba";
                    }
                
                <tr @bgTr>
                    <td style="text-align: center">
                        @count
                    </td>
                    <td style="text-align: left">
                        @user.Username
                    </td>
                    <td style="text-align: left">
                        @user.FirstName
                    </td>
                    <td style="text-align: left">
                        @user.LastName
                    </td>
                    <td style="text-align: center" class="cmd">
                        @user.Status
                    </td>
                    <td style="text-align: center" class="cmd">
                    @if (!user.IsInternal)
                    {  
                        <span data-custid="@user.UserID" data-lastname="@user.LastName" data-firstname="@user.FirstName" data-username="@user.Username" onclick="ManageAccount.resetPassword(this)" class="link">
                            @ViewResources.Reset</span>
                    }
                    </td>
                    <td style="text-align: center" class="cmd">
                    @if (!user.IsInternal)
                    {  
                        <span data-custid="@user.UserID" onclick="ManageAccount.editAccount(this)" class="link">@ViewResources.Edit</span>
                    }
                    </td>
                    <td style="text-align: center">
                        <span data-custid="@user.UserID" onclick="ManageAccount.editPermission(this)" class="link">@ViewResources.Edit</span>
                    </td>
                    <td style="text-align: center" class="cmd">
                    @if (user.IsManageAccount)
                    {

                            <img title="yes" alt="yes" src="@Url.ContentLink("/Resources/Images/icon_checked.gif")" />
                    }
                    </td>
                </tr>
                    count++;
                }
            }
            else
            {
                <tr>
                    <td colspan="9">
                        @ViewResources.NoInfo
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

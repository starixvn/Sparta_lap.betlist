@{
    ViewBag.Title = "LRF - " + ViewResources.Report + " - " + ViewResources.Customer + " " + ViewResources.PendingFunds;
    Layout = "~/Views/Shared/_ReportLayout.cshtml";
}
@using Fanex.Athena.Model.Report.ViewModel
@model Fanex.Athena.Model.Report.ViewModel.CustomerPendingFundsViewModel
@section pagecss {
    <link href="@Url.ContentLink("/Content/Report/CustomerPendingFunds.css")" rel="stylesheet" type="text/css" />
}
@section pagejs {
    <script src="@Url.ContentLink("/Scripts/Report/CustomerPendingFunds.js")" type="text/javascript"></script>
}
@{
    ViewBag.NumberWidth = 40;
    ViewBag.ExternalIdWidth = 200;
    ViewBag.SystemIdWidth = 200;
    ViewBag.BetCountWidth = 120;
    ViewBag.PendingFundsWidth = 115;
    ViewBag.ContainerWidth = ViewBag.NumberWidth + ViewBag.ExternalIdWidth + ViewBag.SystemIdWidth
        + ViewBag.BetCountWidth + ViewBag.PendingFundsWidth + 5;

    ViewBag.WrapperWidth = ViewBag.ContainerWidth + 22;
    ViewBag.FilterWidth = ViewBag.WrapperWidth > 1075 ? 1075 : ViewBag.WrapperWidth;
}
@section ContentTitle
{
    @ViewResources.CustomerPedingFunds
}
@section ContentFilter
{
    @{
        Html.RenderPartial("~/Views/Report/CustomerPendingFunds/Filter.cshtml");
    }
}
@if (!Model.ShowEmptyContent)
{
    Html.RenderPartial("~/Views/Report/CustomerPendingFunds/Content.cshtml");
}
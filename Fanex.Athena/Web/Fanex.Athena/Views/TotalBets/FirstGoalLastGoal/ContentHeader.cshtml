@using Fanex.Athena.Models.ViewModel
<div class="header-content">
<table class="report-table">
    <thead>
        <tr class="report-header" style="height:48px!important;">
            <td style="width: 3%">#</td>
            <td style="width: 20%">@ViewResources.Time
            </td>
            <td style="width: 30%">@ViewResources.Home/@ViewResources.Away
            </td>
            <td style="width: 15%">@ViewResources.FirstGoal
            </td>
            <td style="width: 15%">@ViewResources.LastGoal
            </td>
            <td style="width: 15%">@ViewResources.NoGoal
            </td>
        </tr>
    </thead>
</table>
</div>

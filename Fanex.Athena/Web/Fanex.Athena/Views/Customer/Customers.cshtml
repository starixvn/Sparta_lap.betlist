@{
    ViewBag.Title = "LRF - " + ViewResources.CustomerList;
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}
@using Fanex.Athena.Models.ViewModel;
@model Fanex.Athena.Models.ViewModel.Customer.CustomerListViewModel
@section pagecss {
    <link href="@Url.ContentLink("/Content/Customer/CustomerList.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.ContentLink("/Content/Plugin/MultiSelect/jquery.multiselect.css")" rel="stylesheet" type="text/css" />
}
@section pagejs {
    <script src="@Url.ContentLink("/Scripts/Plugin/MultiSelect/jquery.multiselect.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Customer/Customers.option.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Customer/Customers.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Customer/CustomerCommList.js")" type="text/javascript"></script>
}
@section ContentTitle
{
    @ViewResources.CustomerList
}
@section ContentFilter
{
    @{Html.RenderPartial("~/Views/Customer/Filter.cshtml", Model);}
}
<div id="ajax-panel">

@{
    foreach (var item in Model.Param.GridColumns)
    {
        if (item.Checked)
        {
            ViewData[item.Name] = item.Name;
        }
    }

    ViewBag.CommCount = 1;
    ViewBag.CommCount += Model.ProductAccess.IsAllowRb ? 1 : 0;
    ViewBag.CommCount += Model.ProductAccess.IsAllowNg ? 1 : 0;
    ViewBag.CommCount += Model.ProductAccess.IsAllowLc ? 1 : 0;
    ViewBag.CommCount += Model.ProductAccess.IsAllowCs ? 1 : 0;

    ViewBag.NumberWidth = 30;
    ViewBag.GroupWidth = ViewData["Group"] != null ? 95 : 0;
    ViewBag.ExternalIdWidth = ViewData["ExternalId"] != null ? 110 : 0;
    ViewBag.SystemIdWidth = ViewData["SystemId"] != null ? 110 : 0;
    ViewBag.AvailableFundsWidth = ViewData["AvailableFunds"] != null ? 85 : 0;
    ViewBag.PendingFundsWidth = ViewData["PendingFunds"] != null ? 80 : 0;
    ViewBag.StatusWidth = ViewData["Status"] != null ? 75 : 0;
    ViewBag.BaStatusWidth = ViewData["BaStatus"] != null ? 70 : 0;
    ViewBag.SpecialLevelWidth = ViewData["SpecialLevel"] != null ? 80 : 0;
    ViewBag.CustomerOptionWidth = ViewData["CustomerOption"] != null ? 90 : 0;
    ViewBag.CommMergeWidth = ViewData["Commission"] != null ? 150 : 0;
    ViewBag.CommWidth = ViewData["Commission"] != null ? 150 / ViewBag.CommCount : 0;
    ViewBag.CommMergeWidth = ViewBag.CommWidth * ViewBag.CommCount + ViewBag.CommCount - 1;

    ViewBag.ColumnCount = Model.Param.GridColumns.Where(i => i.Checked).Count();
    ViewBag.ColumnCount += Model.ProductAccess.IsAllowBa && ViewData["BaStatus"] != null ? 2 : 0;
    ViewBag.ColumnCount += Model.IsAllowedCustomerCommission && ViewData["Commission"] != null ? 1 : 0;

    ViewBag.ContainerWidth = ViewBag.NumberWidth + ViewBag.ExternalIdWidth +
    ViewBag.SystemIdWidth + ViewBag.AvailableFundsWidth + ViewBag.PendingFundsWidth +
    ViewBag.StatusWidth + ViewBag.SpecialLevelWidth + ViewBag.CustomerOptionWidth;
    ViewBag.ContainerWidth += Model.ProductAccess.IsAllowBa ? ViewBag.BaStatusWidth : 0;
    ViewBag.ContainerWidth += Model.IsAllowedCustomerCommission ? ViewBag.CommMergeWidth + ViewBag.GroupWidth : 0;

    ViewBag.ContainerWidth += ViewBag.ColumnCount - 1;
    if (ViewBag.ContainerWidth < 300)
    {
        ViewBag.NumberWidth = 300 - ViewBag.ContainerWidth + 30;
        ViewBag.ContainerWidth = 300;

    }
    ViewBag.WrapperWidth = ViewBag.ContainerWidth + 18;

    ViewBag.TitleWidth = ViewBag.WrapperWidth - 24;
    if (ViewBag.TitleWidth < 600)
    {
        if (!string.IsNullOrEmpty(Model.BaTimeCheck))
        {
            ViewBag.TitleWidth = 600;
        }
        else if (ViewBag.TitleWidth < 300)
        {
            ViewBag.TitleWidth = 300;
        }
    }

    ViewBag.FilterWidth = ViewBag.WrapperWidth > 1075 ? 1075 : ViewBag.WrapperWidth;
}
@if (Model.DataList != null)
{
    if (Model.IsAllowedUserEditComm && Model.IsAllowedCustomerCommission)
    {

    <div class="grid_9 filter-input new-line" style="padding-bottom: 2px;">
        <input type="button" id="MoveToGroup" value="@ViewResources.MoveToGroup" class="button" />&nbsp;&nbsp;&nbsp;
        <input type="button" id="UpdateComm" value="@ViewResources.UpdateCommission" class="button" data-group-id="@Model.Param.GroupCommId"/>&nbsp;&nbsp;&nbsp;
        <input type="button" id="RemoveFromGroup" value="@ViewResources.RemoveFromGroup" class="button" />&nbsp;&nbsp;&nbsp;
    </div>
    }
 
    <div class="container_26">
        <div class="grid_26">
            <div class="report-title" style="width:@(ViewBag.TitleWidth)px;">
                @ViewResources.SearchResult:
                <label class="num-of-customer">@Model.TotalRows @ViewResources.Customers.ToLower()</label>
                <div style="float: right;">
                    @using (Html.BeginForm("ExportExcel", "Customer", FormMethod.Post, new { @id = "CustomerExcelForm" }))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="excelParam" id="excelParam" value="@Model.Param.ToJson()" />
                        <input alt="@ViewResources.ExportToExcel" src="@Url.ContentLink("/Content/Global/Images/excel.gif")"
               type="image" id="ExportToExcel" name="exporttoexcel"
               title="@ViewResources.ExportToExcel" class="hand" />
                    }
                </div>
                <label class="ba-time-notice">@Model.BaTimeCheck</label>
            </div>
             <div class="report-content"  style="width:@(ViewBag.WrapperWidth)px;">
                <div style="width: 100%">
                    <table id="ReportGrid" data-hidden-column="">
                        <tr>
                            <td>
                            </td>
                        </tr>
                    </table>
                    <div id="ppdata">
                    </div>
                    <div id="footer" class="hide">
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!--popup-->
    <div title="@ViewResources.BetSetting" id="bet-setting-dialog" class="hide">
        <iframe id="bet-setting-frame" style="border: none;" src=""></iframe>
    </div>
                  if (Model.IsAllowedCustomerCommission)
                  {
    <div id="MoveToGroupPopUp" class="hide" title="@ViewResources.MoveToGroup">
        @{
                      Html.RenderPartial("~/Views/Customer/CustomerDialog/MoveToGroup.cshtml");   
        }
    </div>
    <div id="UpdateCustCommPopUp" class="hide" title="@ViewResources.UpdateCustomerCommission">
        @{
                      Html.RenderPartial("~/Views/Customer/CustomerDialog/UpdateCustComm.cshtml", Model.ProductAccess);   
        }
    </div>
    <div id="ConfirmRemoveFromGroupPopUp" class="hide" title="@ViewResources.RemoveFromGroup">
        @{
                      Html.RenderPartial("~/Views/Customer/CustomerDialog/RemoveFromGroup.cshtml");   
        }
    </div>
  
                  }
                  if (Model.DataList != null)
                  {
    @Html.Hidden("NumOfCheckBox", Model.DataList.Count)
                  }
                  Html.RenderPartial("~/Views/Customer/ContextMenu.cshtml", Model);   
    <!--/popup-->
}
</div>
@{
    string titleFormat = @"LRF {0} {1} - {2}";
    ViewBag.Title = string.Format(titleFormat, HttpUtility.HtmlDecode("&bull;"),
        ViewResources.AccountManagement, ViewResources.ManageAccount);
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}
@model Fanex.Athena.Model.Core.DTO.Users.User

@section pagecss {
   <link href="@Url.ContentLink("/Content/Global/lrf.global.reportable.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.ContentLink("/Content/Account/AccountManagement.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.ContentLink("/Content/Account/Permission.css")" rel="stylesheet" type="text/css" />
}

@section pagejs {
    <script src="@Url.ContentLink("/Scripts/Account/EditPermission.js")" type="text/javascript"></script>
}

@section ContentTitle
{
    @(ViewResources.PermissionForUser + " \""  + Model.Username + "\"")
}
<div class="response-area">
    <span id="resultMessage">
        
    </span>
</div>

@{
    var enableAssignCurrency = ViewBag.EnableAssignCurrency;
}
<div id="permission-tabs">
     <ul>
        <li><a href="@Url.Action("EditPermission", "Account", new { UserId =Model.Id})">@ViewResources.Function</a></li>

    @if (enableAssignCurrency)
    {
        <li><a href="@Url.Action("AssignCurrency", "Account", new { UserId = Model.Id })">@ViewResources.Currency</a></li>
    }
    </ul>

    

</div>

<div style="clear: both;"></div>
<div style="height: 30px; margin: 20px 5px 5px;">
    <input type="button"  id="btnSave" value="@ViewResources.Save" name="btnSave" class="button"/>
    &nbsp;&nbsp;
    <input type="reset" value="@ViewResources.Reset" id="btnReset" class="button" />
    &nbsp;&nbsp;
    <input type="button" value="@ViewResources.Cancel" id="btnCancel" class="button">
</div>

<script type="text/javascript" language="javascript">
    var colUrl = '@Url.ContentLink("/Resources/Images/collapse.png")';
    var expUrl = '@Url.ContentLink("/Resources/Images/expand.png")';
    var nullUrl = '@Url.ContentLink("/Resources/Images/null.png")';

    $(document).ready(function () {
        EditPermission.init(colUrl, expUrl, nullUrl);
    });
</script>

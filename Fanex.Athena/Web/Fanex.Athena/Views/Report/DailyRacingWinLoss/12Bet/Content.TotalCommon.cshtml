@using Fanex.Athena.Model.Report.ViewModel
@using Fanex.Athena.Extension.Helper;
@model Fanex.Athena.Model.Report.DTO.DailyRacingWinLoss
<div class="content-row common-total-row" style="width: @ViewBag.ContainerWidth@("px")">
    <div class="common-total-text" style="width: @(ViewBag.TotalWidth)@("px")">
        @ViewResources.Total</div>
    <div class="common-total-row-group" style="width: @(ViewBag.ContainerWidth - ViewBag.TotalWidth - 1)@("px")">
        @*-----------------------------------Total Currency---------------------------------*@
        <div class="content-row" style="width: @(ViewBag.ContainerWidth - ViewBag.TotalWidth)@("px")">
            <div class="row" style="width: @ViewBag.CurrencyWidth@("px")">
                <div class="title-text">@Model.CurrencyName</div>
            </div>
            <div class="row" style="width: @ViewBag.CommonWidth@("px")">
                <div>@Model.WinTO.ToStringExt()</div>
            </div>
            <div class="row" style="width: @ViewBag.CommonWidth@("px")">
                <div>@Model.PlaceTO.ToStringExt()</div>
            </div>
            <div class="row" style="width: @ViewBag.CommonWidth@("px")">
                <div>@Model.WPTO.ToStringExt()</div>
            </div>
            <div class="row" style="width: @ViewBag.CommonWidth@("px")">
                <div>@Model.TotalTO.ToStringExt()</div>
            </div>
            <div class="row" style="width: @ViewBag.DividendWidth@("px")">
                <div>@Model.DividendWon.ToStringExt()</div>
            </div>
            @if (Convert.ToBoolean(ViewBag.IsAllowedCustomerCommission))
            {
                <div class="row" style="width: @ViewBag.CustomerCommWidth@("px")">
                    <div>@Model.CustomerCommission.ToStringExt()</div>
                </div>
            }
            <div class="row" style="width: @ViewBag.CommonWidth@("px")">
                <div>@Model.WinTO12Bet.ToStringExt()</div>
            </div>
            <div class="row" style="width: @ViewBag.CommonWidth@("px")">
                <div>@Model.PlaceTO12Bet.ToStringExt()</div>
            </div>
            <div class="row" style="width: @ViewBag.CommonWidth@("px")">
                <div>@Model.WPTO12Bet.ToStringExt()</div>
            </div>
            <div class="row" style="width: @ViewBag.CommonWidth@("px")">
                <div>@Model.TotalTO12Bet.ToStringExt()</div>
            </div>
            <div class="row" style="width: @ViewBag.CommonWidth@("px")">
                <div>@Model.WinLoss12Bet.ToStringExt()</div>
            </div>
            <div class="row" style="width: @ViewBag.LicenseeCommWidth@("px")">
                <div>@Model.CommIncome.ToStringExt()</div>
            </div>
            <div class="row" style="width: @ViewBag.AmountDueToWidth@("px")">
                <div>@Model.AmountDueToRacing.ToStringExt()</div>
            </div>
        </div>
        @*-----------------------------------Total MYR---------------------------------------*@
        <div class="content-row" style="width: @(ViewBag.ContainerWidth - ViewBag.TotalWidth)@("px")">
            <div class="row title-text" style="width: @ViewBag.CurrencyWidth@("px")">
                <div class="title-text">@ViewResources.MYR</div>
            </div>
            <div class="row" style="width: @ViewBag.CommonWidth@("px")">
                <div>@Model.WinTOMYR.ToStringExt()</div>
            </div>
            <div class="row" style="width: @ViewBag.CommonWidth@("px")">
                <div>@Model.PlaceTOMYR.ToStringExt()</div>
            </div>
            <div class="row" style="width: @ViewBag.CommonWidth@("px")">
                <div>@Model.WPTOMYR.ToStringExt()</div>
            </div>
            <div class="row" style="width: @ViewBag.CommonWidth@("px")">
                <div>@Model.TotalTOMYR.ToStringExt()</div>
            </div>
            <div class="row" style="width: @ViewBag.DividendWidth@("px")">
                <div>@Model.DividendWonMYR.ToStringExt()</div>
            </div>
            @if (Convert.ToBoolean(ViewBag.IsAllowedCustomerCommission))
            {
                <div class="row" style="width: @ViewBag.CustomerCommWidth@("px")">
                    <div>@Model.CustomerCommissionMYR.ToStringExt()</div>
                </div>
            }
            <div class="row" style="width: @ViewBag.CommonWidth@("px")">
                <div>@Model.WinTO12BetMYR.ToStringExt()</div>
            </div>
            <div class="row" style="width: @ViewBag.CommonWidth@("px")">
                <div>@Model.PlaceTO12BetMYR.ToStringExt()</div>
            </div>
            <div class="row" style="width: @ViewBag.CommonWidth@("px")">
                <div>@Model.WPTO12BetMYR.ToStringExt()</div>
            </div>
            <div class="row" style="width: @ViewBag.CommonWidth@("px")">
                <div>@Model.TotalTO12BetMYR.ToStringExt()</div>
            </div>
            <div class="row" style="width: @ViewBag.CommonWidth@("px")">
                <div>@Model.WinLoss12BetMYR.ToStringExt()</div>
            </div>
            <div class="row" style="width: @ViewBag.LicenseeCommWidth@("px")">
                <div>@Model.CommIncomeMYR.ToStringExt()</div>
            </div>
            <div class="row" style="width: @ViewBag.AmountDueToWidth@("px")">
                <div>@Model.AmountDueToRacingMYR.ToStringExt()</div>
            </div>
        </div>
    </div>
</div>

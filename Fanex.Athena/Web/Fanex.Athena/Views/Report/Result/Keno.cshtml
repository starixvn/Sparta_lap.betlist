@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>@ViewResources.Keno - @ViewResources.Results</title>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <link href="@Url.ContentLink("/Content/Global/grid26.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.ContentLink("/Content/Global/lrf.global.content.css")" rel="stylesheet" type="text/css" />
    <script src="@Url.ContentLink("/Scripts/Library/jquery.min.js")" type="text/javascript"></script>
    <style type="text/css">
        div.fanex-result-keno
        {
        }
        div.fanex-result-keno iframe
        {
            width: 1024px;
            min-height: 520px;
            overflow: hidden;
        }
    </style>
    <script type="text/javascript">
        function SwitchPage(section) {
            var normalUrl = '@Url.Content("~/Report/Result")';
            self.location.href = normalUrl + section;
        }
    </script>
</head>
<body>
    <div class="container_26">
        <div class="grid_26">
            <div class="grid_4 content-title" style="min-width: 550px;">
                @ViewResources.Results
            </div>
            <div class="grid_2 filter-input">
                <input type="button" onclick="javascript:SwitchPage('#normal');" value="@ViewResources.Normal" class="button" />
            </div>
            <div class="grid_2 filter-input">
                <input type="button" onclick="javascript:SwitchPage('#outright');" value="@ViewResources.Outright" class="button" />
            </div>
            <div class="grid_2 filter-input">
                <input type="button" value="@ViewResources.Keno" disabled="disabled" class="button button-disabled" />
            </div>
        </div>
    </div>
    <div class="content-main">
        @Html.Raw(ViewBag.Data)
    </div>
</body>
</html>

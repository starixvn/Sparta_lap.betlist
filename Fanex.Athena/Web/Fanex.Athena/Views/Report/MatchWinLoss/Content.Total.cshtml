@using Fanex.Athena.Models.ViewModel
@using Fanex.Athena.Models.Cache
@model Fanex.Athena.Models.ViewModel.Report.MatchWinLossViewModel
@{
    var dataTotal = Model.Total;

    if (Model.MainResult.Count > 0)
    {
    <tr class="total-rows total-first-row total-in-eur">
        <td colspan="2">@ViewResources.Total
        </td>
        <td style="width: 85px">@NumberHelper.DecFormat(@dataTotal.Turnover)
        </td>
        <td style="width: 70px">@dataTotal.TotalTransaction.ToString("#,###")
        </td>
        @if (Model.IsAllowedCustomerCommission)
        {
            <td style="width: 85px">@NumberHelper.DecFormat(@dataTotal.CustomerWl)
            </td>
            <td style="width: 60px">@NumberHelper.DecFormat(@dataTotal.CustomerComm)
            </td>
            <td style="width: 85px">@NumberHelper.DecFormat(@dataTotal.CustomerWl + @dataTotal.CustomerComm)
            </td>
        }
        else
        {
            <td style="width: 85px">@NumberHelper.DecFormat(@dataTotal.CustomerWL)
            </td>
        }
        <td class="highlight" style="width: 85px">
            @RazorHelper.NegativeFormat(dataTotal.LicenseeWL)
        </td>
        @{
        if (Model.ProductAccess.IsAllowBA)
        {
            <td class="highlight" style="width: 60px">
                @RazorHelper.NegativeFormat(dataTotal.BACommission)
            </td>
        }
        }
        @if (Model.ProductAccess.IsAllowRB)
        {
            <td class="highlight" style="width: 70px">
                @RazorHelper.NegativeFormat(dataTotal.RacingRevenue)
            </td>
        }
        @if (Model.ProductAccess.IsAllowBA)
        {
            <td style="width: 70px">@NumberHelper.DecFormat(@dataTotal.AmtDueToBA, 2)
            </td>
        }
        @if (Model.ProductAccess.IsAllowRB)
        {
            <td style="width: 70px">@NumberHelper.DecFormat(@dataTotal.AmtDueToRacing, 2)
            </td>
        }
    </tr>
    }

    var dataListOutright = Model.SpecialBetTypeResult;
    // Display information for outright and mixparlay
    foreach (var itemOutRight in dataListOutright)
    {
    <tr>
        <td colspan="2" class="title-text">
            <span class="downline-link outright-link" onclick="MatchWinLoss.viewOutrightMixParlay(@itemOutRight.BetType)">@CacheRef.GetBettype(@itemOutRight.BetType)</span>
        </td>
        <td>@NumberHelper.DecFormat(itemOutRight.Turnover)
        </td>
        <td>@itemOutRight.TotalTransaction.ToString("#,###")
        </td>
        @if (Model.IsAllowedCustomerCommission)
        {
            <td>@NumberHelper.DecFormat(itemOutRight.CustomerWL)
            </td>
            <td>@NumberHelper.DecFormat(itemOutRight.CustomerComm)
            </td>
            <td>@NumberHelper.DecFormat(itemOutRight.CustomerWL + itemOutRight.CustomerComm)
            </td>
        }
        else
        {
            <td>@NumberHelper.DecFormat(itemOutRight.CustomerWL)
            </td>
        }
        <td class="highlight">
            @RazorHelper.NegativeFormat(@itemOutRight.LicenseeWL)
        </td>
        @if (Model.ProductAccess.IsAllowBA)
        {
            <td class="highlight">
                @RazorHelper.NegativeFormat(itemOutRight.BACommission)
            </td>
        }
        @if (Model.ProductAccess.IsAllowRB)
        {
            <td class="highlight">
                @RazorHelper.NegativeFormat(itemOutRight.RacingRevenue)
            </td>
        }
        @if (Model.ProductAccess.IsAllowBA)
        {
            <td>@NumberHelper.DecFormat(@itemOutRight.AmtDueToBA)
            </td>
        }
        @if (Model.ProductAccess.IsAllowRB)
        {
            <td>@NumberHelper.DecFormat(@itemOutRight.AmtDueToRacing)
            </td>
        }
    </tr>
    }
}

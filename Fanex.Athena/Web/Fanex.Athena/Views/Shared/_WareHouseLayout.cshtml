@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section css
{
    @System.Web.Optimization.Styles.Render("~/bundles/WareHouseLayoutStyes")
    @RenderSection("pagecss", required: false)
}
@section js
{
    @System.Web.Optimization.Scripts.Render("~/bundles/WareHouseLayoutScripts")
    @RenderSection("pagejs", required: false)
}

<div class="container_26">
    <div class="grid_26">
        <div class="content-title">
            @RenderSection("ContentTitle", required: false)
        </div>
    </div>
    @RenderSection("ContentFilter", required: false)
    <div class="content-main">
        <div class="loading">
        </div>
        <div class="block-body">
        </div>
        @RenderBody()
    </div>
</div>

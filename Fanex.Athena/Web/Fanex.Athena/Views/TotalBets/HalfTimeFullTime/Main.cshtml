@{
    ViewBag.Title = "LRF - " + ViewResources.TotalBets +
    " - " + ViewResources.HTFT;
    Layout = Request.IsAjaxRequest() ? null : "~/Views/Shared/_TotalBetsLayout.cshtml";
}
@using Fanex.Athena.Model.Report.ViewModel
@model Fanex.Athena.Model.TotalBet.ViewModel.HalfTimeFullTimeViewModel
@section page {
    <script src="@Url.ContentLink("/Scripts/TotalBets/halftimefulltime.js")" type="text/javascript"></script>
    <script type="text/javascript">
        $(window).load(function () {
            HalfTimeFullTime.initialize();
            RefreshCountDown.initEvent();
        });
    </script>
}
@section ContentTitle
    {
    @ViewResources.HTFT
}
@section ContentFilter
{
    @{
        Html.RenderPartial("~/Views/TotalBets/HalfTimeFullTime/Filter.cshtml");
    }
}
@{
    Html.RenderPartial("~/Views/TotalBets/HalfTimeFullTime/Content.cshtml");
}
@{
    ViewBag.Title = "LRF - " + ViewResources.TotalBets +
    " - " + ViewResources.TotalGoal;
    Layout = Request.IsAjaxRequest() ? null : "~/Views/Shared/_TotalBetsLayout.cshtml";
}
@using Fanex.Athena.Models.ViewModel
@model Fanex.Athena.Models.ViewModel.TotalBets.TotalGoalViewModel
@section page {
    <script src="@Url.ContentLink("/Scripts/TotalBets/totalgoal.js")" type="text/javascript"></script>
    <script type="text/javascript">
        $(window).load(function () {
            TotalGoal.initialize();
            RefreshCountDown.initEvent();
        });
    </script>
}
@section ContentTitle
    {
    @ViewResources.TotalGoal
}
@section ContentFilter
{
    @{
        Html.RenderPartial("~/Views/TotalBets/TotalGoal/Filter.cshtml");
    }
}
@{
    Html.RenderPartial("~/Views/TotalBets/TotalGoal/Content.cshtml");
}
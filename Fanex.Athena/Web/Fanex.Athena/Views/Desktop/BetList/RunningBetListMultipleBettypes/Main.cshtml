@{

    var formatTitle = "{0} {1} {2} - {3}";
    ViewBag.Title = string.Format(formatTitle, "LRF", HttpUtility.HtmlDecode("&bull;"), ViewResources.TotalBets, ViewBag.ReportTitle);

    Layout = "~/Views/Desktop/Shared/_BetListLayout.cshtml";
}

@model Fanex.Athena.Model.BetList.ViewModel.BetListBaseViewModel

@section pagecss{
    <link href="@Url.ContentLinkByEnv("/www/css/build/pages/totalbet/mixparlay.css")" rel="stylesheet" />
}
@section pagejs {
    <script src="@Url.ContentLinkByEnv("/www/js/build/pages/betlist/betlistrunningmultiplebettypes.chunk.js")" type="text/javascript"></script>
}
@section ContentTitle
    {
    @{
        if (ViewBag.IsMixParlay == true || ViewBag.IsSystemParlay == true)
        {
            <a href="javascript:;" id="mixparlay_link" class="center-align parlay-tab @(ViewBag.IsMixParlay == true ? "active" : string.Empty)">
                @ViewResources.MixParlay
            </a>

            <a href="javascript:;" id="systemparlay_link" class="center-align parlay-tab @(ViewBag.IsSystemParlay == true ? "active" : string.Empty)">
                @ViewResources.SystemParlay
            </a>
        }
    }
}
@section ContentFilter
{
    @{
        Html.RenderPartial("~/Views/Desktop/BetList/RunningBetListMultipleBettypes/Filter.cshtml");
    }
}

<div id="popupSystemParlay"></div>
<input type="hidden" id="HiddenColumnList" value="winloss,licenseewl" />
<input type="hidden" id="IsShowSumStake" value="1" />
<input type="hidden" id="title" value="@ViewBag.ReportTitle" />
<input type="hidden" id="userGuideName" value="@ViewBag.UserGuideName" />
<input type="hidden" id="BetListMetaModel" value="@Model.Param.ToJson()" />
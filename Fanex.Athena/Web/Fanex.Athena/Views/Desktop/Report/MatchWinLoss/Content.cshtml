@model Fanex.Athena.Model.Report.ViewModel.MatchWinLossViewModel

@helper RenderFirstRow()
{
    <tr class="first-row">
        <td class="col-small"></td>
        <td class="col-medium"></td>

        <td class="col-child small"></td>
        <td class="col-child small"></td>
        <td class="col-child small"></td>
        @if (Model.IsAllowedCustomerCommission)
        {
            <td class="col-child small"></td>
            <td class="col-child small"></td>
        }
        <td class="col-child small"></td>

        @if (Model.ProductAccess.IsAllowBA)
        {
            <td class="col-child small"></td>
        }
        
        @if (Model.ProductAccess.IsAllowRB)
        {
            <td class="col-child small"></td>
        }

        @if (Model.ProductAccess.IsAllowBA)
        {
            <td class="col-child small"></td>
        }

        @if (Model.ProductAccess.IsAllowRB)
        {
            <td class="col-child small"></td>
        }
    </tr>
}

<div class="page-results">
    <div class="result-content">
        <div class="panel-heading active">
            <div class="panel-title">
                @ViewResources.MatchWinLoss, @DesktopRazorHelper.TitleDateTime(Model.Param.Date, null)
                - @DesktopRazorHelper.ViewCurrencyBasedOnConverter(Model.Param.IsConvert, Model.Param.BaseCurrency, Model.Param.CurrencyName)
                @DesktopRazorHelper.TitleLicenseeWLPrefix(Model.Param.ProductOptions)
            </div>
        </div>

        <div class="main-content">
            @if (Model.MainResult.Count == 0 && Model.SpecialBetTypeResult.Count == 0)
            {
                <p class="no-info-row">@ViewResources.NoInfo</p>
            }
            else
            {
                <div id="header-content" class="header-content">
                    <table class="table">
                        <thead>
                            @RenderFirstRow()
                            @{ Html.RenderPartial("~/Views/Desktop/Report/MatchWinLoss/Content.Header.cshtml"); }
                        </thead>
                    </table>
                </div>

                <div class="body-content">
                    <table class="table">
                        <tbody>
                            @RenderFirstRow()
                            @{ Html.RenderPartial("~/Views/Desktop/Report/MatchWinLoss/Content.Data.cshtml"); }
                        </tbody>
                    </table>
                </div>

                <div class="footer-content">
                    <table class="table">
                        <tbody>
                            @RenderFirstRow()
                            @{
                                if (Model.SpecialBetTypeResult.Count > 0)
                                {
                                    Html.RenderPartial("~/Views/Desktop/Report/MatchWinLoss/Content.Total.cshtml");
                                }

                                Html.RenderPartial("~/Views/Desktop/Report/MatchWinLoss/Content.GrandTotal.cshtml");
                            }
                        </tbody>

                    </table>
                </div>
            }
        </div>
    </div>
</div>
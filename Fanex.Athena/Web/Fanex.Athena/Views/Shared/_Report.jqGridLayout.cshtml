@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using Fanex.Athena.Extension.Helper;
@section css
{
    @System.Web.Optimization.Styles.Render("~/bundles/jqGridLayoutStyles")
    @RenderSection("pagecss", required: false)
}
@section js
{
    @System.Web.Optimization.Scripts.Render("~/bundles/jqGridLayoutScripts")
    @RenderSection("pagejs", required: false)
}
@{
    var userSession = new Fanex.Athena.Service.Core.Users.SessionService().UserSession;
    var isAppModeSelf = userSession == null ? true : userSession.ApplicationMode == Fanex.Athena.Model.Core.DataDomain.AppMode.Self;
}
<div class="container_26">
    <div class="grid_26 @(isAppModeSelf ? string.Empty: "hide")">
        <div class="content-title">
            @RenderSection("ContentTitle", required: false)
        </div>
    </div>
    @RenderSection("ContentFilter", required: false)
</div>
<div class="content-main">
    <div class="loading">
    </div>
    <div class="block-body">
    </div>
    @RenderBody()
</div>
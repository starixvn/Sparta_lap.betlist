@using Fanex.Athena.Models.ViewModel
<div class="header-content"  style="width:@(ViewBag.WrapperWidth + 1)@("px")">
    <div class="row" style="width:@(ViewBag.NumberWidth)@("px")">#</div>
    <div class="row" style="width:@(ViewBag.BetTypeNameWidth)@("px")">
        @ViewResources.GameTypeName
    </div>
    <div class="row" style="width:@(ViewBag.TurnOverWidth)@("px")">
        @ViewResources.Turnover
    </div>
    @SplitingProductHelper.CustomerWLHeader(Model.IsAllowedCustomerCommission,
                                            ViewBag.CustomerWLLargeWidth,
                                            ViewBag.CustomerWLMergeWidth,
                                            ViewBag.CustomerWLWidth,
                                            ViewBag.CustomerCommWidth,
                                            ViewBag.CustomerWLTotalWidth)
    <div class="row" style="width:@(ViewBag.LicenseeWLWidth)@("px")">
        <div class="licenseewl" style="width:@(ViewBag.LicenseeWLWidth - 2)@("px")">
            @ViewResources.LicenseeW_L
        </div>
    </div>
    @*Check BA, RB commission*@
    @if (Model.ProductAccess.IsAllowBa)
    { 
        <div class="row" style="width:@(ViewBag.RbBaWidth)@("px")">
            @ViewResources.BACommission
        </div>
    }
    @if (Model.ProductAccess.IsAllowRb)
    { 
        <div class="row" style="width:@(ViewBag.RbBaWidth)@("px")">
            @ViewResources.RacingRevenue
        </div>
    }
    @if (Model.ProductAccess.IsAllowBa)
    { 
        <div class="row" style="width:@(ViewBag.RbBaWidth)@("px")">
            @ViewResources.AmtDueToBA
        </div>
    }
    @if (Model.ProductAccess.IsAllowRb)
    { 
        <div class="row"  style="width:@(ViewBag.RbBaWidth)@("px")">
            <div class="grid-header-two-line">@ViewResources.AmtDueToRacing</div>
        </div>
    }
</div>

@using Fanex.Athena.Model.Report.ViewModel
@model DailyRacingWinLossViewModel
           <div class="grid_26 content-filter new-line" style="width:@(ViewBag.FilterWidth)px;">

@using (Html.BeginForm("Index", "DailyRacingWinLossReport", FormMethod.Post, new { @id = "ReportForm" }))
{
    @Html.AntiForgeryToken()
    <div id="hiddenfield">
        @Html.Hidden("IsExportExcel", Model.Param.IsExportExcel)
        @Html.Hidden("BalanceUpDay", Model.Param.BalanceUpDay)
    </div>
    <div class="grid_2 filter-label">
        <label>@ViewResources.Date</label>
    </div> 
    //-----------------------------Date---------------------------------------//    
    @DatePickerHelper.RenderDatePicker(Model.Param.Date, Convert.ToDateTime(Model.Param.BalanceUpDay), DateTime.Today,
        "Date", "", 3)
    //-----------------------------Type of licensee---------------------------//
    <div class="new-line">
    </div>

    <div class="grid_2 filter-label"><label>@ViewResources.Currency</label></div>
    <div class="grid_3 filter-input">
        @RazorHelper.CurrencyList(Model.CurrencyList, "currencyid", Model.Param.CurrencyId, true, false)
    </div>
    <div class="grid_3 filter-label">
        <label for="BaseCurrency">@ViewResources.Based </label>
    </div>
    <div class="grid_1 filter-input">
        @RazorHelper.BasedCurrency(Model.Param.BaseCurrency)
    </div>
    <div class="grid_2 userguide-group">
        <div>
            <div class="userguide-icon" id="UserGuide" title="@ViewResources.UserGuide"></div>
        </div>
        <div>
            <input alt="@ViewResources.ExportToExcel" src="@Url.ContentLink("/Content/Global/Images/excel.gif")"
               type="image" id="ExportToExcel" name="exporttoexcel"
               title="@ViewResources.ExportToExcel" class="hand" />
        </div>
    </div>
    <div class="grid_2 filter-label new-line">
            &nbsp;</div>
    <div class="grid_2 filter-input">
        <input type="submit" id="SubmitButton" value="@ViewResources.Submit" class="button blockui" />
    </div>
}
</div>

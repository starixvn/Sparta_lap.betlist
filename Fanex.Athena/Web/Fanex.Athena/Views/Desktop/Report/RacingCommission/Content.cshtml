@model Fanex.Athena.Model.Report.ViewModel.RacingCommissionViewModel

@helper RenderFirstRow()
{
    <tr class="first-row">
        <td class="col-small"></td>
        <td class="col-medium"></td>
        <td class="col-medium"></td>
        <td class="col-child"></td>
        <td class="col-child"></td>
        <td class="col-child"></td>
        <td class="col-child"></td>
        <td class="col-medium"></td>
    </tr>
}

<div class="page-results">
    <div class="result-content">
        <div class="panel-heading active">
            <div class="panel-title">
                @ViewResources.RacingCommission, @RazorHelper.TitleDateTime(Model.Param.FromDate, Model.Param.ToDate)
                - @RazorHelper.ViewCurrencyBasedOnConverter(Model.Param.IsConvert, Model.Param.BaseCurrency, Model.Param.CurrencyName)
            </div>
        </div>

        <div class="main-content">
            @if (Model.RacingCommissionList.Count <= 0)
            {
                <p class="no-info-row">@ViewResources.NoInfo</p>
            }
            else
            {
                <div id="header-content" class="header-content">
                    <table class="table">
                        <thead>
                            @RenderFirstRow()
                            @{ Html.RenderPartial("~/Views/Desktop/Report/RacingCommission/Content.Header.cshtml"); }
                        </thead>
                    </table>
                </div>

                <div class="body-content">
                    <table class="table table-bordered">
                        <tbody>
                            @RenderFirstRow()
                            @{ Html.RenderPartial("~/Views/Desktop/Report/RacingCommission/Content.Data.cshtml"); }
                        </tbody>
                    </table>
                </div>

                <div class="footer-content">
                    <table class="table">
                        <tbody>
                            @RenderFirstRow()
                            @{ Html.RenderPartial("~/Views/Desktop/Report/RacingCommission/Content.Total.cshtml"); }
                        </tbody>
                    </table>
                </div>

                <div class="paging-content">
                    @DesktopRazorHelper.Paging("ReportForm", Model.Total.TotalRows, Model.Param.PageIndex, Model.Param.PageSize)
                </div>
            }
        </div>
    </div>
</div>
@model Fanex.Athena.Model.Report.ViewModel.WinLossByLeagueViewModel
@{
    var appSettings = new AppSettings();
    var sportList = this.Model.Sports
           .Select(item => new SelectListItem { Value = item.Key.ToString(), Text = item.Value })
           .ToList();
    sportList.Insert(0, new SelectListItem { Value = "0", Text = ViewResources.All, Selected = true });

    var leagues = this.Model.Leagues
            .Select(x => new SelectListItem { Value = x.Key.ToString(), Text = x.Value }).ToList();

    var matches = this.Model.Matches
            .Select(x => new SelectListItem { Value = x.Key.ToString(), Text = x.Value }).ToList();
    matches.Insert(0, new SelectListItem { Value = "0", Text = ViewResources.All, Selected = true });
}

<div class="page-form">
    <form id="searchForm" name="searchForm" method="post" action="">
        @Html.AntiForgeryToken()

        <div class="row">
            @RazorHelperDesktop.MonthPicker(Model.Param.FromDate, Model.Param.ToDate)

            <div class="input-field col l2 m3 s12">
                @RazorHelperDesktop.CurrencyList(Model.CurrencyList, "select", Model.Param.CurrencyId, true)
                <label>@ViewResources.Currency</label>
            </div>
            <div class="input-field col l2 m2 s12">
                @RazorHelperDesktop.BasedCurrency(Model.Param.BaseCurrency, Model.Param.CurrencyName)
                <label>@ViewResources.Based</label>
            </div>
            <div class="input-field col l3 m3 s12">
                @Html.DropDownList("League", leagues, new { @class = "select hide" })
                <label>@ViewResources.League</label>
            </div>
        </div>

        <div class="row">
            <div class="input-field col l3 m3 s12">
                @Html.DropDownList("Match", matches, new { @class = "select hide" })
                <label>@ViewResources.Match</label>
            </div>
            @RazorHelperDesktop.RenderProductFilter(Model.Param.ProductOptions)

            <div class="input-field col l3 m3 s12">
                @RazorHelperDesktop.TicketFilter()
            </div>

        </div>

        <div class="row">
            <div class="input-field col l2 m2 s12">
                <input id="Odds" name="Odds" type="text" value="0"  />
                <label>@ViewResources.MinimumOdds <span class="decimal-odds">(@ViewResources.DecimalOdds)</span></label>
            </div>

            <div class="input-field col l2 m2 s12">
                @Html.DropDownList("Sport", sportList, new { @class = "select hide" })
                <label>@ViewResources.Sport</label>
            </div>

            <div class="col l2 m2 s12 button-block">
                <a id="SubmitButton" class="waves-effect waves-light btn btn-primary">@ViewResources.Submit</a>
            </div>
        </div>
        <div class="row">
            <div class="col">
                <span class="circle"></span>
                <span>
                    @ViewResources.OANDANote
                </span>
            </div>
        </div>
        @Html.Hidden("IsExportExcel", Model.Param.IsExportExcel)
    </form>

    @Html.Hidden("ProductOptionJson", Model.Param.ProductOptions.ToJson())
    <input type="hidden" id="OriginalCurrencyId" name="OriginalCurrencyId" value="@Model.Param.CurrencyId" />
    <input type="hidden" id="OriginalCurrencyName" name="OriginalCurrencyName" value="@Model.Param.CurrencyName" />
    <input type="hidden" id="OriginalFromDate" name="OriginalFromDate" value="@Model.Param.FromDate.ToString("MM/dd/yyyy")" />
    <input type="hidden" id="OriginalToDate" name="OriginalToDate" value="@Model.Param.ToDate.ToString("MM/dd/yyyy")" />        
</div>
@{
    Layout = null;
}
@model Fanex.Athena.Models.ViewModel.Report.ResultReportViewModel
<div class="grid_26 content-filter new-line" style="width: 100%;">
    @using (Html.BeginForm("Result", "Report", FormMethod.Post, new { @id = "ResultPage" }))
    {
        //---------------------------Filter---------------------------------------//
        <div class="grid_2 filter-label">
            <label id="lable-fromdate">@ViewResources.Date:&nbsp;</label>
        </div>
        @DatePickerHelper.RenderDatePicker(Model.Param.FromDate, Model.Param.BalanceUpDay.Value,
        DateTime.Today, "FromDate",
         "from-date", 3)
        <div class="grid_1 filter-label for-out-right">
            <label>@ViewResources.To:&nbsp;</label>
        </div>
        <div class="grid_3 for-out-right">
            @DatePickerHelper.RenderDatePicker(Model.Param.ToDate, Model.Param.BalanceUpDay.Value,
         DateTime.Today,
        "ToDate", "", 3)
        </div>
       
        <div class="grid_2 filter-input">
            <input type="button" id="SubmitButton" value="@ViewResources.Submit" class="button" />
        </div>
        <div class="grid_2 filter-input">
            <input type="button" id="submit-todate" data-date="@DateTime.Today.ToString("MM/dd/yyyy")" 
            value="@DateTime.Today.ToString("MM/dd/yyyy")" class="button" />
        </div>
        <div class="grid_2 filter-input">
            <input type="button" id="submit-yesterdate" data-date="@DateTime.Now.AddDays(-1).ToString("MM/dd/yyyy")" value="@DateTime.Now.AddDays(-1).ToString("MM/dd/yyyy")" class="button" />
        </div>
       
        <div id="div-container-outright-button" class="prefix_4 grid_2 filter-input">
            <input type="button"  id="submit-normal" value="@ViewResources.Normal" class="button" />
        </div>
        <div class="grid_2 filter-input">
            <input type="button" id="submit-outright" data-isOutright="1" value="@ViewResources.Outright" class="button" />
        </div>
        if (ViewBag.IsAllowedKeno)
        {
        <div class="grid_2 filter-input">
            <input type="button" id="submit-keno" value="@ViewResources.ProductKN"
        class="button" />
        </div>
        }
        
        <div class="note-group">
            <input alt="@ViewResources.ExportToExcel" src="@Url.ContentLink("/Content/Global/Images/excel.gif")"
                   type="image" id="ExportToExcel" name="exporttoexcel"
                   title="@ViewResources.ExportToExcel" class="hand" />
        </div>
        <div class="new-line">
        </div>
        <div class="prefix_1 grid_24">
            <div class="note-message">
                @string.Format(ViewResources.DateRangeNote, Model.Param.BalanceUpDay.Value.ToString("MM/dd/yyyy"))
            </div>
            @if ((bool)ViewBag.IsAllowedRNG)
            {
                <div class="note-message">
                    @ViewResources.RngCasinoAndBingoExcludedNote
                </div>
            }
        </div>
        <input type="hidden" id="hiddenToDate" value="@DateTime.Now.ToString("MM/dd/yyyy")" />
    }
</div>

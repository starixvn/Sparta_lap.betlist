@{
    var formatTitle = "{0} {1} {2} - {3}";
    ViewBag.Title = string.Format(formatTitle, "LRF", HttpUtility.HtmlDecode("&bull;"), ViewResources.Report, ViewResources.DailyBetList);
    Layout = "~/Views/Shared/_BetListLayout.cshtml";
}
@using Fanex.Athena.Model.Report.ViewModel
@model Fanex.Athena.Model.BetList.ViewModel.BetListBaseViewModel
@section pagecss {
}
@section pagejs {
    <script src="@Url.ContentLink("/Scripts/BetList/dailybetlist.js")" type="text/javascript"></script>
}
@{
    var userSession = new Fanex.Athena.Service.Core.Users.SessionService().UserSession;
    var isAppModeSelf = userSession == null ? true : userSession.ApplicationMode == Fanex.Athena.Model.Core.DataDomain.AppMode.Self;
}
@if (isAppModeSelf)
{
@section ContentTitle
{
    @ViewResources.DailyBetList
}
}
@section ContentFilter
{
    @{
        Html.RenderPartial("~/Views/BetList/DailyBetList/Filter.cshtml");
    }
}
@{
    <input type="hidden" id="HiddenColumnList" value="" />
}
@{
    Layout = null;
}
@model Fanex.Athena.Model.Core.ViewModel.HeaderPageViewModel

<nav class="nav-wrapper">
    <a href="#" class="logo toggleMenubar" id="js-toggleMenubar" data-activates="nav-mobile">
        <span class="logo-image"><img src="~/www/assets/images/logo.svg" /></span>
        <span class="logo-text hide-on-med-and-down"><img src="~/www/assets/images/logo-text.svg" /> </span>
    </a>
    <div class="page-title hide-on-small-and-down"><span class="active">Live Report</span></div>

    <div class="right">
        @if (!Model.IsInternalLogin)
        {
            <div class="navbar-avatar">
                <div class="dropdown-button" href="javascript:void(0)" data-activates="profile">
                    <img class="avatar" src="~/www/assets/images/15.jpg" alt="@Html.Encode(Model.UserName)">
                    <span class="name hide-on-med-and-down">@Html.Encode(Model.UserName)</span>
                    <i class="icon icon-menu-down" aria-hidden="true"></i>
                </div>
                <ul id="profile" class="dropdown-content profile-items">
                    <li>
                        <i class="icon icon-account"></i>
                        <a href="@Url.Content("~/Authorization/ChangePassword")" target="main">@ViewResources.ChangePassword</a>
                    </li>
                    <li>
                        <i class="icon icon-logout"></i>
                        <a href="@Url.Content("~/Authorization/SignOut")">@ViewResources.Logout</a>
                    </li>
                </ul>
            </div>
        }

        <div class="licensees-block languages-block">
            @{
                var currentLicensee = Model.LicenseeList.FirstOrDefault(p => p.Id.Equals(Model.CurrentLicenseeId)).Name;
            }
            <a class="dropdown-button" href="javascript:void(0)" data-activates="ddlLicensee">
                @currentLicensee
                <i class="icon icon-menu-down" aria-hidden="true"></i>
            </a>

            <ul id="ddlLicensee" class="dropdown-content licensee-items language-items">
                @foreach (var licensee in Model.LicenseeList)
                {
                    <li>
                        <a href="javascript:void(0)" class="licenseeItem" licenseeId="@licensee.Id">
                            @licensee.Name
                        </a>
                    </li>
                }
            </ul>
        </div>

        <div class="languages-block">
            @{
                var currentLanguage = Model.SupportedLanguageList.FirstOrDefault(p => p.Key.Equals(Model.Language)).Value;
            }
            <a class="dropdown-button" href="javascript:void(0)" data-activates="languagesite">
                <span class="flag-icon flag-icon-@Model.Language"></span>
                @currentLanguage
                <i class="icon icon-menu-down" aria-hidden="true"></i>
            </a>

            <ul id="languagesite" class="dropdown-content language-items">
                @foreach (var language in Model.SupportedLanguageList)
                {
                    <li>
                        <a href="javascript:void(0)" class="languageItem" langkey="@language.Key">
                            <span class="flag-icon flag-icon-@language.Key"></span> @language.Value
                        </a>
                    </li>
                }
            </ul>
        </div>

        <form class="search_bar" id="CustomerSearchForm">
            <input type="text" autocomplete="off" name="query" id="searchbox" class="placeholder" placeholder="@ViewResources.ExternalIdOrSystemId" />
            <label id="label-search" for="search" class="active"><i class="icon icon-search"></i></label>
            <ul id="suggestionDropdown" class="dropdown-content ac-dropdown"></ul>
        </form>
    </div>
</nav>
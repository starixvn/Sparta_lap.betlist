@{
    Layout = null;
    var maxHeight = 500;
    
}
@using Fanex.Athena.Extension.Helper
@using Fanex.Athena.Models.ViewModel
@model Fanex.Athena.Models.ViewModel.Report.PlaytechCasinoViewModel
@if (Model.MainData == null || Model.MainData.Count == 0)
{
    <!--No result-->
    <div class="content-row" style="width:@ViewBag.ContainerWidth@("px");">
        <div class="row grid-noinfo "style="width:@ViewBag.ContainerWidth@("px");">
            <div>
                @ViewResources.NoInfo
            </div>
        </div>
    </div>
}
else
{
    var rowNumber = 1;
    var formatDateString = Model.Param.ReportBy == Fanex.Athena.Models.DataDomain.ReportByType.Monthly ? "MM/yyyy" : "MM/dd/yyyy";
    <div id="data-content" class="data-content" style="width:@(ViewBag.WrapperWidth)px;max-height:@(maxHeight)px">
        <table cellpadding="0" cellspacing="0">
            @foreach (var item in Model.MainData)
            {
                <tr class="content-row" style="width:@ViewBag.ContainerWidth@("px");">
                    <td class="row title-text" style="width:@ViewBag.NumberWidth@("px")">
                        @rowNumber
                    </td>
                    @if (Model.Param.Level == 0)
                    {
                        <td class="row title-text" style="width:@ViewBag.DateWidth@("px");">
                            @item.WinlossDate.ToString(formatDateString)
                        </td>   
                    }
                    @if (Model.Param.Level == 1)
                    {    
                        <td class="row text-data" style="width:@ViewBag.SystemIdWidth@("px")">
                            <span class="drill-down-link" data-level="2" data-currency="@item.CurrencyId" data-custid="@item.CustId">
                                @item.SystemId
                            </span>
                        </td>
                    }
                    @if (Model.Param.Level == 2)
                    {
                        <td class="row text-data" style="width:@ViewBag.ExternalIdWidth@("px")">
                            @item.ExternalId
                        </td>    
                        <td class="row text-data" style="width:@ViewBag.SystemIdWidth@("px")">
                            @item.SystemId
                        </td>
                    }
                    <td class="row title-text" style="width:@ViewBag.CurrencyWidth@("px")">
                        @if (Model.Param.Level == 0)
                        {
                        <span class="drill-down-link" data-level="@(Model.Param.LicenseeId == 1 ? 1 : 2)" data-currency="@item.CurrencyId" 
                            data-custid="@item.CustId" data-date="@item.WinlossDate.ToShortDateString()">
                            @item.CurrencyName
                        </span>
                        }
                        else
                        {
                            <span>@item.CurrencyName</span>
                        }
                    </td>
                    <td class="row" style="width:@ViewBag.TurnoverWidth@("px")">
                        <div>@item.Turnover.ToStringExt()</div>
                    </td>
                    <td class="row" style="width:@ViewBag.TotalTransWidth@("px")">
                        <div>@item.TotalTrans.ToString("#,##")</div>
                    </td>
                    <td class="row line-height" style="width:@ViewBag.CustomerWLWidth@("px")">
                        <div>@item.CustomerWinLoss.ToStringExt()</div>
                    </td>
                    <td class="row highlight" style="width:@ViewBag.LicenseeWLWidth@("px")">
                        @FormatHelper.NegativeFormat(item.LicenseeWinLoss)
                    </td>
                    <td class="row" style="width:@ViewBag.ProgressiveShareWidth@("px")">
                        <div>@item.ProgressiveShare.ToStringExt()</div>
                    </td>
                    <td class="row" style="width:@ViewBag.ProgressiveWinWidth@("px")">
                        <div>@item.ProgressiveWin.ToStringExt()</div>
                    </td>
                    <td class="row" style="width:@ViewBag.NetGamingWidth@("px")">
                        <div>@item.NetGaming.ToStringExt()</div>
                    </td>
                </tr>
                    rowNumber++;
            }
        </table>
    </div>
}

@{    
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using Fanex.Athena.Controllers
@section css
{
    @System.Web.Optimization.Styles.Render("~/bundles/BetSettingLayoutCss")
    @RenderSection("pagecss", required: false)
}
@section js
{
    @System.Web.Optimization.Scripts.Render("~/bundles/BetSettingLayoutScripts")
    @RenderSection("pagejs", required: false)
}


<div class="content-main">
    <div class="loading">
    </div>
    <div class="block-body">
    </div>

    @RenderBody()
</div>

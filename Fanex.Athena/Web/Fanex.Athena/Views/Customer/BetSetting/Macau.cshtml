@{
    Layout = "~/Views/Shared/_BetSettingLayout.cshtml";
}
@model Fanex.Athena.Model.BetSettings.ViewModel.ThirdPartyBetSettingViewModel
@using Fanex.Athena.Model.Report.ViewModel;
@using Fanex.Athena.Model.Core.DataDomain;
@section pagecss
{
}

@{Html.RenderPartial("~/Views/Customer/BetSetting/_Menu.cshtml", Model);}

<div class="content-title" style="width: 855px">
    @Model.Param.BetSettingName @ViewResources.BetSettings - @Model.Param.NickName (@Model.Param.UserName)
</div>
<!--Content-->
<div class="data-content">
    @if (Model.IsLineEnabled)
    {
        <div style="width: 885px!important; padding: 20px 0px 20px 0px">
            <div>@String.Format(ViewResources.CannotUpdateBetLimitForProduct, ViewResources.ProductVG)</div>
        </div>
    }
    else
    {
        <div style="width: 885px!important;width: 885px!important; padding: 20px 0px 20px 0px">
            <div>@ViewResources.MacauNotOfferCurrency</div>
        </div>
    }
</div>
<!--/Content-->
<!--SubmitButton-->
@if (Model.Editable)
{
    <div style="width: 855px">
        @if (Model.IsLineEnabled)
        {
            <input type="button" class="button" data-status="@(Model.IsEnabled.HasValue && Model.IsEnabled.Value ? 0 : 1)" 
            data-cust-id="@Model.Param.CustId" 
            data-nick-name="@Model.Param.NickName" value="@(Model.IsEnabled.HasValue && Model.IsEnabled.Value ? ViewResources.DisableMacau : ViewResources.EnableMacau)"
            id="btnUpdateStatus" />
        }
    </div>
}
<!--/SubmitButton-->

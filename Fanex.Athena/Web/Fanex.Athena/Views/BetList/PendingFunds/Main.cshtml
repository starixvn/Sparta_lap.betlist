@{
    ViewBag.Title = string.Format("LRF - {0}", ViewResources.BetList);
    Layout = "~/Views/Shared/_BetListSimpleLayout.cshtml";
}
@using Fanex.Athena.Models.ViewModel
@using Fanex.Athena.Models.Cache
@model Fanex.Athena.Models.MetaModel.BetList.BetListMetaModel
@section pagecss {}
@section pagejs {}
@section ContentTitle
{
    @ViewResources.BetListRunning - @(Model.ExternalId)(@(Model.SystemId)) - <span class="base-currency">@RazorHelper.ViewBaseCurrency(Model.CurrencyName, Model.BaseCurrency)</span>
        
}
@section BackButton
{
    <div onclick="history.go(-1)" class="history-link"></div>
}
@{
    <input type="hidden" id="BetListMetaModel" value="@Model.ToJson()" />
    <input type="hidden" id="HiddenColumnList" value="externalid,systemid,winloss,licenseewl" />
}

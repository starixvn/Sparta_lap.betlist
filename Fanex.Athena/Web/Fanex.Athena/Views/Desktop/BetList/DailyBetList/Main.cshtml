@{
    var formatTitle = "{0} {1} {2} - {3}";
    ViewBag.Title = string.Format(formatTitle, "LRF", HttpUtility.HtmlDecode("&bull;"), ViewResources.Report, ViewResources.DailyBetList);
    Layout = "~/Views/Desktop/Shared/_BetListLayout.cshtml";
}
@model Fanex.Athena.Model.BetList.ViewModel.BetListBaseViewModel
@section pagecss {
    <link href="@Url.ContentLinkByEnv("/www/css/build/pages/betlist/betlistdaily.css")" rel="stylesheet" />
}
@section pagejs {
    <script src="@Url.ContentLinkByEnv("/www/js/build/pages/betlist/betlistdaily.chunk.js")" type="text/javascript"></script>
}
@section ContentFilter
{
    @{
        Html.RenderPartial("~/Views/Desktop/BetList/DailyBetList/Filter.cshtml");
    }
}
@{
    <input type="hidden" id="HiddenColumnList" value="" />
}
@{
    var title = string.Empty;
    var userGuideName = string.Empty;
    int bettype = 0;

    if(Request.QueryString["multiplebettype"] != null)
    {
        bettype = Convert.ToInt32(Request.QueryString["multiplebettype"].Split(',')[0]);
        switch(bettype)
        {
            case 9:
                title = ViewResources.MixParlay;
                userGuideName = "TotalBetsMixParlay";
                break;
            case 24:
                title = ViewResources.DoubleChance;
                userGuideName = "TotalBetsDoubleChance";
                break;
            case 26:
                title = ViewResources.BONTeamToScore;
                userGuideName = "TotalBetsBON";
                break;
            case 29:
                title = ViewResources.SystemParlay;
                userGuideName = "TotalBetsMixParlay";
                break;
            default:
            break;
        }
        var formatTitle = "{0} {1} {2} - {3}";
        ViewBag.Title = string.Format(formatTitle, "LRF", HttpUtility.HtmlDecode("&bull;"), ViewResources.TotalBets,  title);
    }
    Layout = "~/Views/Shared/_BetListLayout.cshtml";
}
@using Fanex.Athena.Models.ViewModel
@model Fanex.Athena.Models.ViewModel.BetList.BetListBaseViewModel
@section pagecss {
    <link href="@Url.ContentLink("/Content/UserGuide/user-guide.css")" rel="stylesheet" type="text/css" />
}
@section pagejs {    
    <script src="@Url.ContentLink("/Scripts/BetList/runningbetlist.multiplebettypes.js")" type="text/javascript"></script>
}
@section ContentTitle
{
    @{
        if(bettype == 9 || bettype == 29)
        {

            <span id="mixparlay_9" class="inactive-switch-link" onclick="RunningBetListMultipleBettype.switchMixParlayTotalBet(9)">@ViewResources.MixParlay</span>
            <span>|</span>
            <span id="mixparlay_29" class="active-switch-link" onclick="RunningBetListMultipleBettype.switchMixParlayTotalBet(29)">@ViewResources.SystemParlay</span>            
        }
        else
        {
            @title
        }
    }
}
@section ContentFilter
{
    @{
        Html.RenderPartial("~/Views/BetList/RunningBetListMultipleBettypes/Filter.cshtml");
    }
}
@{
    <div id="popupSystemParlay"></div>
    <input type="hidden" id="HiddenColumnList" value="winloss,licenseewl" />
    <input type="hidden" id="IsShowSumStake" value="1" />
}
<script type="text/javascript">
    var popupTitle = "@title";
    var userGuideName = "@userGuideName";
</script>
@model Fanex.Athena.Model.Core.DTO.Common.ProductAccess
<table>
    <tr>
        <td>
            @ViewResources.SBComm (%)
        </td>
        <td>
            @GroupCommRazorHelper.CommDropdowns("CustSBComm")
        </td>
    </tr>

    <tr>
        <td>
            @ViewResources.ParlayComm (%)
        </td>
        <td>
            @GroupCommRazorHelper.CommDropdowns("CustParlayComm")
        </td>
    </tr>

    <tr class="@(!Model.IsAllowRB ? "hide" : "")">
        <td>
            @ViewResources.RBComm (%)
        </td>
        <td>
            @GroupCommRazorHelper.CommDropdowns("CustRBComm")
        </td>
    </tr>
    <tr class="@(!Model.IsAllowNG ? "hide" : "")">
        <td>
            @ViewResources.NGComm (%)
        </td>
        <td>
            @GroupCommRazorHelper.CommDropdowns("CustNGComm")
        </td>
    </tr>
    <tr class="@(!Model.IsAllowCS ? "hide" : "")">
        <td>
            @ViewResources.CSComm (%)
        </td>
        <td>
            @GroupCommRazorHelper.CommDropdowns("CustCSComm")
        </td>
    </tr>
    <tr class="@(!Model.IsAllowAB ? "hide" : "")">
        <td>
            @ViewResources.ABComm (%)
        </td>
        <td>
            @GroupCommRazorHelper.CommDropdowns("CustABComm")
        </td>
    </tr>
</table>
<p id="InfoMsg" class="attention-message">@ViewResources.PayAttentionMsg</p>
<div class="success-message">
</div>
<div class="error-message">
</div>
<div class="ajax-loading">
    <img alt="Sending" src="@Url.ContentLink("/Content/Customer/images/ajax-loader.gif")" />
</div>
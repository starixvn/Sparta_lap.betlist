@using System.Linq
@model Fanex.Athena.Model.TotalBet.ViewModel.TotalGoalViewModel
@{
    var index = 1;
    var listMatch = Model.MainData.OrderBy(x => x.HomeTeamName).ToList();
}
<div class="data-content">
    <table class="report-table">
        <tbody>
            @foreach (var match in listMatch)
            {
                <tr>
                    <td style="width: 3%" class="order-number">
                        @(index++)
                    </td>
                    <td style="width: 14%" class="match-name">
                        <a data-leagueid="@match.LeagueId" data-match-id="@match.MatchId" class="team" href="javascript:;">@match.HomeTeamName</a>
                    </td>
                    <td style="width: 14%" class="match-name">
                        @match.AwayTeamName
                    </td>
                    <td style="width: 10%" class="score-value">
                        @RazorHelper.PositiveFormat(match.Total01, true, false)
                    </td>
                    <td style="width: 10%" class="score-value">
                        @RazorHelper.PositiveFormat(match.Total23, true, false)
                    </td>
                    <td style="width: 10%" class="score-value">
                        @RazorHelper.PositiveFormat(match.Total46, true, false)
                    </td>
                    <td style="width: 10%" class="score-value">
                        @RazorHelper.PositiveFormat(match.Total7Over, true, false)
                    </td>
                    <td style="width: 10%" class="score-value">
                        @RazorHelper.PositiveFormatExt(match.TotalFirstHalf01)
                    </td>
                    <td style="width: 10%" class="score-value">
                        @RazorHelper.PositiveFormatExt(match.TotalFirstHalf23)
                    </td>
                    <td style="width: 10%" class="score-value">
                        @RazorHelper.PositiveFormatExt(match.Total4Over)
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div class="line">
</div>
@*Footer*@
<div class="footer-content">
    <table class="report-table">
        <thead>
            <tr class="total-footer">
                <td style="width: 3%">
                </td>
                <td style="width: 14%">
                </td>
                <td style="width: 14%" class="score-value">@ViewResources.Total
                </td>                
                <td style="width: 40%" class="score-value">@RazorHelper.DecFormat(Model.TotalData.Total01, true, false)
                </td>
                <td style="width: 30%" class="score-value">@RazorHelper.DecFormat(Model.TotalData.TotalFirstHalf01 ?? 0, true, false)
                </td>
            </tr>
        </thead>
    </table>
</div>
@*/Footer*@ 
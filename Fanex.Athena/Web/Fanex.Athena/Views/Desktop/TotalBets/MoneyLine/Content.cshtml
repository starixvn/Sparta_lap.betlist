@model Fanex.Athena.Model.TotalBet.ViewModel.MoneyLineViewModel

@helper RenderFirstRow()
{
    <tr class="first-row">
        <td class="col-small"></td>
        <td class="col-medium"></td>
        <td class="col-large"></td>
        <td class="col-child"></td>
        <td class="col-child"></td>
        <td class="col-child"></td>
        <td class="col-child"></td>
        <td class="col-child"></td>
        <td class="col-child"></td>
        <td class="col-child"></td>
        <td class="col-child"></td>
    </tr>
}

@if (Model.MainData.Count == 0)
{
    <p class="no-info-row">@ViewResources.NoInfo</p>
}
else
{
    <div class="header-content">
        <table class="table">
            <thead>
                @RenderFirstRow()

                <tr>
                    <th rowspan="2">#</th>
                    <th rowspan="2">@ViewResources.Time</th>
                    <th rowspan="2">@ViewResources.Event</th>
                    <th colspan="4">@ViewResources.FullTime</th>
                    <th colspan="4" class="col-last">@ViewResources.lbl1stHalf</th>
                </tr>
                <tr>
                    <th>@ViewResources.TotalHome</th>
                    <th>@ViewResources.TotalAway</th>
                    <th>@ViewResources.ForecastHome</th>
                    <th>@ViewResources.ForecastAway</th>

                    <th>@ViewResources.TotalHome</th>
                    <th>@ViewResources.TotalAway</th>
                    <th>@ViewResources.ForecastHome</th>
                    <th>@ViewResources.ForecastAway</th>
                </tr>
            </thead>
        </table>
    </div>

    <div class="body-content">
        <table class="table">
            <tbody>
                @RenderFirstRow()
                @{ Html.RenderPartial("~/Views/Desktop/TotalBets/MoneyLine/ContentData.cshtml"); }
            </tbody>
        </table>
    </div>

    <div class="footer-content">
        <table class="table">
            <tbody>
                @RenderFirstRow()

                <tr class="total total-footer">
                    <td class="right-align total-label" colspan="3">
                        @ViewResources.Total
                    </td>
                    <td class="right-align no-margin" colspan="2">
                        @RazorHelperDesktop.DecFormat(Model.TotalData.TotalHomeFt + Model.TotalData.TotalAwayFt)
                    </td>
                    <td></td>
                    <td></td>
                    <td class="right-align no-margin" colspan="2">
                        @RazorHelperDesktop.DecFormat(Model.TotalData.TotalHomeFirstHalf + Model.TotalData.TotalAwayFirstHalf)
                    </td>
                    <td></td>
                    <td></td>
                </tr>
            </tbody>
        </table>
    </div>
}
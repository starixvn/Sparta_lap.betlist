@{
    ViewBag.Title = "LRF - " + ViewResources.Report +
    " - " + "Betting Tickets Center";
    Layout = "~/Views/Desktop/Shared/_ReactPageLayout.cshtml";
}
@using Fanex.Athena.Model.Core.DataDomain;
@model bool
@{
    var baseCurrencyList = SystemConstants.NewBaseCurrencyList.Select(c => new { value = c, label = c }).ToList();
}
@section pagecss {
    <link href="@Url.ContentLinkByEnv("/www/css/build/reactpages/bettingticketscenter/index.css")" rel="stylesheet" type="text/css" />
}
@section pagejs {
    <script src="@Url.ContentLinkByEnv("/www/js/build/reactpages/bettingticketscenter/refno.chunk.js")"></script>
}

@section globaljscode{
    window.initialState = {
        refno: "",
        username: "",
        selectedBaseCurrency: '@(baseCurrencyList.Any() ? baseCurrencyList.First().value : string.Empty)',
        isLoading: false,
        isConvertAll: true
    };
    window._AppData = {
        isAllowedCustomerComm: @Model.ToJson(),
        baseCurrencyList:@Html.Raw(baseCurrencyList.ToJson())
    };
}
<div id="app-container">

</div>

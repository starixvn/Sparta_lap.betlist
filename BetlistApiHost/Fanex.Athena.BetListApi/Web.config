	<system.web>
		<compilation debug="true" targetFramework="4.6.1">
		</compilation>
		<httpRuntime targetFramework="4.6.1" requestValidationMode="2.0" executionTimeout="300" />
		<customErrors mode="Off">
		</customErrors>

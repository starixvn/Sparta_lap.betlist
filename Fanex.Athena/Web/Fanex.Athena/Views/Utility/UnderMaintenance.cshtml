@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@Fanex.Athena.Resources.ViewResources.UnderMaintenance</title>
    <link href="@Url.ContentLink("/Content/Utility/UM.css")" rel="stylesheet" type="text/css" />
</head>
<body>
    <div class="container">
        <div class="img">
            <img src="/Content/Utility/images/UM.png" />
        </div>
        <div class="caption">
            <p>Risk & Forecast System servers are currently</p>
            <p>unavailable and scheduled to be back at </p>
            <p>@ViewBag.UmTimeTo (HK Time GMT +8).</p>
            <p>We apologize for the inconvenience.</p>
            <p>Thank you for your patience.</p>
        </div>
    </div>
    <script type="text/javascript">
        if (window.parent != window) {
            window.parent.location = location.href;
        }
    </script>
</body>
</html>
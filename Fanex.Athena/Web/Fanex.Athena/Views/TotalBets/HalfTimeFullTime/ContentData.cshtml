@model Fanex.Athena.Models.ViewModel.TotalBets.HalfTimeFullTimeViewModel
@{
    var index = 1;
}
<div class="data-content">
    <table class="report-table">
        <tbody>
            @foreach (var match in Model.MainData)
            {
                <tr>
                    <td style="width: 3%" class="order-number">
                        @(index++)
                    </td>
                    <!--Home-->
                    <td style="width: 20%" class="match-name">
                        <a data-match-id="@match.MatchId" class="team" href="javascript:;">@match.HomeTeamName</a>
                    </td>
                    <!--/Home-->
                    <!--Away-->
                    <td style="width: 20%" class="match-name">
                        @match.AwayTeamName
                    </td>
                    <!--/Away-->
                    <!--HH-->
                    <td style="width: 6%" class="score-value">
                        @RazorHelper.PositiveFormat(match.HomeHome, true, false)
                    </td>
                    <!--/HH-->
                    <!--HD-->
                    <td style="width: 6%" class="score-value">
                        @RazorHelper.PositiveFormat(match.HomeDraw, true, false)
                    </td>
                    <!--/HD-->
                    <!--HA-->
                    <td style="width: 6%" class="score-value">
                        @RazorHelper.PositiveFormat(match.HomeAway, true, false)
                    </td>
                    <!--/HA-->
                    <!--DH-->
                    <td style="width: 6%" class="score-value">
                        @RazorHelper.PositiveFormat(match.DrawHome, true, false)
                    </td>
                    <!--/DH-->
                    <!--DD-->
                    <td style="width: 6%" class="score-value">
                        @RazorHelper.PositiveFormat(match.DrawDraw, true, false)
                    </td>
                    <!--/DD-->
                    <!--DA-->
                    <td style="width: 6%" class="score-value">
                        @RazorHelper.PositiveFormat(match.DrawAway, true, false)
                    </td>
                    <!--/DA-->
                    <!--AH-->
                    <td style="width: 6%" class="score-value">
                        @RazorHelper.PositiveFormat(match.AwayHome, true, false)
                    </td>
                    <!--/AH-->
                    <!--AD-->
                    <td style="width: 6%" class="score-value">
                        @RazorHelper.PositiveFormat(match.AwayDraw, true, false)
                    </td>
                    <!--/AD-->
                    <!--AA-->
                    <td style="width: 6%" class="score-value">
                        @RazorHelper.PositiveFormat(match.AwayAway, true, false)
                    </td>
                    <!--/AA-->
                </tr>
            }
        </tbody>
    </table>
</div>
<div class="line">
</div>
@*Footer*@
<div class="footer-content" style="width: 1017px !important">
    <table class="report-table">
        <thead>
            <tr class="total-footer">
                <!--Away-->
                <td class="score-value" colspan="3">
                    @ViewResources.Total
                </td>
                <!--/Away-->
                <!--HH-->
                <td class="score-value">
                    @RazorHelper.PositiveFormat(Model.MainData.Sum(t => t.HomeHome), true, false)
                </td>
                <!--/HH-->
                <!--HD-->
                <td class="score-value">
                    @RazorHelper.PositiveFormat(Model.MainData.Sum(t => t.HomeDraw), true, false)
                </td>
                <!--/HD-->
                <!--HA-->
                <td class="score-value">
                    @RazorHelper.PositiveFormat(Model.MainData.Sum(t => t.HomeAway), true, false)
                </td>
                <!--/HA-->
                <!--DH-->
                <td class="score-value">
                    @RazorHelper.PositiveFormat(Model.MainData.Sum(t => t.DrawHome), true, false)
                </td>
                <!--/DH-->
                <!--DD-->
                <td class="score-value">
                    @RazorHelper.PositiveFormat(Model.MainData.Sum(t => t.DrawDraw), true, false)
                </td>
                <!--/DD-->
                <!--DA-->
                <td class="score-value">
                    @RazorHelper.PositiveFormat(Model.MainData.Sum(t => t.DrawAway), true, false)
                </td>
                <!--/DA-->
                <!--AH-->
                <td class="score-value">
                    @RazorHelper.PositiveFormat(Model.MainData.Sum(t => t.AwayHome), true, false)
                </td>
                <!--/AH-->
                <!--AD-->
                <td class="score-value">
                    @RazorHelper.PositiveFormat(Model.MainData.Sum(t => t.AwayDraw), true, false)
                </td>
                <!--/AD-->
                <!--AA-->
                <td class="score-value">
                    @RazorHelper.PositiveFormat(Model.MainData.Sum(t => t.AwayAway), true, false)
                </td>
            </tr>
        </thead>
    </table>
</div>
@*/Footer*@ 
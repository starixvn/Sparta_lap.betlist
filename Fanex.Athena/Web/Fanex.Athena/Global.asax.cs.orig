        /// <summary>
        /// Code that runs on application shutdown.
        /// </summary>
        /// <param name="sender">The sender.</param>
        /// <param name="e">The event ARGS.</param>
        public void Application_End(object sender, EventArgs e)
        {
        }

        /// <summary>
        /// The application errors.
        /// </summary>
        /// <param name="sender">The sender.</param>
        /// <param name="e">The event ARGS.</param>
        public void Application_Error(object sender, EventArgs e)
        {
            // Code that runs when an unhandled error occurs
            Exception ex = Server.GetLastError().GetBaseException();
            if (ex is HttpException)
            {
                return;
            }

            string message = ex.Message +
                             "\r\nSOURCE: " + ex.Source +
                             "\r\nDOMAIN: " + HttpContext.Current.Request.Headers["Host"] +
                             "\r\nFORM: " + Request.Form +
                             "\r\nUrl: " + Request.RawUrl +
                             "\r\nQUERYSTRING: " + Request.QueryString +
                             "\r\nUrl: " + Request.RawUrl +
                             "\r\nTARGETSITE: " + ex.TargetSite +
                             "\r\nSTACKTRACE: " + ex.StackTrace;

            Logging.LogService.Error(message, ex);

        }

        protected void Application_BeginRequest()
        {
            if (Request.IsLocal)
            {
                // MiniProfiler.Start();
            }
        }

        /// <summary>
        /// End request.
        /// </summary>
        protected void Application_EndRequest()
        {
            /*stop as early as you can, even earlier with MvcMiniProfiler.MiniProfiler.Stop(discardResults: true);*/
            MiniProfiler.Stop();
        }
    }

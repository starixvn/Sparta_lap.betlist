@using Fanex.Athena.Models.ViewModel
@using Fanex.Athena.Extension.Helper;
@model Fanex.Athena.Models.ViewModel.Report.DailyRacingWinLossViewModel
@{
    var grandTotalData = Model.DailyRacingWinLossData.GrandTotalData;
}
<div class="total-content" style="width: @(ViewBag.ContainerWidth + 1)@("px")">
    <div class="content-row" style="width: @(ViewBag.ContainerWidth + 1)@("px")">
        <div class="row" style="width: @(ViewBag.RaceWidth + 1)@("px")">
            <div class="title-text">@ViewResources.GrandTotalIn @ViewResources.RM</div>
        </div>
        <div class="row" style="width: @ViewBag.CommonWidth@("px")">
            <div>@grandTotalData.WinTOMYR.ToStringExt()</div>
        </div>
        <div class="row" style="width: @ViewBag.CommonWidth@("px")">
            <div>@grandTotalData.PlaceTOMYR.ToStringExt()</div>
        </div>
        <div class="row" style="width: @ViewBag.CommonWidth@("px")">
            <div>@grandTotalData.WPTOMYR.ToStringExt()</div>
        </div>
        <div class="row" style="width: @ViewBag.CommonWidth@("px")">
            <div>@grandTotalData.TotalTOMYR.ToStringExt()</div>
        </div>
        <div class="row" style="width: @ViewBag.DividendWidth@("px")">
            <div>@grandTotalData.DividendWonMYR.ToStringExt()</div>
        </div>
        @if (Model.IsAllowedCustomerCommission)
        {
            <div class="row" style="width: @ViewBag.CustomerCommWidth@("px")">
                <div>@grandTotalData.CustomerCommissionMYR.ToStringExt()</div>
            </div>
        }
        <div class="row" style="width: @ViewBag.CommonWidth@("px")">
            <div>@grandTotalData.WinTO12BetMYR.ToStringExt()</div>
        </div>
        <div class="row" style="width: @ViewBag.CommonWidth@("px")">
            <div>@grandTotalData.PlaceTO12BetMYR.ToStringExt()</div>
        </div>
        <div class="row" style="width: @ViewBag.CommonWidth@("px")">
            <div>@grandTotalData.WPTO12BetMYR.ToStringExt()</div>
        </div>
        <div class="row" style="width: @ViewBag.CommonWidth@("px")">
            <div>@grandTotalData.TotalTO12BetMYR.ToStringExt()</div>
        </div>
        <div class="row" style="width: @ViewBag.CommonWidth@("px")">
            <div>@grandTotalData.WinLoss12BetMYR.ToStringExt()</div>
        </div>
        <div class="row" style="width: @ViewBag.LicenseeCommWidth@("px")">
            <div>@grandTotalData.CommIncomeMYR.ToStringExt()</div>
        </div>
        <div class="row" style="width: @ViewBag.AmountDueToWidth@("px")">
            <div>@grandTotalData.AmountDueToRacingMYR.ToStringExt()</div>
        </div>
    </div>
    <div class="content-row" style="width: @(ViewBag.ContainerWidth + 1)@("px")">
        <div class="row title-text" style="width: @(ViewBag.RaceWidth + 1)@("px")">
            <div class="title-text">@ViewResources.GrandTotalIn @ViewResources.EUR</div>
        </div>
        <div class="row" style="width: @ViewBag.CommonWidth@("px")">
            <div>@grandTotalData.WinTOEUR.ToStringExt()</div>
        </div>
        <div class="row" style="width: @ViewBag.CommonWidth@("px")">
            <div>@grandTotalData.PlaceTOEUR.ToStringExt()</div>
        </div>
        <div class="row" style="width: @ViewBag.CommonWidth@("px")">
            <div>@grandTotalData.WPTOEUR.ToStringExt()</div>
        </div>
        <div class="row" style="width: @ViewBag.CommonWidth@("px")">
            <div>@grandTotalData.TotalTOEUR.ToStringExt()</div>
        </div>
        <div class="row" style="width: @ViewBag.DividendWidth@("px")">
            <div>@grandTotalData.DividendWonEUR.ToStringExt()</div>

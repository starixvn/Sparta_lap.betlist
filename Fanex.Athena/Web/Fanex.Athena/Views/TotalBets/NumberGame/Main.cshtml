@{
    ViewBag.Title = "LRF - " + ViewResources.TotalBets +
    " - " + ViewResources.NumberGame;
    Layout = Request.IsAjaxRequest() ? null : "~/Views/Shared/_TotalBetsLayout.cshtml";
}
@using Fanex.Athena.Models.ViewModel
@model Fanex.Athena.Models.ViewModel.TotalBets.NumberGameViewModel
@section page {
    <script src="@Url.ContentLink("/Scripts/TotalBets/numbergame.js")" type="text/javascript"></script>
    <link href="@Url.ContentLink("/Content/TotalBets/numbergame.css")" rel="stylesheet" type="text/css" />
    <script type="text/javascript">
        $(window).load(function () {
            NumberGame.initialize();
            RefreshCountDown.initEvent();
        });
    </script>
}
@section ContentTitle
    {
    @ViewResources.NumberGame
}
@section ContentFilter
{
    @{
        Html.RenderPartial("~/Views/TotalBets/NumberGame/Filter.cshtml");
    }
}
@{
    Html.RenderPartial("~/Views/TotalBets/NumberGame/Content.cshtml");
}
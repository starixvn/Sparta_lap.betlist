@{
    var sessionService = new Fanex.Athena.Service.Core.Users.SessionService();
    var userSession = sessionService.UserSession;
    var licSession = sessionService.LicenseeSession;
    var userCurrencies = userSession == null || userSession.CurrencyList == null ?
        new Dictionary<string, string>() :
        userSession.CurrencyList.ToDictionary(x => x.Key.ToString(), x => x.Value);

    var hasCustComm = licSession != null && licSession.IsAllowedCustomerComm;
    var isParasiticMode = userSession != null && userSession.ApplicationMode == Fanex.Athena.Model.Core.DataDomain.AppMode.Parasitic;
    var appSettings = new AppSettings();
    var hasSystemId = !appSettings.LicenseesNotHaveSystemId.Contains(licSession.LicenseeId);
}
<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0">

    <title>@ViewBag.Title</title>
    <link href="@Url.ContentLinkByEnv("/www/css/build/main.css")" rel="stylesheet" />

    @RenderSection("css", required: false)
    <meta name="description" content="The Risk & Forecast System" />
</head>
<body>
    <input type="hidden" id="RootUrl" value="@Url.Content("~/")" />
    <input type="hidden" id="PageLanguage" value="@System.Globalization.CultureInfo.CurrentUICulture.IetfLanguageTag" />
    <input type="hidden" id="HasCustComm" value="@( hasCustComm ? 1 : 0)" />
    <input type="hidden" id="HistoryDate" value="@( appSettings.HistoryDate)" />
    <input type="hidden" id="HasSystemId" value="@( hasSystemId ? 1 : 0)" />
    @Html.AntiForgeryToken()

    <div class="loading" style="display: none">
        <div class="icon-loading">
            <div class="loader-inner ball-beat">
                <span class="icon-ball"></span>
                <span class="icon-ball"></span>
                <span class="icon-ball"></span>
            </div>
        </div>
    </div>
    <div class="block-body" style="display: none">
    </div>

    <div class="wrapper">
        @RenderBody()
    </div>

    <script src="@Url.ContentLinkByEnv("/www/js/build/common.chunk.js")"></script>
    <script src="@Url.ContentLinkByEnv("/www/js/build/language.chunk.js")"></script>
    @RenderSection("js", required: false)
    @if (isParasiticMode)
    {
        Html.RenderPartial("~/Views/Desktop/Shared/_SessionScript.cshtml");
    }
    @if (appSettings.Environment.Equals("PRO", StringComparison.OrdinalIgnoreCase))
    {
        <script>
            (function(i,s,o,g,r,a,m){i['GoogleAnalyticsObject']=r;i[r]=i[r]||function(){
                (i[r].q=i[r].q||[]).push(arguments)},i[r].l=1*new Date();a=s.createElement(o),
                m=s.getElementsByTagName(o)[0];a.async=1;a.src=g;m.parentNode.insertBefore(a,m)
            })(window,document,'script','https://www.google-analytics.com/analytics.js','ga');

            ga('create', 'UA-93927620-1', 'auto');
            ga('send', 'pageview');
        </script>
    }
</body>
</html>
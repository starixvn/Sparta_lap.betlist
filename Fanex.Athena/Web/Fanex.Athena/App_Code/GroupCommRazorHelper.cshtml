@functions
{
    public static IDictionary<int, int> GetCommValue(int max, int increase)
    {
        var items = new Dictionary<int, int>();
        for (int i = 0; i <= max; i++)
        {
            items.Add(i * increase, i * increase);
        }

        return items;
    }
}

@helper CommDropdowns(string name, int value1 = 0, int value2 = 0, int value3 = 0)
{
    @GroupComSettingDropDownList(name + "1", GetCommValue(15, 1), value1)
    <text>•</text>
    @GroupComSettingDropDownList(name + "2", GetCommValue(9, 1), value2)
    @GroupComSettingDropDownList(name + "3", GetCommValue(1, 5), value3)
}
@helper GroupComSettingDropDownList(string name, IDictionary<int, int> items, decimal selectedValue = 0)
{
    <select id="@name" name="@name" class="commission-selection">
        @foreach (var item in items)
        {
            <option @(selectedValue == item.Value ? "selected=selected" : string.Empty) value="@item.Value">@item.Key.ToString("0.#")</option>
        }
    </select>
}
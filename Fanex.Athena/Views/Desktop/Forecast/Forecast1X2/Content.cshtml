@model Fanex.Athena.Model.Forecast.ViewModel.ForecastOneXTwoViewModel

@helper RenderFirstRow()
{
    <tr class="first-row">
        <td class="col-medium"></td>
        <td class="col-extra-small"></td>
        <td class="col-child"></td>
        <td class="col-child"></td>
        <td class="col-child"></td>
    </tr>
}

@if (Model.MainData.Count == 0)
{
    <p class="no-info-row">@ViewResources.NoInfo</p>
}
else
{
    <div class="header-content">
        <table class="table">
            <thead>
                @RenderFirstRow()

                <tr>
                    <th colspan="2">@ViewResources.Team</th>
                    <th colspan="3">@ViewResources.OneXTwo</th>
                </tr>
            </thead>
        </table>
    </div>

    <div class="body-content">
        <table class="table">
            <tbody>
                @RenderFirstRow()
                @{ Html.RenderPartial("~/Views/Desktop/Forecast/Forecast1X2/ContentData.cshtml"); }
            </tbody>
        </table>
    </div>
}
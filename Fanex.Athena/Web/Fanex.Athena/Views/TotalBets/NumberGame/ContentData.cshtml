@using System.Linq
@model Fanex.Athena.Models.ViewModel.TotalBets.NumberGameViewModel
@{
    var leagueList = Model.MainData.GroupBy(x => new { x.LeagueId, x.LeagueName })
                            .Select(x => x.Key)
                            .OrderBy(x => x.LeagueName)
                            .Distinct()
                            .ToList();
    var index = 1;
}
<div class="data-content">
    <table class="report-table">
        @{
            Html.RenderPartial("~/Views/TotalBets/NumberGame/ContentHeader.cshtml");
        }
        <tbody>
            @foreach (var league in leagueList)
            {
                // Render League name
                <tr>
                    <td class="league" colspan="18">@league.LeagueName
                    </td>
                </tr>
                var matchOfLeague = Model.MainData.Where(x => x.LeagueId == league.LeagueId).ToList();

                // Render Match League
                foreach (var match in matchOfLeague)
                { 
                <tr>
                    <td style="width: 3%" class="order-number">@(index++)
                    </td>
                    <td style="width: 14%" class="match-name">
                        @match.NumberGameName
                    </td>
                    <!--Warrior-->
                    <td style="width: 7%" class="score-value">
                        @if (match.BetCountWarrior > 0 && match.Warrior2Nd > 0)
                        {
                            <a class="forcast-number" data-match-id="@match.MatchId" data-bet-type="88" data-is-live="0" data-bet-team="h" href="javascript:;">
                                @RazorHelper.NegativeFormatNumber(match.Warrior2Nd)
                            </a>    
                        }
                    </td>
                    <td style="width: 7%" class="score-value">
                        @if (match.BetCountWarrior > 0 && match.Warrior3Rd > 0)
                        {
                            <a class="forcast-number" data-match-id="@match.MatchId" data-bet-type="88" data-is-live="0" data-bet-team="a" href="javascript:;">
                                @RazorHelper.NegativeFormatNumber(match.Warrior3Rd)
                            </a>    
                        }
                    </td>
                    <!--/Warrior-->
                    <!--First Ball-->
                    <td style="width: 4%" class="score-value">
                        @if (match.BetCountOu1St > 0)
                        {
                            <a class="forcast-number" data-match-id="@match.MatchId" data-bet-type="81" data-is-live="0" href="javascript:;">
                                @RazorHelper.NegativeFormatNumber(match.OverUnderFirstBall)
                            </a>    
                        }
                    </td>
                    <td style="width: 4%" class="score-value">
                        @if (match.BetCountOe1St > 0)
                        {
                            <a class="forcast-number" data-match-id="@match.MatchId" data-bet-type="83" data-is-live="0" href="javascript:;">
                                @RazorHelper.NegativeFormatNumber(match.OddEvenFirstBall)
                            </a>    
                        }
                    </td>
                    <!--/First Ball-->
                    <!--Last Ball-->
                    <td style="width: 4%" class="score-value">
                        @if (match.BetCountOuLast > 0)
                        {
                            <a class="forcast-number" data-match-id="@match.MatchId" data-bet-type="82" data-is-live="0" href="javascript:;">
                                @RazorHelper.NegativeFormatNumber(match.OverUnderLastBall)
                            </a>    
                        }
                    </td>
                    <td style="width: 4%" class="score-value">
                        @if (match.BetCountOeLast > 0)
                        {
                            <a class="forcast-number" data-match-id="@match.MatchId" data-bet-type="84" data-is-live="0" href="javascript:;">
                                @RazorHelper.NegativeFormatNumber(match.OddEvenLastBall)
                            </a>    
                        }
                    </td>
                    <!--/Last Ball-->
                    <!--Next Ball-->
                    <td style="width: 5%" class="score-value">
                        @if (match.BetCountOuNext > 0)
                        {
                            <a class="forcast-number" data-match-id="@match.MatchId" data-bet-type="85" data-is-live="1" href="javascript:;">
                                @RazorHelper.NegativeFormatNumber(match.OverUnderNext)
                            </a>    
                        }
                    </td>
                    <td style="width: 5%" class="score-value">
                        @if (match.BetCountOeNext > 0)
                        {
                            <a class="forcast-number" data-match-id="@match.MatchId" data-bet-type="86" data-is-live="1" href="javascript:;">
                                @RazorHelper.NegativeFormatNumber(match.OddEvenNext)
                            </a>    
                        }
                    </td>
                    <td style="width: 6%" class="score-value">
                        @if (match.BetCountHighLow > 0)
                        {
                            <a class="forcast-number" data-match-id="@match.MatchId" data-bet-type="87" data-is-live="1" href="javascript:;">
                                @RazorHelper.NegativeFormatNumber(match.HighLow)
                            </a>    
                        }
                    </td>
                    <!--/Next Ball-->
                    <!--Next Combo-->
                    <td style="width: 4%" class="score-value">
                        @if (match.BetCountNextCombo > 0)
                        {
                            <a class="forcast-number" data-match-id="@match.MatchId" data-bet-type="89" data-is-live="1" data-bet-team="1:1" href="javascript:;">
                                @RazorHelper.NegativeFormatNumber(match.NextComboOo)
                            </a>    
                        }
                    </td>
                    <td style="width: 4%" class="score-value">
                        @if (match.BetCountNextCombo > 0)
                        {
                            <a class="forcast-number" data-match-id="@match.MatchId" data-bet-type="89" data-is-live="1" data-bet-team="2:1" href="javascript:;">
                                @RazorHelper.NegativeFormatNumber(match.NextComboUo)
                            </a>    
                        }
                    </td>
                    <td style="width: 4%" class="score-value">
                        @if (match.BetCountNextCombo > 0)
                        {
                            <a class="forcast-number" data-match-id="@match.MatchId" data-bet-type="89" data-is-live="1" data-bet-team="1:2" href="javascript:;">
                                @RazorHelper.NegativeFormatNumber(match.NextComboOe)
                            </a>    
                        }
                    </td>
                    <td style="width: 4%" class="score-value">
                        @if (match.BetCountNextCombo > 0)
                        {
                            <a class="forcast-number" data-match-id="@match.MatchId" data-bet-type="89" data-is-live="1" data-bet-team="2:2" href="javascript:;">
                                @RazorHelper.NegativeFormatNumber(match.NextComboUe)
                            </a>    
                        }
                    </td>
                    <!--/Next Combo-->
                    <!--Full time O/E-->
                    <td style="width: 6%" class="score-value">
                        @if (match.BetCountOeFt > 0)
                        {
                            <a class="forcast-number" data-match-id="@match.MatchId" data-bet-type="86" data-is-live="0" href="javascript:;">
                                @RazorHelper.NegativeFormatNumber(match.OddEvenFullTime)
                            </a>    
                        }
                    </td>
                    <!--/Full time O/E-->
                    <!--Number wheel-->
                    <td style="width: 7%" class="score-value">
                        @if (match.BetCountNumberWheelLive > 0)
                        {
                            <a class="forcast-number" data-match-id="@match.MatchId" data-bet-type="90" data-is-live="1" href="javascript:;">
                                @RazorHelper.NegativeFormatNumber(match.NumberWheelLiveGame)
                            </a>    
                        }
                    </td>
                    <td style="width: 7%" class="score-value">
                        @if (match.BetCountNumberWheelPre > 0)
                        {
                            <a class="forcast-number" data-match-id="@match.MatchId" data-bet-type="90" data-is-live="0" href="javascript:;">
                                @RazorHelper.NegativeFormatNumber(match.NumberWheelPreGame)
                            </a>    
                        }
                    </td>
                    <!--/Number wheel-->
                </tr>
                }
            }
        </tbody>
    </table>
</div>
<div class="line">
</div>

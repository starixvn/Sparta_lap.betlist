@using Fanex.Athena.Model.Report.ViewModel
<div class="header-content">
    <table class="report-table">
        <thead>
            <tr class="report-header">
                <td style="width: 10%" rowspan="2">@ViewResources.Race
                </td>
                <td style="width: 8%" rowspan="2">@ViewResources.RunnerNo
                </td>
                <td style="width: 30%" rowspan="2">@ViewResources.Runner
                </td>
                <td style="width: 16%" colspan="2">@ViewResources.Win
                </td>
                <td style="width: 16%" colspan="2">@ViewResources.Place
                </td>
                <td style="width: 16%" colspan="2">@ViewResources.WinPlace
                </td>
            </tr>
            <tr class="report-header">
                <td style="width: 8%">@ViewResources.Total
                </td>
                <td style="width: 8%">@ViewResources.Revenue
                </td>
                <td style="width: 8%">@ViewResources.Total
                </td>
                <td style="width: 8%">@ViewResources.Revenue
                </td>
                <td style="width: 8%">@ViewResources.Total
                </td>
                <td style="width: 8%">@ViewResources.Revenue
                </td>
            </tr>
        </thead>
    </table>
</div>

@{
    ViewBag.Title = "LRF -  Bet List";
    Layout = "~/Views/Shared/_BetListSimpleLayout.cshtml";
}

@using Fanex.Athena.Model.Core.Helper
@model Fanex.Athena.Model.BetList.MetaModel.LiveReportBetListMetaModel
@section pagecss {}
@section pagejs {
}
@section ContentTitle
{
    @ViewResources.BetList - @CacheRef.GetBettype(Model.BetType) - @Model.FromDate.ToShortDateString()<span class="header-title-arrow">
        → </span>@Model.ToDate.ToShortDateString() - <span class="base-currency">@RazorHelper.ViewBaseCurrency(Model.CurrencyName, Model.BaseCurrency)</span>
        
}
@section BackButton
{
    <div onclick="history.back()" class="history-link"></div>
}
@{
    <input type="hidden" id="BetListMetaModel" value="@Model.ToJson()" />
    <input type="hidden" id="HiddenColumnList" value="" />
    <input type="hidden" id="IsServerPaging" value="1" />
}

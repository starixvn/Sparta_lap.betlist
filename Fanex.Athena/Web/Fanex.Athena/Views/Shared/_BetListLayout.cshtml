@using System.Web.Optimization
@{    
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.MasterClass += " bet-list";
    
}
@section css
{
    <link href="@Url.ContentLink("/Content/Library/smoothness/jqgrid-custom.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.ContentLink("/Content/Library/ui.jqgrid/jqgrid.extension.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.ContentLink("/Content/Library/start/jquery-ui.min.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.ContentLink("/Content/Library/ui.jqgrid/ui.jqgrid.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.ContentLink("/Content/Global/grid26.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.ContentLink("/Content/Global/lrf.global.content.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.ContentLink("/Content/Plugin/MonthPickr/monPickr.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.ContentLink("/Content/Global/Paging.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.ContentLink("/Content/Plugin/DateRangePicker/daterangepicker.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.ContentLink("/Content/BetList/betlist.core.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.ContentLink("/Content/FlatPopup/jquery.custom-scrollbar.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.ContentLink("/Content/FlatPopup/jquery.flatpopup.css")" rel="stylesheet" type="text/css" />
    @RenderSection("pagecss", required: false)
}
@section js
{
   @* <script src="@Url.ContentLink("/Scripts/global/jquery.jqgrid.additional.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Library/jquery.jqGrid.en.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Library/jquery.jqGrid.min.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Plugin/MonthPickr/monpickr.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Report/report.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/scripts/global/Paging.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Plugin/DateRangePicker/date.min.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Plugin/DateRangePicker/daterangepicker.js")" type="text/javascript"></script>*@
     @Scripts.Render("~/bundles/jqGridScripts")
    <script src="@Url.ContentLink("/Scripts/BetList/betlist.option.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/BetList/betlist.js")" type="text/javascript"></script>
    @RenderSection("pagejs", required: false)
}
<div class="container_26 ">
    <div class="grid_26">
        <div class="content-title">
            @RenderSection("ContentTitle", required: false)
        </div>
    </div>
    <div class="grid_26 content-filter new-line">
        @RenderSection("ContentFilter", required: false)
    </div>
</div>
<div class="content-main">
    <div class="loading">
    </div>
    <div class="block-body">
    </div>
    <div id="dialog">
    </div>
    <div class="theme_jqGrid" style="width: 100%">
        <div id="pager1">
        </div>
        <table id="BetListGrid" style="border-left: 0px">
            <tr>
                <td>
                </td>
            </tr>
        </table>
        <div id="pager2">
        </div>
    </div>
    @RenderBody()
    @{var actionName = ViewContext.Controller.ValueProvider.GetValue("action").RawValue;}
    <input type="hidden" id="ActionName" value="@actionName" />
</div>

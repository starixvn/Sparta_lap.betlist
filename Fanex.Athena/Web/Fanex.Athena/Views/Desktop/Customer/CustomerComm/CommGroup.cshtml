@{
    Layout = null;
}
@model Fanex.Athena.Model.Customer.MetaModel.GroupCommMetaModel
<div class="row">
    <div class="col s12 text-bold input-field">
        @ViewResources.Commission (%)
    </div>
</div>
<div class="row">
    <div class="col l2 m3 s12 input-field">
        @ViewResources.Sportsbook
    </div>
    <div class="col l1 m3 s4">
        @DesktopRazorHelper.GroupComSettingDropDownList("SBComm1", GroupCommSetting.GetCommValue(15, 1), Model.SBComm1, "select")
        @Html.HiddenFor(model => model.SBComm)
    </div>
    <div class="col l1 m3 s4">
        @DesktopRazorHelper.GroupComSettingDropDownList("SBComm2", GroupCommSetting.GetCommValue(9, 1), Model.SBComm2, "select")
    </div>
    <div class="col l1 m3 s4">
        @DesktopRazorHelper.GroupComSettingDropDownList("SBComm3", GroupCommSetting.GetCommValue(1, 5), Model.SBComm3, "select")
    </div>
</div>

@{
    ViewBag.Title = "LRF - Group Management";
    Layout = "~/Views/Shared/_GroupCommLayout.cshtml";
}
@using Fanex.Athena.Extension.Utility;
@section pagecss {
    <link href="@Url.ContentLink("/Content/Plugin/ColorPicker/Spectrum.css")" rel="stylesheet" type="text/css" />
}
@section pagejs
{
    <script src="@Url.ContentLink("/Scripts/Plugin/ColorPicker/spectrum.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Customer/CustomerComm/createnewgroup.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Customer/CustomerComm/groupcomm.js")" type="text/javascript"></script>
}
@section ContentTitle{
    @ViewResources.CreateNewGroup
}
@model Fanex.Athena.Model.Customer.MetaModel.GroupCommMetaModel
@using Fanex.Athena.Model.Report.ViewModel
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div id="form_result">
        @Html.ValidationSummary(true)
        @if (ViewBag.Result != null)
        {
            var errorMsg = ViewBag.Result.ErrorMessage;

            <div class="@(ViewBag.Result.Success ? "response-area field-validation-success" : "response-area field-validation-error")">
                @(ViewBag.Result.Success ? ViewBag.Result.Message : string.IsNullOrEmpty(errorMsg) ? Html.ValidationMessageFor(model => model.GroupName) : errorMsg)
            </div>
        }
        else
        {
            <div class="validate-result response-area field-validation-error" style="display: none">
                @ViewResources.ChooseGroupNameMsg</div>
        }
    </div>
    <div class="container_26" style="padding-left: 10px">
        <div class="border-group-update">
            <table class="create-new-group-table">
                <tr style="height: 20px">
                    <td style="width: 180px">
                        @ViewResources.GroupName
                    </td>
                    <td style="width: 500px;">
                        <div class="grid_4">@Html.TextBoxFor(model => model.GroupName, new { style = "width: 125px" })</div>
                        <input type="button" id="Validate" value="@ViewResources.Checkavailability" class="button" maxlength="100" />
                        <img id="ValidateOK" src="@Url.ContentLink("/Content/Customer/images/validated.png")"
                style="display:none;margin-bottom:-3px" width="16px" height="16px" />
                        <img id="ValidateFail" src="@Url.ContentLink("/Content/Customer/images/validatefail.png")"
                style="display:none;margin-bottom:-3px" width="16px" height="16px" />
                    </td>
                </tr>
                <tr>
                    <td>
                        @ViewResources.Commission (%)
                    </td>
                    <td>
                        <div class="grid_3 product-label">
                            @ViewResources.Sportsbook</div>
                        <div class="grid_5">
                            @RazorHelper.GroupComSettingDropDownList("DdlSBComm1", GroupCommSetting.GetCommValue(15, 1), Model.SBComm1)
                            &#8226
                            @RazorHelper.GroupComSettingDropDownList("DdlSBComm2", GroupCommSetting.GetCommValue(9, 1), Model.SBComm2)
                            @RazorHelper.GroupComSettingDropDownList("DdlSBComm3", GroupCommSetting.GetCommValue(1, 5), Model.SBComm3)
                            @Html.HiddenFor(model => model.SBComm)
                            @Html.HiddenFor(model => model.SBComm1)
                            @Html.HiddenFor(model => model.SBComm2)
                            @Html.HiddenFor(model => model.SBComm3)
                        </div>
                    </td>
                </tr>

                <tr>
                    <td></td>
                    <td>
                        <div class="grid_3 product-label">
                            @ViewResources.Parlay
                        </div>
                        <div class="grid_5">
                            @RazorHelper.GroupComSettingDropDownList("DdlParlayComm1", GroupCommSetting.GetCommValue(15, 1), Model.ParlayComm1)
                            &#8226
                            @RazorHelper.GroupComSettingDropDownList("DdlParlayComm2", GroupCommSetting.GetCommValue(9, 1), Model.ParlayComm2)
                            @RazorHelper.GroupComSettingDropDownList("DdlParlayComm3", GroupCommSetting.GetCommValue(1, 5), Model.ParlayComm3)
                            @Html.HiddenFor(model => model.ParlayComm)
                            @Html.HiddenFor(model => model.ParlayComm1)
                            @Html.HiddenFor(model => model.ParlayComm2)
                            @Html.HiddenFor(model => model.ParlayComm3)
                        </div>
                    </td>
                </tr>

                @if (Model.IsUpdateRacing)
                {
                    <tr>
                        <td>
                        </td>
                        <td>
                            <div class="grid_3 product-label">@ViewResources.ProductRB</div>
                            <div class="grid_5">
                                @RazorHelper.GroupComSettingDropDownList("DdlRCComm1", GroupCommSetting.GetCommValue(15, 1), Model.RCComm1)
                                &#8226
                                @RazorHelper.GroupComSettingDropDownList("DdlRCComm2", GroupCommSetting.GetCommValue(9, 1), Model.RCComm2)
                                @RazorHelper.GroupComSettingDropDownList("DdlRCComm3", GroupCommSetting.GetCommValue(1, 5), Model.RCComm3)
                                @Html.HiddenFor(model => model.RCComm)
                                @Html.HiddenFor(model => model.RCComm1)
                                @Html.HiddenFor(model => model.RCComm2)
                                @Html.HiddenFor(model => model.RCComm3)
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    @Html.HiddenFor(model => model.RCComm)

                }
                @if (Model.IsUpdateNG)
                {
                    <tr>
                        <td>
                        </td>
                        <td>
                            <div class="grid_3 product-label">@ViewResources.ProductNG</div>
                            <div class="grid_5">
                                @RazorHelper.GroupComSettingDropDownList("DdlNGComm1", GroupCommSetting.GetCommValue(15, 1), Model.NGComm1)
                                &#8226
                                @RazorHelper.GroupComSettingDropDownList("DdlNGComm2", GroupCommSetting.GetCommValue(9, 1), Model.NGComm2)
                                @RazorHelper.GroupComSettingDropDownList("DdlNGComm3", GroupCommSetting.GetCommValue(1, 5), Model.NGComm3)
                                @Html.HiddenFor(model => model.NGComm)
                                @Html.HiddenFor(model => model.NGComm1)
                                @Html.HiddenFor(model => model.NGComm2)
                                @Html.HiddenFor(model => model.NGComm3)
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    @Html.HiddenFor(model => model.NGComm)
                }

                @if (Model.IsUpdateLC)
                {
                    <tr>
                        <td>
                        </td>
                        <td>
                            <div class="grid_3 product-label">@ViewResources.ProductLC</div>
                            <div class="grid_5">
                                @RazorHelper.GroupComSettingDropDownList("DdlLCComm1", GroupCommSetting.GetCommValue(15, 1), Model.LCComm1)
                                &#8226
                                @RazorHelper.GroupComSettingDropDownList("DdlLCComm2", GroupCommSetting.GetCommValue(9, 1), Model.LCComm2)
                                @RazorHelper.GroupComSettingDropDownList("DdlLCComm3", GroupCommSetting.GetCommValue(1, 5), Model.LCComm3)
                                @Html.HiddenFor(model => model.LCComm)
                                @Html.HiddenFor(model => model.LCComm1)
                                @Html.HiddenFor(model => model.LCComm2)
                                @Html.HiddenFor(model => model.LCComm3)
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    @Html.HiddenFor(model => model.LCComm)
                }

                @if (Model.IsUpdateCS)
                {
                    <tr>
                        <td>
                        </td>
                        <td>
                            <div class="grid_3 product-label">@ViewResources.ProductCS</div>
                            <div class="grid_5">
                                @RazorHelper.GroupComSettingDropDownList("DdlCSComm1", GroupCommSetting.GetCommValue(15, 1), Model.CSComm1)
                                &#8226
                                @RazorHelper.GroupComSettingDropDownList("DdlCSComm2", GroupCommSetting.GetCommValue(9, 1), Model.CSComm2)
                                @RazorHelper.GroupComSettingDropDownList("DdlCSComm3", GroupCommSetting.GetCommValue(1, 5), Model.CSComm3)
                                @Html.HiddenFor(model => model.CSComm)
                                @Html.HiddenFor(model => model.CSComm1)
                                @Html.HiddenFor(model => model.CSComm2)
                                @Html.HiddenFor(model => model.CSComm3)
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    @Html.HiddenFor(model => model.CSComm)
                }

                <tr>
                    <td  style="vertical-align: top">
                        @ViewResources.SetAsDefaultGroup
                    </td>
                    <td>
                        <div class="grid_1">
                            @Html.CheckBoxFor(model => model.IsDefaultGroup)
                            @Html.HiddenFor(model => model.IsResetDefault)
                            @Html.HiddenFor(model => model.DefaultGroupId)
                        </div>
                        <div class="note-message grid_11">
                            @ViewResources.GroupCommNote
                        </div>
                    </td>
                </tr>
                <tr style="height: 20px">
                </tr>
                <tr>
                    <td>
                        @ViewResources.GroupColor
                    </td>
                    <td>
                        <div class="grid_2">
                            <input id="showInput" type="text" name="showInput" style="display: none;" />
                            @Html.HiddenFor(model => model.GroupColor)
                            @Html.ValidationMessageFor(model => model.GroupColor)
                        </div>
                    </td>
                </tr>
                <tr style="height: 28px">
                    <td>
                    </td>
                    <td>
                        <div class="grid_10">
                            <input type="button" id="Add" value="@ViewResources.CreateGroup" class="button" />
                            <div class="grouComm_grid_2">
                                <input type="button" id="Cancel" value="@ViewResources.Cancel" class="button" />
                            </div>
                        </div>
                    </td>
                </tr>
            </table>
        </div>
    </div>
    @Html.HiddenFor(model => model.LicenseeId)
    @Html.ValidationMessageFor(model => model.LicenseeId)
    @Html.HiddenFor(model => model.GroupCommId)
    @Html.ValidationMessageFor(model => model.GroupCommId)
    @Html.HiddenFor(model => model.IsUpdateNG)
    @Html.HiddenFor(model => model.IsUpdateRacing)
    @Html.HiddenFor(model => model.IsUpdateLC)
    @Html.HiddenFor(model => model.IsUpdateCS)
}
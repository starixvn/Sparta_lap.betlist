@using Fanex.Athena.Model.Report.ViewModel
@model Fanex.Athena.Model.Report.ViewModel.LiveReports.LiveReportViewModel
@{
    var minDate = DateTime.Today.AddMonths(-3).AddDays(1 - DateTime.Today.Day);
}

<div class="col-sm-12">
    <div class="panel">
        <div class="panel-body">
            <form id="livereport" name="livereport" method="post" action="@Url.Content("~/LiveReport?isViewedHistory=false")">
                @Html.AntiForgeryToken()

                <div class="form-group form-material row margin-bottom-0">
                    <div class="col-sm-4 col-md-3 col-lg-2 has-icon calendar">
                        <label class="control-label">@ViewResources.From</label>
                        <input class="form-control range" type="text" value="@Model.Param.FromDate.ToString("MM/dd/yyyy")">
                    </div>
                    <div class="col-sm-4 col-md-3 col-lg-2 has-icon calendar">
                        <label class="control-label">@ViewResources.To</label>
                        <input type="text" class="form-control range" value="@Model.Param.ToDate.ToString("MM/dd/yyyy")" />
                    </div>

                    <div class="col-sm-4 col-md-3 col-lg-2 has-icon mdl-select">
                        <label class="control-label" for="CurrencyId">@ViewResources.Currency</label>
                        @RazorHelper.CurrencyList(Model.CurrencyList, "form-control", Model.Param.CurrencyId)
                    </div>

                    <div class="col-sm-4 col-md-3 col-lg-2 has-icon mdl-select">
                        <label class="control-label" for="BaseCurrency">@ViewResources.Based</label>
                        @RazorHelper.BasedCurrency(Model.Param.BaseCurrency, Model.Param.CurrencyName)
                    </div>

                    <div class="col-sm-4 col-md-3 col-lg-2 has-icon mdl-select">
                        <label class="control-label" for="LiveIndicator">@ViewResources.LiveStatus</label>
                        @RazorHelper.LiveStatus(Model.Param.LiveIndicator)
                    </div>

                    <div class="col-sm-4 col-md-3 col-lg-2 padding-top-15">
                        <input type="submit" value="@ViewResources.Submit" class="btn btn-primary waves-effect waves-light text-uppercase" />
                    </div>

                    <div class="col-sm-6 padding-top-15">
                        <p class="margin-bottom-5">
                            <span class="circle"></span>
                            <span>
                                @string.Format(ViewResources.HistoricalReportDateRangeNote, minDate),
                                <a data-history-mode="False" id="switchreport" href="javascript:;">
                                    @ViewResources.ToViewHistoryRptMsg
                                </a>
                            </span>
                        </p>

                    </div>

                    <div class="col-sm-4 col-md-3 col-lg-2 pull-right padding-top-15">
                        <i class="icon-book pull-right"></i>
                        <i class="icon-excel pull-right margin-right-10"></i>
                    </div>

                    <input type="hidden" name="ProductCode" id="ProductCode" />
                </div>
            </form>
        </div>
    </div>
</div>
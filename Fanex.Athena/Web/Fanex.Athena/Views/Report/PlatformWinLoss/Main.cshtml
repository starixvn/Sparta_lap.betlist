    " - " + ViewResources.PlatformWinLoss;
    Layout = "~/Views/Shared/_Report.jqGridLayout.cshtml";
}
@using Fanex.Athena.Models.ViewModel.Report
@model PlatformWinLossViewModel
@section pagecss {
    <link href="@Url.ContentLink("/Content/Plugin/Common/bread-crumb.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.ContentLink("/Content/Report/platformWinLoss.css")" rel="stylesheet" type="text/css" />
}
@section pagejs {
    <script src="@Url.ContentLink("/Scripts/Report/platformwinloss.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Report/platformwinloss.option.js")" type="text/javascript"></script>

}
@section ContentTitle

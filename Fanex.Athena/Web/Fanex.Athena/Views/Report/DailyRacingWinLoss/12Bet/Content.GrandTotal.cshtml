        @if (Model.IsAllowedCustomerCommission)
        {
            <div class="row" style="width: @ViewBag.CustomerCommWidth@("px")">
                <div>@grandTotalData.CustomerCommissionEUR.ToStringExt()</div>
            </div>
        }
        <div class="row" style="width: @ViewBag.CommonWidth@("px")">
            <div>@grandTotalData.WinTO12BetEUR.ToStringExt()</div>
        </div>
        <div class="row" style="width: @ViewBag.CommonWidth@("px")">
            <div>@grandTotalData.PlaceTO12BetEUR.ToStringExt()</div>
        </div>
        <div class="row" style="width: @ViewBag.CommonWidth@("px")">
            <div>@grandTotalData.WPTO12BetEUR.ToStringExt()</div>
        </div>
        <div class="row" style="width: @ViewBag.CommonWidth@("px")">
            <div>@grandTotalData.TotalTO12BetEUR.ToStringExt()</div>
        </div>
        <div class="row" style="width: @ViewBag.CommonWidth@("px")">
            <div>@grandTotalData.WinLoss12BetEUR.ToStringExt()</div>
        </div>
        <div class="row" style="width: @ViewBag.LicenseeCommWidth@("px")">

@{
    Layout = "~/Views/Desktop/Shared/_BetSettingLayout.cshtml";
}
@model Fanex.Athena.Model.BetSettings.ViewModel.BetSettingViewModel

@helper RenderFirstRow()
{
    <tr class="first-row">
        <td class="col-medium"></td>
        <td class="col-medium"></td>
        <td class="col-medium"></td>
        <td class="col-medium"></td>
    </tr>
}
@section pagejs {
    <script src="@Url.ContentLinkByEnv("/www/js/build/pages/customer/betradarvsbetsetting.chunk.js")"></script>
}

@section Menu{
    @{Html.RenderPartial("~/Views/Desktop/Customer/BetSetting/Menu.cshtml", Model);}
}

@section ContentTitle{
    @Model.Param.BetSettingName @ViewResources.BetSettings - @Model.Param.NickName (@Model.Param.UserName)
}

@Html.Hidden("dataCount", (Model.MainData.Count))

@if (Model.MainData.Count == 0)
{
    <p class="no-info-row">@ViewResources.NoInfo</p>
}
else
{
    var decimalFormatter = "#,###,##0.##";
    <div class="table-content">
        <!--Header-->

        <div class="header-content">
            <table class="table">
                <thead>
                    @RenderFirstRow()

                    <tr>
                        <th>@ViewResources.Sport</th>
                        <th>@ViewResources.MinBet</th>
                        <th>@ViewResources.MaxBet</th>
                        <th>@ViewResources.MaxPerMatch</th>
                    </tr>
                </thead>
            </table>
        </div>
        <!--/Header-->
        <!--Content-->
        <div class="body-content">
            <table class="table betsetting-form">
                @RenderFirstRow()

                @foreach (var item in Model.MainData)
                {
                    <tr>
                        <td>@item.BetSettingType</td>
                        <td>
                            @item.MinBet.ToString(decimalFormatter)
                        </td>
                        <td>
                            @item.MaxBet.ToString(decimalFormatter)
                        </td>
                        <td>
                            @item.MaxPerMatch.ToString(decimalFormatter)
                        </td>
                    </tr>
                }
            </table>
        </div>
        <!--/Content-->
    </div>
}
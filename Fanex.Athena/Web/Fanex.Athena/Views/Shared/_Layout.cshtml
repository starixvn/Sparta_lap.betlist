@using System.Linq;
@using System.Web.Optimization;

@{
    var sessionService = new Fanex.Athena.Service.Implement.Users.SessionService();
}
<!DOCTYPE html>
<html>
<head>
    <title>@ViewBag.Title</title>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    @RenderSection("css", required: false)
    <link href="@Url.ContentLink("/Content/Plugin/Note/note.css")" rel="stylesheet" type="text/css" />
    @Scripts.Render("~/bundles/CoreJs")
    <script type="text/javascript">
        function resolveClientUrl(relativeUrl) {
            return '@Url.Content("~/")' + relativeUrl;
        }

        Site.resolveClientUrl = function (relativeUrl) {
            return '@Url.Content("~/")' + relativeUrl;
        };
        Site.userCurrencies = @(Html.Raw(JsonHelper.ToJson(sessionService.UserSession.CurrencyList.ToDictionary(x => x.Value.ToString(), x => x.Key))));
        var _page = {
            lang: '@System.Globalization.CultureInfo.CurrentUICulture.IetfLanguageTag'
        };
    </script>
    @RenderSection("js", required: false)
</head>
<body class="@ViewBag.MasterClass">
    @{
        var hasCustComm = sessionService.LicenseeSession != null && sessionService.LicenseeSession.IsAllowedCustomerComm;
    }
    <input type="hidden" id="UserCurrencies" value="" />
    <input type="hidden" id="HasCustComm" value="@( hasCustComm ? 1 : 0)" />
    <input type="hidden" id="HistoryDate" value="@( Fanex.Athena.Extension.Utility.AppSettings.HistoryDate)" />
    @Html.AntiForgeryToken()
    <div id="BodyContent">
        @RenderBody()
    </div>
    <script type="text/javascript">
        $(window).load(function () {
            if (navigator.userAgent.toLowerCase().indexOf('safari') > 0 && navigator.appVersion.indexOf("Mac") != -1) {
                $('#BodyContent').css('overflow-y', 'auto');
                $('#BodyContent').css('max-height', 500);
            };
        });        
    </script>
    @if (AppSettings.IsEnablePiwik)
    {
        <script type="text/javascript">
            var _paq = _paq || [];
            _paq.push(['trackPageView']);
            _paq.push(['enableLinkTracking']);

            $(function () {
                setTimeout(function () {
                    var u = "https://pw.detecas.com/";
                    window._paq.push(['setTrackerUrl', u + 'piwik.php']);
                    window._paq.push(['setSiteId', 5]);
                    var d = document, g = d.createElement('script'), s = d.getElementsByTagName('script')[0];
                    g.type = 'text/javascript'; g.async = true; g.defer = true; g.src = u + 'piwik.js'; s.parentNode.insertBefore(g, s);
                }, 500);
            });
        </script>
    
        <noscript>
            <p>
                <img src="https://pw.detecas.com/piwik.php?rec=1&idsite=5" style="border: 0;" alt="" /></p>
        </noscript>
    }
</body>
</html>

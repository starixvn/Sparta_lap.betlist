@{
    Layout = "~/Views/Desktop/Shared/_Layout.cshtml";
}
@section css
{
    <link href="@Url.ContentLink("/Content/Plugin/MultiSelect/jquery.multiselect.css")" rel="stylesheet" type="text/css" />

    <link href="@Url.ContentLink("/www/css/source/pages/common.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.ContentLink("/www/css/source/extensions/report-ex.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.ContentLink("/www/css/source/components/jqgrid/jqgrid.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.ContentLink("/www/css/source/extensions/jqgrid-ex.css")" rel="stylesheet" type="text/css" />
    @RenderSection("pagecss", required: false)
}
@section js
{
    @RenderSection("pagejs", required: false)
}

<div class="loading">
    <div class="preloader-wrapper big active">
        <div class="spinner-layer spinner-blue-only">
            <div class="circle-clipper left">
                <div class="circle"></div>
            </div>
            <div class="gap-patch">
                <div class="circle"></div>
            </div>
            <div class="circle-clipper right">
                <div class="circle"></div>
            </div>
        </div>
    </div>
</div>
<div class="block-body">
</div>

@RenderSection("Filter", required: false)

@RenderSection("Content", required: false)
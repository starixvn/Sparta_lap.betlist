@model Fanex.Athena.Model.Report.ViewModel.LiveReports.LiveReportDetailViewModel

<div class="panel-body">
    <div class="table-title"><span>@ViewResources.BySportsType</span></div>

    <table class="table table-bordered">
        <thead>
            @{ Html.RenderPartial("~/Views/Desktop/Report/LiveReport/AjaxTemplate/BySport/Content.Header.cshtml"); }
        </thead>

        <tbody>
            @if (Model.BySports == null || Model.BySports.Count == 0)
            {
                <tr>
                    <td colspan="@ReportContentHelperNewUI.GetNumberOfColumnInLiveReport(Model)" class="text-center">@ViewResources.NoInfo</td>
                </tr>
            }
            else
            {
                Html.RenderPartial("~/Views/Desktop/Report/LiveReport/AjaxTemplate/BySport/Content.Data.cshtml");
            }
        </tbody>
    </table>
</div>
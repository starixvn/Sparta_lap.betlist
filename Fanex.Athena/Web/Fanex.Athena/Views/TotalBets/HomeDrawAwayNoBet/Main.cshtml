@{
    ViewBag.Title = "LRF - " + ViewResources.TotalBets +
    " - " + ViewResources.HomeDrawAwayNoBet;
    Layout = Request.IsAjaxRequest() ? null : "~/Views/Shared/_TotalBetsLayout.cshtml";
}
@using Fanex.Athena.Models.ViewModel
@model Fanex.Athena.Models.ViewModel.TotalBets.HomeDrawAwayNoBetViewModel
@section page {
    <script src="@Url.ContentLink("/Scripts/TotalBets/homedrawawaynobet.js")" type="text/javascript"></script>
    <script type="text/javascript">
        $(window).load(function () {
            HomeDrawAwayNoBet.initialize();
            RefreshCountDown.initEvent();
        });
    </script>
}
@section ContentTitle
    {
    @ViewResources.HomeDrawAwayNoBet
}
@section ContentFilter
{
    @{
        Html.RenderPartial("~/Views/TotalBets/HomeDrawAwayNoBet/Filter.cshtml");
    }
}
@{
    Html.RenderPartial("~/Views/TotalBets/HomeDrawAwayNoBet/Content.cshtml");
}
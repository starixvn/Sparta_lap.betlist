@model Fanex.Athena.Model.Report.ViewModel.WinLossByLeagueViewModel
@{
    var appSettings = new AppSettings();
}

<div class="page-form">
    <form id="mainform" name="mainform" method="post" action="">
        @Html.AntiForgeryToken()

        <div class="row">
            @RazorHelperDesktop.MonthPicker(Model.Param.FromDate, Model.Param.ToDate)

            <div class="input-field col l2 m3 s12">
                @RazorHelperDesktop.CurrencyList(Model.CurrencyList, "select", Model.Param.CurrencyId, true, true)
                <label>@ViewResources.Currency</label>
            </div>
            <div class="input-field col l2 m2 s12">
                @RazorHelperDesktop.BasedCurrency(Model.Param.BaseCurrency, Model.Param.CurrencyName)
                <label>@ViewResources.Based</label>
            </div>

            <div class="col right icon-block">
                <i class="icon-book right" id="UserGuide" title="@ViewResources.UserGuide"></i>
                <i class="icon-excel right" title="@ViewResources.ExportToExcel" id="ExportToExcel"></i>
            </div>
        </div>

        <div class="row">
            
            <div class="input-field input col l2 m3 s12">
                @RazorHelperDesktop.ReportBy(Model.Param.ReportBy)
            </div>

            <div class="col l2 m2 s12 button-block">
                <a id="SubmitButton" class="waves-effect waves-light btn btn-primary">@ViewResources.Submit</a>
            </div>
        </div>
        @Html.Hidden("IsExportExcel", Model.Param.IsExportExcel)
    </form>

    @Html.Hidden("ProductOptionJson", Model.Param.ProductOptions.ToJson())
    @Html.Hidden("drillDownLicenseeId", Model.Param.LicenseeId)
    @Html.Hidden("IsAllowedBACommission", Model.ProductAccess.IsAllowBA)
    @Html.Hidden("IsAllowedRacing", Model.ProductAccess.IsAllowRB)
    @Html.Hidden("IsAllowedCustomerCommission", Model.IsAllowedCustomerCommission)
</div>
@using System.Linq
@model Fanex.Athena.Models.ViewModel.TotalBets.FirstGoalLastGoalViewModel
@{
    var leagueList = Model.MainData.GroupBy(x => new { x.LeagueId, x.LeagueName })
                            .Select(x => x.Key)
                            .OrderBy(x => x.LeagueName)
                            .Distinct()
                            .ToList();
    var index = 1;
}
<div class="data-content">
    <table class="report-table">
        <tbody>
            @foreach (var league in leagueList)
            {
                // Render League name
                <tr>
                    <td class="league" colspan="9">@league.LeagueName.ToUpper()
                    </td>
                </tr>
                var matchOfLeague = Model.MainData.Where(x => x.LeagueId == league.LeagueId)
                                                  .OrderBy(x => x.HomeTeamName)
                                                  .ToList();

                // Render Team in League
                foreach (var team in matchOfLeague)
                { 
                <tr>
                    <td style="width: 3%" class="order-number" rowspan="2">@(index++)
                    </td>
                    <td style="width: 15%" class="show-time" rowspan="2">
                        @Html.Raw(team.ShowTime)
                    </td>
                    <td style="width: 25%" class="match-name">
                        <a class="team" data-match-id="@team.MatchId" href="javascript:;">@team.HomeTeamName</a>
                    </td>
                    <td style="width: 10%" class="score-value">
                        @RazorHelper.PositiveFormat(team.HomeFirstGoal, true)
                    </td>
                    <td style="width: 10%" class="score-value">
                        @RazorHelper.PositiveFormat(team.HomeLastGoal, true)
                    </td>
                    <td style="width: 10%" class="score-value" rowspan="2">
                        @RazorHelper.PositiveFormat(team.NoGoal, true)
                    </td>
                    <td style="width: 10%" class="score-value">
                        @RazorHelper.PositiveFormatExt(team.HomeFirstHalfFirstGoal, true)
                    </td>
                    <td style="width: 10%" class="score-value">
                        @RazorHelper.PositiveFormatExt(team.HomeFirstHalfLastGoal, true)
                    </td>
                    <td style="width: 10%" class="score-value" rowspan="2">
                        @RazorHelper.PositiveFormatExt(team.FirstHalfNoGoal, true)
                    </td>
                </tr>
                <tr>
                    <td style="width: 25%" class="match-name">
                        <a class="team" data-match-id="@team.MatchId" href="javascript:;">@team.AwayTeamName</a>
                    </td>
                    <td style="width: 10%" class="score-value">
                        @RazorHelper.PositiveFormat(team.AwayFirstGoal, true)
                    </td>
                    <td style="width: 10%" class="score-value">
                        @RazorHelper.PositiveFormat(team.AwayLastGoal, true)
                    </td>
                    <td style="width: 10%" class="score-value">
                        @RazorHelper.PositiveFormatExt(team.AwayFirstHalfFirstGoal, true)
                    </td>
                    <td style="width: 10%" class="score-value">
                        @RazorHelper.PositiveFormatExt(team.AwayFirstHalfLastGoal, true)
                    </td>
                </tr>
                }
            }
        </tbody>
    </table>
</div>
<div class="line">
</div>

@{    
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section css
{
    @System.Web.Optimization.Styles.Render("~/bundles/GroupCommLayoutStyles")
    @RenderSection("pagecss", required: false)
}
@section js
{
    @System.Web.Optimization.Scripts.Render("~/bundles/GroupCommLayoutScripts")
    @RenderSection("pagejs", required: false)
}
@{
    var userSession = new Fanex.Athena.Service.Core.Users.SessionService().UserSession;
    var isAppModeSelf = userSession == null ? true : userSession.ApplicationMode == Fanex.Athena.Model.Core.DataDomain.AppMode.Self;
}
<div class="content-title @(isAppModeSelf ? string.Empty: "hide")">
    @RenderSection("ContentTitle")
</div>
<div class="content-main">
    <div class="loading">
    </div>
    <div class="block-body">
    </div>
    @RenderBody()
</div>

<div id="dialog" class="invisible"></div>
<div id="dialogIP" class="invisible"></div>

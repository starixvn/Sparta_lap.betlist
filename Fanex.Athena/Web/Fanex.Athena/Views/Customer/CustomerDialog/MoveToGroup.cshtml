@using Fanex.Athena.Models.ViewModel
@model Fanex.Athena.Models.ViewModel.Customer.CustomerListViewModel
<table class="create-new-group-table" style="width: 280px !important">
    <tr>
        <td>
            @ViewResources.SelectGroup
        </td>
        <td>
            <select id="GroupListSelect">
                @foreach (var group in Model.GroupCommDataList)
                {
                    <option value="@group.GroupCommId">@group.GroupName</option>
                }
            </select>
            @foreach (var group in Model.GroupCommDataList)
            {
                @Html.Hidden("SBComm" + @group.GroupCommId, RazorHelper.DecFormat((group.SBComm * 100), true))
                @Html.Hidden("RBComm" + @group.GroupCommId, RazorHelper.DecFormat((group.RCComm * 100), true))
                @Html.Hidden("NGComm" + @group.GroupCommId, RazorHelper.DecFormat((group.NGComm * 100), true))
                @Html.Hidden("LCComm" + @group.GroupCommId, RazorHelper.DecFormat((group.LCComm * 100), true))
                @Html.Hidden("CSComm" + @group.GroupCommId, RazorHelper.DecFormat((group.CSComm * 100), true))
            }
        </td>
    </tr>
    <tr>
        <td>
            @ViewResources.SBComm (%)
        </td>
        <td>
            <input id="NewSbComm" type="text" disabled='disabled' value="@(Model.GroupCommDataList.Count > 0 ? NumberHelper.DecFormat((Model.GroupCommDataList[0].SBComm * 100), 2) : string.Empty)"/>
        </td>
    </tr>
    <tr class="@(!Model.ProductAccess.IsAllowRb ? "hide" : "")">
        <td>
            @ViewResources.RBComm (%)
        </td>
        <td>
            <input id="NewRbComm" type="text" disabled='disabled' value="@(Model.GroupCommDataList.Count > 0 ? NumberHelper.DecFormat((Model.GroupCommDataList[0].RCComm * 100), 2) : string.Empty)"/>
        </td>
    </tr>
    <tr class="@(!Model.ProductAccess.IsAllowNg ? "hide" : "")">
        <td>
            @ViewResources.NGComm (%)
        </td>
        <td>
            <input id="NewNgComm" type="text" disabled='disabled' value="@(Model.GroupCommDataList.Count > 0 ? NumberHelper.DecFormat((Model.GroupCommDataList[0].NGComm * 100), 2) : string.Empty)"/>
        </td>
    </tr>
    <tr class="@(!Model.ProductAccess.IsAllowLc ? "hide" : "")">
        <td>
            @ViewResources.LCComm (%)
        </td>
        <td>
            <input id="NewLcComm" type="text" disabled='disabled' value="@(Model.GroupCommDataList.Count > 0 ? NumberHelper.DecFormat((Model.GroupCommDataList[0].LCComm * 100), 2) : string.Empty)"/>
        </td>
    </tr>
    <tr class="@(!Model.ProductAccess.IsAllowCs ? "hide" : "")">
        <td>
            @ViewResources.CSComm (%)
        </td>
        <td>
            <input id="NewCsComm" type="text" disabled='disabled' value="@(Model.GroupCommDataList.Count > 0 ? NumberHelper.DecFormat((Model.GroupCommDataList[0].CSComm * 100), 2) : string.Empty)"/>
        </td>
    </tr>
</table>
<div class="success-message">
</div>
<div class="error-message">
</div>
<div class="ajax-loading">
    <img alt="Sending" src="@Url.Content("~/Content/Customer/images/ajax-loader.gif")" />
</div>
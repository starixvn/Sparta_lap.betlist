@{    
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section css
{
    @System.Web.Optimization.Styles.Render("~/bundles/GroupCommLayoutCss")
    @RenderSection("pagecss", required: false)
}
@section js
{
    @System.Web.Optimization.Scripts.Render("~/bundles/GroupCommLayoutScripts")
    @RenderSection("pagejs", required: false)
}

<div class="content-title">
    @RenderSection("ContentTitle")
</div>
<div class="content-main">
    <div class="loading">
    </div>
    <div class="block-body">
    </div>
    @RenderBody()
</div>

<div id="dialog" class="invisible"></div>
<div id="dialogIP" class="invisible"></div>

@using Fanex.Athena.Model.Report.ViewModel
<div class="header-content">
    <table class="report-table">
        <thead>
            <tr class="report-header">
                <td style="width: 3%" rowspan="2">
                    #
                </td>
                <td style="width: 10%" rowspan="2">@ViewResources.Time
                </td>
                <td style="width: 30%" rowspan="2">@ViewResources.Event
                </td>
                <td style="width: 30%" colspan="3">@ViewResources.FullTime
                </td>
                <td style="width: 20%" colspan="2">@ViewResources.lbl1stHalf
                </td>
            </tr>
            <tr class="report-header">
                <td style="width: 10%">@ViewResources.OddEven
                </td>
                <td style="width: 10%">@ViewResources.OneXTwo
                </td>
                <td style="width: 10%">@ViewResources.DrawNoDraw
                </td>
                <td style="width: 10%">@ViewResources.OddEven
                </td>
                <td style="width: 10%">@ViewResources.OneXTwo
                </td>
            </tr>
        </thead>
    </table>
</div>

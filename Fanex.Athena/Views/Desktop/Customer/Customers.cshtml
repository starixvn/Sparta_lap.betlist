@{
    ViewBag.Title = "LAP - " + ViewResources.CustomerList;
    Layout = "~/Views/Desktop/Shared/_Report.jqGridLayout.cshtml";
}
@model Fanex.Athena.Model.Customer.ViewModel.CustomerListViewModel
@section pagecss {
    <link href="@Url.ContentLinkByEnv("/www/css/build/pages/customer/customerlist.css")" rel="stylesheet" />
}
@section pagejs {
    <script src="@Url.ContentLinkByEnv("/www/js/build/pages/customer/customerlist.chunk.js")"></script>
}
@section Filter
{
    @{Html.RenderPartial("~/Views/Desktop/Customer/Filter.cshtml", Model);}
}
@section Content
{
    @if (Model.IsAllowedUserEditComm && Model.IsAllowedCustomerCommission && !Model.IsSubsidiary)
    {
        <div class="page-button">
            <input type="button" id="MoveToGroup" class="btn btn-back" value="@ViewResources.MoveToGroup" />
            <input type="button" id="UpdateComm" value="@ViewResources.UpdateCommission" class="btn btn-back" data-group-id="@Model.Param.GroupCommId" />
            <input type="button" id="RemoveFromGroup" value="@ViewResources.RemoveFromGroup" class="btn btn-back" />
        </div>
    }
    
    <div class="page-results" style="display:none">
        <div class="tab">
            <button class="tablinks active" data-tab="tabActiveCustomer" >@ViewResources.ActiveCustomers (<span id="num-of-customer-header">0</span>)</button>
            <button class="tablinks"  data-tab="tabDormantCustomer">@ViewResources.DormantCustomers (<span id="num-of-dormant-customer-header">0</span>)</button>
        </div>

        @*Tab 1*@
        <div class="result-content tabcontent"  id="tabActiveCustomer" style="margin: 0">
            <div class="panel-heading active">
                <div class="panel-title">
                    <div class="report-title" style="">
                        @ViewResources.SearchResult:
                        <span id="num-of-customer" class="num-of-customer"></span> @ViewResources.Customers.ToLower()
                        <p class="ba-time-notice">@Model.BATimeCheck</p>
                    </div>
                </div>
                <div class="excel-container">
                    @using (Html.BeginForm("ExportExcel", "Customer", FormMethod.Post, new { @id = "CustomerExcelForm" }))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="excelParam" id="excelParam" value="@Model.Param.ToJson()" />
                        <i class="icon-excel" title="@ViewResources.ExportToExcel" id="ExportToExcel"></i>
                    }
                </div>
            </div>
            <div class="main-content"  id="report-content">
                <div class="theme_jqGrid">
                    <div style="width: 100%">
                        <table id="ReportGrid" class="table" data-hidden-column=""></table>
                        <div class="paging" id="ActiveCustomerPager">
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @*Tab 2*@
        <div id="tabDormantCustomer" class="tabcontent"  style="margin: 0; display: none">
            <div class="panel-heading">
                <div class="panel-title">
                    <div class="report-title" style="">
                        @ViewResources.SearchResult:
                        <span id="num-of-dormant-customer" class="num-of-customer"></span> @ViewResources.Customers.ToLower()
                    </div>
                </div>
                <div class="excel-container">
                    @using (Html.BeginForm("ExportExcelDormantCustomer", "Customer", FormMethod.Post, new { @id = "DormantCustomerExcelForm" }))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="excelParam" id="excelDormantParam" value="@Model.Param.ToJson()" />
                        <i class="icon-excel" title="@ViewResources.ExportToExcel" id="ExportToExcelDormantCustomer"></i>
                    }
                </div>
            </div>
            <div class="main-content">
                <div class="theme_jqGrid">
                    <div style="width: 100%">
                        <table id="DormantCustomerGrid" class="table" data-hidden-column=""></table>
                        <div class="paging"  id="DormantCustomerPager">
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>



    @if (!Model.IsSubsidiary && Model.IsAllowedUserEditComm && Model.IsAllowedCustomerCommission)
    {
        <div id="MoveToGroupPopUp" title="@ViewResources.MoveToGroup" style="display: none">
            @{
                Html.RenderPartial("~/Views/Desktop/Customer/CustomerDialog/MoveToGroup.cshtml");
            }
        </div>
        <div id="UpdateCustCommPopUp" title="@ViewResources.UpdateCustomerCommission" style="display: none">
            @{
                Html.RenderPartial("~/Views/Desktop/Customer/CustomerDialog/UpdateCustComm.cshtml", Model.ProductAccess);
            }
        </div>
        <div id="ConfirmRemoveFromGroupPopUp" title="@ViewResources.RemoveFromGroup" style="display: none">
            @{
                Html.RenderPartial("~/Views/Desktop/Customer/CustomerDialog/RemoveFromGroup.cshtml");
            }
        </div>
                }
    @if (Model.DataList != null)
    {
        @Html.Hidden("NumOfCheckBox", Model.DataList.Count())
    }
    @{ Html.RenderPartial("~/Views/Desktop/Customer/ContextMenu.cshtml", Model); }
    <!--/popup-->
    <input type="hidden" id="IsAllowedCustomerCommission" value="@(Model.IsAllowedCustomerCommission.ToString())" />
    <input type="hidden" id="IsAllowedUserEditComm" value="@(Model.IsAllowedUserEditComm.ToString())" />
    <input type="hidden" id="ProductList" value="@(string.Join(",", ViewBag.ProductList))" />
}

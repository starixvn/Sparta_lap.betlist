@{    
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section css
{
     @System.Web.Optimization.Styles.Render("~/bundles/CustomerLogLayoutStyles")   
}
@section js
{
     @System.Web.Optimization.Scripts.Render("~/bundles/CustomerLogLayoutScripts")
    
    @RenderSection("pagejs", required: false)
}

@RenderSection("Menu", required: false)
<div class="container_26">
    <div class="grid_26">
        <div class="content-title">
            @RenderSection("ContentTitle", required: false)
        </div>
    </div>
    <div class="clear">
    </div>
    <div class="grid_26 content-filter">
        @RenderSection("ContentFilter", required: false)
    </div>
    <div class="clear">
    </div>
    <div class="grid_26">
        <div class="content-main">
            <div class="loading">
            </div>
            <div class="block-body">
            </div>
            @RenderBody()
        </div>
    </div>
</div>

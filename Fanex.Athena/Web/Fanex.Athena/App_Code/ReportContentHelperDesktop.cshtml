@using Fanex.Athena.Resources
@using Fanex.Athena.Extension.Helper
@using Fanex.Athena.Model.Core.ViewModel
@using Fanex.Athena.Model.Report.DTO
@using Fanex.Athena.Model.Report.DTO.LiveReports

@helper CreateHeaderForLiveReport(BaseViewModel model, string firstColumnHeader)
{
    var rowspanText = model.IsAllowedCustomerCommission ? "rowspan=2" : "";
    var colspanText = model.IsAllowedCustomerCommission ? "colspan=3" : "";

    <tr>
        <th class="header-large" @rowspanText>@firstColumnHeader</th>
        <th @colspanText>@ViewResources.CustomerW_L</th>
        <th class="header-medium" @rowspanText>@ViewResources.Turnover</th>
        <th class="header-small" @rowspanText>@ViewResources.BetCount</th>
        <th class="header-medium" @rowspanText>@ViewResources.LicenseeW_L</th>
        @if (model.ProductAccess.IsAllowRB || model.ProductAccess.IsAllowBA)
        {
            <th class="header-small" @rowspanText>@ViewResources.Comm</th>
        }
        <th class="header-medium" @rowspanText>@ViewResources.AmountDueTo</th>
    </tr>

    if (model.IsAllowedCustomerCommission)
    {
        <tr>
            <th class="header-medium">@ViewResources.WinLoss</th>
            <th class="header-small">@ViewResources.Comm</th>
            <th class="header-medium">@ViewResources.Total</th>
        </tr>
    }
}

@helper RenderDataForLiveReport(BaseViewModel model, LiveReport data)
{
    @RenderCustomerWinLossForLiveReport(data, model.IsAllowedCustomerCommission)

    <td class="right-align">@data.TurnOver.ToStringExt()</td>
    <td class="right-align">@data.BetCount.ToStringExt()</td>
    <td class="right-align highlight">@RazorHelperDesktop.HighlightNegativeFormat(data.LicenseeWinLoss)</td>

    if (model.ProductAccess.IsAllowRB || model.ProductAccess.IsAllowBA)
    {
        <td class="right-align highlight">@data.LicenseeComm.ToStringExt()</td>
    }

    <td class="right-align">@data.AmountDue.ToStringExt()</td>
}

@helper RenderCustomerWinLossForLiveReport(ICustomerWinLoss data, bool isAllowedCustomerCommission)
{
    if (isAllowedCustomerCommission)
    {
        <td class="right-align">@data.CustomerWinLoss.ToStringExt()</td>
        <td class="right-align">@data.CustomerComm.ToStringExt()</td>
        <td class="right-align">@data.CustomerTotal.ToStringExt()</td>
    }
    else
    {
        <td class="right-align">@data.CustomerWinLoss.ToStringExt()</td>
    }
}
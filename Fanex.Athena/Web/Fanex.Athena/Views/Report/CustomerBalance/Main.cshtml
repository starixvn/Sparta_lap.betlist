@{
    ViewBag.Title = "LRF - Report - " + ViewResources.CustomerBalance;
    Layout = "~/Views/Shared/_ReportLayout.cshtml";
}
@using Fanex.Athena.Model.Report.ViewModel
@model Fanex.Athena.Model.Report.ViewModel.CustomerBalanceViewModel
@section pagecss {
    <link href="@Url.ContentLink("/Content/Report/CustomertBalance.css")" rel="stylesheet" type="text/css" />
}
@section pagejs {
    <script src="@Url.ContentLink("/Scripts/Report/CustomerBalance.js")" type="text/javascript"></script>
}
@section ContentTitle
{
    @ViewResources.CustomerBalance
}
@{  // Set width
    ViewBag.ColumnCount = 15;
    ViewBag.ColumnCount += Model.ProductAccess.IsAllowBA ? 1 : 0;

    ViewBag.NumberWidth = 40;
    ViewBag.ExternalIdWidth = 120;
    ViewBag.SystemIdWidth = 120;
    ViewBag.OpeningBalanceWidth = 90;
    ViewBag.DepositWidth = 100;
    ViewBag.WithdrawalWidth = 100;
    ViewBag.BonusWidth = 60;
    ViewBag.AdjustmentWidth = 80;
    ViewBag.TurnoverWidth = 100;
    ViewBag.DrawGameWidth = 100;
    ViewBag.NetTurnoverWidth = 100;
    ViewBag.PendingFundsWidth = 100;
    ViewBag.CustomerWLLargeWidth = 90;
    ViewBag.CustomerWLWidth = 100;
    ViewBag.CustomerCommWidth = 80;
    ViewBag.CustomerWLTotalWidth = 100;
    ViewBag.CustomerWLMergeWidth = ViewBag.CustomerWLWidth + ViewBag.CustomerCommWidth + ViewBag.CustomerWLTotalWidth + 2; //242;
    ViewBag.ClosingBalanceWidth = 100;
    ViewBag.AffiliateTransferWidth = 100;
    ViewBag.BaTurnoverWidth = 100;
    ViewBag.BaCommWidth = 80;
    ViewBag.AmountDueToBaWidth = 100;
    ViewBag.BaMergeWidth = ViewBag.BaTurnoverWidth + ViewBag.BaCommWidth + ViewBag.AmountDueToBaWidth + 2;

    ViewBag.ContainerWidth = ViewBag.NumberWidth + ViewBag.ExternalIdWidth + ViewBag.SystemIdWidth + ViewBag.OpeningBalanceWidth
    + ViewBag.DepositWidth + ViewBag.WithdrawalWidth + ViewBag.BonusWidth
    + ViewBag.AdjustmentWidth + ViewBag.TurnoverWidth + ViewBag.DrawGameWidth
    + ViewBag.NetTurnoverWidth + ViewBag.PendingFundsWidth
    + (Model.IsAllowedCustomerCommission ? ViewBag.CustomerWLMergeWidth : ViewBag.CustomerWLLargeWidth)
    + ViewBag.ClosingBalanceWidth + ViewBag.AffiliateTransferWidth
    + (Model.ProductAccess.IsAllowBA ? ViewBag.BaMergeWidth : 0);

    ViewBag.ContainerWidth += ViewBag.ColumnCount - 1;
    ViewBag.FilterWidth = ViewBag.ContainerWidth > 1075 ? 1075 : ViewBag.ContainerWidth;
    ViewBag.WrapperWidth = ViewBag.FilterWidth;
    ViewBag.TitleWidth = ViewBag.FilterWidth - 24;
    ViewBag.TotalWrapperWidth = ViewBag.FilterWidth - 18;
}
@section ContentFilter
{
    @{
        Html.RenderPartial("~/Views/Report/CustomerBalance/Filter.cshtml");
    }
}
@{
    if(Model.IsValidTimeRequest)
    {    
        if (!Model.ShowEmptyContent)
        {
            Html.RenderPartial("~/Views/Report/CustomerBalance/Content.cshtml");
        }
    }
    else
    {
        <input type="hidden" id="IsValidTimeRequest" name="IsValidTimeRequest" value="@Model.IsValidTimeRequest.ToString()" />
    }
}

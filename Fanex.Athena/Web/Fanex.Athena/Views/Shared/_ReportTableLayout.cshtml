@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section css{
    @System.Web.Optimization.Styles.Render("~/bundles/ReportTableLayoutStyles")
    @RenderSection("pagecss", required: false)
}
@section js{
    @System.Web.Optimization.Scripts.Render("~/bundles/ReportTableLayoutScripts")
    @RenderSection("pagejs", required: false)
}
@{
    var userSession = new Fanex.Athena.Service.Core.Users.SessionService().UserSession;
    var isAppModeSelf = userSession != null ? false : userSession.ApplicationMode == Fanex.Athena.Model.Core.DataDomain.AppMode.Self;
}
<div class="container_26">
    <div class="grid_26 @(isAppModeSelf ? string.Empty: "hide")">
        <div class="content-title">
            @RenderSection("ContentTitle", required: false)
        </div>
    </div>
    <div class="grid_26 content-filter new-line">
        @RenderSection("ContentFilter", required: false)
    </div>
</div>
<div class="content-main new-line">
    <div class="loading">
    </div>
    <div class="block-body">
    </div>
    @RenderBody()
</div>

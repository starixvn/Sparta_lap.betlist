@{
    ViewBag.Title = "LRF - " + ViewResources.Forecast +
    " - " + ViewResources.HandicapOverUnderLive;
    Layout = Request.IsAjaxRequest() ? null : "~/Views/Shared/_ForecastLayout.cshtml";
}
@using Fanex.Athena.Models.ViewModel
@model Fanex.Athena.Model.Forecast.ViewModel.ForecastHdpOuViewModel
@section page {
    <script src="@Url.ContentLink("/Scripts/Forecast/forecast.handicapoverunder.js")" type="text/javascript"></script>
    <link href="@Url.ContentLink("/Content/Forecast/forecasthandicapoverunder.css")" rel="stylesheet" type="text/css" />
    <script type="text/javascript">
        $(window).load(function () {
            ForecastHDPOU.initialize();
            RefreshCountDown.initEvent();
        });
    </script>
}
@section ContentTitle
{
    @ViewResources.HandicapOverUnderLive
}
@section ContentFilter
{
    @{
        Html.RenderPartial("~/Views/Forecast/ForecastHDPOU/Filter.cshtml");
    }
}
@{
    Html.RenderPartial("~/Views/Forecast/ForecastHDPOU/Content.cshtml");
}
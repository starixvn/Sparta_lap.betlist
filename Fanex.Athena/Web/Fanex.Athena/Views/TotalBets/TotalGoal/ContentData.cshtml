@using System.Linq
@model Fanex.Athena.Models.ViewModel.TotalBets.TotalGoalViewModel
@{
    var index = 1;
    var listMatch = Model.MainData.OrderBy(x => x.HomeTeamName).ToList();
}
<div class="data-content">
    <table class="report-table">
        <tbody>
            @foreach (var match in listMatch)
            {
                <tr>
                    <td style="width: 3%" class="order-number">
                        @(index++)
                    </td>
                    <td style="width: 14%" class="match-name">
                        <a data-leagueid="@match.LeagueId" data-match-id="@match.MatchId" class="team" href="javascript:;">@match.HomeTeamName</a>
                    </td>
                    <td style="width: 14%" class="match-name">
                        @match.AwayTeamName
                    </td>
                    <td style="width: 10%" class="score-value">
                        @RazorHelper.PositiveFormat(match.Total01, true, false)
                    </td>
                    <td style="width: 10%" class="score-value">
                        @RazorHelper.PositiveFormat(match.Total23, true, false)
                    </td>
                    <td style="width: 10%" class="score-value">
                        @RazorHelper.PositiveFormat(match.Total46, true, false)
                    </td>
                    <td style="width: 10%" class="score-value">
                        @RazorHelper.PositiveFormat(match.Total7Over, true, false)
                    </td>
                    <td style="width: 10%" class="score-value">
                        @RazorHelper.PositiveFormatExt(match.TotalFirstHalf01)
                    </td>
                    <td style="width: 10%" class="score-value">
                        @RazorHelper.PositiveFormatExt(match.TotalFirstHalf23)
                    </td>
                    <td style="width: 10%" class="score-value">
                        @RazorHelper.PositiveFormatExt(match.Total4Over)
                    </td>
                </tr>
            }
            @if (Model.MainData.Any())
            {
            <tr class="total-footer">
                <td class="score-value" colspan="3">@ViewResources.Total</td>
                <td class="score-value"><span>@Model.MainData.Sum(t => t.Total01).ToString("#,###.##")</span></td>
                <td class="score-value"><span>@Model.MainData.Sum(t => t.Total23).ToString("#,###.##")</span></td>
                <td class="score-value"><span>@Model.MainData.Sum(t => t.Total46).ToString("#,###.##")</span></td>
                <td class="score-value"><span>@Model.MainData.Sum(t => t.Total7Over).ToString("#,###.##")</span></td>
                <td class="score-value"><span>@Model.MainData.Sum(t => (decimal)t.TotalFirstHalf01).ToString("#,###.##")</span></td>
                <td class="score-value"><span>@Model.MainData.Sum(t => (decimal)t.TotalFirstHalf23).ToString("#,###.##")</span></td>
                <td class="score-value"><span>@Model.MainData.Sum(t => (decimal)t.Total4Over).ToString("#,###.##")</span></td>
            </tr>
            }
        </tbody>
    </table>
</div>
<div class="line">
</div>

@using System.Linq
@model Fanex.Athena.Models.ViewModel.TotalBets.FirstGoalLastGoalViewModel
@{
    var leagueList = Model.MainData.GroupBy(x => new { x.LeagueId, x.LeagueName })
                            .Select(x => x.Key)
                            .OrderBy(x => x.LeagueName)
                            .Distinct()
                            .ToList();
    var index = 1;
}
<div class="data-content">
    <table class="report-table">
        <tbody>
            @foreach (var league in leagueList)
            {
                // Render League name
                <tr>
                    <td class="league" colspan="9">@league.LeagueName.ToUpper()
                    </td>
                </tr>
                var matchOfLeague = Model.MainData.Where(x => x.LeagueId == league.LeagueId)
                                                  .OrderBy(x => x.HomeTeamName)
                                                  .ToList();

                // Render Team in League
                foreach (var team in matchOfLeague)
                { 
                <tr>
                    <td style="width: 3%" class="order-number" rowspan="2">@(index++)
                    </td>
                    <td style="width: 15%" class="show-time" rowspan="2">
                        @Html.Raw(team.ShowTime)
                    </td>
                    <td style="width: 25%" class="match-name">
                        <a class="team" data-match-id="@team.MatchId" href="javascript:;">@team.HomeTeamName</a>
                    </td>
                    <td style="width: 10%" class="score-value">
                        @RazorHelper.PositiveFormat(team.HomeFirstGoal, true, false)
                    </td>
                    <td style="width: 10%" class="score-value">
                        @RazorHelper.PositiveFormat(team.HomeLastGoal, true, false)
                    </td>
                    <td style="width: 10%" class="score-value" rowspan="2">
                        @RazorHelper.PositiveFormat(team.NoGoal, true, false)
                    </td>
                    <td style="width: 10%" class="score-value">
                        @RazorHelper.PositiveFormatExt(team.HomeFirstHalfFirstGoal)
                    </td>
                    <td style="width: 10%" class="score-value">
                        @RazorHelper.PositiveFormatExt(team.HomeFirstHalfLastGoal)
                    </td>
                    <td style="width: 10%" class="score-value" rowspan="2">
                        @RazorHelper.PositiveFormatExt(team.FirstHalfNoGoal)
                    </td>
                </tr>
                <tr>
                    <td style="width: 25%" class="match-name">
                        <a class="team" data-match-id="@team.MatchId" href="javascript:;">@team.AwayTeamName</a>
                    </td>
                    <td style="width: 10%" class="score-value">
                        @RazorHelper.PositiveFormat(team.AwayFirstGoal, true, false)
                    </td>
                    <td style="width: 10%" class="score-value">
                        @RazorHelper.PositiveFormat(team.AwayLastGoal, true, false)
                    </td>
                    <td style="width: 10%" class="score-value">
                        @RazorHelper.PositiveFormatExt(team.AwayFirstHalfFirstGoal)
                    </td>
                    <td style="width: 10%" class="score-value">
                        @RazorHelper.PositiveFormatExt(team.AwayFirstHalfLastGoal)
                    </td>
                </tr>
                }
            }
            @if (Model.MainData.Any())
            {
            <tr class="total-footer">
                <td class="score-value" colspan="3">
                    @ViewResources.Total
                </td>
                <td class="score-value">
                    <span>@Model.MainData.Sum(t => t.HomeFirstGoal + t.AwayFirstGoal).ToString("#,###.##")</span>
                </td>
                <td class="score-value">
                    <span>@Model.MainData.Sum(t => t.HomeLastGoal + t.AwayLastGoal).ToString("#,###.##")</span>

                </td>
                <td class="score-value">
                    <span>@Model.MainData.Sum(t => t.NoGoal).ToString("#,###.##")</span>
                </td>
                <td class="score-value">
                    <span>@Model.MainData.Sum(t => (decimal)t.HomeFirstHalfFirstGoal + (decimal)t.AwayFirstHalfFirstGoal).ToString("#,###.##")</span>

                </td>
                <td class="score-value">
                    <span>@Model.MainData.Sum(t => (decimal)t.HomeFirstHalfLastGoal + (decimal)t.AwayFirstHalfLastGoal).ToString("#,###.##")</span>

                </td>
                <td class="score-value">
                    <span>@Model.MainData.Sum(t => (decimal)t.FirstHalfNoGoal).ToString("#,###.##")</span>
                </td>
            </tr>
            }
        </tbody>
    </table>
</div>
<div class="line">
</div>

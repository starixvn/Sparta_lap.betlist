@{
    Layout = null;
}
@using Fanex.Athena.Extension.Utility;
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>LRF • Reports - Balance</title>
    <link href="@Url.ContentLink("/Content/Global/Global.css")" rel="Stylesheet" />
    <link href="@Url.ContentLink("/Content/Themes/12Bet/Site.css")" rel="Stylesheet" />
    <link href="@Url.ContentLink("/Content/Layout/master.css")" rel="stylesheet" type="text/css" />
    <script src="@Url.ContentLink("/Scripts/Library/jquery.min.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Library/jquery-ui.min.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Library/jquery.cookie.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Library/jquery.blockUI.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Library/jquery.layout.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Global/site.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Global/lrf.layout.js")" type="text/javascript"></script>
    <script type="text/javascript">
        Site.resolveClientUrl = function (relativeUrl) {
            return '@Url.Content("~/")' + relativeUrl;
        };
    </script>
    <style type="text/css">
        #center
        {
            overflow: auto;
            -webkit-overflow-scrolling: touch;
        }
    </style>
</head>
<body>
    <div class="ui-layout-north">
        <iframe src="@(Util.RootPath)Header/Index" id="header" name="header"
            width="100%" scrolling="no" frameborder="0" height="52px"></iframe>
    </div>
    <div class="ui-layout-west">
        <iframe src="@(Util.RootPath)/Menu/Index" scrolling="no" height="100%" id="menu" name="menu"
            width="170px" frameborder="0"></iframe>
    </div>
    <div id="footer" class="ui-layout-south">
        <iframe src="@(Util.RootPath)Footer/Index" height="25px" width="100%"
            scrolling="no" frameborder="0" id="frFooter" name="frFooter"></iframe>
    </div>
    <div id="center" class="ui-layout-center">
        <iframe src="@(Util.RootPath)Report/Balance" id="main" name="main" scrolling="auto"
            width="100%" height="100%" frameborder="0"></iframe>
        <div id="notification_popup">
            <div class="command">
                <input type="button" id="notificaiton_close" />
            </div>
            <div class="popup-title">
                Risk & ForeCast
                @Fanex.Athena.Models.ViewModel.ViewResources.Notification
            </div>
            <div class="note-message">
                @string.Format(Fanex.Athena.Models.ViewModel.ViewResources.LayoutNoteMsg, "<span id=\"browser\"></span>")
            </div>
            <div class="browsers">
                <ul>
                    <li class="download-chrome"><a target="_blank" href="http://www.google.de/chrome/eula.html?hl=en">
                        @Fanex.Athena.Models.ViewModel.ViewResources.Download
                        Google Chrome </a></li>
                    <li class="download-firefox"><a target="_blank" href="http://www.mozilla.org/products/download.html?product=firefox-11.0&os=win&lang=en-US">
                        @Fanex.Athena.Models.ViewModel.ViewResources.Download
                    </a></li>
                    <li class="download-ie"><a target="_blank" href="http://windows.microsoft.com/en-US/internet-explorer/downloads/ie">
                        @Fanex.Athena.Models.ViewModel.ViewResources.Download
                    </a></li>
                </ul>
            </div>
            <div class="remove-notif">
                <a href="javascript:;" id="remove_notif_cmd">
                    @Fanex.Athena.Models.ViewModel.ViewResources.Dontshowagain
                </a>
            </div>
</body>
</html>
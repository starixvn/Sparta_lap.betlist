@using System.Linq
@model Fanex.Athena.Models.ViewModel.TotalBets.TotalGoalViewModel
@{
    var index = 1;
    var listMatch = Model.MainData.OrderBy(x => x.HomeTeamName).ToList();
}
<div class="data-content">
    <table class="report-table">
        <tbody>
            @foreach (var match in listMatch)
            {
                <tr>
                    <td style="width: 3%" class="order-number">
                        @(index++)
                    </td>
                    <td style="width: 14%" class="match-name">
                        <a data-leagueid="@match.LeagueId" data-match-id="@match.MatchId" class="team" href="javascript:;">@match.HomeTeamName</a>
                    </td>
                    <td style="width: 14%" class="match-name">
                        @match.AwayTeamName
                    </td>
                    <td style="width: 10%" class="score-value">
                        @RazorHelper.PositiveFormat(match.Total01, true)
                    </td>
                    <td style="width: 10%" class="score-value">
                        @RazorHelper.PositiveFormat(match.Total23, true)
                    </td>
                    <td style="width: 10%" class="score-value">
                        @RazorHelper.PositiveFormat(match.Total46, true)
                    </td>
                    <td style="width: 10%" class="score-value">
                        @RazorHelper.PositiveFormat(match.Total7Over, true)
                    </td>
                    <td style="width: 10%" class="score-value">
                        @RazorHelper.PositiveFormat(match.TotalFirstHalf01, true)
                    </td>
                    <td style="width: 10%" class="score-value">
                        @RazorHelper.PositiveFormat(match.TotalFirstHalf23, true)
                    </td>
                    <td style="width: 10%" class="score-value">
                        @RazorHelper.PositiveFormat(match.Total4Over, true)
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div class="line">
</div>

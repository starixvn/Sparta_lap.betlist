            <div class="title-text">@ViewResources.GrandTotalIn @ViewResources.USD</div>
        </div>
        <div class="row" style="width: @ViewBag.CommonWidth@("px")">
            <div>@grandTotalData.WinTOUSD.ToStringExt()</div>
        </div>
        <div class="row" style="width: @ViewBag.CommonWidth@("px")">
            <div>@grandTotalData.PlaceTOUSD.ToStringExt()</div>
        </div>
        <div class="row" style="width: @ViewBag.CommonWidth@("px")">
            <div>@grandTotalData.WPTOUSD.ToStringExt()</div>
        </div>
        <div class="row" style="width: @ViewBag.CommonWidth@("px")">
            <div>@grandTotalData.TotalTOUSD.ToStringExt()</div>
        </div>
        <div class="row" style="width: @ViewBag.DividendWidth@("px")">
            <div>@grandTotalData.DividendWonUSD.ToStringExt()</div>
        </div>
        @if (Model.IsAllowedCustomerCommission)
        {
            <div class="row" style="width: @ViewBag.CustomerCommWidth@("px")">
                <div>@grandTotalData.CustomerCommissionUSD.ToStringExt()</div>
            </div>
        }
        <div class="row" style="width: @ViewBag.CommonWidth@("px")">
            <div>@grandTotalData.WinTO12BetUSD.ToStringExt()</div>
        </div>
        <div class="row" style="width: @ViewBag.CommonWidth@("px")">
            <div>@grandTotalData.PlaceTO12BetUSD.ToStringExt()</div>
        </div>
        <div class="row" style="width: @ViewBag.CommonWidth@("px")">
            <div>@grandTotalData.WPTO12BetUSD.ToStringExt()</div>
        </div>
        <div class="row" style="width: @ViewBag.CommonWidth@("px")">
            <div>@grandTotalData.TotalTO12BetUSD.ToStringExt()</div>
        </div>
        <div class="row" style="width: @ViewBag.CommonWidth@("px")">
            <div>@grandTotalData.WinLoss12BetUSD.ToStringExt()</div>

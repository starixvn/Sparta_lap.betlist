@{
    Layout = null;
    var appSettings = new AppSettings();
}
@model Fanex.Athena.Model.Report.ViewModel.TurnoverViewModel
<div class="page-form">
    @using (Html.BeginForm("Turnover", "Report", FormMethod.Post, new { @id = "TurnoverForm" }))
    {
        @Html.AntiForgeryToken()
        //-----------------------------Hidden Field-------------------------------//

        @Html.Hidden("IsAllowedCustomerCommission", Model.IsAllowedCustomerCommission)
        @Html.Hidden("IsAllowedCasinoTransfer", Model.IsAllowedCasinoTransfer)
        @Html.Hidden("IsAllowBa", Model.ProductAccess.IsAllowBA)
        <div class="row">
            <div class="input-field input col month-picker">
                <div id="month-picker"></div>
                <input name="FromDate" id="FromDate" type="hidden" data-original-from="@Model.Param.FromDate.ToString("MM/dd/yyyy")" value="@Model.Param.FromDate.ToString("MM/dd/yyyy")" />
                <input name="ToDate" id="ToDate" type="hidden" data-original-to="@Model.Param.ToDate.ToString("MM/dd/yyyy")" value="@Model.Param.ToDate.ToString("MM/dd/yyyy")" />
                <label for="DateRange" class="active">@ViewResources.ViewDataInMonth</label>
            </div>
            <div class="input-field input col">
                <label class="active">@ViewResources.From</label>
                <div id="fDay">
                </div>
            </div>
            <div class="input-field input col">
                <label class="active">@ViewResources.To</label>
                <div id="tDay">
                </div>
            </div>
            @if (Model.LicenseeTypeList.Count > 0)
            {
                <div class="input-field col l2 m3 s12">
                    @RazorHelperDesktop.LicenseeType(Model.LicenseeTypeList, "select", Model.Param.LicenseeType, true)
                    <label>@ViewResources.Type</label>
                </div>
            }
            <div class="input-field col l1 m2 s12">
                @RazorHelperDesktop.CurrencyList(Model.CurrencyList, "currency", Model.Param.CurrencyId, false, true)
                <label>@ViewResources.Currency</label>
            </div>
        </div>
        <div class="row">
            @RazorHelperDesktop.RenderProductFilter(Model.Param.ProductOptions)

            <div class="input-field col l2 m3 s12">
                @Html.TextBox("Username", Model.Param.Username)
                <label>@ViewResources.Username</label>
            </div>
            
            <div class="input-field input col l2 m3 s12">
                <input type="radio" value="true" class="with-gap" @(Model.Param.IsExcludeTest == true ? "checked=checked" : "") name="IsExcludeTest" id="IsExcludeTest0" />
                <label for="IsExcludeTest0">
                    @ViewResources.Yes
                </label>
                <input type="radio" class="with-gap" value="false" @(Model.Param.IsExcludeTest == false ? "checked=checked" : "") name="IsExcludeTest" id="IsExcludeTest1" />
                <label for="IsExcludeTest1">
                    @ViewResources.No
                </label>

                <label class="active">@ViewResources.ExcludeTestData</label>
            </div>

            <div class="col l1 m2 s12 button-block">
                <a id="SubmitButton" class="waves-effect waves-light btn btn-primary">@ViewResources.Submit</a>
            </div>
        </div>
        <div>
            <input type="hidden" id="IsExportExcel" name="IsExportExcel" value="@Model.Param.IsExportExcel" />
            @{
                var beginOfMonth = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
                var minDate = beginOfMonth.AddMonths(-18);
            }
            <input type="hidden" id="MinDate" value="@minDate.ToString("yyyy/M/d")" />
            <input type="hidden" id="MaxDate" value="@appSettings.MaxDate.ToString("yyyy/M/d")" />
        </div>
                }
</div>
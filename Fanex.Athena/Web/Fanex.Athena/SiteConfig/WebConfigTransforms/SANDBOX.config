<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">  
  <system.web>
    <compilation xdt:Transform="Remove" />
    <customErrors mode="RemoteOnly" defaultRedirect="~/Utility/Error" xdt:Transform="Replace">
      <error statusCode="403" redirect="~/Utility/Error?err=403" />
      <error statusCode="404" redirect="~/Utility/Error?err=404" />
    </customErrors>    
  </system.web>  
</configuration>
@{
    Layout = "~/Views/Shared/_BetSettingLayout.cshtml";
}
@model Fanex.Athena.Models.ViewModel.Customer.BetSetting.BetSettingViewModel
@using Fanex.Athena.Models.ViewModel;
@using Fanex.Athena.Models.DataDomain;
@section pagecss
{
}
@section pagejs {
    <script src="@Url.ContentLink("/Scripts/Customer/BetSetting/agcasino.js")" type="text/javascript"></script>
}
@{Html.RenderPartial("~/Views/Customer/BetSetting/Menu.cshtml", Model.Param);}
@{    
    var hasData = Model.AgCasinoViewModel.Games.Count > 0;
}
<div class="content-title" style="width: 855px">
    @Model.Param.BetSettingName @ViewResources.BetSettings - @Model.Param.NickName (@Model.Param.UserName)
</div>
<div style="padding-bottom: 5px">
    @ViewResources.BetSettingGroups:
    @if (Model.AgCasinoViewModel.BetSetting.IsEnabled)
    {
        <select id="betSettingGroup">
            @foreach (var item in Model.AgCasinoViewModel.BetSetting.CheckedGroups)
            {
                <option value="@item" @(item == Model.AgCasinoViewModel.BetSetting.AgGroup ? "selected" : null) >@item</option>
            }
        </select>
    }
    else
    {
        <span>@Model.AgCasinoViewModel.BetSetting.AgGroup</span>
    }
</div>
@Html.Hidden("editable", Model.Param.Editable)
@Html.Hidden("dataCount", Model.AgCasinoViewModel.BetSetting.IsEnabled ? 1: 0)
@Html.Hidden("BettingLimit", new System.Web.Script.Serialization.JavaScriptSerializer().Serialize(Model.AgCasinoViewModel.Games))
<!--Header-->
<div class="header-content" style="width: 884px;">
    <div class="row" style="width: 295px;">@ViewResources.GameType</div>
    <div class="row" style="width: 293px;">
        @ViewResources.MinBet
    </div>
    <div class="row" style="width: 293px;">
        @ViewResources.MaxBet
    </div>
</div>
<!--/Header-->
<!--Content-->
<div class="data-content">
    @if (!hasData)
    {
        <div class="content-row" style="width: 885px!important">
            <div class="no-info">
                <div>@ViewResources.NoInfo</div>
            </div>
        </div>
    }
    else
    {
        foreach (var game in Model.AgCasinoViewModel.Games)
        {
            var group = game.Groups.Where(x => x.GroupType == Model.AgCasinoViewModel.BetSetting.AgGroup).FirstOrDefault();
         <div class="content-row">
            <div class="row text-data first-column" style="width: 295px">
                <div>@game.Name</div>
            </div>
            <div id="min-@(game.GameType)" class="row text-data" style="width: 293px">
                @(group != null ? group.Min.ToString("#,###,##0.##") : "")
            </div>
            <div id="max-@(game.GameType)" class="row text-data" style="width: 293px">
                @(group != null ? group.Max.ToString("#,###,##0.##") : "")
            </div>
        </div>
        }
    }
</div>
<!--/Content-->
<!-- Hidden-->
@Html.Hidden("IDList", String.Join(",", Model.MainData.Select(x => x.SportId)))
<!--/Hidden-->
<!--SubmitButton-->
@if (Model.Param.Editable && hasData)
{
    <div style="width: 855px">
        <input type="button" class="button" data-cust-id="@Model.Param.CustId" data-user-name="@Model.Param.UserName.ToString()" data-nick-name="@Model.Param.NickName" value="@ViewResources.Submit"
        id="btnSubmitBetSetting"/>
        <input type="button" class="button" value="@ViewResources.Reset"
        id="btnReset" />
        <input type="button" class="button" data-status="@(Model.IsEnabled.HasValue && Model.IsEnabled.Value ? 0 : 1)" 
        data-cust-id="@Model.Param.CustId" 
        data-nick-name="@Model.Param.NickName" value="@(Model.IsEnabled.HasValue && Model.IsEnabled.Value ? ViewResources.DisableAgCasino : ViewResources.EnableAgCasino)"
        id="btnUpdateStatus" />
    </div>
}
<!--/SubmitButton-->

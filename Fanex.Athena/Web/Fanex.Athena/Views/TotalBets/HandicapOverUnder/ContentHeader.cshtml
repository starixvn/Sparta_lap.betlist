@using Fanex.Athena.Model.Report.ViewModel
<div class="header-content">
    <table class="report-table">
        <thead>
            <tr class="report-header">
                <td style="width: 3%" rowspan="2">
                    #
                </td>
                <td style="width: 10%" rowspan="2">@ViewResources.Time
                </td>
                <td style="width: 38%" rowspan="2">@ViewResources.Event
                </td>
                <td style="width: 24%" colspan="2">@ViewResources.FullTime
                </td>
                <td style="width: 24%" colspan="2">@ViewResources.lbl1stHalf
                </td>
            </tr>
            <tr class="report-header">
                <td style="width: 12%">@ViewResources.Handicap
                </td>
                <td style="width: 12%">@ViewResources.OverUnder
                </td>
                <td style="width: 12%">@ViewResources.Handicap
                </td>
                <td style="width: 12%">@ViewResources.OverUnder
                </td>
            </tr>
        </thead>
    </table>
</div>

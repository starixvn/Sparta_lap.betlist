@model Fanex.Athena.Models.ViewModel.Report.CasinoProgressiveWinsViewModel
@{
    ViewBag.Title = "LRF - " + ViewResources.Report +
    " - " + ViewResources.CasinoProgressiveWins;
    Layout = "~/Views/Shared/_Report.jqGridLayout.cshtml";
}
@section pagecss {    
    <link href="@Url.ContentLink("/Content/Plugin/Common/bread-crumb.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.ContentLink("/Content/Report/casinoprogressivewins.css")" rel="stylesheet" type="text/css" />
}
@section pagejs {
    <script src="@Url.ContentLink("/Scripts/Report/CasinoProgressiveWins.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Report/CasinoProgressiveWins.option.js")" type="text/javascript"></script>
}
@section ContentTitle
    {
    @ViewResources.CasinoProgressiveWins
}

<div class="container_26" style="margin-left: -7px">
    <div class="grid_26">
        @{
            Html.RenderPartial("~/Views/Report/CasinoProgressiveWins/Content.cshtml");
        }
    </div>
  
</div>
@section ContentFilter
{
    @{Html.RenderPartial("~/Views/Report/CasinoProgressiveWins/Filter.cshtml");}
}


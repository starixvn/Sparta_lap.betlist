@model Fanex.Athena.Models.ViewModel.Report.MatchWinLossViewModel        
@{
    var dataList = Model.MainResult;
    var dataListOutright = Model.SpecialBetTypeResult;

    if (dataList.Count > 0)
    {
        var dataGrandTotal = Model.GrandTotal;
    <tr class="total-first-row total-in-eur">
        <td colspan="2">@ViewResources.GrandTotal
        </td>
        <td style="width: 85px">@NumberHelper.DecFormat(dataGrandTotal.Turnover)
        </td>
        <td style="width: 70px">@dataGrandTotal.TotalTransaction.ToString("#,###")
        </td>
        @if (Model.IsAllowedCustomerCommission)
        {
            <td style="width: 85px">@NumberHelper.DecFormat(dataGrandTotal.CustomerWL)
            </td>
            <td style="width: 60px">@NumberHelper.DecFormat(dataGrandTotal.CustomerComm)
            </td>
            <td style="width: 85px">@NumberHelper.DecFormat(dataGrandTotal.CustomerWL + dataGrandTotal.CustomerComm)
            </td>
        }
        else
        {
            <td style="width: 85px">@NumberHelper.DecFormat(dataGrandTotal.CustomerWL)
            </td>
        }
        <td class="hightlight" style="width: 85px">
            @RazorHelper.NegativeFormat(dataGrandTotal.LicenseeWL)
        </td>
        @if (Model.ProductAccess.IsAllowBA)
        {
            <td class="hightlight" style="width: 60px">
                @RazorHelper.NegativeFormat(dataGrandTotal.BACommission)
            </td>
        }
        @if (Model.ProductAccess.IsAllowRB)
        {
            <td class="hightlight" style="width: 70px">
                @RazorHelper.NegativeFormat(dataGrandTotal.RacingRevenue)
            </td>
        }
        @if (Model.ProductAccess.IsAllowBA)
        {
            <td style="width: 70px">@NumberHelper.DecFormat(@dataGrandTotal.AmtDueToBA)
            </td>
        }
        @if (Model.ProductAccess.IsAllowRB)
        {
            <td style="width: 70px">@NumberHelper.DecFormat(@dataGrandTotal.AmtDueToRacing)
            </td>
        }
    </tr>
    }
}

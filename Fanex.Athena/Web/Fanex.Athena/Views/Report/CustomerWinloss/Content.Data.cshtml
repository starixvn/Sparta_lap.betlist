@{
    Layout = null;
    var maxHeight = 500;
    
}
@using Fanex.Athena.Extension.Helper
@model Fanex.Athena.Models.ViewModel.Report.CustomerWinLossViewModel
@if (Model.DataList == null || Model.DataList.Count == 0)
{
    <!--No result-->
    <div class="content-row" style="width:@ViewBag.ContainerWidth@("px");">
        <div class="row grid-noinfo "style="width:@ViewBag.ContainerWidth@("px");">
            <div>
                @ViewResources.NoInfo
            </div>
        </div>
    </div>
}
else
{
    var rowNumber = 1;
    <div id="data-content" class="data-content" style="width:@(ViewBag.WrapperWidth)px;min-height:0%;max-height:@(maxHeight)px; overflow-x: auto; overflow-y: scroll;">
        @foreach (var item in Model.DataList)
        {
            <div class="content-row" style="width:@ViewBag.ContainerWidth@("px");">
                <div class="row title-text" style="width:@ViewBag.NumberWidth@("px")">
                    @rowNumber
                </div>
                <div class="row text-data" style="width:@ViewBag.TextWidth@("px")">
                    <div>
                        <a class="bet-list-link" title="@item.ExternalId" data-cust-id="@item.CustId" data-system-id="@item.SystemId" data-external-id="@item.ExternalId" href="javascript:;">
                            @RazorHelper.TruncateWithTip(item.ExternalId, 17, true)
                        </a>
                    </div>
                </div>
                <div class="row text-data" title="@item.SystemId" style="width:@ViewBag.TextWidth@("px")">
                    <div>@item.SystemId</div>
                </div>
                <div class="row" style="width:@ViewBag.TurnoverWidth@("px")">
                    <div>@item.Turnover.ToStringExt()</div>
                </div>
                <div class="row" style="width:@ViewBag.TotalTransWidth@("px")">
                    <div>@item.TotalTransaction.ToString("#,##")</div>
                </div>
                @if (Model.IsAllowedCustomerCommission)
                {
                    <div class="row line-height" style="width:@ViewBag.CustomerWLWidth@("px")">
                        <div>@item.MemberWL.ToStringExt()</div>
                    </div>
                    <div class="row line-height" style="width:@ViewBag.CustomerCommWidth@("px")">
                        <div>@item.PlayerComm.ToStringExt()</div>
                    </div>
                    <div class="row line-height" style="width:@ViewBag.CustomerWLTotalWidth@("px")">
                        <div>@((item.PlayerComm + item.MemberWL).ToStringExt())</div>
                    </div>
                }
                else
                {
                    <div class="row line-height" style="width:@ViewBag.CustomerWLLargeWidth@("px")">
                        <div>@item.MemberWL.ToStringExt()</div>
                    </div>
                }
                <div class="row line-height" style="width:@ViewBag.CustomerBetEffecitveWidth@("px")">
                    <div>@item.BetEffective.ToStringExt()</div>
                </div>
                <div class="row highlight" style="width:@ViewBag.LicenseeWLWidth@("px")">
                    @RazorHelper.HighlightNegativeFormat(item.LicenseeWL)
                </div>
                @if (Model.ProductAccess.IsAllowBA)
                {
                    <div class="row highlight" style="width:@ViewBag.RbBaWidth@("px")">
                        @RazorHelper.HighlightNegativeFormat(item.BAComm)
                    </div>                
                }
                @if (Model.ProductAccess.IsAllowRB)
                {
                    <div class="row highlight" style="width:@ViewBag.RbBaWidth@("px")">
                        @RazorHelper.HighlightNegativeFormat(item.RacingRevenue)
                    </div>                
                }
                @if (Model.ProductAccess.IsAllowBA)
                {
                    <div class="row" style="width:@ViewBag.RbBaWidth@("px")">
                        <div>@item.AmtDueToBA.ToStringExt()</div>
                    </div>                
                }
                @if (Model.ProductAccess.IsAllowRB)
                {
                    <div class="row" style="width:@ViewBag.RbBaWidth@("px")">
                        <div>@item.AmtDueToRacing.ToStringExt()</div>
                    </div>                
                }
            </div>
                rowNumber++;
        }
    </div>
}

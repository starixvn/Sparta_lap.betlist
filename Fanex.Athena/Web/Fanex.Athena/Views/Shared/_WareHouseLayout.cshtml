@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section css
{
    <link href="@Url.ContentLink("/Content/Library/start/jquery-ui.min.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.ContentLink("/Content/Global/grid26.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.ContentLink("/Content/Global/lrf.global.content.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.ContentLink("/Content/Global/lrf.global.grid.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.ContentLink("/Content/Plugin/DateRangePicker/daterangepicker.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.ContentLink("/Content/Warehouse/Warehouse.css")" rel="stylesheet" type="text/css" />
    @RenderSection("pagecss", required: false)
}
@section js
{
    <script src="@Url.ContentLink("/Scripts/Plugin/DateRangePicker/date.min.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Plugin/DateRangePicker/daterangepicker.js")" type="text/javascript"></script>
    @RenderSection("pagejs", required: false)
}

<div class="container_26">
    <div class="grid_26">
        <div class="content-title">
            @RenderSection("ContentTitle", required: false)
        </div>
    </div>
    @RenderSection("ContentFilter", required: false)
    <div class="content-main">
        <div class="loading">
        </div>
        <div class="block-body">
        </div>
        @RenderBody()
    </div>
</div>

@{    
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using Fanex.Athena.Extension.Helper;
@section css
{
    <link href="@Url.ContentLink("/Content/Global/grid26.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.ContentLink("/Content/Global/lrf.global.content.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.ContentLink("/Content/Plugin/DateRangePicker/daterangepicker.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.ContentLink("/Content/Plugin/MultiSelect/jquery.multiselect.css")" rel="stylesheet" type="text/css" />

    <link href="@Url.ContentLink("/Content/Library/ui.jqgrid/ui.jqgrid.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.ContentLink("/www/css/source/components/jqgrid/jqgrid.css")" rel="stylesheet" type="text/css" />
    @RenderSection("pagecss", required: false)
}
@section js
{
    @System.Web.Optimization.Scripts.Render("~/bundles/jqGridLayoutScripts")
    @RenderSection("pagejs", required: false)
}
<div class="container_26">
@if (ViewBag.NotificationMessage != null)
{
<div class="grid_26 content-filter new-line notification">
    <div id="notification-marquee" style="color: #C02603">@ViewBag.NotificationMessage</div>   
</div>
}
    <div class="grid_26">
        <div class="content-title">
            @RenderSection("ContentTitle", required: false)
        </div>
    </div>
    @RenderSection("ContentFilter", required: false)
</div>
<div class="content-main">
    <div class="loading">
    </div>
    <div class="block-body">
    </div>
    @RenderBody()
</div>

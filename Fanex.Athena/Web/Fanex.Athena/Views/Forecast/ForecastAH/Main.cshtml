@model Fanex.Athena.Models.ViewModel.Forecast.ForecastAHViewModel
@{
    Layout = Request.IsAjaxRequest() ? null : "~/Views/Shared/_Layout.cshtml";
}
@section css
{
    @Styles.Render("~/bundles/ForeCastAHViewStyles")
}
@section js
{
    @Scripts.Render("~/bundles/ForeCastAHScripts")

    <script type="text/javascript">
        $(window).load(function () {
            Forecast.initialize();
            RefreshCountDown.initEvent();
        });
    </script>
}
<div id="Refresh-Content">
    <div class="container_26">
        @{
                    // -----------------------------Refresh countdown------------------------ //
            <div class="grid_3 timer">
                @RazorHelper.TimerCountDown("forecastah", 15)
            </div>
        }
        @{
            Html.RenderPartial("~/Views/Forecast/ForecastAH/Content.cshtml");
        }
    </div>
</div>
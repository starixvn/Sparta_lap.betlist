@using Fanex.Athena.Models.ViewModel
<div class="header-content">
    <table class="report-table">
        <thead>
            <tr class="report-header">
                <td style="width: 3%" rowspan="2">
                    #
                </td>
                <td style="width: 10%" rowspan="2">@ViewResources.Time
                </td>
                <td style="width: 38%" rowspan="2">@ViewResources.Event
                </td>
                <td style="width: 36%" colspan="3">@ViewResources.FullTime
                </td>
            </tr>
            <tr class="report-header">
                <td style="width: 12%">@ViewResources.HomeNoBet
                </td>
                <td style="width: 12%">@ViewResources.DrawNoBet
                </td>
                <td style="width: 12%">@ViewResources.AwayNoBet
                </td>
            </tr>
        </thead>
    </table>
</div>

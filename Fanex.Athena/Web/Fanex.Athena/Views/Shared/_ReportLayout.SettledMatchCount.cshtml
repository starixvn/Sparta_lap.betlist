@{    
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section css
{
    @System.Web.Optimization.Styles.Render("~/bundles/ReportLayoutSettledMatchCountStyles")
    @RenderSection("pagecss")
}
@section js
{
    @System.Web.Optimization.Scripts.Render("~/bundles/ReportLayoutSettledMatchCountScripts")
    @RenderSection("pagejs")
}
@{
    var userSession = new Fanex.Athena.Service.Core.Users.SessionService().UserSession;
    var isAppModeSelf = userSession == null ? true : userSession.ApplicationMode == Fanex.Athena.Model.Core.DataDomain.AppMode.Self;
}
@RazorHelper.MoveBetNotification()
<div class="container_26">
    <div class="grid_26 @(isAppModeSelf ? string.Empty: "hide")">
        <div class="content-title grid_12" style="min-width:0">
            @RenderSection("ContentTitle")
        </div>
        <div class="grid_2" style="padding-left:65px">
            @RenderSection("UserGuide", required: false)
        </div>
    </div>
    @RenderSection("ContentFilter")
</div>
<div class="content-main">
    <div class="loading">
    </div>
    <div class="block-body">
    </div>
    @RenderBody()
</div>

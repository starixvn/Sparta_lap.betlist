<!DOCTYPE html>
<html>
<head>
    <title>@ViewBag.Title</title>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    @RenderSection("css", required: false)
    <link href="@Url.ContentLink("/Content/Plugin/Note/note.css")" rel="stylesheet" type="text/css" />
    <script src="@Url.ContentLink("/Scripts/Library/jquery.min.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Library/jquery-ui.min.js")" type="text/javascript"></script>    
    <script src="@Url.ContentLink("/Scripts/Library/BigDecimal-all-last.min.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Library/jquery.cookie.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Library/jquery.blockUI.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Library/jquery.autocomplete.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Library/jquery.balloon.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Extension/jquery.extension.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Languages/ViewResources.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Languages/ViewResources.zh-CN.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Languages/ViewResources.zh-TW.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Languages/ViewResources.ko-KR.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Global/site.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Global/query.string.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Plugin/Note/note.js")" type="text/javascript"></script>
    <script type="text/javascript">

        function resolveClientUrl(relativeUrl) {
            return '@Url.Content("~/")' + relativeUrl;
        }

        Site.resolveClientUrl = function (relativeUrl) {
            return '@Url.Content("~/")' + relativeUrl;
        };
        var _page = {
            lang: '@System.Globalization.CultureInfo.CurrentUICulture.IetfLanguageTag'
        };
    </script>
    @RenderSection("js", required: false)
</head>
<body class="@ViewBag.MasterClass">
    @{
        var sessionService = new Fanex.Athena.Service.Implement.Users.SessionService();
        var hasCustComm = sessionService.LicenseeSession != null && sessionService.LicenseeSession.IsAllowedCustomerComm;
    }
    <input type="hidden" id="HasCustComm" value="@( hasCustComm ? 1 : 0)" />
    <input type="hidden" id="HistoryDate" value="@( Fanex.Athena.Extension.Utility.AppSettings.HistoryDate )" />
    @Html.AntiForgeryToken()
    <div id="BodyContent">
        @RenderBody()
    </div>
    <script type="text/javascript">
        $(window).load(function () {
            if (navigator.userAgent.toLowerCase().indexOf('safari') > 0 && navigator.appVersion.indexOf("Mac") != -1) {
                $('#BodyContent').css('overflow-y', 'auto');
                $('#BodyContent').css('max-height', 500);
            };
        });        
    </script>    
</body>
</html>

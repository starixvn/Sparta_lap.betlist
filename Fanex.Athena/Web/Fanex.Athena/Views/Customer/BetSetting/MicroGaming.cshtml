@{
    Layout = "~/Views/Shared/_BetSettingLayout.cshtml";
}
@model Fanex.Athena.Models.ViewModel.Customer.BetSetting.ThirdPartyBetSettingViewModel
@using Fanex.Athena.Models.ViewModel;
@using Fanex.Athena.Models.DataDomain;
@section pagecss
{
}

@{Html.RenderPartial("~/Views/Customer/BetSetting/Menu.cshtml", Model.Param);}

<div class="content-title" style="width: 855px">
    @Model.Param.BetSettingName @ViewResources.BetSettings - @Model.Param.NickName (@Model.Param.UserName)
</div>
<!--Content-->
<div class="data-content">
    @if (!Model.IsLineEnabled)
    {
        <div style="width: 885px!important;width: 885px!important; padding: 20px 0px 20px 0px">
            <div>@ViewResources.MicroGamingNotOfferCurrency</div>
        </div>
    }
</div>
<!--/Content-->
@if (Model.Param.Editable)
{
    <div style="width: 855px">
        @if (Model.IsLineEnabled)
        {
            <div class="filter-input">
                <input id="enable-product" type="checkbox" name="enable-product"
                    @(Model.IsEnabled.HasValue && Model.IsEnabled.Value ? "checked" : "") 
                    class="childCheckbox" />
                <label for="enable-product">@ViewResources.EnableMicrogaming</label>
            </div>
            <div>
                <input type="button" class="button" data-status="@(Model.IsEnabled.HasValue && Model.IsEnabled.Value ? 1 : 0)" 
                data-cust-id="@Model.Param.CustId" 
                data-nick-name="@Model.Param.NickName" value="@ViewResources.Submit"
                id="btnUpdateStatus" />
                <input type="reset" class="button" value="@ViewResources.Reset" />
            </div>
        }
    </div>
}

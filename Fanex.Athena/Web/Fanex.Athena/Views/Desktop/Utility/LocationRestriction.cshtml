@{
    Layout = null;
    Page.Title = "LRF - " + Fanex.Athena.Resources.ViewResources.LocationRestriction;
}
<!DOCTYPE html>
<html>
<head>
    <title>@Page.Title</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0">
    <title>Error!!!!!</title>
    <link href="@Url.ContentLinkByEnv("/www/css/build/pages/utility/error.css")" rel="stylesheet" />
    <style>
        body {
            font-family: Verdana,'sans-serif';
        }

        .center {
            margin: auto;
            width: 50%;
            padding: 10px;
        }
    </style>

    <script>
        var index = window;
        while (index != index.parent) // Jump out
        {
            index = index.parent;
        }

        var currentLocation = index.location.href.toLowerCase();
        var isSigninPage = currentLocation.indexOf("locationrestriction") >= 0 || currentLocation.indexOf("signin") >= 0;

        if (!isSigninPage) {
            index.location.href = location.href;
        }
    </script>
</head>
<body>
    <div class="error-content">
        <img src="@Url.ContentLink("/www/assets/images/location-restriction-guide.png")" />
        <div class="center">
            <div>
                <strong>You're here because of one of those reasons:</strong>
            </div>
            <ul style="list-style-type: decimal;">
                <li>You might have entered this link or similar links that contains "<a href="http://www.amazzu.com"><strong>www.amazzu.com</strong></a>" .</li>
                <li>
                    Your internet connection might be temporally broken.
                </li>
                <li>
                    Your authorization may be no longer valid since web browser's caches are cleared.
                </li>
                <li>
                    Your login credentials are used on other browsers/ devices at the same time.
                </li>
            </ul>
            <div>
                Please try to login again at Internal Admin:
            </div>
            <ul style="list-style-type: decimal;">
                <li>From internal admin, click "<strong>Risk& Forecast</strong>"</li>
                <li>
                    Access the reports/ functions you want.
                </li>
            </ul>
        </div>
    </div>
</body>
</html>
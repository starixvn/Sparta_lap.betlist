@{
    ViewBag.Title = string.Format("LAP - {0}", ViewResources.BetList);
    Layout = "~/Views/Desktop/Shared/_BetListSimpleLayout.cshtml";
}
@using Fanex.Athena.Model.Core.DataDomain

@model Fanex.Athena.Model.BetList.MetaModel.BetListMetaModel
@section pagecss {}
@section pagejs {
}
@{
    var platformText = PlatformType.GetPlatformName(Model.PlatformType);
}
@section ContentTitle
{
    @ViewResources.CustomerBetList @Model.FromDate.ToString("MM/dd/yyyy")
    <span class="header-title-arrow"> → </span>
    @Model.ToDate.ToString("MM/dd/yyyy") - @Model.ExternalId@(Model.IsFakeLicensee ? string.Empty : " (" + Model.SystemId + ")") - @ViewResources.Platform: @platformText -
    <span class="base-currency">
        @{var curencyId = Model.IsConvert ? Model.BaseCurrencyId : Model.CurrencyId;}

        @DesktopRazorHelper.ViewInCurrency(curencyId, Model.CurrencyName)
    </span>
}
@section BackButton
{
}
@{
    <input type="hidden" id="ApiUrl" value="api/PlatformWinLossBetList/Index" />
    <input type="hidden" id="BetListMetaModel" value="@Model.ToJson()" />
    <input type="hidden" id="HiddenColumnList" value="externalid,systemid" />
}
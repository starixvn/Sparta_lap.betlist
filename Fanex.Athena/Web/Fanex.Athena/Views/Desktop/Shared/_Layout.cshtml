@{
    var sessionService = new Fanex.Athena.Service.Core.Users.SessionService();
    var userCurrencies = sessionService.UserSession == null || sessionService.UserSession.CurrencyList == null ?
        new Dictionary<string, string>() :
        sessionService.UserSession.CurrencyList.ToDictionary(x => x.Value.ToString(), x => x.Key);

    var hasCustComm = sessionService.LicenseeSession != null && sessionService.LicenseeSession.IsAllowedCustomerComm;
    var appSettings = new AppSettings();
}
<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0">

    <title>@ViewBag.Title</title>
    <link href="https://fonts.googleapis.com/css?family=Roboto" rel="stylesheet">
    <link href="@Url.ContentLink("/www/css/build/main.css")" rel="stylesheet" />

    @RenderSection("css", required: false)
</head>
<body class="body">
    <input type="hidden" id="RootUrl" value="@Url.Content("~/")" />
    <input type="hidden" id="PageLanguage" value="@System.Globalization.CultureInfo.CurrentUICulture.IetfLanguageTag" />
    <input type="hidden" id="UserCurrencies" value="@(Html.Raw(JsonHelper.ToJson(userCurrencies)))" />
    <input type="hidden" id="HasCustComm" value="@( hasCustComm ? 1 : 0)" />
    <input type="hidden" id="HistoryDate" value="@( appSettings.HistoryDate)" />
    @RenderBody()

    <script src="@Url.ContentLink("/www/js/build/common.chunk.js")"></script>
    <script src="@Url.ContentLink("/www/js/build/language.chunk.js")"></script>
    @RenderSection("js", required: false)
</body>
</html>
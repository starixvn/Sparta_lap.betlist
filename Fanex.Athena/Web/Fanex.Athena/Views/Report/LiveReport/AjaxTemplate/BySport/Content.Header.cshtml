@using Fanex.Athena.Models.ViewModel
@using Fanex.Athena.Extension.Helper
@model Fanex.Athena.Models.ViewModel.Report.LiveReports.LiveReportDetailViewModel
<div class="header-content" style="width:@(ViewBag.ContainerWidth)px;">
    <div class="row" style="width:@(ViewBag.ProductWidth)px">
        @ViewResources.Sport
    </div>
    @SplitingProductHelper.CustomerWLHeader(Model.IsAllowedCustomerCommission,
        (int)ViewBag.CustomerWLLargeWidth, (int)ViewBag.CustomerWLMergeWidth,
                (int)ViewBag.CustomerWLWidth, (int)ViewBag.CustomerCommWidth, 
                (int)ViewBag.CustomerWLTotalWidth)
    <div class="row" style="width:@(ViewBag.TurnoverWidth)px">
        @ViewResources.Turnover
    </div>
    <div class="row" style="width:@(ViewBag.BetCountWidth)px">
        @ViewResources.BetCount
    </div>
    <div class="row" style="width:@(ViewBag.LicenseeWLWidth)px">
        @ViewResources.LicenseeW_L
    </div>
    @if (Model.ProductAccess.IsAllowRb || Model.ProductAccess.IsAllowBa)
    {
        <div class="row" style="width:@(ViewBag.CommWidth)px">
            @ViewResources.Comm
        </div>
    }
    <div class="row " style="width:@(ViewBag.AmountDueWidth)px">
        @ViewResources.AmountDueTo
    </div>
</div>

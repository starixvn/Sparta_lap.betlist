@using Fanex.Athena.Extension.Utility;
@{
    Layout = null;
}
<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0">

    <title>@ViewBag.Title</title>

    <link href="~/www/css/build/vendors/materialize.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css?family=Roboto" rel="stylesheet">
    <link href="~/www/css/build/main.css" rel="stylesheet" />
    <link href="~/www/css/build/pages/layout/layout.css" rel="stylesheet" />
</head>
<body>
    <header>
        <div class="navbar-fixed">
            @{ Html.RenderAction("Index", "Header"); }
        </div>
    </header>

    <ul id="nav-mobile" class="side-nav fixed">
        <li class="logo-block">
            <a id="logo-container" href="#" class="logo left">
                <span class="logo-image"><img src="~/www/assets/images/logo.png" /></span>
                <span class="logo-text"><img src="~/www/assets/images/logo-text.png" /> </span>
            </a>
        </li>
        <li class="site-menu">
            @{ Html.RenderAction("Index", "Menu"); }
        </li>
    </ul>    

    <main class="main">
        <!--Place your content at here -->
        <iframe id="mainFrame" name="main" src="@(Util.RootPath + ViewBag.DefaultReportUrl)" frameborder="0" scrolling="auto" width="100%" height="100%"></iframe>
    </main>

    <script src="~/www/js/build/vendors.chunk.js"></script>
    <script src="~/www/js/build/pages/layout/layout.chunk.js"></script>
</body>
</html>
@{
    ViewBag.Title = "LRF - " + ViewResources.Balance;
    Layout = "~/Views/Shared/_ReportLayout.cshtml";
}
@model Fanex.Athena.Model.Report.ViewModel.BalanceViewModel
@section pagecss 
{
    <link href="@Url.ContentLink("/Content/Report/balance.css")" rel="stylesheet" type="text/css" />
}
@section pagejs 
{
    <script src="@Url.ContentLink("/Scripts/Report/Balance.js")" type="text/javascript"></script>
}
@{
    ViewBag.ColumnCount = 2;

    ViewBag.ColumnCount += Model.ProductAccess.IsAllowBT ? 2 : 0;
    ViewBag.ColumnCount += Model.ProductAccess.IsAllowBA ? 2 : 0;
    ViewBag.ColumnCount += Model.ProductAccess.IsAllowRB ? 2 : 0;
    ViewBag.ColumnCount += Model.IsAllowedCustomerCommission ? 1 : 0;

    ViewBag.ColumnWidth = 115;
    
    ViewBag.FirstColumnWidth = ViewBag.ColumnCount == 9 ? 140 : (9 - ViewBag.ColumnCount) * 130;

    ViewBag.ContainerWidth = ViewBag.FirstColumnWidth + ViewBag.ColumnWidth;
    ViewBag.ContainerWidth += ViewBag.ColumnWidth * (Model.ProductAccess.IsAllowBT ? 2 : 0);
    ViewBag.ContainerWidth += ViewBag.ColumnWidth * (Model.ProductAccess.IsAllowBA ? 2 : 0);
    ViewBag.ContainerWidth += ViewBag.ColumnWidth * (Model.ProductAccess.IsAllowRB ? 2 : 0);
    ViewBag.ContainerWidth += ViewBag.ColumnWidth * (Model.IsAllowedCustomerCommission ? 1 : 0);
    ViewBag.ContainerWidth += ViewBag.ColumnCount;
    if (ViewBag.ContainerWidth < 700) { ViewBag.ContainerWidth = 700; }
    ViewBag.FilterWidth = ViewBag.ContainerWidth > 1075 ? 1075 : ViewBag.ContainerWidth;
}
@section ContentTitle
{
    @ViewResources.Balance
}
@section ContentFilter
{
    @{        
        Html.RenderPartial("~/Views/Report/Balance/Filter.cshtml");
    }
}
@{
    Html.RenderPartial("~/Views/Report/Balance/Content.cshtml");                
}

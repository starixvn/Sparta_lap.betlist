    @ViewResources.PlatformWinLoss
}
@section ContentFilter
{
    @{        
        Html.RenderPartial("~/Views/Report/PlatformWinLoss/Filter.cshtml");
    }
}
@{
    
    Html.RenderPartial("~/Views/Report/PlatformWinLoss/Content.cshtml");
}

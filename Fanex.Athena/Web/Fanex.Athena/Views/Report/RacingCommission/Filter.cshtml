@using Fanex.Athena.Models.ViewModel;
@model Fanex.Athena.Models.ViewModel.Report.RacingCommissionViewModel
<div class="grid_26 content-filter new-line" style="width:@(ViewBag.FilterWidth)px;">
    @using (Html.BeginForm("RacingCommission", "Report", FormMethod.Post, new { @id = "ReportForm" }))
    {
        //-----------------------------Hidden Field-------------------------------//

        <div>
            @Html.Hidden("IsExportExcel", Model.Param.IsExportExcel)
            @Html.Hidden("BalanceUpDay", Model.Param.BalanceUpDay)
            @Html.Hidden("SortDirection", Model.Param.SortDirection)
            @Html.Hidden("SortColumn", Model.Param.SortColumn)
            @Html.Hidden("RowCount", Model.RacingCommissionList == null ? 0 : Model.RacingCommissionList.Count)
        </div>

        //-----------------------------Type of licensee---------------------------//
        @DatePickerHelper.RenderDateRangePicker(Model.Param.FromDate, Model.Param.ToDate, Model.Param.BalanceUpDay, DateTime.Today, "date-range", "date-range", 2, 3, 2, 3, true)
        <div class="new-line">
        </div>
        if (Model.Param.LicenseeId == 1)
        {
            // Type
        <div class="grid_2 filter-label">
            <label>@ViewResources.Type</label>
        </div>
        <div class="grid_3 filter-input">
            @RazorHelper.LicenseeType(Model.LicenseeTypeList, "licenseetype", Model.Param.LicenseeType)
        </div>
        }

        // Currency
        <div class="grid_2 filter-label">
            <label>@ViewResources.Currency</label>
        </div>
        <div class="grid_3 filter-input">
            @RazorHelper.CurrencyList(Model.CurrencyList, "currencyid", Model.Param.CurrencyId, true, false)
        </div>

        // Convert
        <div class="grid_2 filter-label">
            <label for="BaseCurrency">@ViewResources.Based </label>
        </div>
        <div class="grid_1 filter-input">
            @RazorHelper.BasedCurrency(Model.Param.BaseCurrency)
        </div>
        // Export excel
        <div class="grid_2 note-group">
            <div>
                @{Html.RenderAction("Index", "Note", new { viewName = "RacingCommission" });}
            </div>
            <div>
                <input alt="@ViewResources.ExportToExcel" src="@Url.ContentLink("/Content/Global/Images/excel.gif")"
               type="image" id="ExportToExcel" name="exporttoexcel"
               title="@ViewResources.ExportToExcel" class="hand" />
            </div>
        </div>

        // Button submit
        <div class="grid_2 filter-label new-line">
            &nbsp;</div>
        <div class="grid_2 filter-input">
            <input type="button" id="SubmitButton" value="@ViewResources.Submit" class="button" />
        </div>
    }
</div>

@using Fanex.Athena.Extension.Utility;
@{
    Layout = null;
}
<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0">

    <title>@ViewBag.Title</title>

    <link href="~/www/css/test/vendors/materialize.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css?family=Roboto" rel="stylesheet">
    <link href="~/www/css/test/main.css" rel="stylesheet" />
    <link href="~/www/css/test/pages/layout/layout.css" rel="stylesheet" />
</head>
<body class="site-menubar-unfold">
    @{ Html.RenderAction("Index", "Header"); }

    @{ Html.RenderAction("Index", "Menu"); }

    <div class="page">
        <iframe src="@(Util.RootPath + ViewBag.DefaultReportUrl)" id="main" name="main" scrolling="auto"
                width="100%" height="100%" frameborder="0"></iframe>
    </div>
    <script src="~/www/js/test/vendors.chunk.js"></script>
    <script src="~/www/js/test/pages/layout/layout.chunk.js"></script>
</body>
</html>
@using Fanex.Athena.Models.ViewModel
@using Fanex.Athena.Models.Cache
@model Fanex.Athena.Models.ViewModel.Report.MatchWinLossViewModel
@{
    var dataTotal = Model.Total;

    if (Model.MainResult.Count > 0)
    {
    <tr class="total-rows total-first-row total-in-eur">
        <td colspan="2">@ViewResources.Total
        </td>
        <td style="width: 85px">@NumberHelper.DecFormat(@dataTotal.Turnover, 2)
        </td>
        <td style="width: 70px">@dataTotal.TotalTransaction.ToString("#,###")
        </td>
        @if (Model.IsAllowedCustomerCommission)
        {
            <td style="width: 85px">@NumberHelper.DecFormat(@dataTotal.CustomerWl, 2)
            </td>
            <td style="width: 60px">@NumberHelper.DecFormat(@dataTotal.CustomerComm, 2)
            </td>
            <td style="width: 85px">@NumberHelper.DecFormat(@dataTotal.CustomerWl + @dataTotal.CustomerComm, 2)
            </td>
        }
        else
        {
            <td style="width: 85px">@NumberHelper.DecFormat(@dataTotal.CustomerWl, 2)
            </td>
        }
        <td class="highlight" style="width: 85px">
            @RazorHelper.HighlightNegativeNumber(dataTotal.LicenseeWl)
        </td>
        @{
        if (Model.ProductAccess.IsAllowBa)
        {
            <td class="highlight" style="width: 60px">
                @RazorHelper.HighlightNegativeNumber(dataTotal.BaCommission)
            </td>
        }
        }
        @if (Model.ProductAccess.IsAllowRb)
        {
            <td class="highlight" style="width: 70px">
                @RazorHelper.HighlightNegativeNumber(dataTotal.RacingRevenue)
            </td>
        }
        @if (Model.ProductAccess.IsAllowBa)
        {
            <td style="width: 70px">@NumberHelper.DecFormat(@dataTotal.AmtDueToBa, 2)
            </td>
        }
        @if (Model.ProductAccess.IsAllowRb)
        {
            <td style="width: 70px">@NumberHelper.DecFormat(@dataTotal.AmtDueToRacing, 2)
            </td>
        }
    </tr>
    }

    var dataListOutright = Model.SpecialBetTypeResult;
    // Display information for outright and mixparlay
    foreach (var itemOutRight in dataListOutright)
    {
    <tr>
        <td colspan="2" class="title-text">
            <span class="downline-link outright-link" onclick="MatchWinLoss.viewOutrightMixParlay(@itemOutRight.BetType)">@CacheRef.GetBettype(@itemOutRight.BetType)</span>
        </td>
        <td>@NumberHelper.DecFormat(itemOutRight.Turnover, 2)
        </td>
        <td>@itemOutRight.TotalTransaction.ToString("#,###")
        </td>
        @if (Model.IsAllowedCustomerCommission)
        {
            <td>@NumberHelper.DecFormat(itemOutRight.CustomerWl, 2)
            </td>
            <td>@NumberHelper.DecFormat(itemOutRight.CustomerComm, 2)
            </td>
            <td>@NumberHelper.DecFormat(itemOutRight.CustomerWl + itemOutRight.CustomerComm, 2)
            </td>
        }
        else
        {
            <td>@NumberHelper.DecFormat(itemOutRight.CustomerWl, 2)
            </td>
        }
        <td class="highlight">
            @RazorHelper.HighlightNegativeNumber(@itemOutRight.LicenseeWl)
        </td>
        @if (Model.ProductAccess.IsAllowBa)
        {
            <td class="highlight">
                @RazorHelper.HighlightNegativeNumber(itemOutRight.BaCommission)
            </td>
        }
        @if (Model.ProductAccess.IsAllowRb)
        {
            <td class="highlight">
                @RazorHelper.HighlightNegativeNumber(itemOutRight.RacingRevenue)
            </td>
        }
        @if (Model.ProductAccess.IsAllowBa)
        {
            <td>@NumberHelper.DecFormat(@itemOutRight.AmtDueToBa, 2)
            </td>
        }
        @if (Model.ProductAccess.IsAllowRb)
        {
            <td>@NumberHelper.DecFormat(@itemOutRight.AmtDueToRacing, 2)
            </td>
        }
    </tr>
    }
}

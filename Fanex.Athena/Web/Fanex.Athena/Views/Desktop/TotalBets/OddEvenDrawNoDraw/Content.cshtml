@model Fanex.Athena.Model.TotalBet.ViewModel.OddEvenDrawNoDrawViewModel

@helper RenderFirstRow()
{
    <tr class="first-row">
        <td class="col-small"></td>
        <td class="col-medium small"></td>
        <td class="col-large small"></td>
        <td class="col-child"></td>
        <td class="col-child"></td>
        <td class="col-child"></td>
        <td class="col-child"></td>
        <td class="col-child"></td>
    </tr>
}

@if (Model.MainData.Count == 0)
{
    <p class="no-info-row">@ViewResources.NoInfo</p>
}
else
{
    <div class="header-content">
        <table class="table">
            <thead>
                @RenderFirstRow()

                <tr>
                    <th rowspan="2">#</th>
                    <th rowspan="2">@ViewResources.Time</th>
                    <th rowspan="2">@ViewResources.Event</th>
                    <th colspan="3">@ViewResources.FullTime</th>
                    <th colspan="2" class="col-last">@ViewResources.lbl1stHalf</th>
                </tr>
                <tr>
                    <th>@ViewResources.OddEven</th>
                    <th>@ViewResources.OneXTwo</th>
                    <th>@ViewResources.DrawNoDraw</th>

                    <th>@ViewResources.OddEven</th>
                    <th>@ViewResources.OneXTwo</th>
                </tr>
            </thead>
        </table>
    </div>

    <div class="body-content">
        <table class="table">
            <tbody>
                @RenderFirstRow()
                @{ Html.RenderPartial("~/Views/Desktop/TotalBets/OddEvenDrawNoDraw/ContentData.cshtml"); }
            </tbody>
        </table>
    </div>

    <div class="footer-content">
        <table class="table">
            <tbody>
                @RenderFirstRow()

                <tr class="total total-footer">
                    <td class="right-align total-label" colspan="3">
                        @ViewResources.Total
                    </td>
                    <td class="right-align no-margin">
                        @RazorHelperDesktop.DecFormat(Model.TotalData.OddEvenFt, true, false)
                    </td>
                    <td class="right-align">
                        @RazorHelperDesktop.DecFormat(Model.TotalData.OneXTwoFt)
                    </td>
                    <td class="right-align no-margin">
                        @RazorHelperDesktop.DecFormat(Model.TotalData.DrawNoDraw, true, false)
                    </td>
                    <td class="right-align no-margin">
                        @RazorHelperDesktop.DecFormat(Model.TotalData.OddEvenFirstHalf, true, false)
                    </td>
                    <td class="right-align">
                        @RazorHelperDesktop.DecFormat(Model.TotalData.OneXTwoFirstHalf)
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
                    }
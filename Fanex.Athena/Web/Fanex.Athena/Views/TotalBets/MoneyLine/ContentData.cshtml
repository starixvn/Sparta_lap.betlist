@using System.Linq
@model Fanex.Athena.Models.ViewModel.TotalBets.MoneyLineViewModel
@{
    var leagueList = Model.MainData.GroupBy(x => new { x.LeagueId, x.LeagueName })
                           .Select(x => x.Key)
                           .OrderBy(x => x.LeagueName)
                           .Distinct()
                           .ToList();
    var index = 1;
}
<div class="data-content">
    <table class="report-table">
        <tbody>
            @foreach (var league in leagueList)
            {
                // Render League name
                <tr>
                    <td class="league" colspan="11">@league.LeagueName
                    </td>
                </tr>
                var matchOfLeague = Model.MainData.Where(x => x.LeagueId == league.LeagueId)
                                    .OrderBy(x => x.HomeTeamName)
                                    .ToList();

                // Render Match League
                foreach (var match in matchOfLeague)
                { 
                <tr class="@(match.LiveIndicator == 1 ? "live" : string.Empty)">
                    <td style="width: 3%" class="order-number">@(index++)
                    </td>
                    <td style="width: 10%">
                        @if (match.LiveIndicator == 1)
                        {
                            <div class="show-time">
                                <span>@match.LiveHomeScore - @match.LiveAwayScore</span>
                                <br />
                                <i class="live-notice">@ViewResources.Live!</i>
                            </div>
                        }
                        else
                        {
                            <div class="show-time">
                                @Html.Raw(match.ShowTime)
                            </div>
                        }
                    </td>
                    <td style="width: 26%" class="match-name">
                        @match.HomeTeamName -vs- @match.AwayTeamName
                    </td>
                    <!--Render Fulltime Money Line-->
                    <td style="width: 7%" class="score-value">
                        <a class="forcast-number" data-match-id="@match.MatchId" data-bet-type="20" href="javascript:;">
                            @RazorHelper.DecFormat(match.TotalHomeFt, false)
                        </a>
                    </td>
                    <td style="width: 7%" class="score-value">
                        <a class="forcast-number" data-match-id="@match.MatchId" data-bet-type="20" href="javascript:;">
                            @RazorHelper.DecFormat(match.TotalAwayFt, false)
                        </a>
                    </td>
                    <td style="width: 8%" class="score-value">
                        <a class="forcast-number" data-match-id="@match.MatchId" data-bet-type="20" href="javascript:;">
                            @RazorHelper.PositiveFormat(match.ForecastHomeFt, false)
                        </a>
                    </td>
                    <td style="width: 8%" class="score-value">
                        <a class="forcast-number" data-match-id="@match.MatchId" data-bet-type="20" href="javascript:;">
                            @RazorHelper.PositiveFormat(match.ForecastAwayFt, false)
                        </a>
                    </td>
                    <!--Render 1st Half Money Line-->
                    <td style="width: 7%" class="score-value">
                        <a class="forcast-number" data-match-id="@match.MatchId" data-bet-type="21" href="javascript:;">
                            @RazorHelper.DecFormat(match.TotalHomeFirstHalf, false)
                        </a>
                    </td>
                    <td style="width: 7%" class="score-value">
                        <a class="forcast-number" data-match-id="@match.MatchId" data-bet-type="21" href="javascript:;">
                            @RazorHelper.PositiveFormat(match.TotalAwayFirstHalf, false)
                        </a>
                    </td>
                    <td style="width: 8%" class="score-value">
                        <a class="forcast-number" data-match-id="@match.MatchId" data-bet-type="21" href="javascript:;">
                            @RazorHelper.DecFormat(match.ForecastHomeFirstHalf, false)
                        </a>
                    </td>
                    <td style="width: 8%" class="score-value">
                        <a class="forcast-number" data-match-id="@match.MatchId" data-bet-type="21" href="javascript:;">
                            @RazorHelper.PositiveFormat(match.ForecastAwayFirstHalf, false)
                        </a>
                    </td>
                </tr>
                }
            }
        </tbody>
    </table>
</div>
<div class="line">
</div>
@*Footer*@
<div class="footer-content">
    <table class="report-table">
        <thead>
            <tr class="total-footer">
                <td style="width: 3%">
                </td>
                <td style="width: 10%">
                </td>
                <td style="width: 26%;" class="score-value">
                    @ViewResources.Total
                </td>                
                <td style="width: 14%" class="score-value">
                    @RazorHelper.DecFormat(Model.TotalData.TotalHomeFt + Model.TotalData.TotalAwayFt)
                </td>
                <td style="width: 8%" class="score-value">
                </td>
                <td style="width: 8%" class="score-value">
                </td>                
                <td style="width: 14%" class="score-value">
                    @RazorHelper.DecFormat(Model.TotalData.TotalHomeFirstHalf + Model.TotalData.TotalAwayFirstHalf)
                </td>
                <td style="width: 8%" class="score-value">
                </td>
                <td style="width: 8%" class="score-value">
                </td>
            </tr>
        </thead>
    </table>
</div>
@*/Footer*@ 
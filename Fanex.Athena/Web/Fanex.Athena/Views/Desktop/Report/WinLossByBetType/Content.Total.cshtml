@model Fanex.Athena.Model.Report.ViewModel.WinLossByBetTypeViewModel

<tr class="total">
    <td colspan="2" class="center-align text-bold">@ViewResources.Total</td>
    <td class="right-align text-bold">@Model.Total.Turnover.ToStringExt()</td>

    @DesktopReportRazorHelper.RenderCustomerWinLossData(Model.Total as Fanex.Athena.Model.Report.DTO.ICustomerWinLoss,
                                                            Model.IsAllowedCustomerCommission, false, "text-bold")

    <td class="right-align text-bold">@DesktopRazorHelper.HighlightNegativeFormat(Model.Total.LicenseeWL)</td>

    @if (Model.ProductAccess.IsAllowBA)
    {
        <td class="right-align text-bold">@DesktopRazorHelper.HighlightNegativeFormat(Model.Total.BACommission)</td>
    }
    @if (Model.ProductAccess.IsAllowRB)
    {
        <td class="right-align text-bold">@DesktopRazorHelper.HighlightNegativeFormat(Model.Total.RacingWinLoss)</td>
    }
    @if (Model.ProductAccess.IsAllowBA)
    {
        <td class="right-align text-bold">@Model.Total.AmtDueToBA.ToStringExt()</td>
    }
    @if (Model.ProductAccess.IsAllowRB)
    {
        <td class="right-align text-bold">@Model.Total.AmtDueToRacing.ToStringExt()</td>
    }
</tr>
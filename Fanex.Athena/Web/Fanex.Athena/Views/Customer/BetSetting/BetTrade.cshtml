@{
    Layout = "~/Views/Shared/_BetSettingLayout.cshtml";
}
@model Fanex.Athena.Models.ViewModel.BetSettings.ThirdPartyBetSettingViewModel
@using Fanex.Athena.Models.ViewModel;
@using Fanex.Athena.Model.Core.DataDomain;
@section pagecss
{
}
@{Html.RenderPartial("~/Views/Customer/BetSetting/Menu.cshtml", Model);}
<div class="content-title" style="width: 855px">
    @Model.Param.BetSettingName @ViewResources.BetSettings - @Model.Param.NickName (@Model.Param.UserName)
</div>
<!--Content-->
<div class="data-content">
    @if (!Model.IsLineEnabled)
    {
        <div style="width: 885px!important; width: 885px!important; padding: 20px 0px 20px 0px">
            <div>@ViewResources.BetTradeNotOfferCurrency</div>
        </div>
    }
</div>
<!--/Content-->
<div style="width: 855px">
    @if (Model.IsLineEnabled)
    {
        var status = Model.IsEnabled.HasValue && Model.IsEnabled.Value ? 1 : 0;
        <div class="filter-input">
            <input id="enable-product" type="checkbox" name="enable-product"
                    @(Model.IsEnabled.HasValue && Model.IsEnabled.Value ? "checked" : "")
                    class="childCheckbox" data-original="@status" @(Model.Editable ? "" : "disabled") />
            <label for="enable-product">@ViewResources.EnableBetTrade</label>
        </div>
        if (Model.Editable)
        {
        <div>
            <input type="button" class="button" data-status="@status"
                data-cust-id="@Model.Param.CustId"
                data-nick-name="@Model.Param.NickName" value="@ViewResources.Submit"
                id="btnUpdateStatus" />
            <input id="btnReset" type="reset" class="button" value="@ViewResources.Reset" />
        </div>
        }
    }
</div>

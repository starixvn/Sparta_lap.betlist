@using Fanex.Athena.Models.ViewModel
@using Fanex.Athena.Model.Warehouse.MetaModel
@model Fanex.Athena.Model.Warehouse.ViewModel.WinLossViewModel
@{
    
    var groupingList = GroupingMetaModel.GetCollection();
    var param = Model.Param;    
}
<div class="container_26">
    <div class="grid_26">
        <div class="report-title" style="width:@(ViewBag.TitleWidth)px;">
            @ViewResources.ReportBy
            @groupingList[param.ReportBy.ToString()]&nbsp;
            @ViewResources.From &nbsp;
            @param.FromDate.ToString("MM/dd/yyyy")&nbsp; &rarr; &nbsp;
            @param.ToDate.ToString("MM/dd/yyyy")
            - @RazorHelper.ViewCurrencyBasedOnConverter(Model.Param.IsConvert, Model.Param.BaseCurrency, Model.Param.CurrencyName)
        </div>
        <div class="report-content " style="width:@(ViewBag.WrapperWidth)px;">
            @{
                Html.RenderPartial("~/Views/WareHouse/WinLoss/Content.Header.cshtml");
            }
            <!--Grid.Content-->
            @if (Model.MainResult.Count == 0)
            {
                <div class="content-row" style="width:@(ViewBag.ContainerWidth)px;">
                    <div class="row grid-noinfo" style="width:@(ViewBag.ContainerWidth)px;">
                        <div>
                            @ViewResources.NoInfo
                        </div>
                    </div>
                </div>
            }
            else
            {
                Html.RenderPartial("~/Views/WareHouse/WinLoss/Content.Data.cshtml");
            }
            <!--Grid.Content-->
        </div>
    </div>
</div>

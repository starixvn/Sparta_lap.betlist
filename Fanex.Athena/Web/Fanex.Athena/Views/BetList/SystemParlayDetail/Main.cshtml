@{
    Layout = null;
}
@using Fanex.Athena.Model.BetList.ViewModel

@model SystemParlayDetailViewModel
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <title>@string.Format("LRF - {0}", ViewResources.SystemParlay)</title>
    <link href="@Url.ContentLink("/Content/Global/lrf.global.content.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.ContentLink("/Content/BetList/systemparlaydetail.css")" rel="stylesheet" type="text/css" />
</head>
<body>
    <div class="content-data">
        @Html.Raw(Model.DetailText)
    </div>

    <div class="note-block">
        <p class="note-content"><span class="asterisk">* </span><span class="note-title">@ViewResources.Note</span></p>
        <p class="text-content">@ViewResources.SystemParlayDetailNote</p>
    </div>
</body>
</html>

@{
    Layout = null;
    // Game type: Western Zodiac
}
<link href="@Url.ContentLink("/Content/RNGCasino/rng-casino-hand-history.css")" rel="stylesheet" type="text/css" />
@model Fanex.Athena.Models.ViewModel.Casino.RNGResultDetail.CasinoHandHistoryDetailViewModel
@{
    var headerItem = Model.CasinoDetailHeaderList.Where(x => x.ShowType.Trim() == "BasicInfo").FirstOrDefault();
    var hitItemList = Model.CasinoDetailHeaderList.Where(x => x.ShowType.Trim() == "Result_HitBetLine");
    var totalItem = Model.CasinoDetailHeaderList.Where(x => x.ShowType.Trim() == "Add_TotalLineWin").FirstOrDefault();
}
<table style="width: 100%;" class="casino-detail-table" cellpading="0" cellspacing="0">
    <tr class="detail-header-row">
        <td class="game-type-text" colspan="6">@Model.Param.GameTypeName - @headerItem.BetTime
        </td>
    </tr>
    <tr class="player-total-row">
        <td colspan="6">
            @ViewResources.Player: @headerItem.UserName - @string.Format(ViewResources.Viewin,Model.Param.CurrencyName)
        </td>
    </tr>
    <tr class="detail-header-row">
        <td colspan="6">@headerItem.ResultName
        </td>
    </tr>
    <tr>
        <td colspan="6">
            @if (!string.IsNullOrEmpty(headerItem.Result))
            {
                @Html.Raw(headerItem.Result.Replace("/Form", Url.Content("~/") + "Form"))
            }
        </td>
    </tr>
    <tr>
        <td>@ViewResources.PlayerHistoryNo
        </td>
        <td class="align-left" colspan="5">@Model.Param.PlayerHistoryNo
        </td>
    </tr>
    <tr>
        <td>@ViewResources.Mode
        </td>
        <td class="align-left" colspan="5">@headerItem.ModeResult
        </td>
    </tr>
    <tr>
        <td>@ViewResources.AutoSpin
        </td>
        <td class="align-left" colspan="5">@headerItem.AutoSpinResult
        </td>
    </tr>
    <tr>
        <td>@ViewResources.FreeSpin
        </td>
        <td class="align-left" colspan="5">@headerItem.FreeSpinResult
        </td>
    </tr>
    @if (hitItemList.Count() > 0)
    {
        <tr class="detail-header-row">
            <td>@ViewResources.LineNo
            </td>
            <td>@ViewResources.Symbol
            </td>
            <td>@ViewResources.CoinSize
            </td>
            <td>@ViewResources.BetPerLine
            </td>
            <td>@ViewResources.Odds
            </td>
            <td>@ViewResources.Win/@ViewResources.Loss
            </td>
        </tr>
        foreach (var item in hitItemList)
        {
        <tr>
            <td>
                @Html.Raw(item.LineNo.Replace("/img", Url.Content("~/") + "img"))
            </td>
            <td>
                @Html.Raw(item.Symbol.Replace("/img", Url.Content("~/") + "img"))
            </td>
            <td>@item.CoinSize.ToStringExt()
            </td>
            <td>@item.BetPerLine
            </td>
            <td>@item.Odds
            </td>
            <td>@item.WinBaseCurrencyValue.ToStringExt()
            </td>
        </tr>  
        }        
    }
    <tr class="player-total-row">
        <td class="align-left">@ViewResources.Bet
        </td>
        <td colspan="5" class="align-right">@Model.CasinoDetailList.Sum(p => p.Bet).ToStringExt()
        </td>
    </tr>
    <tr class="player-total-row">
        <td class="align-left">@ViewResources.Win/@ViewResources.Loss
        </td>
        <td colspan="5" class="align-right">@Model.CasinoDetailList.Sum(p => p.WinLoss).ToStringExt()
        </td>
    </tr>
</table>

@model Fanex.Athena.Models.ViewModel.Report.AgCasinoBalanceViewModel
@{
    ViewBag.Title = "LRF - " + ViewResources.Report +
    " - " + ViewResources.AGCasinoBalance;
    Layout = "~/Views/Shared/_Report.jqGridLayout.cshtml";
}
@section pagecss {
    @Styles.Render("~/bundles/AgCasinoBalanceStyles")
}
@section pagejs {
    @Scripts.Render("~/bundles/AgCasinoBalanceScripts")
}
@section ContentTitle
    {
    @ViewResources.AGCasinoBalance
}
<div class="container_26" style="margin-left: -7px">
    <div class="grid_26">
        @{
          Html.RenderPartial("~/Views/Report/AgCasinoBalance/Content.cshtml");
        }
    </div>
</div>
@section ContentFilter
{
    @{Html.RenderPartial("~/Views/Report/AgCasinoBalance/Filter.cshtml");}
}

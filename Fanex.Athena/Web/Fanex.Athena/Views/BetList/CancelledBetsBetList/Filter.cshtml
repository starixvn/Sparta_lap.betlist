@using Fanex.Athena.Models.ViewModel
@using Fanex.Athena.Models.MetaModel.Product
@model Fanex.Athena.Models.ViewModel.BetList.CancelledBetsBetListViewModel
@using (Html.BeginForm("CancelledBetsBetList", "BetList", FormMethod.Post, new { @id = "CancellerBetsBetListForm" }))
{

    //-----------------------------Type of licensee---------------------------//
    if (Model.LicenseeTypeList.Count > 0)
    {
    <div class="grid_2 filter-label">
        <label>@ViewResources.Type</label>
    </div>
    <div class="grid_3 filter-input">
        @RazorHelper.LicenseeType(Model.LicenseeTypeList, "", Model.Param.LicenseeType, true)
    </div>
    }

    //-----------------------------Currency-----------------------------------//
    <div class="grid_2 filter-label">
        <label>@ViewResources.Currency</label>
    </div>
    <div class="grid_3 filter-input">
        @RazorHelper.CurrencyList(Model.CurrencyList, "", Model.Param.CurrencyId, true, false)
    </div>
    <div class="grid_2 filter-label">
        <label for="BaseCurrency">@ViewResources.Based</label>
    </div>
    <div class="grid_2 filter-input">
        @RazorHelper.BasedCurrency(Model.Param.BaseCurrency)
    </div>
    if (Model.CustomerList.Any())
    {
    <div class="grid_2 filter-label">
        <label for="BaseCurrency">@ViewResources.ExternalId</label>
    </div>
    <div class="grid_4 filter-input">
        @{
            var custList = Model.CustomerList.Select(c=> new SelectListItem
            {
                Value = c.CustId.ToString(),
                Text = string.Format("{0} ({1} {2})",c.NickName, c.BetCount, c.BetCount<=1? "bet" :"bets"),
                Selected = c.CustId == Model.Param.CustId,
            });
            @Html.DropDownList("CustId", custList, new { @id="CustId" })
        }
    </div>
    }
    <div class="grid_2 note-group">
        <div>
            @{Html.RenderAction("Index", "Note", new { viewName = "CancelledBetList" });}
        </div>
        <div>
            <input alt="@ViewResources.ExportToExcel" src="@Url.ContentLink("/Content/Global/Images/excel.gif")"
               type="image" id="ExportToExcel" name="exporttoexcel"
               title="@ViewResources.ExportToExcel" class="hand" />
        </div>
    </div>
    <div class="grid_2 filter-input">
        <input type="submit" id="SubmitButton" value="@ViewResources.Submit" class="button" />
    </div>
    <input type="hidden" name="LicenseeId" id="LicenseeId" value="@Model.Param.LicenseeId"/>
    <input type="hidden" name="IsExportExcel" id="IsExportExcel" value="@Model.Param.IsExportExcel"/>
}

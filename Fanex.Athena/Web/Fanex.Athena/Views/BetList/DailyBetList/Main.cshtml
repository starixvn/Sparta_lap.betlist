@{
    var formatTitle = "{0} {1} {2} - {3}";
    ViewBag.Title = string.Format(formatTitle, "LRF", HttpUtility.HtmlDecode("&bull;"), ViewResources.Report, ViewResources.DailyBetList);
    Layout = "~/Views/Shared/_BetListLayout.cshtml";
}
@using Fanex.Athena.Models.ViewModel
@model Fanex.Athena.Models.ViewModel.BetList.BetListBaseViewModel
@section pagecss {
    <link href="@Url.ContentLink("/Content/FlatPopup/jquery.custom-scrollbar.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.ContentLink("/Content/FlatPopup/jquery.flatpopup.css")" rel="stylesheet" type="text/css" />
}
@section pagejs {
    <script src="@Url.ContentLink("/Scripts/Plugin/FlatPopup/jquery.custom-scrollbar.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Plugin/FlatPopup/jquery.flatpopup.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/BetList/betlist.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/BetList/dailybetlist.js")" type="text/javascript"></script>
}
@section ContentTitle
{
    @ViewResources.DailyBetList
}
@section ContentFilter
{
    @{
        Html.RenderPartial("~/Views/BetList/DailyBetList/Filter.cshtml");
    }
}
@{
    <input type="hidden" id="HiddenColumnList" value="" />
}
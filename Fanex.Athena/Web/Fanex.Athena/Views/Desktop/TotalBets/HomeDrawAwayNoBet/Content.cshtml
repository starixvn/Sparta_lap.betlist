@model Fanex.Athena.Model.TotalBet.ViewModel.HomeDrawAwayNoBetViewModel

@helper RenderFirstRow()
{
    <tr class="first-row">
        <td class="col-small"></td>
        <td class="col-medium"></td>
        <td class="col-large"></td>
        <td class="col-child"></td>
        <td class="col-child"></td>
        <td class="col-child"></td>
    </tr>
}

@if (Model.MainData.Count == 0)
{
    <p class="no-info-row">@ViewResources.NoInfo</p>
}
else
{
    <div class="header-content">
        <table class="table">
            <thead>
                @RenderFirstRow()

                <tr>
                    <th rowspan="2">#</th>
                    <th rowspan="2">@ViewResources.Time</th>
                    <th rowspan="2">@ViewResources.Event</th>
                    <th colspan="3" class="col-last">@ViewResources.FullTime</th>
                </tr>

                <tr>
                    <th>@ViewResources.HomeNoBet</th>
                    <th>@ViewResources.DrawNoBet</th>
                    <th>@ViewResources.AwayNoBet</th>
                </tr>
            </thead>
        </table>
    </div>

    <div class="body-content">
        <table class="table">
            <tbody>
                @RenderFirstRow()
                @{ Html.RenderPartial("~/Views/Desktop/TotalBets/HomeDrawAwayNoBet/ContentData.cshtml"); }
            </tbody>
        </table>
    </div>

    <div class="footer-content">
        <table class="table">
            <tbody>
                @RenderFirstRow()

                <tr class="total total-footer">
                    <td class="right-align total-label" colspan="3">
                        @ViewResources.Total
                    </td>
                    <td class="right-align no-margin">
                        @DesktopRazorHelper.DecFormat(Model.MainData.Sum(t => t.RunningStakeHomeNoBet), true, false)
                    </td>
                    <td class="right-align no-margin">
                        @DesktopRazorHelper.DecFormat(Model.MainData.Sum(t => t.RunningStakeDrawNoBet), true, false)
                    </td>
                    <td class="right-align no-margin">
                        @DesktopRazorHelper.DecFormat(Model.MainData.Sum(t => t.RunningStakeAwayNoBet), true, false)
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
}
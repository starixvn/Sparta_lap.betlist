@{
    Layout = null;
}
@using Fanex.Athena.Models.ViewModel
@using Fanex.Athena.Models.DataDomain
@model Fanex.Athena.Models.ViewModel.Report.CustomerWinLossViewModel
@{
    var minDate = DateTime.Today.AddMonths(-3).AddDays(1 - DateTime.Today.Day);
    var modelParam = Model.Param;
}
<div class="grid_26 content-filter new-line" style="width:@(ViewBag.FilterWidth)px;">
    @using (Html.BeginForm("CustomerWinLoss", "Report", FormMethod.Post, new { @id = "CustomerWinlossForm" }))
    {
        <div>
            @Html.Hidden("TodayVal", DateTime.Today.ToString(Fanex.Athena.Models.DataDomain.FormatKey.ShortFormatDate))
            @Html.Hidden("YesterdayVal", DateTime.Today.AddDays(-1).ToString(Fanex.Athena.Models.DataDomain.FormatKey.ShortFormatDate))
            @Html.Hidden("IsHistory", Model.IsHistory)
            @Html.Hidden("SortDirection", Model.Param.SortDirection)
            @Html.Hidden("SortColumn", Model.Param.SortColumn)
            @Html.Hidden("RowCount", Model.DataList == null ? 0 : Model.DataList.Count)
            @Html.Hidden("IsExportExcel", Model.Param.IsExportExcel)
        </div>
        @DatePickerHelper.RenderDateRangePicker(modelParam.FromDate, modelParam.ToDate, minDate, AppSettings.MaxDate, "", "", 2, 3, 2, 3)
        <div class="new-line">
        </div>
@*Row 1*@
        <div class="grid_2 filter-label">
            <label>@ViewResources.Currency</label>
        </div>
        <div class="grid_3 filter-input">
            @RazorHelper.CurrencyList(Model.CurrencyList, "currencylist", modelParam.CurrencyId)
        </div>
        <div class="grid_3 filter-label">
            <label for="BaseCurrency">@ViewResources.Based
            </label>
        </div>
        <div class="grid_1 filter-input">
            @RazorHelper.BasedCurrency(Model.Param.BaseCurrency)
        </div>
        <div class="grid_4 note-group">
            <div>
                <div class="userguide-icon" id="UserGuide" title="@ViewResources.UserGuide">
                </div>
            </div>
            <div>
                <input alt="@ViewResources.ExportToExcel" src="@Url.ContentLink("/Content/Global/Images/excel.gif")"
               type="image" id="ExportToExcel" name="exporttoexcel"
               title="@ViewResources.ExportToExcel" class="hand" />
            </div>
        </div>
@*End Row 1*@
@*Row 2*@

@*End Row 2*@
@*Row 3*@
        <div class="new-line">
        </div>
        @RazorHelper.RenderProductFilter(modelParam.ProductOptions)
@*End Row 3*@
@*Row 4 - Note*@

@*    <div class="grid_2 filter-label new-line">
        <label>
            @ViewResources.DrawFilter
        </label>
    </div>
    <div class="grid_9 filter-input option-list">
        <input type="radio" value="@(DrawFilterType.Normal)" @(Model.Param.DrawFilter == DrawFilterType.Normal ? "checked=checked" : "") name="drawfilter" />
        <label>
            @ViewResources.Normal
        </label>
        <input type="radio" value="@(DrawFilterType.NoDraws)" @(Model.Param.DrawFilter == DrawFilterType.NoDraws ? "checked=checked" : "") name="drawfilter" />
        <label>
            @ViewResources.NoDraws
        </label>
        <input type="radio" value="@(DrawFilterType.NoDrawsForTurnoverOnly)" @(Model.Param.DrawFilter == DrawFilterType.NoDrawsForTurnoverOnly ? "checked=checked" : "") name="drawfilter" />
        <label>
            @ViewResources.NoDrawsForTurnoverOnly
        </label>
    </div>       *@
        <div class="grid_2 filter-label new-line">
        </div>
        <div class="grid_@(Model.ProductAccess.IsAllowBA || Model.ProductAccess.IsAllowRB ? 15 : 13) filter-input">
            <div class="note-message">
                @string.Format(ViewResources.HistoricalReportDateRangeNote, minDate), <a href="javascript:;"
                    id="history-report-link" style="text-decoration: none;">@ViewResources.ToViewHistoryRptMsg</a>
            </div>
        </div>

        <div class="grid_2 filter-label new-line">
            &nbsp;</div>
        <div class="grid_2 filter-input">
            <input type="button" id="SubmitButton" value="@ViewResources.Submit" class="button" />

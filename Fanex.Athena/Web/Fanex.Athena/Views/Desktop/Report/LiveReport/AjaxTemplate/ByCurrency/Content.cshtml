@model Fanex.Athena.Model.Report.ViewModel.LiveReports.LiveReportDetailViewModel

<div class="panel-body">
    <div class="table-title"><span>@ViewResources.ByCurrency</span></div>
    @if (Model.ByCurrencies == null || Model.ByCurrencies.Count == 0)
    {
        <p class="no-info-row">@ViewResources.NoInfo</p>
    }
    else
    {
        <table class="table table-bordered">
            <thead>
                @{ Html.RenderPartial("~/Views/Desktop/Report/LiveReport/AjaxTemplate/ByCurrency/Content.Header.cshtml"); }
            </thead>

            <tbody>
                @{Html.RenderPartial("~/Views/Desktop/Report/LiveReport/AjaxTemplate/ByCurrency/Content.Data.cshtml");}
            </tbody>
        </table>
    }
</div>
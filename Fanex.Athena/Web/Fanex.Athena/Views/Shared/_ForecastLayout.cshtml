@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section css
{
    @System.Web.Optimization.Styles.Render("~/bundles/ForecastLayoutStyles")
}
@section js
{
    @System.Web.Optimization.Scripts.Render("~/bundles/ForecastLayoutScripts")
    @RenderSection("page", required: false)
}
<div>
    <div class="container_26">
        <div class="grid_26">
            <div class="content-title">
                @RenderSection("ContentTitle", required: false)
            </div>
        </div>
        <div class="clear">
        </div>
        <div class="grid_26 content-filter">
            @RenderSection("ContentFilter", required: false)
        </div>
        <div class="clear">
        </div>
        <div class="grid_26">
            <div class="content-main">
                <div class="loading">
                </div>
                <div class="block-body">
                </div>
                <div id="Refresh-Content">
                    @RenderBody()
                </div>
            </div>
        </div>
    </div>
</div>
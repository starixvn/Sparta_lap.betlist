@model Fanex.Athena.Model.Report.ViewModel.RacingCommissionViewModel

@{var index = 1;}

@foreach (var item in Model.RacingCommissionList)
{
    <tr>
        <td class="center-align">@(index++)</td>
        <td>
            <a href="javascript:;" class="bet-list-link" data-cust-id="@item.CustID" data-system-id="@item.SystemID" data-external-id="@item.ExternalID">
                @DesktopRazorHelper.TruncateWithTip(item.ExternalID, 16)
            </a>
        </td>
        <td>@item.SystemID</td>
        <td class="right-align">@item.ToteWin.ToStringExt()</td>
        <td class="right-align">@item.TotePlace.ToStringExt()</td>
        <td class="right-align">@item.ToteWinPlace.ToStringExt()</td>
        <td class="right-align">@item.ToteTotal.ToStringExt()</td>
        @if (Model.IsAllowedCustomerCommission)
        {
            <td class="right-align">@item.CustomerCommission.ToStringExt()</td>
        }
    </tr>
}
@model Fanex.Athena.Models.MetaModel.Customer.BetSetting.BetSettingMetaModel
@using Fanex.Athena.Models.ViewModel
@using Fanex.Athena.Models.DataDomain
<div>
    <div style="display:inline-block; padding-bottom: 5px">
            <div class="grid_2 product-select-label">
                <label>@ViewResources.Product</label>
            </div>
            <div id="product-dropdown" class="wrapper-dropdown-5">@Model.BetSettingName
		        <ul class="dropdown">
                    @foreach (var product in Model.BetSettingProducts)
                    {
                        var productName = product.ProductName;
                         <li><a href="@Url.Action("Index", "BetSetting", new
                            {
                                ProductId = product.ProductId,
                                CustId = Model.CustId,
                                UserName = Model.UserName,
                                NickName = Model.NickName,
                                BetSettingName = productName
                            })">
                            @productName
                        </a></li>
                    }
		        </ul>
                @Html.Hidden("ProductId", Model.ProductId)
	        </div>
    </div>
</div>

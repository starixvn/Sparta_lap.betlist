@{
    Layout = "~/Views/Shared/_BetSettingLayout.cshtml";
}
@model Fanex.Athena.Model.BetSettings.ViewModel.RngCasinoBetSettingViewModel
@using Fanex.Athena.Model.Report.ViewModel;
@using System.Linq;
@section pagecss{
    <link href="@Url.ContentLink("/Content/Customer/BetSetting/rngcasino.css")" rel="stylesheet" type="text/css" />
}
@section pagejs {
    <script src="@Url.ContentLink("/Scripts/Customer/BetSetting/rngcasino.js")" type="text/javascript"></script>
}
@{Html.RenderPartial("~/Views/Customer/BetSetting/_Menu.cshtml", Model);}
<div class="content-title">
    @Model.Param.BetSettingName @ViewResources.BetSettings - @Model.Param.NickName (@Model.Param.UserName)
</div>
@Html.Hidden("IDList", String.Join(",", Model.MainData.Select(x => x.SportId)))
<table class="report-table" style="width: 885px">
    <thead>
        <tr class="report-header">
            <td style="width: 20%">@ViewResources.GameKind
            </td>
            <td style="width: 30%">@ViewResources.GameType
            </td>
            <td style="width: 50%">@ViewResources.BettingLimit
            </td>
        </tr>
    </thead>
</table>
@{
    var disabledAttribute = Model.Editable ? null : "disabled";
}
<div class="data-content">
    <table class="report-table" style="width: 885px;">
        <tbody>
            @if (Model.GameKinds.Count == 0)
            {
                <tr style="height: 34px">
                    <td class="noinfo" colspan="3">@ViewResources.NoInfo
                    </td>
                </tr>
            }
            else
            {
                foreach (var gameKind in Model.GameKinds)
                {
                    var rowspan = gameKind.GameTypeList.Count;
                    var visible = true;

                    foreach (var gameType in gameKind.GameTypeList)
                    {
                        // Get original data
                        var originalStakeLevel = string.Empty;
                        foreach (var stakelevel in gameType.StakeLevelList)
                        {
                            originalStakeLevel += stakelevel.IsCheck ? "," + stakelevel.StakeLevelId : string.Empty;
                        }

                <tr class="casino-row" data-gametypeid="@gameType.GameTypeId" data-stake-original="@(originalStakeLevel.Length > 0 ? originalStakeLevel.Substring(1) : string.Empty)">
                    <td class="game-kind text-data" style="width: 20%;@(!visible ? "display:none" : string.Empty)" rowspan="@(rowspan) @(visible = false)">@gameKind.GameKindName
                    </td>
                    <td class="text-data" style="width: 30%" data-gametypeid="@gameType.GameTypeId">@gameType.GameTypeName
                    </td>
                    <td style="width: 50%" class="text-data" data-gametypeid="@gameType.GameTypeId">
                        @foreach (var stakeLevel in gameType.StakeLevelList)
                        {
                            <input class="input-@(gameType.GameTypeId)" @disabledAttribute  type="checkbox" data-stakeid="@stakeLevel.StakeLevelId" data-ischeck="@(stakeLevel.IsCheck ? "true" : "false")"  @(stakeLevel.IsCheck ? "checked='checked'" : string.Empty)/><span
                                class="stake-level-name">@stakeLevel.StakeLevelNameFormated</span>
                        }
                    </td>
                </tr>
                    }
                }
            }
        </tbody>
    </table>

    @Html.Hidden("isenabled", Model.IsEnabled.Value)
</div>
@if (Model.Editable && Model.GameKinds.Count > 0)
{
    <div style="width: 855px">
        <input type="button" class="button" data-cust-id="@Model.Param.CustId" data-user-name="@Model.Param.UserName.ToString()" data-nick-name="@Model.Param.NickName" value="@ViewResources.Submit"
        id="btnRngCasino"/>
        <input type="button" class="button" value="@ViewResources.Reset"
        id="btnResetRngCasino" />
        @if (Model.IsEnabled.HasValue)
        {
            <input type="button" class="button" data-status="@(Model.IsEnabled.Value ? 1 : 0)" 
            data-cust-id="@Model.Param.CustId" 
            data-nick-name="@Model.Param.NickName" value="@(Model.IsEnabled.Value ? ViewResources.DisableRNGCasino : ViewResources.EnableRNGCasino)"
            id="btnUpdateStatus" />
        }
        else
        {
            <p>
            @string.Format(ViewResources.CustomerHasNeverPlayed, ViewResources.ProductCS)
            </p>
        }
    </div>
}
<script type="text/javascript">
    $(window).load(function () {
        RnGCasino.initialize();
    });
</script>
@{
    Layout = null;
}
@model Fanex.Athena.Model.Customer.MetaModel.GroupCommMetaModel
<div class="row">
    <div class="col s12 text-bold input-field">
        @ViewResources.Commission (%)
    </div>
</div>
<div class="row">
    <div class="col l2 m3 s12 input-field">
        @ViewResources.Sportsbook
    </div>
    <div class="col l1 m3 s4 first-value">
        @Html.HiddenFor(model => model.SBComm)
        @DesktopGroupCommRazorHelper.CommDropDownFirst("SBComm1", Model.SBComm1)    
    </div>
    <div class="col l1 m3 s4">
        @DesktopGroupCommRazorHelper.CommDropDownSecond("SBComm2", Model.SBComm2)
    </div>
    <div class="col l1 m3 s4 third-value">
        @DesktopGroupCommRazorHelper.CommDropDownThird("SBComm3", Model.SBComm3)
    </div>
</div>
<div class="row">
    <div class="col l2 m3 s12 input-field">
        @ViewResources.Parlay
    </div>
    <div class="col l1 m3 s4 first-value">
        @Html.HiddenFor(model => model.ParlayComm)
        @DesktopGroupCommRazorHelper.CommDropDownFirst("ParlayComm1", Model.ParlayComm1)       
    </div>
    <div class="col l1 m3 s4">
        @DesktopGroupCommRazorHelper.CommDropDownSecond("ParlayComm2", Model.ParlayComm2)
    </div>
    <div class="col l1 m3 s4 third-value">
        @DesktopGroupCommRazorHelper.CommDropDownThird("ParlayComm3", Model.ParlayComm3)
    </div>
</div>
@if (Model.IsUpdateNG)
{
    <div class="row">
        <div class="col l2 m3 s12 input-field">
            @ViewResources.ProductNG
        </div>
        <div class="col l1 m3 s4 first-value">
            @Html.HiddenFor(model => model.NGComm)
            @DesktopGroupCommRazorHelper.CommDropDownFirst("NGComm1", Model.NGComm1)
        </div>
        <div class="col l1 m3 s4">
            @DesktopGroupCommRazorHelper.CommDropDownSecond("NGComm2", Model.NGComm2)
        </div>
        <div class="col l1 m3 s4 third-value">
            @DesktopGroupCommRazorHelper.CommDropDownThird("NGComm3", Model.NGComm3)
        </div>
    </div>
}
else
{
    @Html.HiddenFor(model => model.NGComm)
}
@if (Model.IsUpdateCS)
 {
    <div class="row">
        <div class="col l2 m3 s12 input-field">
            @ViewResources.ProductCS
        </div>
        <div class="col l1 m3 s4 first-value">
            @Html.HiddenFor(model => model.CSComm)
            @DesktopGroupCommRazorHelper.CommDropDownFirst("CSComm1", Model.CSComm1)          
        </div>
        <div class="col l1 m3 s4">
            @DesktopGroupCommRazorHelper.CommDropDownSecond("CSComm2", Model.CSComm2)
        </div>
        <div class="col l1 m3 s4 third-value">
            @DesktopGroupCommRazorHelper.CommDropDownThird("CSComm3", Model.CSComm3)
        </div>
    </div>
}
else
{
    @Html.HiddenFor(model => model.CSComm)
}
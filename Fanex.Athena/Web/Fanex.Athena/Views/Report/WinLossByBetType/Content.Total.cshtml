@using Fanex.Athena.Models.ViewModel
@using Fanex.Athena.Extension.Helper
@model Fanex.Athena.Models.ViewModel.Report.WinLossByBetTypeViewModel
<div class="total-content"  style="width:@(ViewBag.WrapperWidth)@("px")">
    <div class="row title-text" style="width:@(ViewBag.TotalWidth)@("px");">
        @ViewResources.Total
    </div>
    <div class="row" style="width:@(ViewBag.TurnOverWidth)@("px")">
        <div>@Model.Total.Turnover.ToStringExt()</div>
    </div>
    @SplitingProductHelper.CustomerWLContent(Model.Total as Fanex.Athena.Models.DTO.Report.ICustomerWinLoss,
                                             Model.IsAllowedCustomerCommission,
                                             ViewBag.CustomerWLLargeWidth,
                                             ViewBag.CustomerWLWidth,
                                             ViewBag.CustomerCommWidth,
                                             ViewBag.CustomerWLTotalWidth)
    <div class="row highlight" style="width:@(ViewBag.LicenseeWLWidth)@("px")">
        @RazorHelper.HighlightNegativeFormat(Model.Total.LicenseeWL)
    </div>
    @*Check BA, RB Commission*@
    @if (Model.ProductAccess.IsAllowBa)
    { 
        <div class="row highlight" style="width:@(ViewBag.RbBaWidth)@("px")">
            @RazorHelper.HighlightNegativeFormat(Model.Total.BACommission)
        </div>
    }
    @if (Model.ProductAccess.IsAllowRb)
    { 
        <div class="row highlight" style="width:@(ViewBag.RbBaWidth)@("px")">
            @RazorHelper.HighlightNegativeFormat(Model.Total.RacingWinLoss)
        </div>
    }
    @if (Model.ProductAccess.IsAllowBa)
    { 
        <div class="row" style="width:@(ViewBag.RbBaWidth)@("px")">
            <div>@Model.Total.AmtDueToBA.ToStringExt()</div>
        </div>
    }
    @if (Model.ProductAccess.IsAllowRb)
    { 
        <div class="row" style="width:@(ViewBag.AmtRacingWidth)@("px")">
            <div>@Model.Total.AmtDueToRacing.ToStringExt()</div>
        </div>
    }
</div>

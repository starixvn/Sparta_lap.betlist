@using System.Web.Mvc;
@using System.Web.WebPages;
@using Fanex.Athena.Models.ViewModel;
@using Fanex.Athena.Extension.Helper;
@helper RenderDateRangePicker(DateTime fromDate, DateTime toDate, DateTime minDate, DateTime maxDate,
    string fromClass = "", string toClass = "",
    int fromGrid = 2, int fromInputGrid = 3, int toGrid = 2, int toInputGrid = 3, bool simpleMode = false)
    {
        var today = DateTime.Today < maxDate ? DateTime.Today : maxDate;
        var url = new System.Web.Mvc.UrlHelper(Context.Request.RequestContext);
    <div class="grid_@(fromGrid) filter-label">
        <label>@ViewResources.From</label>
    </div>
    <div class="grid_@(fromInputGrid) filter-input">
        <input type="text" id="FromDate" data-original="@fromDate.ToString("MM/dd/yyyy")" value="@fromDate.ToString("MM/dd/yyyy")" class = "date-range @fromClass" readonly = "readonly" name="FromDate" />
    </div>
    <div class="grid_@(toGrid) filter-label">
        <label>@ViewResources.To</label>
    </div>
    <div class="grid_@(toInputGrid) filter-input">
        <input type="text" id="ToDate" data-original="@toDate.ToString("MM/dd/yyyy")" value="@toDate.ToString("MM/dd/yyyy")" class = "date-range @toClass" readonly = "readonly" name="ToDate" />
    </div>
    <div>
        <script type="text/ecmascript">
            var dateRangePicker = null;
            $(window).load(function () {
                            var monthShort = ['@ViewResources.Jan', '@ViewResources.Feb', '@ViewResources.Mar', '@ViewResources.Apr', '@ViewResources.May', '@ViewResources.Jun', '@ViewResources.Jul', '@ViewResources.Aug', '@ViewResources.Sep', '@ViewResources.Oct', '@ViewResources.Nov', '@ViewResources.Dec']
                var dayMin = ['@ViewResources.Su', '@ViewResources.Mo', '@ViewResources.Tu', '@ViewResources.We', '@ViewResources.Th', '@ViewResources.Fr', '@ViewResources.Sa'];

                var disabledPreset = @(simpleMode ? 1 : 0) ? ['Lastweek', 'Currentmonth', 'Lastmonth', 'Sincelastmonth'] : [];
                dateRangePicker = $('#FromDate, #ToDate').daterangepicker({
                    today: '@(today.ToString("MMM d yyyy"))',
                    buttonImage: '@url.Content("~/Content/Library/start/images/calendar.png")',
                    datepickerOptions: {
                        showOtherMonths: true,
                        changeMonth: true,
                        changeYear: true,
                        selectOtherMonths: true,
                        closeText: 'OK',
                        dateFormat: 'mm/dd/yy',
                        minDate: '@(minDate.ToString("MM/dd/yyyy"))',
                        maxDate: '@(maxDate.ToString("MM/dd/yyyy"))',
                        monthNamesShort: monthShort,
                        dayNamesMin: dayMin
                    },
                    dateFormat: 'mm/dd/yy',
                    disabledPreset: disabledPreset,
                     monthNamesShort: monthShort
                    
                });
            });
        </script>
    </div>
}
@helper RenderDatePicker(DateTime date, DateTime minDate, DateTime maxDate, string id = "FromDate",
    string className = "", int inputWidth = 3)
    {
        var url = new System.Web.Mvc.UrlHelper(Context.Request.RequestContext);  
    <div class="date-picker-wrapper grid_@(inputWidth) filter-input">
        <input type="text" readonly="readonly" data-original="@date.ToString("MM/dd/yyyy")" name="@(id)" id="@(id)" class="@(className)" />
        <script type="text/javascript">

            $(window).load(function () {
                var monthShort = ['@ViewResources.Jan', '@ViewResources.Feb', '@ViewResources.Mar', '@ViewResources.Apr', '@ViewResources.May', '@ViewResources.Jun', '@ViewResources.Jul', '@ViewResources.Aug', '@ViewResources.Sep', '@ViewResources.Oct', '@ViewResources.Nov', '@ViewResources.Dec']
                var dayMin = ['@ViewResources.Su', '@ViewResources.Mo', '@ViewResources.Tu', '@ViewResources.We', '@ViewResources.Th', '@ViewResources.Fr', '@ViewResources.Sa'];
               
                $("#@(id)").datepicker({
                    showOn: "both",
                    buttonImage: '@url.Content("~/Content/Library/start/images/calendar.png")',
                    buttonText: "Show Date Picker",
                    buttonImageOnly: true,
                    showOtherMonths: true,
                    changeMonth: true,
                    changeYear: true,
                    selectOtherMonths: true,
                    closeText: 'OK',
                    dateFormat: 'mm/dd/yy',
                    monthNamesShort: monthShort,
                    dayNamesMin: dayMin,
                    minDate: '@(minDate.ToString("MM/dd/yyyy"))',
                    maxDate: '@(maxDate.ToString("MM/dd/yyyy"))'
                });
                $('#@(id)').datepicker('setDate', '@(date.ToString("MM/dd/yyyy"))');
            });
        </script>
    </div> 
    
}

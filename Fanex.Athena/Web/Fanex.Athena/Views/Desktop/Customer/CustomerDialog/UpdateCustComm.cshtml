@model Fanex.Athena.Model.Core.DTO.Common.ProductAccess

<div class="row">
    <div class="col l4 m4 s4 input-field first-value">
        @DesktopGroupCommRazorHelper.CommDropDownFirst("CustSBComm1")
        <label>@ViewResources.SBComm (%)</label>
    </div>
    <div class="col l4 m4 s4 input-field">
        @DesktopGroupCommRazorHelper.CommDropDownSecond("CustSBComm2")
    </div>
    <div class="col l4 m4 s4 input-field third-value">
        @DesktopGroupCommRazorHelper.CommDropDownThird("CustSBComm3")
    </div>
</div>

<div class="row">
    <div class="col l4 m4 s4 input-field first-value">
        @DesktopGroupCommRazorHelper.CommDropDownFirst("CustParlayComm1")
        <label>@ViewResources.ParlayComm (%)</label>
    </div>
    <div class="col l4 m4 s4 input-field">
        @DesktopGroupCommRazorHelper.CommDropDownSecond("CustParlayComm2")
    </div>
    <div class="col l4 m4 s4 input-field third-value">
        @DesktopGroupCommRazorHelper.CommDropDownThird("CustParlayComm3")
    </div>
</div>

<div class="row @(!Model.IsAllowNG ? "hide" : "")">
    <div class="col l4 m4 s4 input-field first-value">
        @DesktopGroupCommRazorHelper.CommDropDownFirst("CustNGComm1")
        <label>@ViewResources.NGComm (%)</label>
    </div>
    <div class="col l4 m4 s4 input-field">
        @DesktopGroupCommRazorHelper.CommDropDownSecond("CustNGComm2")
    </div>
    <div class="col l4 m4 s4 input-field third-value">
        @DesktopGroupCommRazorHelper.CommDropDownThird("CustNGComm3")
    </div>
</div>
<div class="row @(!Model.IsAllowCS ? "hide" : "")">
    <div class="col l4 m4 s4 input-field first-value">
        @DesktopGroupCommRazorHelper.CommDropDownFirst("CustCSComm1")
        <label>@ViewResources.CSComm (%)</label>
    </div>
    <div class="col l4 m4 s4 input-field">
        @DesktopGroupCommRazorHelper.CommDropDownSecond("CustCSComm2")
    </div>
    <div class="col l4 m4 s4 input-field third-value">
        @DesktopGroupCommRazorHelper.CommDropDownThird("CustCSComm3")
    </div>
</div>
<div class="row">
    <div id="InfoMsg" class="col l12 m12 s12 attention-message">@ViewResources.PayAttentionMsg</div>
    <div class="col l12 m12 s12 success-message">
    </div>
    <div class="col l12 m12 s12 error-message">
    </div>
    <div class="col l12 m12 s12 ajax-loading">
        <img alt="Sending" src="@Url.ContentLink("/www/assets/images/ajax-loader.gif")" />
    </div>
</div>
@{    
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using Fanex.Athena.Controllers
@section css
{
    <link href="@Url.ContentLink("/Content/Library/start/jquery-ui.min.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.ContentLink("/Content/Global/grid26.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.ContentLink("/Content/Global/lrf.global.grid.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.ContentLink("/Content/Global/lrf.global.content.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.ContentLink("/Content/Global/lrf.global.reportable.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.ContentLink("/Content/Customer/BetSetting/BetSetting.css")" rel="stylesheet" type="text/css" />
    @RenderSection("pagecss", required: false)
}
@section js
{
    <script src="@Url.ContentLink("/Scripts/Customer/BetSetting/betsetting.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Library/jquery.balloon.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Plugin/FormatNumber/jshashtable.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Plugin/FormatNumber/jquery.numberformatter.js")" type="text/javascript"></script>
    @RenderSection("pagejs", required: false)
}


<div class="content-main">
    <div class="loading">
    </div>
    <div class="block-body">
    </div>

    @RenderBody()
</div>

@using Fanex.Athena.Model.Report.ViewModel
@using Fanex.Athena.Model.Core.MetaModel.Product
@model Fanex.Athena.Model.Report.ViewModel.BalanceViewModel
<div class="grid_26 content-filter new-line" style="width:@(ViewBag.FilterWidth)px;">
    @using (Html.BeginForm("Balance", "Report", FormMethod.Post, new { @id = "BalanceForm" }))
    {
        //-----------------------------Hidden Field-------------------------------//
    
        @Html.Hidden("IsExportExcel", Model.Param.IsExportExcel)
        @Html.Hidden("FromDate", Model.Param.FromDate)
        @Html.Hidden("ToDate", Model.Param.ToDate)
        //-----------------------------Type of licensee---------------------------//
        if (@Model.LicenseeTypeList.Count > 0)
        {
        <div class="grid_2 filter-label">
            <label>@ViewResources.Type</label>
        </div>
        <div class="grid_3 filter-input">
            @RazorHelper.LicenseeType(Model.LicenseeTypeList, "licenseetype", Model.Param.LicenseeType, true)
        </div>
        }

        //-----------------------------Currency-----------------------------------//
        <div class="grid_2 filter-label">
            <label>@ViewResources.Currency</label>
        </div>
        <div class="grid_3 filter-input">
            @{
                @RazorHelper.CurrencyList(Model.CurrencyList, "CurrencyId", Model.Param.CurrencyId)
            }
        </div>
        <div class="grid_3 filter-label">
            <label>@ViewResources.Based </label>
        </div>
    
        <div class="grid_1 filter-input">
            @RazorHelper.BasedCurrency(Model.Param.BaseCurrency)
        </div>
    
        <div class="grid_2 note-group">
            
            <div>
                <input alt="@ViewResources.ExportToExcel" src="@Url.ContentLink("/Content/Global/Images/excel.gif")"
               type="image" id="ExportToExcel" name="exporttoexcel"
               title="@ViewResources.ExportToExcel" class="hand" />
            </div>
        </div>
    
                  //-----------------------------Date---------------------------------------//
        <div class="grid_2 filter-label new-line">
            <label>@ViewResources.Month</label>
        </div>
        <div class="grid_3 filter-input">
            @RazorHelper.MonthDropDownList(Model.Param.FromDate.Month)
        </div>
    
        <div class="grid_2 filter-label">
            <label>
                @ViewResources.Year</label>
        </div>
        <div class="grid_3 filter-input">
            @RazorHelper.YearDropDownList(Model.Param.FromDate.Year, 5)
        </div>
        <div class="grid_2 filter-label new-line">
            &nbsp;</div>
        <div class="grid_2 filter-input">
            <input type="submit" id="SubmitButton" value="@ViewResources.Submit" class="button" />
        </div>
    }
</div>

@{
    Layout = "~/Views/Desktop/Shared/_BetSettingLayout.cshtml";
}
@model Fanex.Athena.Model.BetSettings.ViewModel.ThirdPartyBetSettingViewModel

@section Menu{
    @{Html.RenderPartial("~/Views/Desktop/Customer/BetSetting/Menu.cshtml", Model);}
}

@section ContentTitle{
    @Model.Param.BetSettingName @ViewResources.BetSettings - @Model.Param.NickName (@Model.Param.UserName)
}

<!--Content-->
<div class="data-content">
    @if (!Model.IsLineEnabled)
    {
        <div style="width: 885px!important;width: 885px!important; padding: 20px 0px 20px 0px">
            <div>@ViewResources.MicroGamingLiveCasinoNotOfferCurrency</div>
        </div>
    }
</div>
<!--/Content-->
@if (Model.IsLineEnabled)
{
    var status = Model.IsEnabled.HasValue && Model.IsEnabled.Value ? 1 : 0;
    <div class="filter-input">
        <input id="enable-product" type="checkbox" name="enable-product"
               @(Model.IsEnabled.HasValue && Model.IsEnabled.Value ? "checked" : "")
               class="childCheckbox" data-original="@status" @(Model.Editable ? "" : "disabled") />
        <label for="enable-product">@ViewResources.EnableMicrogamingLiveCasino</label>
    </div>
    if (Model.Editable)
    {
        <div class="right button-block">
            <button type="button" class="btn btn-submit"
                    data-status="@status"
                    data-cust-id="@Model.Param.CustId"
                    data-nick-name="@Model.Param.NickName"
                    id="btnUpdateStatus">
                @ViewResources.Submit
            </button>
            <button id="btnReset" type="reset" class="btn btn-cancel">@ViewResources.Reset</button>
        </div>
    }
}
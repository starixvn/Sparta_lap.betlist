@{
    ViewBag.Title = "LRF - " + ViewResources.TotalBets +
    " - " + ViewResources.MoneyLine;
    Layout = Request.IsAjaxRequest() ? null : "~/Views/Shared/_TotalBetsLayout.cshtml";
}
@using Fanex.Athena.Models.ViewModel
@model Fanex.Athena.Models.ViewModel.TotalBets.MoneyLineViewModel
@section page {
    <script src="@Url.ContentLink("/Scripts/TotalBets/moneyline.js")" type="text/javascript"></script>
    <script type="text/javascript">
        $(window).load(function () {
            MoneyLine.initialize();
            RefreshCountDown.initEvent();
        });
    </script>
}
@section ContentTitle
    {
    @ViewResources.MoneyLine
}
@section ContentFilter
{
    @{
        Html.RenderPartial("~/Views/TotalBets/MoneyLine/Filter.cshtml");
    }
}
@{
    Html.RenderPartial("~/Views/TotalBets/MoneyLine/Content.cshtml");
}
@{
    Layout = null;
}
<link href="@Url.ContentLink("/Content/RNGCasino/rng-casino-hand-history.css")" rel="stylesheet" type="text/css" />
@model Fanex.Athena.Model.Casino.ViewModel.CasinoHandHistoryDetailViewModel
@{
    var headerItem = Model.CasinoDetailHeaderList.FirstOrDefault();
}
<table style="width: 100%;" class="casino-detail-table" cellpading="0" cellspacing="0">
    <tr class="detail-header-row">
        <td class="game-type-text" colspan="2">@Model.Param.GameTypeName - @headerItem.BetTime
        </td>
    </tr>
    <tr class="player-total-row">
        <td colspan="2">
            @ViewResources.Player: @headerItem.UserName - @string.Format(ViewResources.Viewin,Model.Param.CurrencyName)
        </td>
    </tr>
    <tr class="detail-header-row">
        <td colspan="2">@headerItem.ResultName
        </td>
    </tr>
    <tr>
        <td colspan="2">
            @if (!string.IsNullOrEmpty(headerItem.Result) && headerItem.Result.Contains("/Form"))
            {
                @Html.Raw(headerItem.Result.Replace("/Form", Url.Content("~/") + "Form"))
            }
            else
            {
                var resultList = headerItem.Result.Split(',');
                if (resultList.Count() == 9)
                {
                <table style="width: 60%; margin-left: 20%;" class="casino-detail-table" cellpading="0" cellspacing="0">
                    @for (int i = 0; i < 3; i++)
                    {
                        <tr>
                            @for (int k = 0; k < 3; k++)
                            {
                                <td style="width: 33%;">
                                    @Html.Raw(resultList[i * 3 + k])
                                </td>                    
                            }
                        </tr>
                    }
                </table>
                }
            }
        </td>
    </tr>
    <tr>
        <td>@ViewResources.PlayerHistoryNo
        </td>
        <td class="align-left">@Model.Param.PlayerHistoryNo
        </td>
    </tr>
    <tr>
        <td>@ViewResources.AutoPlay
        </td>
        <td class="align-left">@headerItem.AutoPlayResult
        </td>
    </tr>
    <tr class="player-total-row">
        <td class="align-left">@ViewResources.Bet
        </td>
        <td class="align-right">@Model.CasinoDetailList.Sum(p => p.Bet).ToStringExt()
        </td>
    </tr>
    <tr class="player-total-row">
        <td class="align-left">@ViewResources.Odds
        </td>
        <td class="align-right">@Model.CasinoDetailList.Sum(p => p.Odds).ToStringExt()
        </td>
    </tr>
    <tr class="player-total-row">
        <td class="align-left">@ViewResources.Win/@ViewResources.Loss
        </td>
        <td class="align-right">@Model.CasinoDetailList.Sum(p => p.WinLoss).ToStringExt()
        </td>
    </tr>
</table>

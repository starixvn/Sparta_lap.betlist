@{
    Layout = null;

    var isAllowNg = ViewBag.IsAllowNG;
    var isAllowRc = ViewBag.IsAllowRC;
    var isAllowLc = ViewBag.IsAllowLC;
    var isAllowCs = ViewBag.IsAllowCS;
}

<div class="main-content">
    @if (Model.Count == 0)
    {
        <p class="no-info-row">@ViewResources.NoInfo</p>
    }
    else
    {
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th class="col-extra-small">#</th>
                    <th class="col-child medium">@ViewResources.GroupId</th>
                    <th class="col-medium large">@ViewResources.GroupName</th>
                    <th class="col-child medium">@ViewResources.DefaultGroup</th>
                    <th class="col-child">@ViewResources.NoOfCustmer</th>
                    <th class="col-child medium">@ViewResources.SBComm (%)</th>
                    @if (isAllowRc)
                    {
                        <th class="col-child medium">@ViewResources.RacingComm (%)</th>
                    }
                    @if (isAllowNg)
                    {
                        <th class="col-child medium">@ViewResources.NGComm (%)</th>
                    }
                    @if (isAllowLc)
                    {
                        <th class="col-child medium">@ViewResources.LCComm (%)</th>
                    }
                    @if (isAllowCs)
                    {
                        <th class="col-child medium">@ViewResources.CSComm (%)</th>
                    }
                    <th class="col-child">@ViewResources.GroupColor</th>
                    <th class="col-child">@ViewResources.EditGroup</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int number = 1;
                    foreach (var groupComm in Model)
                    {
                        <tr>
                            <td class="middle-text">@(number++)</td>
                            <td class="middle-text">@groupComm.GroupCommId</td>
                            <td class="left-text">
                                <a href="@Url.Action("Update", "CustomerComGroup", new { groupId = @groupComm.GroupCommId })" title="@ViewResources.EditGroup">
                                    @groupComm.GroupName
                                </a>
                            </td>
                            <td class="middle-text @(groupComm.IsDefaultGroup ? "default-group" : string.Empty)"></td>
                            <td class="middle-text">
                                <a href="@Url.Action("CustomerList", "Customer", new { groupId = groupComm.GroupCommId })" class="no-customer-border">
                                    @groupComm.NumberOfCustomer
                                </a>
                            </td>
                            <td class="middle-text">
                                @(groupComm.SBComm.ToString("P2"))
                            </td>
                            @if (isAllowRc)
                            {
                                <td class="middle-text">
                                    @(groupComm.RCComm.ToString("P2"))
                                </td>
                            }
                            @if (isAllowNg)
                            {
                                <td class="middle-text">
                                    @(groupComm.NGComm.ToString("P2"))
                                </td>
                            }
                            @if (isAllowLc)
                            {
                                <td class="middle-text">
                                    @(groupComm.LCComm.ToString("P2"))
                                </td>
                            }
                            @if (isAllowCs)
                            {
                                <td class="middle-text">
                                    @(groupComm.CSComm.ToString("P2"))
                                </td>
                            }
                            <td class="middle-text">
                                <div class="group-color-box" style="background-color:@groupComm.GroupColor;"></div>
                            </td>
                            <td class="middle-text">
                                <a class="underline" href="@Url.Action("Update", "CustomerComGroup", new { groupId = @groupComm.GroupCommId })" title="@ViewResources.EditGroup">
                                    <img src="@Url.ContentLink("/Content/Customer/images/edit.png")"
                                         style="width:16px; height: 16px;" />
                                </a>&nbsp; <a class="underline" href="javascript:GroupComm.initDeleteGroup('@groupComm.GroupCommId')" title="@ViewResources.DeleteGroup">
                                    <img src="@Url.ContentLink("/Content/Customer/images/validatefail.png")"
                                         style="width:16px; height: 16px;" />
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    }
</div>
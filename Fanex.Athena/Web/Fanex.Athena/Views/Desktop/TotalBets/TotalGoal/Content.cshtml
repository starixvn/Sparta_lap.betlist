@model Fanex.Athena.Model.TotalBet.ViewModel.TotalGoalViewModel

@helper RenderFirstRow()
{
    <tr class="first-row">
        <td class="col-small"></td>
        <td class="col-medium"></td>
        <td class="col-medium"></td>
        <td class="col-child small"></td>
        <td class="col-child small"></td>
        <td class="col-child small"></td>
        <td class="col-child small"></td>
        <td class="col-child small"></td>
        <td class="col-child small"></td>
        <td class="col-child small"></td>
    </tr>
}

@if (Model.MainData.Count == 0)
{
    <p class="no-info-row">@ViewResources.NoInfo</p>
}
else
{
    <div class="header-content">
        <table class="table">
            <thead>
                @RenderFirstRow()

                <tr>
                    <th rowspan="2">#</th>
                    <th rowspan="2">@ViewResources.Home</th>
                    <th rowspan="2">@ViewResources.Away</th>
                    <th colspan="4">@ViewResources.FullTime</th>
                    <th colspan="3" class="col-last">@ViewResources.lbl1stHalf</th>
                </tr>
                <tr>
                    <th>0 - 1</th>
                    <th>2 - 3</th>
                    <th>4 - 6</th>
                    <th>@ViewResources.lbl7Over</th>

                    <th>0 - 1</th>
                    <th>2 - 3</th>
                    <th>4@(ViewResources.Over)</th>
                </tr>
            </thead>
        </table>
    </div>

    <div class="body-content">
        <table class="table">
            <tbody>
                @RenderFirstRow()
                @{ Html.RenderPartial("~/Views/Desktop/TotalBets/TotalGoal/ContentData.cshtml"); }
            </tbody>
        </table>
    </div>

    <div class="footer-content">
        <table class="table">
            <tbody>
                @RenderFirstRow()

                <tr class="total total-footer">
                    <td class="right-align total-label" colspan="3">
                        @ViewResources.Total
                    </td>
                    <td class="right-align no-margin" colspan="4">
                        @RazorHelperDesktop.DecFormat(Model.TotalData.Total01, true, false)
                    </td>
                    <td class="right-align no-margin" colspan="3">
                        @RazorHelperDesktop.DecFormat(Model.TotalData.TotalFirstHalf01 ?? 0, true, false)
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
                    }
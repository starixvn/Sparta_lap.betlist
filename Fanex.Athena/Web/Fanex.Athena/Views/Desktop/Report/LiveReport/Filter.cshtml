@model Fanex.Athena.Model.Report.ViewModel.LiveReports.LiveReportViewModel
@{
    var minDate = DateTime.Today.AddMonths(-3).AddDays(1 - DateTime.Today.Day);
}

<div class="page-form">
    <form id="livereport" name="livereport" method="post" action="@Url.Content("~/LiveReport?isViewedHistory=false")">
        @Html.AntiForgeryToken()
        <div class="row">
            <div class="input-field input col l3 m3 s12 calendar">
                <input name="DateRange" autocomplete="off" id="DateRange" class="datepicker" type="text" />
                <input name="FromDate" id="FromDate" type="hidden" data-original-from="@Model.Param.FromDate.ToString("MM/dd/yyyy")" value="@Model.Param.FromDate.ToString("MM/dd/yyyy")" />
                <input name="ToDate" id="ToDate" type="hidden" data-original-to="@Model.Param.ToDate.ToString("MM/dd/yyyy")" value="@Model.Param.ToDate.ToString("MM/dd/yyyy")" />

                <label for="DateRange" class="active">@ViewResources.Date</label>
                <span class="icon icon-calendar"></span>
            </div>
            <div class="input-field col l2 m3 s12">
                @RazorHelperNewUI.CurrencyList(Model.CurrencyList, "select", Model.Param.CurrencyId)
                <label>@ViewResources.Currency</label>
            </div>
            <div class="input-field col l2 m3 s12">
                @RazorHelperNewUI.BasedCurrency(Model.Param.BaseCurrency, Model.Param.CurrencyName)
                <label>@ViewResources.Based</label>
            </div>
            <div class="input-field col l2 m3 s12">
                @RazorHelperNewUI.LiveStatus(Model.Param.LiveIndicator)
                <label>@ViewResources.LiveStatus</label>
            </div>
            <div class="col button-block" id="btnSubmit">
                <a class="waves-effect waves-light btn btn-primary">@ViewResources.Submit</a>
            </div>
        </div>
        <div class="row">
            <div class="col">
                <span class="circle"></span>
                <span>
                    @string.Format(ViewResources.HistoricalReportDateRangeNote, minDate),
                    <a data-history-mode="False" id="switchreport" href="javascript:;">
                        @ViewResources.ToViewHistoryRptMsg
                    </a>
                </span>
            </div>
            <div class="col right">
                <i class="icon-book right" id="UserGuide" title="@ViewResources.UserGuide"></i>
                <i class="icon-excel right" title="@ViewResources.ExportToExcel" id="exporttoexcel" name="exporttoexcel"></i>
            </div>
        </div>

        <input type="hidden" name="ProductCode" id="ProductCode" />
        <input type="hidden" name="IsExportExcel" id="IsExportExcel" value="false" />
    </form>
</div>
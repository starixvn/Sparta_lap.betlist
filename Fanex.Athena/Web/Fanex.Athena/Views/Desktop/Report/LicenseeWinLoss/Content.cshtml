@{
    Layout = null;
}

<div class="page-results">
    <div class="breadCrumbHolder" id="level-link-container">
        <div class="breadcrumb flat">
            <a class="level0 level-link" data-level="0" href="#">@ViewResources.Main</a>
            <a class="level1 level-link" data-level="1" href="#">@ViewResources.Licensee</a>
            <a class="level2 level-link" href="#">@ViewResources.Customer</a>
        </div>
    </div>
    <ul class="collapsible collapsible-accordion" data-collapsible="expandable">
        <li>
            <div class="collapsible-header panel-heading active">
                <div class="panel-title">
                    <span class="report-title"></span>
                    <i class="right icon-arrow"></i>
                </div>
            </div>

            <div class="collapsible-body">
                <div class="panel-body theme_jqGrid">
                    <table id="ReportGrid" class="table" data-hidden-column=""></table>

                    <div id="ppdata">
                    </div>
                    <div id="footer" class="hide">
                    </div>
                </div>
            </div>
        </li>
    </ul>
</div>
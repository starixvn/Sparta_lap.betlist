@using System.Linq
@model Fanex.Athena.Model.TotalBet.ViewModel.HomeDrawAwayNoBetViewModel
@{
    var leagueList = Model.MainData.GroupBy(x => new { x.LeagueId, x.LeagueName, x.LiveIndicator })
                            .Select(x => x.Key)
                            .OrderBy(x => x.LeagueName)
                            .OrderByDescending(x => x.LiveIndicator)
                            .ToList();

    var index = 1;
}
<div class="data-content">
    <table class="report-table">
        <tbody>
            @foreach (var league in leagueList)
            {
                // Render League name
                <tr>
                    <td class="league" colspan="11">@league.LeagueName
                    </td>
                </tr>
                var matchOfLeague = Model.MainData
                            .Where(x => x.LeagueId == league.LeagueId && x.LiveIndicator == league.LiveIndicator)
                            .ToList();

                // Render Match League
                foreach (var match in matchOfLeague)
                { 
                <tr class="@(match.LiveIndicator == 1 ? "live" : string.Empty)">
                    <td style="width: 34px" class="order-number">@(index++)
                    </td>
                    <td style="width: 126px">
                        @if (match.LiveIndicator == 1)
                        {
                            <div class="show-time">
                                <span>@match.LiveHomeScore - @match.LiveAwayScore</span>
                                <br />
                                <i class="live-notice">@ViewResources.Live!</i>
                            </div>
                        }
                        else
                        {
                            <div class="show-time">
                                @Html.Raw(match.ShowTime)
                            </div>
                        }
                    </td>
                    <td style="width: 427px" class="match-name">
                        @match.HomeTeamName -vs- @match.AwayTeamName
                    </td>
                    <!--Home No Bet-->
                    <td style="width: 135px" class="score-value">
                        @if (match.BetCountHomeNoBet != 0)
                        {
                            <a class="forcast-number" data-match-id="@match.MatchId" data-bet-type="121" href="javascript:;">
                                @RazorHelper.NegativeFormat(match.HomeNoBet, true, false)
                            </a>
                        }
                    </td>
                    <!--/Home No Bet-->
                    <!--Draw No Bet-->
                    <td style="width: 135px" class="score-value">
                        @if (match.BetCountDrawNoBet != 0)
                        {
                            <a class="forcast-number" data-match-id="@match.MatchId" data-bet-type="25" href="javascript:;">
                                @RazorHelper.NegativeFormat(match.DrawNoBet, true, false)
                            </a>    
                        }
                    </td>
                    <!--/Draw No Bet-->
                    <!--Away No Bet-->
                    <td style="width: 135px" class="score-value">
                        @if (match.BetCountAwayNoBet != 0)
                        {
                            <a class="forcast-number" data-match-id="@match.MatchId" data-bet-type="122" href="javascript:;">
                                @RazorHelper.NegativeFormat(match.AwayNoBet, true, false)
                            </a>    
                        }
                    </td>
                    <!--/Away No Bet-->
                </tr>
                }
            }
        </tbody>
    </table>
</div>
<div class="line">
</div>
@*Footer*@
<div class="footer-content">
    <table class="report-table">
        <thead>
            <tr class="total-footer">
                <td style="width: 34px">
                </td>
                <td style="width: 126px">
                </td>
                <td style="width: 427px" class="score-value">
                    @ViewResources.Total
                </td>
                <td style="width: 135px" class="score-value">@RazorHelper.DecFormat(Model.MainData.Sum(t => t.RunningStakeHomeNoBet), true, false)
                </td>
                <td style="width: 135px" class="score-value">@RazorHelper.DecFormat(Model.MainData.Sum(t => t.RunningStakeDrawNoBet), true, false)
                </td>
                <td style="width: 135px" class="score-value">@RazorHelper.DecFormat(Model.MainData.Sum(t => t.RunningStakeAwayNoBet), true, false)
                </td>
            </tr>
        </thead>
    </table>
</div>
@*/Footer*@ 
@{
    Layout = "~/Views/Desktop/Shared/_ErrorLayout.cshtml";
    Page.Title = "LRF - " + Fanex.Athena.Resources.ViewResources.LocationRestriction;
}

@section head{
    <style>
        .error-content .second-line {
            font-size: 30px;
        }
    </style>

    <script type="text/ecmascript">
        var index = window;
        while (index != index.parent) // Jump out
        {
            index = index.parent;
        }

        var currentLocation = index.location.href.toLowerCase();
        var isSigninPage = currentLocation.indexOf("locationrestriction") >= 0 || currentLocation.indexOf("signin") >= 0;

        if (!isSigninPage) {
            index.location.href = location.href;
        }
    </script>
}

@section message{
    @Fanex.Athena.Resources.ViewResources.LocationRestriction
}

<p>
    @Html.Raw(
            string.Format(Fanex.Athena.Resources.ViewResources.LocationRestrictionMsg,
           "<b style=\"color: Red\">CS ONEONONE </b>(<a href=\"mailto:cs@oneonone-solutions.com\"><b>cs@oneonone-solutions.com</b></a>)"))
</p>
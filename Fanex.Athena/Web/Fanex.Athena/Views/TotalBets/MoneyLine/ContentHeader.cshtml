@using Fanex.Athena.Model.Report.ViewModel
<div class="header-content">
    <table class="report-table">
        <thead>
            <tr class="report-header">
                <td style="width: 3%" rowspan="2">
                    #
                </td>
                <td style="width: 10%" rowspan="2">@ViewResources.Time
                </td>
                <td style="width: 26%" rowspan="2">@ViewResources.Event
                </td>
                <td style="width: 30%" colspan="4">@ViewResources.FullTime
                </td>
                <td style="width: 30%" colspan="4">@ViewResources.lbl1stHalf
                </td>
            </tr>
            <tr class="report-header">
                <td style="width: 7%">@ViewResources.TotalHome
                </td>
                <td style="width: 7%">@ViewResources.TotalAway
                </td>
                <td style="width: 8%">@ViewResources.ForecastHome
                </td>
                <td style="width: 8%">@ViewResources.ForecastAway
                </td>
                <td style="width: 7%">@ViewResources.TotalHome
                </td>
                <td style="width: 7%">@ViewResources.TotalAway
                </td>
                <td style="width: 8%">@ViewResources.ForecastHome
                </td>
                <td style="width: 8%">@ViewResources.ForecastAway
                </td>
            </tr>
        </thead>
    </table>
</div>

@{
    Layout = null;
}

@model IList<Fanex.Athena.Models.DTO.Common.Sport>
@{
    var dllSportList = Model.Select(i => new SelectListItem
    {
        Text = i.SportName,
        Value = i.SportId
        
    }).ToList();
    
    @Html.DropDownList("SelectSport", dllSportList, new { @style = "width:100px" })
}
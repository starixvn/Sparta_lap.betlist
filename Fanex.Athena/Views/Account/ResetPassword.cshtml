@{
    string titleFormat = @"LRF {0} {1} - {2}";
    ViewBag.Title = string.Format(titleFormat, HttpUtility.HtmlDecode("&bull;"),
                                         ViewResources.AccountManagement, ViewResources.ManageAccount);
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using Fanex.Athena.Model.Core.DTO.Users;
@using Fanex.Athena.Model.Report.ViewModel;
@model Fanex.Athena.Model.Core.MetaModel.Account.ResetPasswordMetaModel

@section css {
    @Styles.Render("~/bundles/ResetPasswordViewStyles")
}

@section js {
    <script src="@Url.ContentLink("/Scripts/Account/ResetPassword.js")" type="text/javascript"></script>
}

@using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post, new { id="ResetPasswordForm" }))
{
    <table cellspacing="0" cellpadding="4" border="0">
        <tbody>
            <tr>
                <td width="60px" class="ralign">
                    @Html.LabelFor(m => m.UserName):
                </td>
                <td>
                    <b>@Model.UserName</b>
                </td>
            </tr>
            <tr>
                <td class="ralign">
                    @Html.LabelFor(m => m.FirstName):
                </td>
                <td>
                    <b>@Model.FirstName</b>
                </td>
            </tr>
            <tr>
                <td class="ralign">
                    @Html.LabelFor(m => m.LastName):
                </td>
                <td>
                    <b>@Model.LastName</b>
                </td>
            </tr>
            <tr>
                <td class="ralign">
                    @Html.LabelFor(m => m.Password):
                </td>
                <td>
                    @Html.PasswordFor(m => m.Password)
                    <span style="display:none;" id="rfvPassword">(*)</span>
                </td>
            </tr>
            <tr>
                <td class="ralign">
                    @Html.LabelFor(m => m.ConfirmPassword):
                </td>
                <td>
                    @Html.PasswordFor(m => m.ConfirmPassword)
                    <span style="display:none;" id="rfvConfirm">(*)</span>
                    <span style="display:none;" id="cvConfirm">(Passwords are not identical)</span>
                </td>
            </tr>
            <tr>
                <td>
                </td>
                <td>
                    <input type="button" class="button" id="btnSave" value="Save" name="btnSave">
                    <input type="button" value="Cancel" id="btnCancel" class="button">
                </td>
            </tr>
            <tr>
                <td></td>
                <td>
                    <div id="resultMessage" class="message" style="display: none;"></div>
                </td>
            </tr>
            <tr>
                <td colspan="2">
                    @Html.HiddenFor(m => m.UserId)
                    @Html.HiddenFor(m => m.UserName)
                    @Html.HiddenFor(m => m.FirstName)
                    @Html.HiddenFor(m => m.LastName)
                </td>
            </tr>
        </tbody>
    </table>
}
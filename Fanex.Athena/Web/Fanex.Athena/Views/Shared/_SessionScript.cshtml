
<script type="text/javascript" language="javascript">
    $(document).ready(function () {
        $(function () {
            var lastUpdate = 0;
            var url = (window.location != window.parent.location)
            ? document.referrer
            : document.location.href;
            var sessionUrl = $(url).attr("hostname") + "/ExternalApi/SessionIsAlive";
            var internalSessionUrl='@Url.Content("~/Utility/SessionIsAlive")';
            var internalSignOutUrl='@Url.Content("~/Utility/InternalSignOut")';
            var checkInterval = setInterval(function () {
                if (new Date().getTime() - lastUpdate > 900000) {
                    clearInterval(checkInterval);
                } else {
                    $.getJSON(sessionUrl, function (data) {
                        if(data===true)
                        {
                            $.getJSON(internalSessionUrl, function (data) {
                                if(data===false)
                                {
                                    document.location.href=internalSignOutUrl;
                                }
                            });
                        }
                    });
                }
            }, 900000);

            $(document).keydown(function () {
                lastUpdate = new Date().getTime();
            });
        });
    });

</script>
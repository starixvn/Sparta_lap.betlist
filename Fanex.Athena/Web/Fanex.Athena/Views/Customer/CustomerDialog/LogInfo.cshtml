@using Fanex.Athena.Controllers
@using DNAide.Utils;
@{
    Layout = null;
}
@model Fanex.Athena.Models.ViewModel.Customer.LogInfoViewModel
@{var logInfo = Model.LogInfo;}
<table class="log-info">
    <tr>
        <td colspan="2" class="bold title-text">
            @logInfo.NickName (@logInfo.UserName)
        </td>
    </tr>
    <tr>
        <td class="text-data">
            @ViewResources.CreatedDate
        </td>
        <td class="bold">
            @DateFormat.FullDateFormat(logInfo.CreateDate)
        </td>
    </tr>
    <tr>
        <td class="text-data">
            @ViewResources.LastLogin
        </td>
        <td class="bold">
            @DateFormat.FullDateFormat(logInfo.LastLogged)
        </td>
    </tr>
    <tr>
        <td class="text-data">
            @ViewResources.LastTxn
        </td>
        <td class="bold">
            @DateFormat.FullDateFormat(logInfo.LastTransferDate)
        </td>
    </tr>
    @if (Model.ProductAccess.IsAllowBa)
    {
        <tr>
            <td class="text-data">
                @ViewResources.BAUpdatedBy
            </td>
            <td class="bold">
                @logInfo.BAUpdatedBy
            </td>
        </tr>
        <tr>
            <td class="text-data">
                @ViewResources.LastUpdatedBA
            </td>
            <td class="bold">
                @DateFormat.FullDateFormat(logInfo.LastUpdateBA)
            </td>
        </tr>
    }
    <tr>
        <td class="text-data">
            @ViewResources.SpecialLevel
        </td>
        <td class="bold">
            @logInfo.SpecialLevelUpdateBy
        </td>
    </tr>
    <tr>
        <td class="text-data">
            @ViewResources.LastUpdatedMsg
        </td>
        <td class="bold">
            @DateFormat.FullDateFormat(logInfo.SpecialLevelUpdateDate)
        </td>
    </tr>
</table>
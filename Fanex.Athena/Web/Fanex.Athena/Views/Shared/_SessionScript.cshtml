<script type="text/javascript" language="javascript">
    $(function () {
        var internalSessionUrl = '@Url.Content("~/Utility/SessionIsAlive")';
        var internalSignOutUrl = '@Url.Content("~/Authorization/InternalSignOut")';
        setInterval(function () {
            $.getJSON(internalSessionUrl, function (data) {
                if (data === false) {
                    document.location.href = internalSignOutUrl;
                }
            });
        }, 30000);
    });
</script>
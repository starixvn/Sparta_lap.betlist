@{
    ViewBag.Title = string.Format("LRF - {0}", ViewResources.BetList);
    Layout = "~/Views/Desktop/Shared/_BetListSimpleLayout.cshtml";
}

@using Fanex.Athena.Model.Core.Helper
@model Fanex.Athena.Model.BetList.MetaModel.LiveReportBetListMetaModel
@section pagecss {}
@section pagejs {}
@section ContentTitle
{
    @{
        var matchName = Model.HomeId > 0 && Model.AwayId > 0
                  ? CacheRef.GetTeamName(Model.HomeId) + " vs " + CacheRef.GetTeamName(Model.AwayId) + " - "
                  : string.Empty;
        var betTypeName = CacheRef.GetBettype(Model.BetType);
        if (!string.IsNullOrWhiteSpace(betTypeName))
        {
            betTypeName = betTypeName + " -";
        }
    }
    @ViewResources.BetList - @matchName@CacheRef.GetBettype(Model.BetType) @Model.FromDate.ToShortDateString()<span class="header-title-arrow">→</span>@Model.ToDate.ToShortDateString() - <span class="base-currency">@RazorHelper.ViewBaseCurrency(Model.CurrencyName, Model.BaseCurrency)</span>
}
@section BackButton
{
    <a href="javascript:window.history.back();" class="icon-back"></a>
}
@{
    <input type="hidden" id="ApiUrl" value="api/LiveReportBetList/Match" />
    <input type="hidden" id="BetListMetaModel" value="@Model.ToJson()" />
    <input type="hidden" id="HiddenColumnList" value="" />
}

@{
    Layout = null;

    var sessionService = new Fanex.Athena.Service.Core.Users.SessionService();
    var userSession = sessionService.UserSession;
    var userCurrencies = userSession == null || userSession.CurrencyList == null ?
        new Dictionary<string, string>() :
        userSession.CurrencyList.ToDictionary(x => x.Key.ToString(), x => x.Value);
    var isParasiticMode = userSession != null && userSession.ApplicationMode == Fanex.Athena.Session.Enum.AppMode.Parasitic;
    var appSettings = new AppSettings();
}
<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0">
    <title>@ViewBag.Title</title>
    <meta name="description" content="The Risk & Forecast System" />
    <link href="@Url.ContentLinkByEnv("/www/css/build/reactpages/vendor.css")" rel="stylesheet" type="text/css" />

    @RenderSection("pagecss", required: false)

</head>
<body>
    @Html.AntiForgeryToken()
   
    <div class="wrapper">
        @RenderBody()
    </div>
 
    <script type="text/javascript">
        var PageLanguage = "@System.Globalization.CultureInfo.CurrentUICulture.IetfLanguageTag";
        window.rootUrl = '@Url.Content("~/")';

        @RenderSection("globaljscode", required: false)
    </script>
    <script src="@Url.ContentLinkByEnv("/www/js/build/reactpages/vendors/reactpages.chunk.js")"></script>
    <script src="@Url.ContentLinkByEnv("/www/js/build/reactpages/lib/langHelper.chunk.js")"></script>

    @RenderSection("pagejs", required: false)
    @if (isParasiticMode)
    {
        Html.RenderPartial("~/Views/Desktop/Shared/_SessionScript.cshtml");
    }
    @if (appSettings.Environment.Equals("PRO", StringComparison.OrdinalIgnoreCase))
    {
        <!-- Global site tag (gtag.js) - Google Analytics -->
        <script async src="https://www.googletagmanager.com/gtag/js?id=UA-93927620-1"></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());

            gtag('config', 'UA-93927620-1');
        </script>
    }
</body>
</html>

@using System.Linq
@using Fanex.Athena.Models.ViewModel
@model Fanex.Athena.Models.ViewModel.TotalBets.RacingViewModel
@{
    var leagueList = Model.MainData.RacingDataList
        .Where(x => !x.OddStatus.Equals("suspend"))
        .GroupBy(x => new { x.LeagueId, x.LeagueName, x.OddStatus })
        .Select(x => x.Key)
        .OrderByDescending(x => x.OddStatus)
        .OrderBy(x => x.LeagueName);
}
<div class="data-content">
    <table class="report-table">
        <tbody>
            @foreach (var league in leagueList)
            {
                // Render League name
                <tr>
                    <td class="league" colspan="9">@league.LeagueName.ToUpper()
                    </td>
                </tr>
                var matchOfLeague = Model.MainData.RacingDataList
                                    .Where(x => x.LeagueId == league.LeagueId && x.OddStatus.Equals(league.OddStatus))
                                    .OrderBy(x => x.Race).ToList();

                var rowspan = 0;
                var display = string.Empty;

                // Set row span
                var raceList = matchOfLeague.Select(x => x.Race).Distinct().ToList();
                foreach (var race in raceList)
                {
                    rowspan = 0;
                    foreach (var match in matchOfLeague)
                    {
                        if (match.Race == race)
                        {
                            rowspan++;
                        }
                    }
                    matchOfLeague.Where(x => x.Race == race).First().RowSpan = rowspan;
                }

                // Render match in League
                foreach (var match in matchOfLeague)
                {
                    var curRowspan = match.RowSpan;
                <tr>
                    <td style="width: 10%; display: @(curRowspan == 1 && matchOfLeague.Where(g => g.Race.Equals(match.Race)).Count() > 1 ? "none" : string.Empty)" 
                        class="show-time @(match.OddStatus.ToLower().Equals("running") ? "running-match" : "completed-match")" rowspan="@match.RowSpan"
                        title="@match.OddStatus">
                        <span class="race-number">@match.Race</span>
                        <br />
                        <div class="kick-off-time">
                            <span>@match.KickOffTime.ToString("MM/dd/yyyy")</span>
                            <br />
                            <span>@match.KickOffTime.ToString("hh:mm:ss tt")</span>
                        </div>
                    </td>
                    <td style="width: 8%" class="runner-no">
                        @match.HorseNo
                    </td>
                    <!--Horse Team-->
                    <td style="width: 30%" class="match-name">
                        <a class="team">@match.HorseTeamName</a>
                    </td>
                    <!--/Horse Team-->
                    <!--Win Total-->
                    <td style="width: 8%" class="score-value">
                        @if (match.TotalWin != 0)
                        {
                            <a class="forecast-number-none" data-match-id="@match.MatchId" data-bet-type="31" href="javascript:;">
                                @RazorHelper.NegativeFormat(match.TotalWin, true)
                            </a>
                        }
                        else
                        {
                            @RazorHelper.DecFormat(match.TotalWin, true)
                        }
                    </td>
                    <!--/Win Total-->
                    <!--Win Revenue-->
                    <td style="width: 8%" class="score-value">
                        @RazorHelper.NegativeFormat(match.RevenueWin, true)
                    </td>
                    <!--/Win Revenue-->
                    <!--Place Total-->
                    <td style="width: 8%" class="score-value">
                        @if (match.TotalPlace != 0)
                        {
                            <a class="forecast-number-none" data-match-id="@match.MatchId" data-bet-type="32" href="javascript:;">
                                @RazorHelper.NegativeFormat(match.TotalPlace, true)
                            </a>
                        }
                        else
                        {
                            @RazorHelper.DecFormat(match.TotalPlace, true)
                        }
                    </td>
                    <!--/Place Total-->
                    <!--Place Revenue-->
                    <td style="width: 8%" class="score-value">
                        @RazorHelper.NegativeFormat(match.RevenuePlace, true)
                    </td>
                    <!--/Place Revenue-->
                    <!--Win Place Total-->
                    <td style="width: 8%" class="score-value">
                        @if (match.TotalWinPlace != 0)
                        {
                            <a class="forecast-number-none" data-match-id="@match.MatchId" data-bet-type="33" href="javascript:;">
                                @RazorHelper.NegativeFormat(match.TotalWinPlace, true)
                            </a>
                        }
                        else
                        {
                            @RazorHelper.DecFormat(match.TotalWinPlace, true)
                        }
                    </td>
                    <!--/Place Total-->
                    <!--Win Place Revenue-->
                    <td style="width: 8%" class="score-value">
                        @RazorHelper.NegativeFormat(match.RevenueWinPlace, true)
                    </td>
                    <!--/Place Revenue-->
                </tr>
                }
            }
            <tr class="total-footer">
                <td colspan="3">
                    @ViewResources.Total
                </td>
                <td style="width: 8%" class="score-value">
                    @RazorHelper.DecFormat(Model.MainData.SumTotalWin, true)
                </td>
                <td style="width: 8%" class="score-value">
                    @RazorHelper.DecFormat(Model.MainData.SumRevenueWin, true)
                </td>
                <td style="width: 8%" class="score-value">
                    @RazorHelper.DecFormat(Model.MainData.SumTotalPlace, true)
                </td>
                <td style="width: 8%" class="score-value">
                    @RazorHelper.DecFormat(Model.MainData.SumRevenuePlace, true)
                </td>
                <td style="width: 8%" class="score-value">
                    @RazorHelper.DecFormat(Model.MainData.SumTotalWinPlace, true)
                </td>
                <td style="width: 8%" class="score-value">
                    @RazorHelper.DecFormat(Model.MainData.SumRevenueWinPlace, true)
                </td>
            </tr>
        </tbody>
    </table>
</div>
<div class="line">
</div>

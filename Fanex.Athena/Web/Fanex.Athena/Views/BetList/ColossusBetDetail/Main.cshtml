@{
    ViewBag.Title = string.Format("LRF - {0}", ViewResources.BetList);
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section css{
   <link href="@Url.ContentLink("/Content/Global/lrf.global.reportable.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.ContentLink("/Content/BetList/colossusbetdetail.css")" rel="stylesheet" type="text/css" />
}
@model Fanex.Athena.Model.BetList.ViewModel.ColossusBetDetailViewModel
<div class="content-wrapper">
    <div class="left">
        <iframe src="@Model.IframeUrl"></iframe>
    </div>
    <div class="middle"></div>
    <div class="right">
        <p>Member owned 80% of ticket</p>
        <p>Member sold 20% of ticket for 2,000.00</p>
        <table class="report-table table-detail">
            <tr class="report-header">
                <th>@ViewResources.Date</th>
                <th>Transaction Type</th>
                <th>@ViewResources.WinLoss</th>
                <th>@ViewResources.Commission</th>
            </tr>
            @foreach (var item in Model.DataList)
            {
                <tr>
                    <td class="col-date">@item.TransDate</td>
                    <td class="col-trans">@item.TransactionType</td>
                    <td class="col-winloss">@Html.Raw(item.WinLoss)</td>
                    <td class="col-comm">@item.Commission</td>
                </tr>
            }
            <tr class="total-row">
                <td colspan="2">@ViewResources.Total</td>
                <td>100</td>
                <td>100</td>
            </tr>
        </table>
    </div>
</div>
@model Fanex.Athena.Models.ViewModel.Report.PlaytechCasinoViewModel
@{
    var param = Model.Param;
}
@if (Model.Param.Level > 0)
{
    <div class="breadCrumbHolder module" style="width:@ViewBag.WrapperWidth@("px");">
        <div class="breadCrumb module" id="level-link-container" style="width:@ViewBag.WrapperWidth@("px");">
            <ul>
                <li data-level="0" class="level-link">@ViewResources.Main</li>
                @if (Model.Param.Level == 1)
                {
                    <li data-level="1" class="current-level">@ViewResources.Licensee</li>
                }
                @if (Model.Param.Level == 2)
                {
                    if (Model.Param.LicenseeId == 1)
                    {
                    <li data-level="1" class="level-link">@ViewResources.Licensee</li>
                    }
                    <li data-level="2" class="current-level">@ViewResources.Customer </li>
                }
            </ul>
        </div>
    </div>
}
<div class="report-title" style="width:@ViewBag.TitleWidth@("px");">
    @ViewResources.PlaytechCasino @ViewResources.WinLoss,
    @RazorHelper.TitleDateTime(param.Level == 0 ? param.FromDate : param.DrillDownFromDate, param.Level == 0 ? param.ToDate : param.DrillDownToDate)
    - @RazorHelper.ViewCurrencyBasedOnConverter(param.IsConvert, param.BaseCurrency, string.IsNullOrEmpty(param.CurrencyName) ? ViewResources.AllCurrencies : param.CurrencyName)
    <div style="float: right;">
        @using (Html.BeginForm("PlaytechCasinoWinloss", "Report", FormMethod.Post, new { @id = "PlaytechCasinoExcelForm" }))
        {
            <input type="hidden" name="CurrencyId" value="@Model.Param.CurrencyId" />
            <input type="hidden" name="FromDate" value="@Model.Param.FromDate" />
            <input type="hidden" name="ToDate" value="@Model.Param.ToDate" />
            <input type="hidden" name="ReportBy" value="@Model.Param.ReportBy" />
            <input type="hidden" name="Level" value="@Model.Param.Level" />
            <input type="hidden" name="IsExcludedTestData" value="@Model.Param.IsExcludedTestData" />
            <input type="hidden" name="DrillDownCurrency" value="@Model.Param.DrillDownCurrency" />
            <input type="hidden" name="DrillDownFromDate" value="@Model.Param.DrillDownFromDate" />
            <input type="hidden" name="DrillDownToDate" value="@Model.Param.DrillDownToDate" />
            <input type="hidden" name="IsExportExcel" value="true" />           
        }
        <input alt="@ViewResources.ExportToExcel" src="@Url.ContentLink("/Content/Global/Images/excel.gif")"
               type="image" id="ExportToExcel" name="exporttoexcel"
               title="@ViewResources.ExportToExcel" class="hand" />
    </div>
</div>

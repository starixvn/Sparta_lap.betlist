@using Fanex.Athena.Models.ViewModel
@using Fanex.Athena.Model.Core.MetaModel.Product
@model Fanex.Athena.Model.BetList.MetaModel.BetListMetaModel
@using (Html.BeginForm("DailyBetList", "BetList", FormMethod.Post, new { @id = "DailyBetListForm" }))
{
    // Only restrict from date for Bet List
    var minDate = Model.BetListName == "betlist" ? Model.MoveBetsDay.AddDays(1) : Fanex.Athena.Extension.Utility.AppSettings.HistoryDate;
    <div class="grid_3 filter-input" style="padding: 5px">
        @{
    var viewOptionTextList = new Dictionary<string, string>{
        {"dailystatement",ViewResources.DailyStatement },
        {"betlist",ViewResources.BetList },
        {"betlistrunning",ViewResources.BetListRunning }
    };
    var viewOptionSelectList = viewOptionTextList.Select(c => new SelectListItem
    {
        Value = c.Key,
        Text = c.Value,
        Selected = c.Key == Model.BetListName
    });
            @Html.DropDownList("ViewOption", viewOptionSelectList, new { @style = "width: 123px;" })
        }
    </div>

    @DatePickerHelper.RenderDateRangePicker(Model.FromDate, Model.ToDate, minDate, AppSettings.MaxDate, "", "", 2, 3, 1, 3)

    
    @RazorHelper.RenderProductFilter(Model.ProductOptions, 2)

    <div class="grid_2 filter-input">
        <input type="button" id="SubmitButton" value="@ViewResources.Submit" class="button" />
    </div>
    
    if (Model.BetListName == "dailystatement")
    {
        <div class="grid_7"> </div>
        <div class="grid_1" style="float: right">
            @{Html.RenderAction("Index", "Note", new { viewName = "DailyStatement" });}
        </div>
    }

    <input type="hidden" name="LicenseeId" id="LicenseeId" value="@Model.LicenseeId"/>
    <input type="hidden" name="IsExportExcel" id="IsExportExcel" value="" />
}

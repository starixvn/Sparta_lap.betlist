<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0">

    <title>@ViewBag.Title</title>

    <link href="https://fonts.googleapis.com/css?family=Roboto" rel="stylesheet">
    <link href="~/www/assets/font-icon/style.css" rel="stylesheet" />
    <link href="~/www/css/build/vendors/bootstrap.css" rel="stylesheet" />
    <link href="~/www/css/build/vendors/bootstrap-extend.css" rel="stylesheet" />
    <link href="~/www/css/build/site.min.css" rel="stylesheet" />
    @RenderSection("css", required: false)
</head>
<body class="site-menubar-unfold">
    <input type="hidden" id="RootUrl" value="@Url.Content("~/")" />
    <input type="hidden" id="PageLanguage" value="@System.Globalization.CultureInfo.CurrentUICulture.IetfLanguageTag" />
    @RenderBody()
    <script src="~/Scripts/Languages/ViewResources.js"></script>
    <script src="~/Scripts/Languages/ViewResources.zh-CN.js"></script>
    <script src="~/Scripts/Languages/ViewResources.zh-TW.js"></script>
    <script src="~/Scripts/Languages/ViewResources.zh-Hans.js"></script>
    <script src="~/Scripts/Languages/ViewResources.ko-KR.js"></script>
    <script src="~/www/js/build/vendors.chunk.js"></script>
    @RenderSection("js", required: false)
</body>
</html>
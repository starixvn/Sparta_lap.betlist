@{
    Layout = null;
}
@model Fanex.Athena.Model.Report.ViewModel.CustomerWinLossViewModel
@{
    var minDate = DateTime.Today.AddDays(-90);
    var modelParam = Model.Param;
    var appSettings = new AppSettings();
}
<div class="grid_26 content-filter new-line" style="width:@(ViewBag.FilterWidth)px;">
    <form id="CustomerWinlossForm" action="post">
        @Html.AntiForgeryToken()
        @DatePickerHelper.RenderDateRangePicker(modelParam.FromDate, modelParam.ToDate, minDate, appSettings.MaxDate, "", "", 2, 4, 2, 7)
        @if(Model.IsFakeLicensee)
        {
            <div class="new-line"></div>
        }
        <div class="grid_2 filter-label">
            <label>@ViewResources.Currency</label>
        </div>
        <div class="grid_3 filter-input">
            @RazorHelper.CurrencyList(Model.CurrencyList, "currencylist")
        </div>
        <div class="grid_3 filter-label">
            <label for="BaseCurrency">
                @ViewResources.Based
            </label>
        </div>
        <div class="grid_1 filter-input">
            @RazorHelper.BasedCurrency()
        </div>
        <div class="grid_2 note-group">
            @if (!Model.IsFakeLicensee)
            {
            <div>
                <div class="userguide-icon" id="UserGuide" title="@ViewResources.UserGuide">
                </div>
            </div>
            }
            <div>
                <input alt="@ViewResources.ExportToExcel" src="@Url.ContentLink("/Content/Global/Images/excel.gif")"
                       type="image" id="ExportToExcel" name="exporttoexcel"
                       title="@ViewResources.ExportToExcel" class="hand" />
            </div>
        </div>
        <div class="new-line"></div>
        @if (!Model.IsFakeLicensee)
        {
            <div class="grid_2 filter-label">
                <label>
                    @ViewResources.Username
                </label>
            </div>
            <div class="grid_4 filter-input" style="margin-right: 0px; width: 155px;">
                @Html.TextBox("Username", Model.Param.Username, new { })
            </div>
        }    
        @RazorHelper.RenderProductFilter(modelParam.ProductOptions, 2, false)
        <div class="grid_3 filter-label">
            <label for="IsExcludedTestData">
                @ViewResources.ExcludeTestData
            </label>
        </div>
        <div class="grid_5 filter-input option-list">
            <input type="checkbox" value="true" @(Model.Param.IsExcludedTestData == true ? "checked=checked" : "") name="IsExcludedTestData" id="IsExcludedTestData" />
        </div>
        <div class="grid_2 filter-label new-line">
        </div>
        <div class="grid_15 filter-input">
            <div class="note-message">
                @string.Format(ViewResources.HistoricalReportDateRangeNote, minDate),
                <a href="javascript:;" id="history-report-link" style="text-decoration: none;">@ViewResources.ToViewHistoryRptMsg</a>
            </div>
        </div>
        <div class="grid_2 filter-label new-line">
            &nbsp;
        </div>
        <div class="grid_2 filter-input">
            <input type="button" id="SubmitButton" value="@ViewResources.Submit" class="button" />
        </div>     
    </form>
    @Html.Hidden("IsAllowedCustomerCommission", Model.IsAllowedCustomerCommission)
    @Html.Hidden("IsAllowedBA", Model.ProductAccess.IsAllowBA)
    @Html.Hidden("IsAllowedRB", Model.ProductAccess.IsAllowRB)
</div>
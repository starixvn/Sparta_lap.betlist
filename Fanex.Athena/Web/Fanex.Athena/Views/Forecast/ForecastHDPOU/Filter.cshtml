@using Fanex.Athena.Model.Report.ViewModel
@model Fanex.Athena.Model.Forecast.ViewModel.ForecastHdpOuViewModel
@using (Html.BeginForm("Index", "ForecastHandicapOverUnderForecast", FormMethod.Post, new { @id = "ForecastHandicapOverUnderForm" }))
{
    // ----------------------------- Hidden field -----------------------------//
    <div>
        @Html.Hidden("CurrencyId-Hidden", Model.Param.CurrencyId)
        @Html.Hidden("LicenseeType-Hidden", Model.Param.LicenseeType)
        @Html.Hidden("IsConvert-Hidden", Model.Param.IsConvert)
        @Html.Hidden("IsPopup", Model.Param.IsPopUp)
    </div>
    // ----------------------------- Hidden field -----------------------------//

    // -----------------------------Refresh countdown------------------------ //
    <div class="grid_3">
        @RazorHelper.TimerCountDown("forecasthdpou", 15)
    </div>
    // -----------------------------Refresh countdown------------------------ //

    // ----------------------------Type of licensee------------------------//
    if (@Model.LicenseeTypeList.Count > 0)
    {
    <div class="grid_1 filter-label" style="width: 25px">
        @ViewResources.Type
    </div>
    <div class="grid_3 filter-input">
        @RazorHelper.LicenseeType(Model.LicenseeTypeList, "licenseetype", Model.Param.LicenseeType)
    </div>
    }

    // -----------------------------Currency-------------------------------//
    <div class="grid_2 filter-label" style="width: 50px">
        @ViewResources.Currency
    </div>
    <div class="grid_3 filter-input" style="width: 110px">
        @RazorHelper.CurrencyList(Model.CurrencyList, "currencylist", Model.Param.CurrencyId)
    </div>
    <div class="grid_4 filter-input">
        <label for="BaseCurrency">@ViewResources.Based </label>
        @RazorHelper.BasedCurrency(Model.Param.BaseCurrency)
    </div>

    <div class="grid_2 filter-input">
        <input type="button" id="SubmitButton" value="@ViewResources.Submit" class="button" />
    </div>
    <div class="grid_1 note-group">
        <div class="userguide-icon" id="UserGuide" title="@ViewResources.UserGuide">
        </div>
    </div>
    <div class="clear">
    </div>

@*Render league list*@
    if (Model.Param.LeagueId != 0)
    {
        var leagueSelectedListItem = Model.LeagueList.Select(l => new SelectListItem
        {
            Text = l.LeagueName,
            Value = l.LeagueId.ToString(),
            Selected = l.LeagueId == Model.Param.LeagueId
        });
    <div class="grid_2 filter-label left-text" style="width: 45px">@ViewResources.League</div>
    <div class="grid_4 filter-input">
        @Html.DropDownList("LeagueId", leagueSelectedListItem, new { @class = "league-list", @data_original = Model.Param.LeagueId })
    </div>
    }
}
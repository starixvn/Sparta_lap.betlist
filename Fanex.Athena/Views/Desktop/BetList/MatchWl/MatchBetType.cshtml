@{
    ViewBag.Title = string.Format("LAP - {0}", ViewResources.BetList);
    Layout = "~/Views/Desktop/Shared/_BetListSimpleLayout.cshtml";
}

@using Fanex.Athena.VendorAdapter;
@using Fanex.Athena.Model.Core.Helper
@model Fanex.Athena.Model.BetList.MetaModel.BetListMetaModel
@{
    var _cacheRefAdapter = new CacheRefAdapter();
}
@section ContentTitle
{
    @{
        var matchName = Model.HomeId > 0 && Model.AwayId > 0
                ? _cacheRefAdapter.GetTeamName(Model.HomeId) + " vs " + _cacheRefAdapter.GetTeamName(Model.AwayId) + " - "
                : string.Empty;
        var bettypeName = Model.BetType > 0 ? _cacheRefAdapter.GetBettype(Model.BetType) + " - " : string.Empty;
    }

    @ViewResources.BetList - @matchName @bettypeName @Model.FromDate.ToShortDateString()
    - <span class="base-currency">@DesktopRazorHelper.ViewBaseCurrency(Model.CurrencyName, Model.BaseCurrency)</span>
}
@section BackButton
{
    <a href="javascript:window.history.back();" class="icon-back"></a>
}
@{
    <input type="hidden" id="BetListMetaModel" value="@Model.ToJson()" />
    <input type="hidden" id="HiddenColumnList" value="" />
    <input type="hidden" id="IsServerPaging" value="1" />
    <input type="hidden" id="ApiUrl" value="api/MatchWinLossBetList/MatchBetType" />
}

@using System.Globalization
@using Fanex.Athena.Models.ViewModel
@model Fanex.Athena.Models.ViewModel.Forecast.ForecastAhViewModel
@{
    var fcValue = Model.ForecastValue;
}
@Html.Hidden("IsPopUp", true)
<table class="report-table" id="forecast-table"
       data-match-id="@Model.Param.MatchId"
       data-bettype="@Model.Param.BetType"
       data-licenseetype="@Model.Param.LicenseeType"
       data-basecurrency="@Model.Param.BaseCurrency"
       data-currencyid="@Model.Param.CurrencyId"
       data-currencyname="@Model.Param.CurrencyName"
      
       >
    <tbody>
        <tr>
            <td style="width: 20%" class="middle-text forecast-name">@Model.ForecastHeaderParam.ForecastName
            </td>
            <td class="middle-text" colspan="3">
                <!--Render forecast link-->
                @foreach (var item in fcValue.ForeCastLink)
                {
                    <a href="javascript:;" data-current-score="@item" data-bettype="@Model.Param.BetType"
                       class="forecast-link @(Model.Param.CurrentScore.ToString(CultureInfo.InvariantCulture).Equals(item) ? "current-score" : string.Empty)">
                        @item
                    </a>
                }
                <!--/Render forecast link-->
            </td>
            <td class="middle-text">
                <tt>
                    <input type="text" id="txt-currentscore" onkeyup="javascript:Forecast.currentScoreKeyUp(event)"
                        class="txt-currentscore" />
                </tt><tt>
                    <input type="button" id="btn-currentscore" onclick="javascript:Forecast.setCurrentScore()"
                        value="@ViewResources.Go" class="btn-currentscore" />
                </tt>
            </td>
        </tr>
        <tr>
            <!--Forecasr header number-->
            <td style="width: 20%" class="middle-text">@fcValue.ForecastHeader[4]
            </td>
            <td style="width: 20%" class="middle-text">@fcValue.ForecastHeader[3]
            </td>
            <td style="width: 20%" class="middle-text">@fcValue.ForecastHeader[2]
            </td>
            <td style="width: 20%" class="middle-text">@fcValue.ForecastHeader[1]
            </td>
            <td style="width: 20%" class="middle-text">@fcValue.ForecastHeader[0]
            </td>
            <!--/Forecasr header number-->
        </tr>
        <tr>
            <td style="width: 20%" class="middle-text">@RazorHelper.PositiveFormat(fcValue.ForeCastValue4, true, false)
            </td>
            <td style="width: 20%" class="middle-text">@RazorHelper.PositiveFormat(fcValue.ForeCastValue3, true, false)
            </td>
            <td style="width: 20%" class="middle-text">@RazorHelper.PositiveFormat(fcValue.ForeCastValue2, true, false)
            </td>
            <td style="width: 20%" class="middle-text">@RazorHelper.PositiveFormat(fcValue.ForeCastValue1, true, false)
            </td>
            <td style="width: 20%" class="middle-text">@RazorHelper.PositiveFormat(fcValue.ForeCastValue0, true, false)
            </td>
        </tr>
        <tr>
            <td colspan="5">
                <div>
                    <a href="javascript:;" class="view-betlist" data-bettype="@Model.Param.BetType">@ViewResources.BetList</a>
                </div>
                <div class="view-forecast">
                    <a href="javascript:;" class="view-forecast-link"  data-bettype="@ViewBag.SwitchBetType">@ViewResources.View
                        @(ViewBag.BetTypeName)
                        @ViewResources.Forecast</a>
                </div>
            </td>
        </tr>
    </tbody>
</table>
<div class="clear">
</div>

@model Fanex.Athena.Model.Customer.ViewModel.CustomerLog.CustomerLogViewModel

@{
    var beginOfMonth = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    var minDate = beginOfMonth.AddMonths(-18);
}

@using (Html.BeginForm("GroupCommission", "CustomerLog", FormMethod.Post, new { @id = "SearchForm" }))
{
    @Html.AntiForgeryToken()

    <div class="row">
        @DesktopRazorHelper.MonthPicker(Model.Param.FromDate, Model.Param.ToDate)

        <div class="col l2 m2 s12 button-block">
            <button type="button" id="SubmitButton" class="btn btn-primary">@ViewResources.Submit</button>
        </div>

        <div class="input-field col l2 m2 s12">
            <input id="showall" type="checkbox" checked="checked" />
            <label for="showall">@ViewResources.ShowOldValue</label>
        </div>

        <div class="col right icon-block">
            <i class="icon-book right" id="UserGuide" title="@ViewResources.UserGuide"></i>
        </div>
    </div>

    <input type="hidden" id="MinDate" value="@minDate.ToString("MM/dd/yyyy")" />
}
@model Fanex.Athena.Model.Report.ViewModel.LiveReports.LiveReportViewModel
@{
    var minDate = DateTime.Today.AddMonths(-3).AddDays(1 - DateTime.Today.Day);
}

<div class="page-form">
    <form id="livereport" name="livereport" method="post" action="@Url.Content("~/LiveReport?isViewedHistory=false")">
        @Html.AntiForgeryToken()
        <div class="row">
            @*<div class="input-field input col l2 m3 s12 calendar">
                    <input name="DateRange"
                           data-original-from="@Model.Param.FromDate.ToString("MM/dd/yyyy")"
                           data-original-to="@Model.Param.ToDate.ToString("MM/dd/yyyy")"
                           id="DateRange" class="datepicker" type="text" value="@Model.Param.FromDate.ToString("MM/dd/yyyy")">
                    <input name="FromDate" id="FromDate" type="hidden" />
                    <input name="ToDate" id="ToDate" type="hidden" />

                    <label for="DateRange" class="active">@ViewResources.Date</label>
                    <span class="icon icon-calendar"></span>
                </div>*@
            <div class="input-field input col l2 m3 s12 calendar">
                <input name="FromDate" id="FromDate" type="text" class="datepicker">
                <label for="FromDate" class="active">From</label>
                <span class="icon icon-calendar"></span>
            </div>
            <div class="input-field input col l2 m3 s12 calendar">
                <input name="ToDate" id="ToDate" type="text" class="datepicker">
                <label for="ToDate" class="active">To</label>
                <span class="icon icon-calendar"></span>
            </div>
            <div class="input-field col l2 m3 s12">
                @RazorHelper.CurrencyList(Model.CurrencyList, string.Empty, Model.Param.CurrencyId)
                <label>@ViewResources.Currency</label>
            </div>
            <div class="input-field col l2 m3 s12">
                @RazorHelper.BasedCurrency(Model.Param.BaseCurrency, Model.Param.CurrencyName)
                <label>@ViewResources.Based</label>
            </div>
            <div class="input-field col l2 m3 s12">
                @RazorHelper.LiveStatus(Model.Param.LiveIndicator)
                <label>@ViewResources.LiveStatus</label>
            </div>
            <div class="col button-block">
                <input type="submit" value="@ViewResources.Submit" class="waves-effect waves-light btn btn-primary" />
            </div>
        </div>
        <div class="row">
            <div class="col">
                <span class="circle"></span>
                <span>
                    @string.Format(ViewResources.HistoricalReportDateRangeNote, minDate),
                    <a data-history-mode="False" id="switchreport" href="javascript:;">
                        @ViewResources.ToViewHistoryRptMsg
                    </a>
                </span>
            </div>
        </div>

        <input type="hidden" name="ProductCode" id="ProductCode" />
        <input type="hidden" name="IsExportExcel" id="IsExportExcel" value="false" />
    </form>
</div>

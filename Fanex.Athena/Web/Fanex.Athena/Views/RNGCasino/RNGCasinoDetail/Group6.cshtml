@{
    Layout = null;
    // Game type: Journey to the West
}
<link href="@Url.ContentLink("/Content/RNGCasino/rng-casino-hand-history.css")" rel="stylesheet" type="text/css" />
@model Fanex.Athena.Model.Casino.ViewModel.CasinoHandHistoryDetailViewModel
@{
    var headerItem = Model.CasinoDetailHeaderList.FirstOrDefault();
    var hitItem = Model.CasinoDetailHeaderList.Where(x => x.ShowType.Trim() == "Result_HitBetLine" || x.ShowType.Trim() == "Result_HitScatter");
    var kidnappingItem = Model.CasinoDetailHeaderList.Where(x => x.ShowType.Trim() == "Result_Kidnapping");
}
<table style="width: 100%;" class="casino-detail-table" cellpadding="0" cellspacing="0">
    <tr class="detail-header-row">
        <td class="game-type-text" colspan="6">@Model.Param.GameTypeName - @headerItem.BetTime
        </td>
    </tr>
    <tr class="player-total-row">
        <td colspan="6">
            @ViewResources.Player: @headerItem.UserName - @string.Format(ViewResources.Viewin,Model.Param.CurrencyName)
        </td>
    </tr>
    <tr class="detail-header-row">
        <td colspan="6">@headerItem.ResultName
        </td>
    </tr>
    <tr>
        <td colspan="6">
            @if (!string.IsNullOrEmpty(headerItem.Result))
            {
                @Html.Raw(headerItem.Result.Replace("/Form", Url.Content("~/") + "Form"))
            }
        </td>
    </tr>
    <tr>
        <td>@ViewResources.PlayerHistoryNo
        </td>
        <td class="align-left" colspan="5">@Model.Param.PlayerHistoryNo
        </td>
    </tr>
    <tr>
        <td>@ViewResources.AutoSpin
        </td>
        <td class="align-left" colspan="5">
            @headerItem.AutoSpinResult
        </td>
    </tr>
    @if (hitItem.Count() > 0)
    {
        <tr class="player-total-row">
            <td colspan="6">
                @ViewResources.Normal @ViewResources.Name
            </td>
        </tr>
        <tr class="detail-header-row">
            <td>@ViewResources.Name
            </td>
            <td>@ViewResources.Symbol
            </td>
            <td>@ViewResources.CoinSize
            </td>
            <td>@ViewResources.BetPerLine
            </td>
            <td>@ViewResources.Odds
            </td>
            <td>@ViewResources.PerLineWin
            </td>
        </tr>
        foreach (var item in hitItem)
        {
        <tr>
            <td>@Html.Raw(item.LineNo.Replace("/img", Url.Content("~/") + "img"))
            </td>
            <td>
                @Html.Raw(item.Symbol.Replace("/img", Url.Content("~/") + "img"))
            </td>
            <td class="align-right">@item.CoinSizeBaseCurrencyValue.ToStringExt()
            </td>
            <td class="align-right">@item.BetPerLine
            </td>
            <td class="align-right">@item.Odds
            </td>
            <td class="align-right">@item.WinBaseCurrencyValue.ToStringExt()
            </td>
        </tr>             
        }
        var subItem = Model.CasinoDetailHeaderList.Where(x => x.ShowType.Trim() == "Result_SubWin").FirstOrDefault();
        if (subItem != null)
        {
        <tr>
            <td>@subItem.ActionName
            </td>
            <td colspan="5" class="align-right">@subItem.WinBaseCurrencyValue.ToStringExt()
            </td>
        </tr>
        }
    }
    @if (kidnappingItem.Count() > 0)
    {
        <tr>
            <td colspan="6">@ViewResources.Kidnapping @ViewResources.Game
            </td>
        </tr>
        <tr class="detail-header-row">
            <td>@ViewResources.Name
            </td>
            <td>@ViewResources.Symbol
            </td>
            <td>@ViewResources.Multiplier
            </td>
            <td colspan="3">@ViewResources.Kidnapping @ViewResources.Game @ViewResources.Win
            </td>
        </tr>
        foreach (var item in kidnappingItem)
        {
        <tr>
            <td>@item.ActionName
            </td>
            <td>@Html.Raw(item.Symbol.Replace("/img", Url.Content("~/") + "img"))
            </td>
            <td class="align-right">@item.Multiplier
            </td>
            <td class="align-right" colspan="3">@item.WinBaseCurrencyValue.ToStringExt()
            </td>
        </tr>     
        }
        var subItem = Model.CasinoDetailHeaderList.Where(x => x.ShowType.Trim() == "Result_SubWin").FirstOrDefault();
        if (subItem != null)
        {
        <tr>
            <td>@subItem.ActionName
            </td>
            <td colspan="5" class="align-right">@subItem.WinBaseCurrencyValue.ToStringExt()
            </td>
        </tr>
        }
    }
    <tr class="player-total-row">
        <td class="align-left">@ViewResources.Total @ViewResources.Bet
        </td>
        <td colspan="5" class="align-right">@Model.CasinoDetailList.Sum(p => p.Bet).ToStringExt()
        </td>
    </tr>
    <tr class="player-total-row">
        <td class="align-left">@ViewResources.Total @ViewResources.Win/@ViewResources.Loss
        </td>
        <td colspan="5" class="align-right">@Model.CasinoDetailList.Sum(p => p.WinLoss).ToStringExt()
        </td>
    </tr>
</table>

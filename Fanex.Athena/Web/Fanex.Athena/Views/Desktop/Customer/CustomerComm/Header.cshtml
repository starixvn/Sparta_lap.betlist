<div class="header-content">
    @using (Html.BeginForm("ExportExcel", "CustomerComGroup", FormMethod.Post, new { @id = "CommissionGroupForm" }))
    {
        @Html.AntiForgeryToken()
        <div class="row">
            <div class="col">
                <span class="circle"></span>
                <span>
                    @ViewResources.GroupCommNote
                </span>
            </div>
        </div>
        <div class="row">
            <div class="col l2 m2 s12 button-block">
                <a id="NewGroupButton" class="btn btn-back" href="@Url.Action("Create", "CustomerComGroup")" title="@ViewResources.CreateNewGroup">@ViewResources.NewGroup</a>
            </div>
            <div class="col icon-block">
                <i class="icon-book right" id="UserGuide" title="@ViewResources.UserGuide"></i>
                <i class="icon-excel right" title="@ViewResources.ExportToExcel" id="ExportToExcel"></i>
            </div>
        </div>
    }
</div>
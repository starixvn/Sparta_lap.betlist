@using Fanex.Athena.Model.Report.ViewModel
<div class="header-content">
    <table class="report-table">
        <thead>
            <tr class="report-header">
                <td style="width: 34px" rowspan="2">
                    #
                </td>
                <td style="width: 126px" rowspan="2">@ViewResources.Time
                </td>
                <td style="width: 427px" rowspan="2">@ViewResources.Event
                </td>
                <td style="width: 413px" colspan="3">@ViewResources.FullTime
                </td>
            </tr>
            <tr class="report-header">
                <td style="width: 135px">@ViewResources.HomeNoBet
                </td>
                <td style="width: 135px">@ViewResources.DrawNoBet
                </td>
                <td style="width: 135px">@ViewResources.AwayNoBet
                </td>
            </tr>
        </thead>
    </table>
</div>

@using System.Web.Mvc;
@using System.Web.WebPages;
@using Fanex.Athena.Models.ViewModel;
@using Fanex.Athena.Extension.Helper;
@helper NegativeFormat(decimal value, bool isHiglight = true)
    {
    <span@(isHiglight && value < 0 ? new HtmlString(" class='negative'") : new HtmlString(""))>@value.ToStringExt()</span>
}
@helper WriteDropString(string str, int numOfDisplay)
{
    var extStr = numOfDisplay < str.Length ? "..." : string.Empty;
    numOfDisplay = Math.Min(numOfDisplay, str.Length);
    var temp = str.Substring(0, numOfDisplay) + extStr;
    <span>@temp</span>
}

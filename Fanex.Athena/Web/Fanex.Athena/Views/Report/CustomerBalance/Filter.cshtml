@model Fanex.Athena.Model.Report.ViewModel.CustomerBalanceViewModel
@{ 
    var appSettings = new AppSettings();
}
<div class="grid_26 content-filter new-line" style="width:@(ViewBag.FilterWidth)px;">
    @using (Html.BeginForm("Index", "CustomerBalanceReport", FormMethod.Post, new { @id = "CustomerBalanceForm" }))
    {
        @Html.AntiForgeryToken()
        var minDate = DateTime.Now.AddMonths(-18).AddDays(1 - DateTime.Now.Day);
        @DatePickerHelper.RenderDateRangePicker(Model.Param.FromDate, Model.Param.ToDate, minDate, appSettings.MaxDate, "", "", 3, 3, 2, 3)
        <div class="grid_3 filter-label">
            <label for="IsExcludeTest">@ViewResources.ExcludeTestData</label>
        </div>
        <div class="grid_1 filter-input">
            @Html.CheckBox("IsExcludeTest", Model.Param.IsExcludeTest)
        </div>
        <div class="new-line">
        </div>
        <div class="grid_3 filter-label">
            <label>@ViewResources.Currency</label>
        </div>
        <div class="grid_2 filter-input">
            @RazorHelper.CurrencyList(Model.CurrencyList, "", Model.Param.CurrencyId, false)
        </div>
        
        <div class="grid_2 note-group">
            <div>
                <div class="userguide-icon" id="UserGuide" title="@ViewResources.UserGuide">
                </div>
            </div>
            <div>
                <input alt="@ViewResources.ExportToExcel" src="@Url.ContentLink("/Content/Global/Images/excel.gif")"
               type="image" id="ExportToExcel" name="exporttoexcel"
               title="@ViewResources.ExportToExcel" class="hand" />
            </div>
        </div>
        <div class="grid_3 filter-label">
            <label>@ViewResources.SelectTop</label>
        </div>
        <div class="grid_3 filter-input">
            @Html.DropDownList("TopCount", ViewBag.TopCountList as List<SelectListItem>, new { })
        </div>
        <div class="grid_2 filter-label">
            <label>@ViewResources.SortBy</label>
        </div>
        <div class="grid_4 filter-input">
            @Html.DropDownList("OrderItem", ViewBag.OrderItemList as List<SelectListItem>, new { @style = "width: 110px;" })
        </div>
        @RazorHelper.RenderProductFilter(Model.Param.ProductOptions, 3)
        <div class="grid_3 filter-label new-line">
            &nbsp;</div>
        <div class="grid_2 filter-input">
            <input type="submit" value="@ViewResources.Submit" id="SubmitButton" class="button blockui" />
        </div>
@*End Row 4*@
@*End Row 5*@    
        <div>
            <input type="hidden" id="IsExportExcel" name="IsExportExcel" value="@Model.Param.IsExportExcel" />
        </div>
    }
</div>

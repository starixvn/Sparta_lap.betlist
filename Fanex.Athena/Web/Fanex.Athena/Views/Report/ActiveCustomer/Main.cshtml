@model Fanex.Athena.Models.ViewModel.Report.ActiveCustomerViewModel
@{
    ViewBag.Title = "LRF - " + ViewResources.Report +
    " - " + ViewResources.ActiveCustomer;
    Layout = "~/Views/Shared/_Report.jqGridLayout.cshtml";
}
@section pagecss {    
    <link href="@Url.ContentLink("/Content/Report/licenseewinloss.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.ContentLink("/Content/Plugin/Common/bread-crumb.css")" rel="stylesheet" type="text/css" />
}
@section pagejs {
    <script src="@Url.ContentLink("/Scripts/Report/activecustomer.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Report/activecustomer.option.js")" type="text/javascript"></script>
}
@section ContentTitle
    {
    @ViewResources.ActiveCustomerSummary
}
<div class="container_26" style="margin-left: -7px">
    <div class="grid_26">
        @{
            Html.RenderPartial("~/Views/Report/ActiveCustomer/Content.cshtml");
        }
    </div>
  
</div>
@section ContentFilter
{
    @{Html.RenderPartial("~/Views/Report/ActiveCustomer/Filter.cshtml");}
}


@{
    ViewBag.Title = string.Format("LRF - {0} - {1} {2}", ViewResources.Report, ViewResources.PlaytechCasino, ViewResources.WinLoss);
    Layout = "~/Views/Shared/_ReportTableLayout.cshtml";
}
@using Fanex.Athena.Models.ViewModel
@using Fanex.Athena.Models.DTO.Common
@model Fanex.Athena.Models.ViewModel.Report.PlaytechCasinoViewModel
@section pagecss {
    <link href="@Url.ContentLink("/Content/Plugin/DateRangePicker/daterangepicker.css")" rel="stylesheet" type="text/css" />

    <link href="@Url.ContentLink("/Content/Plugin/Common/bread-crumb.css")" rel="stylesheet" type="text/css" />
}
@section pagejs {
    <script src="@Url.ContentLink("/Scripts/Plugin/DateRangePicker/daterangepicker.js")" type="text/javascript"></script>

    <script src="@Url.ContentLink("/Scripts/Report/playtechcasino.js")" type="text/javascript"></script>
}
@section ContentTitle
{
    @(ViewResources.PlaytechCasino + " " + ViewResources.WinLoss)
}
@{  
    ViewBag.NumberWidth = 40;
    ViewBag.DateWidth = 100;
    ViewBag.SystemIdWidth = 130;
    ViewBag.ExternalIdWidth = 200;
    ViewBag.CurrencyWidth = 90;
    ViewBag.TurnoverWidth = 90;
    ViewBag.TotalTransWidth = 90;
    ViewBag.CustomerWLWidth = 90;    
    ViewBag.LicenseeWLWidth = 90;
    ViewBag.ProgressiveShareWidth = 80;
    ViewBag.ProgressiveWinWidth = 80;
    ViewBag.NetGamingWidth = 80;

    ViewBag.ColumnWidth = Model.Param.Level == 2 ? 11 : 10;

    ViewBag.ContainerWidth = ViewBag.NumberWidth;// +ViewBag.DateWidth + ViewBag.SystemIdWidth + ViewBag.ExternalIdWidth;
    
    switch(Model.Param.Level)
    {
        case 0:
            ViewBag.ContainerWidth += ViewBag.DateWidth;
            break;
        case 1:
            ViewBag.ContainerWidth +=  ViewBag.SystemIdWidth;
            break;
        default:
            ViewBag.ContainerWidth += ViewBag.SystemIdWidth + ViewBag.ExternalIdWidth;
            break;
    }

    ViewBag.TotalWidth = ViewBag.ContainerWidth + ViewBag.ColumnWidth;
    ViewBag.GrantTotalWidth = ViewBag.TotalWidth + ViewBag.CurrencyWidth;
    ViewBag.ContainerWidth += ViewBag.CurrencyWidth + ViewBag.TurnoverWidth + ViewBag.TotalTransWidth + ViewBag.CustomerWLWidth + ViewBag.LicenseeWLWidth;
    ViewBag.ContainerWidth += ViewBag.ProgressiveShareWidth + ViewBag.ProgressiveWinWidth + ViewBag.NetGamingWidth;
    
    ViewBag.ContainerWidth += ViewBag.ColumnWidth;
    ViewBag.WrapperWidth = ViewBag.ContainerWidth + 18;
    ViewBag.TitleWidth = ViewBag.WrapperWidth - 24;
    ViewBag.FilterWidth = ViewBag.WrapperWidth > 1075 ? 1075 : ViewBag.WrapperWidth;
}
@section ContentFilter
{
    @{        
        Html.RenderPartial("~/Views/Report/PlaytechCasino/Filter.cshtml");        
    }
}
@{
    if (!Model.ShowEmptyContent)
    {
        Html.RenderPartial("~/Views/Report/PlaytechCasino/Content.cshtml");
    }
}

@{
    ViewBag.Title = "LRF - " + ViewResources.TotalBets +
    " - " + ViewResources.HandicapOverUnderLive;
    Layout = Request.IsAjaxRequest() ? null : "~/Views/Shared/_TotalBetsLayout.cshtml";
}
@using Fanex.Athena.Model.Report.ViewModel
@model Fanex.Athena.Model.TotalBet.ViewModel.HandicapOverUnderViewModel
@section page {
    <script src="@Url.ContentLink("/Scripts/TotalBets/handicapoverunder.js")" type="text/javascript"></script>
    <script src="@Url.ContentLink("/Scripts/Forecast/forecastpopup.js")" type="text/javascript"></script>
    <script type="text/javascript">
        $(window).load(function () {
            HandicapOU.initialize();
            RefreshCountDown.initEvent();
        });
    </script>
}
@section ContentTitle
    {
    @ViewResources.HandicapOverUnderLive
}
@section ContentFilter
{
    @{
        Html.RenderPartial("~/Views/TotalBets/HandicapOverUnder/Filter.cshtml");
    }
}
@{
    Html.RenderPartial("~/Views/TotalBets/HandicapOverUnder/Content.cshtml");
}
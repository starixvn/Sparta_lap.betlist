@using Fanex.Athena.Model.Report.ViewModel
@using Fanex.Athena.Model.Core.DataDomain
@model Fanex.Athena.Model.Report.ViewModel.CasinoProgressiveWinsViewModel
@{ 
    var appSettings = new AppSettings();
}
<div class="grid_26 content-filter new-line">
    <!--grid_26-->
    <form id="mainForm" name="mainForm" method="post" action="">
        @Html.AntiForgeryToken()
    @DatePickerHelper.RenderDateRangePicker(Model.Param.FromDate, Model.Param.ToDate,
        appSettings.HistoryDate, appSettings.MaxDate, "date-range", "date-range", 3, 3, 2, 3)
    <div class="grid_2 filter-label" style="width: 45px;">
        <label>
            @ViewResources.Currency
        </label>
    </div>
    <div class="grid_3 filter-input">
        @RazorHelper.CurrencyList(Model.CurrencyList, "currency-list", Model.Param.CurrencyId, true, true)
    </div>
    <div class="grid_5 userguide-group">
        <div>
            <div class="userguide-icon hide" id="UserGuide" title="@ViewResources.UserGuide"></div>
        </div>        
        <div>            
            <input alt="@ViewResources.ExportToExcel" src="@Url.ContentLink("/Content/Global/Images/excel.gif")"
               type="image" id="ExportToExcel" name="exporttoexcel"
               title="@ViewResources.ExportToExcel" class="hand" />
        </div>
    </div>
    
    @RazorHelper.RenderProductFilter(Model.Param.ProductOptions, 3)

    <div class="grid_2 filter-input" id="control-container">
        <input type="button" id="SubmitButton" value="@ViewResources.Submit" class="button" style="margin-top: 2px" />
    </div>
    <div class="grid_3 filter-label new-line">
        &nbsp;
    </div>
    <div class="grid_12 filter-input" style="height: 35px;">
        <div class="note-message">
            @ViewResources.CasinoProgressiveWinsGuidelineContent
        </div>
    </div>
    @Html.Hidden("IsExportExcel", Model.Param.IsExportExcel)
    </form>
</div>

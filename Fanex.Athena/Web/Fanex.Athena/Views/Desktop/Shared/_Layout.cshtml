@{
    var sessionService = new Fanex.Athena.Service.Core.Users.SessionService();
    var userSession = sessionService.UserSession;
    var licSession = sessionService.LicenseeSession;
    var userCurrencies = userSession == null || userSession.CurrencyList == null ?
        new Dictionary<string, string>() :
        userSession.CurrencyList.ToDictionary(x => x.Value.ToString(), x => x.Key);

    var hasCustComm = licSession != null && licSession.IsAllowedCustomerComm;
    var isParasiticMode = userSession != null && userSession.ApplicationMode == Fanex.Athena.Model.Core.DataDomain.AppMode.Parasitic;
    var appSettings = new AppSettings();
}
<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0">

    <title>@ViewBag.Title</title>
    <link href="https://fonts.googleapis.com/css?family=Roboto" rel="stylesheet">
    <link href="@Url.ContentLinkByEnv("/www/css/build/main.css")" rel="stylesheet" />

    @RenderSection("css", required: false)
</head>
<body>
    <input type="hidden" id="RootUrl" value="@Url.Content("~/")" />
    <input type="hidden" id="PageLanguage" value="@System.Globalization.CultureInfo.CurrentUICulture.IetfLanguageTag" />
    <input type="hidden" id="UserCurrencies" value="@JsonHelper.ToJson(userCurrencies)" />
    <input type="hidden" id="HasCustComm" value="@( hasCustComm ? 1 : 0)" />
    <input type="hidden" id="HistoryDate" value="@( appSettings.HistoryDate)" />
    @Html.AntiForgeryToken()

    <div class="loading" style="display: none">
        <svg class="icon-loading" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="64" height="64" fill="#4C6375">
            <circle transform="translate(8 0)" cx="0" cy="16" r="0">
                <animate attributeName="r" values="0; 4; 0; 0" dur="1.2s" repeatCount="indefinite" begin="0"
                         keytimes="0;0.2;0.7;1" keySplines="0.2 0.2 0.4 0.8;0.2 0.6 0.4 0.8;0.2 0.6 0.4 0.8" calcMode="spline" />
            </circle>
            <circle transform="translate(16 0)" cx="0" cy="16" r="0">
                <animate attributeName="r" values="0; 4; 0; 0" dur="1.2s" repeatCount="indefinite" begin="0.3"
                         keytimes="0;0.2;0.7;1" keySplines="0.2 0.2 0.4 0.8;0.2 0.6 0.4 0.8;0.2 0.6 0.4 0.8" calcMode="spline" />
            </circle>
            <circle transform="translate(24 0)" cx="0" cy="16" r="0">
                <animate attributeName="r" values="0; 4; 0; 0" dur="1.2s" repeatCount="indefinite" begin="0.6"
                         keytimes="0;0.2;0.7;1" keySplines="0.2 0.2 0.4 0.8;0.2 0.6 0.4 0.8;0.2 0.6 0.4 0.8" calcMode="spline" />
            </circle>
        </svg>
    </div>
    <div class="block-body" style="display: none">
    </div>

    <div class="wrapper">
        @RenderBody()
    </div>

    <script src="@Url.ContentLinkByEnv("/www/js/build/common.chunk.js")"></script>
    <script src="@Url.ContentLinkByEnv("/www/js/build/language.chunk.js")"></script>
    @RenderSection("js", required: false)
    @if (isParasiticMode)
    {
        Html.RenderPartial("~/Views/Desktop/Shared/_SessionScript.cshtml");
    }
    @if (appSettings.IsEnablePiwik)
    {
        var piwikId = isParasiticMode ? 49 : 5;

        <script type="text/javascript">
            var _paq = _paq || [];
            _paq.push(['trackPageView']);
            _paq.push(['enableLinkTracking']);
            $(function () {
                setTimeout(function () {
                    var u = "https://pw.detecas.com/";
                    window._paq.push(['setTrackerUrl', u + 'piwik.php']);
                    window._paq.push(['setSiteId', @piwikId]);
                    var d = document, g = d.createElement('script'), s = d.getElementsByTagName('script')[0];
                    g.type = 'text/javascript'; g.async = true; g.defer = true; g.src = u + 'piwik.js'; s.parentNode.insertBefore(g, s);
                }, 500);
            });
        </script>

        <noscript>
            <p>
                <img src="https://pw.detecas.com/piwik.php?rec=1&idsite=@piwikId" style="border: 0;" alt="" />
            </p>
        </noscript>
    }
</body>
</html>
@{
    // Game type:  Turf King //
    Layout = null; 
}
<link href="@Url.ContentLink("/Content/RNGCasino/rng-casino-hand-history.css")" rel="stylesheet" type="text/css" />
@model Fanex.Athena.Model.Casino.ViewModel.CasinoHandHistoryDetailViewModel
@{
    var headerItem = Model.CasinoDetailHeaderList.Where(x => x.ShowType.Trim() == "BasicInfo").FirstOrDefault();
}
<table style="width: 100%;" class="casino-detail-table" cellpading="0" cellspacing="0">
    <tr class="detail-header-row">
        <td class="game-type-text" colspan="4">@Model.Param.GameTypeName - @headerItem.BetTime
        </td>
    </tr>
    <tr class="player-total-row">
        <td colspan="4">
            @ViewResources.Player: @headerItem.UserName - @string.Format(ViewResources.Viewin,Model.Param.CurrencyName)
        </td>
    </tr>
    <tr class="detail-header-row">
        <td colspan="4">@headerItem.ResultName</td>
    </tr>
    <tr>
        <td colspan="4">
            @Html.Raw(headerItem.Result) 
        </td>
    </tr>    
    <tr>
        <td colspan="2">@ViewResources.PlayerHistoryNo
        </td>
        <td colspan="2" class="align-left">@Model.Param.PlayerHistoryNo
        </td>
    </tr>
    <tr class="detail-header-row">
        <td>@ViewResources.Combination
        </td>
        <td>@ViewResources.Bet
        </td>
        <td>@ViewResources.Odds
        </td>
        <td>@ViewResources.Win/@ViewResources.Loss
        </td>
    </tr>
    @foreach (var casino in Model.CasinoDetailList)
    {
    <tr>
        <td>@casino.BetContent 
        </td>
        <td class="align-right">@casino.Bet.ToStringExt()
        </td>
        <td class="align-right">@casino.Odds.ToStringExt()
        </td>
        <td class="align-right">@casino.WinLoss.ToStringExt()
        </td>
    </tr>
    }
    <tr class="player-total-row">
        <td class="align-left">@ViewResources.Total
        </td>
        <td class="align-right">@Model.CasinoDetailList.Sum(p => p.Bet).ToStringExt()
        </td>
        <td class="align-right"> 
        </td>
        <td class="align-right">@Model.CasinoDetailList.Sum(p => p.WinLoss).ToStringExt()
        </td>
    </tr>
</table>

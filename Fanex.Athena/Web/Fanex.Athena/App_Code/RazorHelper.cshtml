@helper TitleLicenseeWLPrefix(IEnumerable<ProductOption> productOptions)
    {
        var prdOptionTitleList = productOptions.Where(p => p.Code != Product.BA && p.Code != Product.RB);
        var prdText = string.Empty;
        foreach (var prd in prdOptionTitleList)
        {
            if (prd.Status)
            {
                prdText += string.IsNullOrEmpty(prdText) ? prd.Code : ", " + prd.Code;
            }
        }
        prdText = string.IsNullOrEmpty(prdText) ? string.Empty : string.Format(", {0} ({1})", ViewResources.LicenseeW_L, prdText);

    @prdText
}
@helper GroupComSettingDropDownList(string name, Dictionary<int, int> items, decimal selectedValue = 0, string className = "")
    {
    <select id="@name" name="@name" class="@className">
        @foreach (var item in items)
        {
            <option @(selectedValue == item.Value ? "selected=selected" : string.Empty)  value="@item.Value">@item.Key.ToString("0.#")</option>
        }
    </select>
}
@helper TruncateWithTip(String value, Int32 maxLength, bool hasSpanReturn = false)
    {
        if (value.Length > maxLength)
        {
    <span title="@value.Replace("'", "&#39;")">@HttpUtility.HtmlEncode(value.Substring(0, maxLength - 2) + "..")</span>

        }
        else if (hasSpanReturn)
        {
    <span>@HttpUtility.HtmlEncode(value)</span>
        }
        else
        {
    @value
        }

}
@helper  SpecialLevelList(int custId, int level)
    {
    <select id="@("special-level-list-" + custId)" style="width:60px; padding-right: 0px" data-cust-id="@custId" data-level="@level" class="@("special-level-list level-" + level)">
        @for (var i = 0; i <= 10; i++)
        {
            if (i == level)
            {
            <option value="@i" selected='selected' class="@("level-" + i)">@(i == 0 ? ViewResources.None : i.ToString())
            </option>
            }
            else
            {
            <option value="@i"  class="@("level-" + i)">@(i == 0 ? ViewResources.None : i.ToString())
            </option>
            }

        }
    </select>
}
@helper  SpecialLevelListSearch(int level)
    {
    <select id="special-level-list-search" class="@("level-" + level)"
>
        <option value="-1" class="level-0" @(level == -1 ? "selected=selected" : "")>@ViewResources.All</option>
        @for (var i = 0; i <= 10; i++)
        {
            <option value="@i" class="@("level-" + i)" @(level == i ? "selected=selected" : "")>@(i == 0 ? ViewResources.None : i.ToString())
            </option>
        }
    </select>
}
<!--Example:@RazorHelper.Paging("WarehouseWinLossForm", 5000, 1)-->
@helper Paging(string formId, int NoOfItems, int currentIndex = 1, int pageSize = 1000, string method = "POST")
    {
        var noOfPage = NoOfItems / pageSize + (NoOfItems % pageSize == 0 ? 0 : 1);
        var pagingVisible = NoOfItems > 1000;
        if (pagingVisible)
        {
    <div class="pagingContainer">
        <input type="button" class="icon pagingFirst" />
        <input type="button" class="icon pagingPrev  @(currentIndex == 1 ? "pagingDisable" : string.Empty) " @(currentIndex == 1 ? "disabled=disabled" : string.Empty) />
        <span class="pagingSeperator"></span>@ViewResources.Page
        <input  type="text" name="PageIndex" class="pagingCurrent" maxlength="4" size="2" value="@currentIndex" />
        @ViewResources.of @noOfPage
        <input type="hidden" name="PageSize" value="@pageSize" />
        <input type="hidden" name="Method" value="@method" />
        <input type="hidden" name="FormName" value="@formId" />
        <input type="hidden" name="NoOfPage" value="@noOfPage" />
        <span class="pagingSeperator"></span>
        <input type="button" class="icon pagingNext @(currentIndex == noOfPage ? "pagingDisable" : string.Empty)" @(currentIndex == noOfPage ? "disabled=disabled" : string.Empty) />
        <input type="button" class="icon pagingLast @(currentIndex == noOfPage ? "pagingDisable" : string.Empty)" @(currentIndex == noOfPage ? "disabled=disabled" : string.Empty) />
        <select class="pageSizeSelected">
            @for (var i = 1000; i <= 2000; i += 1000)
            {
                <option value="@i" @(pageSize == i ? "selected=selected" : string.Empty)>
                    @i
                </option>
            }
        </select>
    </div>
        }
}
@helper RenderProductFilter(IEnumerable<ProductOption> productOptions)
 {  
    var Url = new UrlHelper(Context.Request.RequestContext);
    var i = 0;
    <div class="grid_2 filter-label new-line">
        <label>
            @ViewResources.Product</label>
    </div>
    <div class="grid_5 option-list filter-input" id="ProductList">
        <select id="grid-products-multiselect" name="grid-products-multiselect">
        </select>       
        <img src="@Url.ContentLink("/Content/Report/Images/icon_error.gif")" alt="" class="hide error-img" />

        <div class="hide" id="items-container">
            @foreach (var product in productOptions)
            {
                <input type="hidden" name="ProductOptions[@i].Code" value="@product.Code"  />
                <input type="hidden" name="ProductOptions[@i].Name" value="@product.Name"  />
                <input type="checkbox" class="childCheckbox" id="@product.Code" @(product.Status ? "checked=checked" : "")  name="ProductOptions[@i].Status" value="True" />
                i++;
            }
        </div>
        <input type="hidden" id="productsData" value="@productOptions.ToJson()" />

        <script type="text/javascript">
            $(window).load(function () {
                Site.setMultiSelectForDropDownList('grid-products-multiselect', $("#productsData").val(), 'Code', 'Name', 'Status');
                $("form").submit(function (event) {
                    if ($("#items-container input[type=checkbox]:checked").length == 0) {
                        $('<div title="LRF-Notification">' + '@ViewResources.AlertChooseProductMsg' + '!</div>').dialog();
                        Site.unBlockUI();
                        return false;
                    }
                    return true;

                });
            });           
        </script>
    </div>
}
@helper MonthDropDownList(int selectedMonth)
    {
    <select id="Month">
        <option @(selectedMonth == 1 ? "selected = selected" : string.Empty) value="0">@ViewResources.January</option>
        <option @(selectedMonth == 2 ? "selected = selected" : string.Empty) value="1">@ViewResources.February</option>
        <option @(selectedMonth == 3 ? "selected = selected" : string.Empty) value="2">@ViewResources.March</option>
        <option @(selectedMonth == 4 ? "selected = selected" : string.Empty) value="3">@ViewResources.April</option>
        <option @(selectedMonth == 5 ? "selected = selected" : string.Empty) value="4">@ViewResources.May</option>
        <option @(selectedMonth == 6 ? "selected = selected" : string.Empty) value="5">@ViewResources.June</option>
        <option @(selectedMonth == 7 ? "selected = selected" : string.Empty) value="6">@ViewResources.July</option>
        <option @(selectedMonth == 8 ? "selected = selected" : string.Empty) value="7">@ViewResources.August</option>
        <option @(selectedMonth == 9 ? "selected = selected" : string.Empty) value="8">@ViewResources.September</option>
        <option @(selectedMonth == 10 ? "selected = selected" : string.Empty) value="9">@ViewResources.October</option>
        <option @(selectedMonth == 11 ? "selected = selected" : string.Empty) value="10">@ViewResources.November</option>
        <option @(selectedMonth == 12 ? "selected = selected" : string.Empty) value="11">@ViewResources.December</option>
    </select>
}
@helper YearDropDownList(int selectedYear, int itemCount)
    {
        var currentYear = DateTime.Now.Year;
    <select id="Year">
        @for (int i = currentYear; i > currentYear - itemCount && i >= 2012; i--)
        {
            <option @(selectedYear == i ? "selected = selected" : string.Empty)  value="@i.ToString()">@i.ToString()</option>
        }
    </select>
}
@helper LicenseeType(IList<string> licenseeTypes, string className = "", string selected = "", bool addMoreAllOption = true)
    {
        var items = licenseeTypes
         .Select(c => new System.Web.WebPages.Html.SelectListItem
         {
             Value = c,
             Text = c,
             Selected = selected == c
         }).ToList();
        if (addMoreAllOption)
        {
            items.Insert(0, new System.Web.WebPages.Html.SelectListItem
            {
                Text = ViewResources.All.ToUpper(),
                Value = "",
                Selected = string.IsNullOrEmpty(selected) || selected == "0"
            });
        }
    <select name="LicenseeType" id="LicenseeType"  class="@className" data-original="@selected">
        @foreach (var item in items)
        {
            <option value="@item.Value" @(item.Selected ? "selected=selected" : "")>
                @item.Text
            </option>
        }
    </select>
}
@helper CurrencyList(IDictionary<string, int> currencyList,
string className = "", int selected = 0,
bool addMoreAllOption = true,
bool addBasedOption = false)
    {
        var selectedName = currencyList.Where(p => p.Value == selected).FirstOrDefault().Key;
        var selectedBaseCurrency = selected == BaseCurrencyType.Gbp ? "gbp" :
                                   (selected == BaseCurrencyType.Usd ? "usd" :
                                   (selected == BaseCurrencyType.Eur ? "eur" : string.Empty));
        var items = currencyList
         .Select(c => new System.Web.WebPages.Html.SelectListItem
         {
             Value = c.Value.ToString(),
             Text = c.Key,
             Selected = selected == c.Value
         }).ToList();
        if (addBasedOption)
        {
            items.Insert(0, new System.Web.WebPages.Html.SelectListItem
            {
                Text = ViewResources.Based + " GBP",
                Value = BaseCurrencyType.Gbp.ToString(),
                Selected = BaseCurrencyType.Gbp == selected
            });

            items.Insert(0, new System.Web.WebPages.Html.SelectListItem
            {
                Text = ViewResources.Based + " USD",
                Value = BaseCurrencyType.Usd.ToString(),
                Selected = BaseCurrencyType.Usd == selected
            });

            items.Insert(0, new System.Web.WebPages.Html.SelectListItem
            {
                Text = ViewResources.Based + " EUR",
                Value = BaseCurrencyType.Eur.ToString(),
                Selected = BaseCurrencyType.Eur == selected
            });

        }
        if (addMoreAllOption)
        {
            items.Insert(0, new System.Web.WebPages.Html.SelectListItem
            {
                Text = ViewResources.All.ToUpper(),
                Value = BaseCurrencyType.All.ToString(),
                Selected = BaseCurrencyType.All == selected
            });
        }
    <select name="CurrencyId" id="CurrencyId"  class="@className" data-original="@selected">
        @foreach (var item in items)
        {
            <option value="@item.Value" @(item.Selected ? new HtmlString("selected=selected") : new HtmlString(""))>
                @item.Text
            </option>
        }
    </select>
    <input type="hidden" id="CurrencyName" name="CurrencyName" value="@selectedName" data-original="@selectedName" />
        if (addBasedOption)
        {
    <input type="hidden" id="BaseCurrency" name="BaseCurrency" value="@selectedBaseCurrency" data-original="@selectedBaseCurrency" />
        }
}
@helper BasedCurrency(string selectedBasedCurrency, string CurrencyName = null)
    {
        selectedBasedCurrency = string.IsNullOrEmpty(selectedBasedCurrency) ? string.Empty : selectedBasedCurrency;
        selectedBasedCurrency = selectedBasedCurrency.ToLower();

    <select class="based-currency" name="BaseCurrency" id="BaseCurrency"  data-original="@selectedBasedCurrency">
        <option value="eur" @(selectedBasedCurrency == "eur" ? new HtmlString("selected=selected") : new HtmlString(""))>
            EUR</option>
        <option value="usd" @(selectedBasedCurrency == "usd" ? new HtmlString("selected=selected") : new HtmlString(""))>
            USD</option>
        <option value="gbp" @(selectedBasedCurrency == "gbp" ? new HtmlString("selected=selected") : new HtmlString(""))>
            GBP</option>
        <option value="" @(selectedBasedCurrency == "" ? new HtmlString("selected=selected") : new HtmlString(""))>@CurrencyName</option>
    </select>
}
@helper LiveStatus(int selectedStatus)
    {
    <select class="live-status" name="LiveIndicator" id="LiveIndicator"  data-original="@selectedStatus">
        <option value="2" @(selectedStatus.Equals(2) ? new HtmlString("selected=selected") : new HtmlString(""))>@ViewResources.All</option>
        <option value="1" @(selectedStatus.Equals(1) ? new HtmlString("selected=selected") : new HtmlString(""))>@ViewResources.Live</option>
        <option value="0" @(selectedStatus.Equals(0) ? new HtmlString("selected=selected") : new HtmlString(""))>@ViewResources.NoneLive</option>
    </select>
}

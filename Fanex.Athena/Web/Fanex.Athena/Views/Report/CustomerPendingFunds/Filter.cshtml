@{
    Layout = null;
}
@using Fanex.Athena.Models.ViewModel
@model Fanex.Athena.Models.ViewModel.Report.CustomerPendingFundsViewModel
<div class="grid_26 content-filter new-line" style="width:@(ViewBag.FilterWidth)px;">
    @using (Html.BeginForm("CustomerPendingFunds", "Report", FormMethod.Post, new { @id = "CustomerPendingFundsForm" }))
    {      
        <div>
            @Html.Hidden("SortDirection", Model.Param.SortDirection)
            @Html.Hidden("SortColumn", Model.Param.SortColumn)
            @Html.Hidden("IsExportExcel", Model.Param.IsExportExcel)
        </div> 
@*Row 1*@
        if (Model.LicenseeTypeList.Count > 0)
        {
        <div class="grid_2 filter-label">
            <label>@ViewResources.Type</label>
        </div>
        <div class="grid_3 filter-input">
            @RazorHelper.LicenseeType(Model.LicenseeTypeList, "", Model.Param.LicenseeType)
        </div>
        }
        <div class="grid_2 filter-label">
            <label>@ViewResources.Currency</label>
        </div>
        <div class="grid_3 filter-input">
            @RazorHelper.CurrencyList(Model.CurrencyList, "", Model.Param.CurrencyId)
        </div>
        <div class="grid_3 filter-label">
            <label for="BaseCurrency">@ViewResources.Based </label>
        </div>
        <div class="grid_1 filter-input">
            @RazorHelper.BasedCurrency(Model.Param.BaseCurrency)
        </div>
        <div class="grid_2 note-group">
            <div>
                @{Html.RenderAction("Index", "Note", new { viewName = "CustomerPendingFunds" });}
            </div>
            <div>
                <input alt="@ViewResources.ExportToExcel" src="@Url.ContentLink("/Content/Global/Images/excel.gif")"
               type="image" id="ExportToExcel" name="exporttoexcel"
               title="@ViewResources.ExportToExcel" class="hand" />
            </div>
        </div>   
@*End Row 1*@     
@*Row 2*@
        @RazorHelper.RenderProductFilter(Model.Param.ProductOptions, 2, 14)
        <div class="grid_2 filter-label new-line">
            &nbsp;</div>
        <div class="grid_2 filter-input">
            <input type="button" id="SubmitButton" value="@ViewResources.Submit" class="button blockui" />
        </div>   
@*End Row 2*@    
         
    }
</div>

@using Fanex.Athena.Model.Report.ViewModel
@using Fanex.Athena.Model.Core.MetaModel.Product
@model Fanex.Athena.Model.BetList.ViewModel.BetListBaseViewModel
@{
    //-----------------------------Date---------------------------------------//
    <div class="grid_2 filter-label">
        <label>@ViewResources.Date</label>
    </div>     
    @DatePickerHelper.RenderDatePicker(Model.Param.Date, Convert.ToDateTime(Model.Param.BalanceUpDay), AppSettings.MaxDate,
        "Date", "", 3)
    //-----------------------------Currency-----------------------------------//
    <div class="grid_2 filter-label">
        <label>
            @ViewResources.Currency</label>
    </div>
    <div class="grid_2 filter-input">
        @RazorHelper.CurrencyList(Model.CurrencyList, "based-currency", Model.Param.CurrencyId, true, false)
    </div>
    <div class="grid_2 filter-label">
        <label for="BaseCurrency">@ViewResources.Based</label>
    </div>
    <div class="grid_2 filter-input">
        @RazorHelper.BasedCurrency(Model.Param.BaseCurrency)
    </div>
    <div class="grid_2 note-group">
        <div>
            <div class="userguide-icon" id="UserGuide" title="@ViewResources.UserGuide"></div>
        </div>     
        <div class="export-excel-area" @(Model.Param.CurrencyId == 0 ? "style=display:none" : string.Empty) >
            <input alt="@ViewResources.ExportToExcel" src="@Url.ContentLink("/Content/Global/Images/excel.gif")"
               type="image" id="ExportToExcel" name="exporttoexcel"
               title="@ViewResources.ExportToExcel" class="hand" />
        </div>
    </div>
    
    <div class="new-line">
    </div>

    //-----------------------------Product---------------------------------------//
    <div class="grid_2 filter-label">
        <label>@ViewResources.Product</label>
    </div> 
    <div class="grid_3 filter-input">
        <select id="ProductCode" name="ProductCode">            
            @foreach (var prd in Model.ProductAccess.ProductList)
            {
                <option value="@prd.ProductCode" @(prd.ProductCode == Model.Param.ProductCode ? "selected='selected'" : string.Empty)>
                    @prd.ProductName</option>
            }
        </select>
    </div>
    
    //-----------------------------Status---------------------------------------//
    <div class="grid_2 filter-label">
        <label>@ViewResources.Status</label>
    </div> 
    <div class="grid_2 filter-input">
        <select id="DailyBetListStatus" name="DailyBetListStatus" class="based-currency">
            <option value="won" @(Model.Param.DailyBetListStatus == "won" ? "selected='selected'" : string.Empty)>@ViewResources.Won</option>
            <option value="lose" @(Model.Param.DailyBetListStatus == "lose" ? "selected='selected'" : string.Empty)>@ViewResources.Lose</option>
            <option value="draw" @(Model.Param.DailyBetListStatus == "draw" ? "selected='selected'" : string.Empty)>@ViewResources.Draw</option>
        </select>
    </div>
    <div class="grid_2 filter-label">
        <label></label>
    </div>
    <div class="grid_3 filter-input">
        <input type="button" id="SubmitButton" value="@ViewResources.Submit" class="button" />
    </div>

    <input type="hidden" name="LicenseeId" id="LicenseeId" value="@Model.Param.LicenseeId"/>
}

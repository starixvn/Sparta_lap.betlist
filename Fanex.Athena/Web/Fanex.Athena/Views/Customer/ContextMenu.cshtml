@using Fanex.Athena.Models.ViewModel
@model Fanex.Athena.Models.ViewModel.Customer.CustomerListViewModel
<div id="ajaxLoaDingUpdateBA" class="hide">
    <img alt="update BA.." style="border: none;" src="@Url.ContentLink("/Content/Customer/images/ajax-loader_arrow.gif")" />
</div>
<input id="CanUpdateBAMessage" type="hidden" value="@Model.CanUpdateBAMessage" />
<input id="CanUpdateBA" type="hidden" value="@(Model.CanUpdateBA ? 1 : 0)" />
<div id="update-cust-status-popup" class="update-cust-status-popup" style="display: none">
    <div>
        @Html.Raw(string.Format(ViewResources.ChangeStatus, "<b id='popup-external-id'></b>"))
    </div>
    <br />
    <div>
        <input type="checkbox" id="popup-suspended" />
        <label for="popup-suspended">
            &nbsp; @ViewResources.Suspended</label>
    </div>
    <div>
        <input type="checkbox" id="popup-closed" />
        <label for="popup-closed">
            &nbsp;
            @ViewResources.Close</label>
    </div>
    <br />
    <input type="button" value="@ViewResources.Update" class="button" id="popup-update" disabled="disabled" />
    <input type="button" value="@ViewResources.Cancel" class="button" id="popup-close" />
</div>
<div id="view-cust-option" class="view-cust-option" style="display: none">
    <a id="bet-setting-link" class="link" title="@ViewResources.View @ViewResources.BetSetting">@ViewResources.BetSetting</a><br />
    <br />
    <a id="bet-list-link" class="link" title="@ViewResources.View @ViewResources.BetList">@ViewResources.BetList</a><br />
    <br />
    <a id="statement-link" class="link" title="@ViewResources.View @ViewResources.Statement">@ViewResources.Statement</a><br />
    <br />
    <a id="login-info-link" class="link" title="@ViewResources.View @ViewResources.LogInfo">@ViewResources.LogInfo</a><br />
    <a id="close-cust-option-link" class="link" title="Close Option">
        <img alt="" src="@Url.Content("~/Content/Customer/images/arrow-up-left.gif")" class="popup-close-button" />
    </a>
</div>

@{
    ViewBag.Title = string.Format("LRF - {0}", ViewResources.BetList);
    Layout = "~/Views/Desktop/Shared/_Layout.cshtml";
}
@section css{
    <link href="@Url.ContentLinkByEnv("/www/css/build/pages/betlist/cashouthistory.css")" rel="stylesheet" type="text/css" />
}
@model Fanex.Athena.Model.BetList.ViewModel.CashOutBetListDetailViewModel

<div class="page-results betlist-container">
    <div class="table-content">
        <p>
            @(ViewResources.OriginalBetTicket):
        </p>
        <table class="table">
            <thead>
                <tr>
                    <th class="col-medium">@ViewResources.TransTime</th>
                    <th class="col-large small">@ViewResources.Choice</th>
                    <th>@ViewResources.Odds</th>
                    <th>@ViewResources.Stake</th>
                    <th>@(ViewResources.WinLoss)/@(ViewResources.Comm)</th>
                    <th>@ViewResources.Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.TicketTextList)
            {
                    <tr>
                        <td class="center-align">@Html.Raw(item.TransTime)</td>
                        <td class="right-align">@Html.Raw(item.Choice)</td>
                        <td class="right-align">@Html.Raw(item.Odds)</td>
                        <td class="right-align">@Html.Raw(item.Stake)</td>
                        <td class="right-align">@Html.Raw(item.WinLoss)</td>
                        <td class="center-align">@Html.Raw(item.Status)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>


    <div class="table-content">
        <p>
            @(Model.IsBoughtTicket ? ViewResources.BoughtTicketsList : ViewResources.CashOutTicketsList):
        </p>
        <table class="table">
            <thead>
                <tr>
                    <th class="col-medium">@ViewResources.TransTime</th>
                    <th class="col-large small">@(Model.IsBoughtTicket ? ViewResources.BoughtStake : ViewResources.CashOutStake)</th>
                    <th>@(Model.IsBoughtTicket ? ViewResources.BoughtAmount : ViewResources.CashOutAmount)</th>
                    <th>@ViewResources.WinLoss</th>
                    <th>@ViewResources.Status</th>
                    <th style="visibility:hidden"></th>
                </tr>
            </thead>
            @{
                var firstRow = true;
            }
            <tbody>
                @foreach (var item in Model.CashOutTicketTextList)
            {
                var tdClass = firstRow ? "highlight" : null;
                    <tr>
                        <td class="center-align @tdClass">@Html.Raw(item.TransTime)</td>
                        <td class="right-align @tdClass">@Html.Raw(item.Stake)</td>
                        <td class="right-align @tdClass">@Html.Raw(item.Price)</td>
                        <td class="right-align @tdClass">@Html.Raw(item.WinLoss)</td>
                        <td class="center-align @tdClass">@Html.Raw(item.Status)</td>
                        <td style="visibility:hidden"></td>
                    </tr>
                    firstRow = false;
                }
            </tbody>
        </table>
    </div>
</div>
@{
    Layout = "~/Views/Desktop/Shared/_BetSettingLayout.cshtml";
}
@model Fanex.Athena.Model.BetSettings.ViewModel.RngCasinoBetSettingViewModel

@section pagecss{
    <link href="@Url.ContentLink("/Content/Customer/BetSetting/rngcasino.css")" rel="stylesheet" type="text/css" />
}
@section pagejs {
    <script src="@Url.ContentLink("/Scripts/Customer/BetSetting/rngcasino.js")" type="text/javascript"></script>
}

@helper RenderFirstRow()
{
    <tr class="first-row">
        <td class="col-medium"></td>
        <td class="col-medium large"></td>
        <td class="col-large"></td>
    </tr>
}

@section Menu{
    @{Html.RenderPartial("~/Views/Desktop/Customer/BetSetting/Menu.cshtml", Model);}
}

@section ContentTitle{
    @Model.Param.BetSettingName @ViewResources.BetSettings - @Model.Param.NickName (@Model.Param.UserName)
}

@Html.Hidden("IDList", String.Join(",", Model.MainData.Select(x => x.SportId)))
@Html.Hidden("isenabled", Model.IsEnabled.Value)

@{
    var disabledAttribute = Model.Editable ? null : "disabled";
}

@if (Model.GameKinds.Count == 0)
{
    <p class="no-info-row">@ViewResources.NoInfo</p>
}
else
{
    <div class="table-content">
        <div class="header-content">
            <table class="table">
                <thead>
                    @RenderFirstRow()
                    <tr>
                        <th>@ViewResources.GameKind</th>
                        <th>@ViewResources.GameType</th>
                        <th>@ViewResources.BettingLimit</th>
                    </tr>
                </thead>
            </table>
        </div>

        <div class="body-content">
            <table class="table betsetting-form">
                <tbody>
                    @RenderFirstRow()

                    @foreach (var gameKind in Model.GameKinds)
                    {
                        var rowspan = gameKind.GameTypeList.Count;
                        var visible = true;
                        foreach (var gameType in gameKind.GameTypeList)
                        {
                            var originalStakeLevel = string.Join(",", gameType.StakeLevelList.Where(x => x.IsCheck).Select(x => x.StakeLevelId));

                            <tr class="casino-row" data-gametypeid="@gameType.GameTypeId" data-stake-original="@originalStakeLevel">
                                <td class="game-kind" style="@(visible ? string.Empty : "display:none")" rowspan="@(rowspan) @(visible = false)">
                                    @gameKind.GameKindName
                                </td>
                                <td data-gametypeid="@gameType.GameTypeId">
                                    @gameType.GameTypeName
                                </td>
                                <td data-gametypeid="@gameType.GameTypeId">
                                    @foreach (var stakeLevel in gameType.StakeLevelList)
                                    {
                                        <input class="input-@(gameType.GameTypeId)" @disabledAttribute type="checkbox" data-stakeid="@stakeLevel.StakeLevelId" data-ischeck="@(stakeLevel.IsCheck ? "true" : "false")" @(stakeLevel.IsCheck ? "checked='checked'" : string.Empty) />
                                        <span class="stake-level-name">@stakeLevel.StakeLevelNameFormated</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}
@if (Model.Editable && Model.GameKinds.Count > 0)
{
    <div class="right button-block">
        <button type="button" class="btn btn-submit"
                data-cust-id="@Model.Param.CustId"
                data-user-name="@Model.Param.UserName.ToString()"
                data-nick-name="@Model.Param.NickName"
                id="btnRngCasino">
            @ViewResources.Submit
        </button>
        <button type="button" class="btn btn-cancel"
                id="btnResetRngCasino">
            @ViewResources.Reset
        </button>
        @if (Model.IsEnabled.HasValue)
        {
            <button type="button" class="btn btn-submit"
                    data-status="@(Model.IsEnabled.Value ? 1 : 0)"
                    data-cust-id="@Model.Param.CustId"
                    data-nick-name="@Model.Param.NickName"
                    id="btnUpdateStatus">
                @(Model.IsEnabled.Value ? ViewResources.DisableRNGCasino : ViewResources.EnableRNGCasino)
            </button>
        }
        else
        {
            <p>
                @string.Format(ViewResources.CustomerHasNeverPlayed, "RNG Casino")
            </p>
        }
    </div>
}
@helper ViewBaseCurrency(string currencyName, string basedCurrencyName)
    {
    @(string.IsNullOrEmpty(basedCurrencyName) ? string.Format(ViewResources.Viewin + " {0}", currencyName) : string.Format(ViewResources.Viewin + " {0}", basedCurrencyName.ToUpper()))
    
}
@helper ViewCurrencyBasedOnConverter(bool converter, string BaseCurrency, string CurrencyName)
    {
    @(ViewResources.Viewin + " " + (converter ? BaseCurrency.ToUpper() : CurrencyName))
}
@helper ViewLiveStatus(int liveStatus)
    {
        string title = string.Empty;
        switch (liveStatus)
        {
            case 0:
                title = ViewResources.Live + " and " + ViewResources.NoneLive;
                break;
            case 1:
                title = ViewResources.Live;
                break;
            case 2:
                title = ViewResources.NoneLive;
                break;
        }

        @(string.Format("{0} data", title))
}
@helper ViewInCurrency(int currenceId, string currencyName)
    {
        string title;

        switch (currenceId)
        {
            case 0:
                title = ViewResources.AllCurrencies;
                break;
            case -1:
                title = ViewResources.Viewin + " " + Fanex.Athena.Models.DataDomain.FormatKey.Eur;
                break;
            case -2:
                title = ViewResources.Viewin + " " + Fanex.Athena.Models.DataDomain.FormatKey.Usd;
                break;
            default:
                title = ViewResources.Viewin + " " + currencyName;
                break;
        }
    @(title)
    
}
@helper TitleDateTime(DateTime fromDate, DateTime? toDate)
    {
    
    @(fromDate.ToString("MM/dd/yyyy"))
        if (toDate != null)
        {
    @(" → ")@(toDate.Value.ToString("MM/dd/yyyy"))
        }
        
}
@helper PositiveFormatExt(object objValue, bool isFormatZero)
    {
        if (!(objValue is DBNull))
        {
            var value = Convert.ToDecimal(objValue);
            if (value != null)
            {
                if (value > 0)
                {
    <span class="positive-number">@value.ToString("#,##0.00")</span>
                }
                else
                {
    <span>@(value == 0 ? (isFormatZero ? "0" : string.Empty) : value.ToString("#,##0.00"))</span>
                }
            }
        }
}
@model Fanex.Athena.Model.Report.ViewModel.WinLossByBetTypeViewModel

@helper RenderFirstRow()
{
    <tr class="first-row">
        <td class="col-small"></td>
        <td class="col-medium large"></td>
        <td class="col-child"></td>

        <td class="col-child"></td>
        @if (Model.IsAllowedCustomerCommission)
        {
            <td class="col-child small"></td>
            <td class="col-child"></td>
        }

        <td class="col-child"></td>
        <td class="col-child medium"></td>
        <td class="col-child small"></td>
        <td class="col-child small"></td>
        <td class="col-child small"></td>
    </tr>
}

<div class="page-results">
    <div class="result-content">
        <div class="panel-heading active">
            <div class="panel-title">
                @ViewResources.WinLossByBetType, @RazorHelperDesktop.TitleDateTime(Model.Param.FromDate, Model.Param.ToDate)
                - @RazorHelperDesktop.ViewCurrencyBasedOnConverter(Model.Param.IsConvert, Model.Param.BaseCurrency, Model.Param.CurrencyName)
            </div>
        </div>

        <div class="main-content">
            @if (!Model.MainResult.Any())
            {
                <p class="no-info-row">@ViewResources.NoInfo</p>
            }
            else
            {
                <div id="header-content" class="header-content">
                    <table class="table">
                        <thead>
                            @RenderFirstRow()
                            @{ Html.RenderPartial("~/Views/Desktop/Report/WinLossByBetType/Content.Header.cshtml"); }
                        </thead>
                    </table>
                </div>

                <div class="body-content">
                    <table class="table table-bordered">
                        <tbody>
                            @RenderFirstRow()
                            @{ Html.RenderPartial("~/Views/Desktop/Report/WinLossByBetType/Content.Data.cshtml"); }
                        </tbody>
                    </table>
                </div>

                <div class="footer-content">
                    <table class="table">
                        <tbody>
                            @RenderFirstRow()
                            @{ Html.RenderPartial("~/Views/Desktop/Report/WinLossByBetType/Content.Total.cshtml"); }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
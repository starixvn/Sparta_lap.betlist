@helper ViewBaseCurrency(string currencyName, string basedCurrencyName)
    {
    @(string.IsNullOrEmpty(basedCurrencyName) ? string.Format(ViewResources.Viewin, currencyName) : string.Format(ViewResources.Viewin, basedCurrencyName.ToUpper()))

}
@helper ViewCurrencyBasedOnConverter(bool converter, string BaseCurrency, string CurrencyName)
    {
    @(string.Format(ViewResources.Viewin, converter ? BaseCurrency.ToUpper() : CurrencyName))
}
@helper ViewLiveStatus(int liveStatus)
    {
        string title = string.Empty;
        switch (liveStatus)
        {
            case 0:
                title = ViewResources.NoneLive;
                break;
            case 1:
                title = ViewResources.Live;
                break;
            case 2:
                title = ViewResources.LiveAndNonLive;
                break;
        }

    @(title + ViewResources.Data)
}
@helper ViewInCurrency(int currencyId, string currencyName)
    {
        string title;

        switch (currencyId)
        {
            case BaseCurrencyType.All:
                title = ViewResources.AllCurrencies;
                break;
            case BaseCurrencyType.Eur:
                title = string.Format(ViewResources.Viewin, FormatKey.Eur);
                break;
            case BaseCurrencyType.Usd:
                title = string.Format(ViewResources.Viewin, FormatKey.Usd);
                break;
            case BaseCurrencyType.Gbp:
                title = string.Format(ViewResources.Viewin, FormatKey.Gbp);
                break;
            default:
                title = string.Format(ViewResources.Viewin, currencyName);
                break;
        }
    @(title)

}
@helper TitleDateTime(DateTime fromDate, DateTime? toDate)
    {
    @(fromDate.ToString("MM/dd/yyyy"))
        if (toDate != null)
        {
    @(" → ")@(toDate.Value.ToString("MM/dd/yyyy"))
        }
}
@helper FullDateFormat(DateTime? date)
    {
        if (date != null)
        {
    @(date.Value.ToString("MM/dd/yyyy hh:mm:ss tt"))
        }
}
@using Fanex.Athena.Models.ViewModel
<div id="header-content" class="header-content" style="width:@(ViewBag.TotalWrapperWidth + 2)@("px");">
    <div style="width:@(ViewBag.ContainerWidth + 2)@("px");">
        <div class="row" style="width:@ViewBag.NumberWidth@("px")">
            #
        </div>
        <div class="row" style="width:@ViewBag.ExternalIdWidth@("px")">
            @ViewResources.ExternalId
        </div>
        <div class="row" style="width:@ViewBag.SystemIdWidth@("px")">
            @ViewResources.SystemId
        </div>
        <div class="row" style="width:@ViewBag.OpeningBalanceWidth@("px")">
            @ViewResources.OpeningBalance
        </div>
        <div class="row" style="width:@ViewBag.DepositWidth@("px")">
            @ViewResources.Deposit
        </div>
        <div class="row" style="width:@ViewBag.WithdrawalWidth@("px")">
            @ViewResources.Withdrawal
        </div>
        <div class="row" style="width:@ViewBag.BonusWidth@("px")">
            @ViewResources.Bonus
        </div>
        <div class="row" style="width:@ViewBag.AdjustmentWidth@("px")">
            @ViewResources.Adjustment
        </div>
        <div class="row" style="width:@ViewBag.TurnoverWidth@("px")">
            @ViewResources.Turnover
        </div>
        <div class="row" style="width:@ViewBag.DrawGameWidth@("px")">
            @ViewResources.DrawGame
        </div>
        <div class="row" style="width:@ViewBag.NetTurnoverWidth@("px")">
            @ViewResources.NetTurnover
        </div>
        <div class="row" style="width:@ViewBag.PendingFundsWidth@("px")">
            @ViewResources.PendingFunds
        </div>
        @SplitingProductHelper.CustomerWLHeader(Model.IsAllowedCustomerCommission,
        (int)ViewBag.CustomerWLLargeWidth, (int)ViewBag.CustomerWLMergeWidth,
                (int)ViewBag.CustomerWLWidth, (int)ViewBag.CustomerCommWidth, (int)ViewBag.CustomerWLTotalWidth)
        <div class="row" style="width:@ViewBag.ClosingBalanceWidth@("px")">
            @ViewResources.ClosingBalance
        </div>
        <div class="row" style="width:@ViewBag.AffiliateTransferWidth@("px")">
            @ViewResources.AffiliateTransfer
        </div>
        @if (Model.ProductAccess.IsAllowBa)
        {
            <div class="group-row">
                <div class="row1" style="width: @ViewBag.BaMergeWidth@("px")">
                    @ViewResources.BA
                </div>
                <div class="group-row2">
                    <div class="row2" style="width:@ViewBag.BaTurnoverWidth@("px")">
                        @ViewResources.Turnover
                    </div>
                    <div class="row2" style="width:@ViewBag.BaCommWidth@("px")">
                        @ViewResources.Comm
                    </div>
                    <div class="row2" style="width:@ViewBag.AmountDueToBaWidth@("px")">
                        @ViewResources.AmountDueTo
                    </div>
                </div>
            </div>    
        }
    </div>
</div>

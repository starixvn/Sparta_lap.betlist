<!--Timer countdown control-->
@helper TimerCountDown(string name, int start)
    {
    <input type="hidden" id="count-down-of" name="@name" data-default-value="@start"/>
    <div class="timer-countdown">
        <div id="count" class="button-refresh">
        </div>
        <div class="button-select">
        </div>
    </div>
    <div id="countdown-menu" class="countdown-menu" style="display: none">
        @for (var i = 1; i <= 5; i++)
        {
            <div id="option-@(start)" data-count-down="@start" class="menu-item">
                @start sec</div>
            start += 15;
        }
    </div>    
}
<!-- Format total bets number -->
@helper PositiveFormat(decimal value, bool isFormatZero)
    {
        if (value > 0)
        {
    <span class="positive-number">@value.ToString("#,##0.00")</span>
        }
        else
        {
    <span>@(value == 0 ? (isFormatZero ? "0" : string.Empty) : value.ToString("#,##0.00"))</span>
        }
}
@helper NegativeFormat(decimal value, bool isFormatZero)
    {
        if (value < 0)
        {
    <span class="negative-number">@value.ToString("#,##0.00")</span>
        }
        else
        {
    <span>@(value == 0 ? (isFormatZero ? "0" : string.Empty) : value.ToString("#,##0.00"))</span>
        }
}

@model Fanex.Athena.Model.Report.ViewModel.CustomerPendingFundsViewModel
<div class="page-form">
    <form id="CustomerPendingFundsForm" name="CustomerPendingFundsForm" method="post" action="">
        @Html.AntiForgeryToken()
        @Html.Hidden("OrderItem", Model.Param.OrderItem)
        @Html.Hidden("IsAscSort", Model.Param.IsAscSort)
        @Html.Hidden("IsExportExcel", Model.Param.IsExportExcel)
        <div class="row">
            <div class="input-field col l2 m3 s12">
                @DesktopRazorHelper.CurrencyList(Model.CurrencyList, "select", Model.Param.CurrencyId, true, false)
                <label>@ViewResources.Currency</label>
            </div>
            <div class="col l2 m3 s12 input-field">
                @DesktopRazorHelper.BasedCurrency(Model.Param.BaseCurrency)
                <label>@ViewResources.BaseCurrency</label>
            </div>
            @DesktopRazorHelper.RenderProductFilter(Model.Param.ProductOptions)
            <div class="col l2 m2 s12 button-block">
                <button type="button" id="SubmitButton" class="btn btn-primary">@ViewResources.Submit</button>
            </div>
            <div class="col right icon-block">
                @if (!Model.IsFakeLicensee)
                {
                <i class="icon-book right" id="UserGuide" title="@ViewResources.UserGuide"></i>
                }
                <i class="icon-excel right" title="@ViewResources.ExportToExcel" id="ExportToExcel"></i>
            </div>
        </div>
    </form>
</div>
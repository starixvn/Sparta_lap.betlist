@{
    ViewBag.Title = "LRF - " + ViewResources.Report +
    " - " + ViewResources.Notifications;
    Layout = "~/Views/Desktop/Shared/_ReactPageLayout.cshtml";
}
@model Fanex.Athena.Model.Report.ViewModel.NotificationViewModel
@{
    var appSettings = new AppSettings();
    var minDate = appSettings.HistoryDate;
    var maxDate = appSettings.MaxDate;
    var notificationTypes = Model.NotificationTypes.Select(x => new { value = x.Key, label = x.Value }).ToList();
    var selectedNotificationType = notificationTypes.FirstOrDefault();
    var tabList = new[]
    {
        new { isActive = true, name = ViewResources.Notifications, url = Url.Action("Index", "NotificationReport") },
        new { isActive = false, name = ViewResources.ResultAmendment, url = Url.Action("ResultAmendment", "NotificationReport") }
    };
}

@section pagecss {
    <link href="@Url.ContentLinkByEnv("/www/css/build/reactpages/notification/index.css")" rel="stylesheet" type="text/css" />
}
@section pagejs {
    <script src="@Url.ContentLinkByEnv("/www/js/build/reactpages/notification/notification.chunk.js")"></script>
}

@section globaljscode{
    window.Lrf = {
        dateRange: {fromDate: '@Model.FromDate.ToString("MM/dd/yyyy")', toDate: '@Model.ToDate.ToString("MM/dd/yyyy")'},
        xsrfToken: document.querySelector("input[name=__RequestVerificationToken]").value,
        isLoading: false,
        dateConstraint: {minDate: '@minDate.ToString("MM/dd/yyyy")', maxDate: '@maxDate.ToString("MM/dd/yyyy")'},
        notificationTypes: @Html.Raw(notificationTypes.ToJson()),
        selectedNotificationType: '@(selectedNotificationType != null ? selectedNotificationType.value : string.Empty)',
        tabList: @Html.Raw(tabList.ToJson())
    }
}
<div id="app-container">

</div>

@model Fanex.Athena.Model.TotalBet.ViewModel.HalfTimeFullTimeViewModel

@helper RenderFirstRow()
{
    <tr class="first-row">
        <td class="col-small"></td>
        <td class="col-medium"></td>
        <td class="col-medium"></td>
        <td class="col-child small"></td>
        <td class="col-child small"></td>
        <td class="col-child small"></td>
        <td class="col-child small"></td>
        <td class="col-child small"></td>
        <td class="col-child small"></td>
        <td class="col-child small"></td>
        <td class="col-child small"></td>
        <td class="col-child small"></td>
    </tr>
}

@if (Model.MainData.Count == 0)
{
    <p class="no-info-row">@ViewResources.NoInfo</p>
}
else
{
    <div class="header-content">
        <table class="table">
            <thead>
                @RenderFirstRow()

                <tr>
                    <th>#</th>
                    <th>@ViewResources.Home</th>
                    <th>@ViewResources.Away</th>
                    <th>@ViewResources.HH</th>
                    <th>@ViewResources.HD</th>
                    <th>@ViewResources.HA</th>
                    <th>@ViewResources.DH</th>
                    <th>@ViewResources.DD</th>
                    <th>@ViewResources.DA</th>
                    <th>@ViewResources.AH</th>
                    <th>@ViewResources.AD</th>
                    <th class="col-last">@ViewResources.AA</th>
                </tr>
            </thead>
        </table>
    </div>

    <div class="body-content">
        <table class="table">
            <tbody>
                @RenderFirstRow()
                @{ Html.RenderPartial("~/Views/Desktop/TotalBets/HalfTimeFullTime/ContentData.cshtml"); }
            </tbody>
        </table>
    </div>

    <div class="footer-content">
        <table class="table">
            <tbody>
                @RenderFirstRow()

                <tr class="total total-footer">
                    <td class="right-align total-label" colspan="3">
                        @ViewResources.Total
                    </td>
                    <td class="right-align no-margin" colspan="9">
                        @RazorHelperDesktop.DecFormat(Model.TotalRunningStake, true, false)
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
                    }
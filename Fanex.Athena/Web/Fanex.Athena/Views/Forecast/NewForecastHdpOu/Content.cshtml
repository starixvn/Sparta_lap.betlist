@{
    Layout = null;    
}
@model Fanex.Athena.Models.ViewModel.Forecast.NewForecastHdpOuViewModel
@{    
    var firstHalfType = 1; // 1st Half Handicap/Over Under
    var fulltimeType = 3;  // Full Time Handicap / Over Under
    var firstHalfTotal = Model.MainData.TotalItemList.Where(x => x.Type == firstHalfType);
    var fullTimeTotal = Model.MainData.TotalItemList.Where(x => x.Type == fulltimeType);
    var firstHalfHdpDetail = Model.MainData.DetailItemList.Where(x => x.Bettype == 7);
    var firstHalfOuDetail = Model.MainData.DetailItemList.Where(x => x.Bettype == 8);
    var fullTimeHdpDetail = Model.MainData.DetailItemList.Where(x => x.Bettype == 1);
    var fullTimeOuDetail = Model.MainData.DetailItemList.Where(x => x.Bettype == 3);
}
<div class="grid_4 push_16 match-info-font">
    @ViewResources.Score
    <span class="match-info-score score red-color">@Model.HeaderInfo.HomeScore : @Model.HeaderInfo.AwayScore</span>
</div>
<div class="grid_6 push_15 match-info-font">
    @ViewResources.Time
    <span class="kick-off-time red-color">
        @Model.HeaderInfo.KickOffDateString
    </span>
</div>
<div class="clear">
</div>
<div class="data-content">
    @if (Model.MainData.TotalItemList.Count == 0)
    {
        <div class="no-info-div">@ViewResources.NoInfo</div>
    }
    @if (firstHalfTotal.Count() > 0)
    {
        ViewBag.BlockId = firstHalfType;
        ViewBag.TotalList = firstHalfTotal.ToList();
        ViewBag.DetailHdpList = firstHalfHdpDetail.ToList();
        ViewBag.DetailOuList = firstHalfOuDetail.ToList();
        ViewBag.HeaderText = ViewResources.lbl1st + " " + ViewResources.Half.ToUpper();
        ViewBag.IsFullTime = false;
        ViewBag.IsExpand = Model.Param.IsShowFH;

        Html.RenderPartial("~/Views/Forecast/NewForecastHdpOu/Content.ForecastItem.cshtml");
    }
    @if (fullTimeTotal.Count() > 0)
    {
        <br />
        ViewBag.BlockId = fulltimeType;
        ViewBag.TotalList = fullTimeTotal.ToList();
        ViewBag.DetailHdpList = fullTimeHdpDetail.ToList();
        ViewBag.DetailOuList = fullTimeOuDetail.ToList();
        ViewBag.HeaderText = ViewResources.Full.ToUpper() + " " + ViewResources.Time.ToUpper();
        ViewBag.IsFullTime = true;
        ViewBag.IsExpand = Model.Param.IsShowFT;

        Html.RenderPartial("~/Views/Forecast/NewForecastHdpOu/Content.ForecastItem.cshtml");
    }
</div>

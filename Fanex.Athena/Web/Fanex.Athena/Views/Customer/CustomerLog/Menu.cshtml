@{
    Layout = null;
}
@section css
{
    <link href="@Url.ContentLink("/Content/Customer/BetSetting/BetSetting.css")" rel="stylesheet" type="text/css" />
}
@section js
{
    <script src="@Url.ContentLink("/Scripts/Customer/CustomerLog/customerlog.js")" type="text/javascript"></script>
}
@{
    var sessionService = new Fanex.Athena.Service.Core.Users.SessionService();
    var hasCustComm = sessionService.LicenseeSession != null && sessionService.LicenseeSession.IsAllowedCustomerComm;
}
@using Fanex.Athena.Model.Report.ViewModel
<div id="header_tab">
    <div id="button_main">
        <ul class="header-menu">
            <!--Login log tab-->
            <li><a href="@Url.Action("LogInLog", "CustomerLog")" id="loginlog">@ViewResources.General
            </a></li>
            <!--/Login log tab-->
            <!--Customer setting log-->
            <li><a href="@Url.Action("CustomerSetting", "CustomerLog")" id="customersettinglog">@ViewResources.CustomerSetting
            </a></li>
            <!--/Customer setting log-->
            <!--Group commission tab-->
            @if (hasCustComm)
            {
                <li><a href="@Url.Action("GroupCommission", "CustomerLog")" id="groupcommlog">@ViewResources.GroupCommission</a></li>
            }
            <!--/Group commission tab-->
        </ul>
    </div>
</div>
